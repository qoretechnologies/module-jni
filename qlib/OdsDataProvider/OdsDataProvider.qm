# minimum required Qore version
%requires qore >= 3.0
%modern

# supports using the DataProvider module
%requires(reexport) DataProvider >= 3.9
%requires FileLocationHandler
%requires Util
%requires ValueMask

%module-cmd(jni) add-relative-classpath ./jar/qore-dataprovider-ods.jar
%module-cmd(jni) add-relative-classpath ./jar/odfdom-java-0.13.0.jar
%module-cmd(jni) add-relative-classpath ./jar/xercesImpl-2.12.2.jar
%module-cmd(jni) add-relative-classpath ./jar/serializer-2.7.3.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-lang3-3.20.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-compress-1.28.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-codec-1.19.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-io-2.20.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-logging-1.3.5.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-collections-3.2.2.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-collections4-4.4.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-csv-1.10.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-validator-1.10.1.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-beanutils-1.11.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-digester-2.1.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-cli-1.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/slf4j-api-1.7.30.jar
%module-cmd(jni) add-relative-classpath ./jar/slf4j-nop-1.7.30.jar
%module-cmd(jni) add-relative-classpath ./jar/json-20251224.jar
%module-cmd(jni) add-relative-classpath ./jar/bcprov-jdk18on-1.83.jar
%module-cmd(jni) add-relative-classpath ./jar/caffeine-3.1.8.jar
%module-cmd(jni) add-relative-classpath ./jar/checker-qual-3.37.0.jar
%module-cmd(jni) add-relative-classpath ./jar/error_prone_annotations-2.21.1.jar
%module-cmd(jni) add-relative-classpath ./jar/collection-0.7.jar
%module-cmd(jni) add-relative-classpath ./jar/java-rdfa-1.0.0-BETA1.jar
%module-cmd(jni) add-relative-classpath ./jar/jena-core-4.10.0.jar
%module-cmd(jni) add-relative-classpath ./jar/jena-base-4.10.0.jar
%module-cmd(jni) add-relative-classpath ./jar/jena-iri-4.10.0.jar
%module-cmd(jni) add-relative-classpath ./jar/RoaringBitmap-1.0.0.jar

%module-cmd(jni) import org.qore.dataprovider.ods.OdsIterator
%module-cmd(jni) import org.qore.dataprovider.ods.OdsFile
%module-cmd(jni) import org.qore.dataprovider.ods.OdsGridReader
%module-cmd(jni) import org.qore.dataprovider.ods.OdsWriter

module OdsDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for reading and writing ODS spreadsheets";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factories
        DataProvider::registerFactory(new OdsReadDataProviderFactory());
        DataProvider::registerFactory(new OdsWriteDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": OdsDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "ODS Spreadsheets",
            "short_desc": "Read and write ODS spreadsheets",
            "desc": "Read and write OpenDocument Spreadsheet (ODS) files, the native spreadsheet "
                "format for LibreOffice Calc and other OpenDocument-compatible applications.\n\n"
                "**Supported Operations**:\n"
                "- **Read**: Parse ODS spreadsheets into structured records with automatic header "
                "detection, cell range selection, and multi-sheet access\n"
                "- **Write**: Create ODS spreadsheet files from structured data with configurable "
                "worksheets and column headers\n\n"
                "**Key Features**:\n"
                "- Multi-sheet support: browse and read individual worksheets\n"
                "- Flexible header handling: auto-detect from first row, specify cell ranges, or provide "
                "explicit header names\n"
                "- Cell range selection: read specific regions of a spreadsheet\n"
                "- Data type preservation: handles strings, numbers, booleans, and dates with timezone "
                "support\n"
                "- In-memory operation: read from or write to binary data without file I/O\n\n"
                "**Business Use Cases**:\n"
                "- Importing LibreOffice Calc spreadsheets into data pipelines\n"
                "- Converting ODS data to other formats in ETL workflows\n"
                "- Generating ODS reports from application data\n"
                "- Processing spreadsheet uploads in web applications",
            "groups": (DataProvider::AppGroup::Spreadsheets,),
            "logo": OdsWhiteLogo,
            "logo_file_name": "ods-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OdsDataProvider::AppName,
            "path": "/",
            "action": "read",
            "display_name": "Read ODS Spreadsheet File",
            "short_desc": "Read ODS spreadsheet from a specific file location",
            "desc": "Read an ODS spreadsheet from a file location and return the data as records.\n\n"
                "Use this action to import data from ODS files stored on disk or accessible via a URL. "
                "The file location is resolved using the `FileLocationHandler` module, supporting local "
                "file paths and remote URLs.\n\n"
                "**Key Options**:\n"
                "- `path` (required) — the file location to read from\n"
                "- `worksheet` — select a specific worksheet by name (defaults to the first sheet)\n"
                "- `header_names` — set to `True` to use the first row as column headers\n"
                "- `header_cells` / `data_cells` — specify cell ranges for headers and data\n"
                "- `headers` — provide explicit column header names",
            "action_code": DPAT_FIND,
            "cls": "OdsDataProvider::OdsReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OdsReadDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsReadDataProvider::ConstructorOptions{"worksheet", "data_cells", "header_cells",
                    "header_names"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsReadDataProvider::ConstructorOptions - ("path", "worksheet", "data_cells", "header_cells",
                    "header_names", "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OdsDataProvider::AppName,
            "path": "/",
            "action": "profile",
            "display_name": "Profile ODS Spreadsheet",
            "short_desc": "Describe the layout and columns of every sheet of an ODS spreadsheet",
            "desc": "Describes how every sheet of an OpenDocument spreadsheet (`.ods`) is laid out, so it can be "
                "read correctly before an integration is built around it.\n\n"
                "**Detects:**\n"
                "- hidden sheets, named ranges, merged cells, and formulas\n"
                "- the header row, title rows and banners above it, and the data region\n"
                "- totals and subtotal rows and blank-row gaps\n"
                "- each column's type with a confidence and counter-examples\n"
                "- dates and numbers stored as text in a local format, and identifiers with leading zeros\n\n"
                "Sample values are redacted to their shape by default (`redact`), so a profile can be shared "
                "without the data itself.",
            "action_code": DPAT_API,
            "cls": "OdsDataProvider::OdsProfileDataProvider",
            "output_type": TabularWorkbookProfileDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TabularProfileRequestDataType::Fields{"path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TabularProfileRequestDataType::Fields - ("path",)
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OdsDataProvider::AppName,
            "path": "/",
            "action": "list-worksheets",
            "display_name": "List ODS Worksheets",
            "short_desc": "List the worksheets of an ODS spreadsheet",
            "desc": "Lists the worksheets of an OpenDocument spreadsheet (`.ods`) in spreadsheet order, so the "
                "worksheet to read can be chosen.\n\n"
                "Each worksheet is listed with its name, its 0-based `index`, which the `worksheet` read option "
                "accepts as well as the name, and whether it is `hidden`; hidden worksheets are listed where they "
                "are in the spreadsheet.",
            "action_code": DPAT_API,
            "cls": "OdsDataProvider::OdsListWorksheetsDataProvider",
            "output_type": OdsListWorksheetsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OdsWorksheetListRequestDataType::Fields{"path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsWorksheetListRequestDataType::Fields{"data",}
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OdsDataProvider::AppName,
            "path": "/",
            "action": "read-data",
            "display_name": "Read ODS Spreadsheet Inline Data",
            "short_desc": "Read ODS spreadsheet inline data",
            "desc": "Read an ODS spreadsheet from inline binary data and return the data as records.\n\n"
                "Use this action when the ODS data is already available in memory (e.g., received from "
                "an API response, uploaded by a user, or read from a database BLOB column) rather than "
                "stored as a file.\n\n"
                "**Key Options**:\n"
                "- `data` (required) — the ODS binary data to parse\n"
                "- `worksheet` — select a specific worksheet by name (defaults to the first sheet)\n"
                "- `header_names` — set to `True` to use the first row as column headers\n"
                "- `header_cells` / `data_cells` — specify cell ranges for headers and data\n"
                "- `headers` — provide explicit column header names",
            "action_code": DPAT_FIND,
            "cls": "OdsDataProvider::OdsReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OdsReadDataProvider::ConstructorOptions{"data",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsReadDataProvider::ConstructorOptions{"worksheet", "data_cells", "header_cells",
                    "header_names"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsReadDataProvider::ConstructorOptions - ("path", "worksheet", "data_cells", "header_cells",
                    "header_names", "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OdsDataProvider::AppName,
            "path": "/",
            "action": "write",
            "display_name": "Write ODS Spreadsheet File",
            "short_desc": "Write data to an ODS spreadsheet file",
            "desc": "Write data to an ODS spreadsheet file at a specified path.\n\n"
                "Use this action to generate ODS files from structured data for reporting, data export, "
                "or integration with LibreOffice Calc and other OpenDocument-compatible applications.\n\n"
                "**Key Options**:\n"
                "- `path` (required) — the output file location\n"
                "- `worksheet` — the worksheet name (defaults to `Sheet1`)\n"
                "- `headers` — explicit column header names; if not provided, headers are auto-detected "
                "from the first record\n"
                "- `column_formats` — the display format of columns, such as `dd.mm.yyyy` or `#,##0.00`\n"
                "- `column_masks` — the display format of columns as masks, such as `DD.MM.YYYY` or `#.##0,00 €`",
            "action_code": DPAT_CREATE,
            "cls": "OdsDataProvider::OdsWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OdsWriteDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsWriteDataProvider::ConstructorOptions{"worksheet", "headers"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsWriteDataProvider::ConstructorOptions - ("path", "worksheet", "headers", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OdsDataProvider::AppName,
            "path": "/",
            "action": "write-data",
            "display_name": "Create ODS Spreadsheet Data",
            "short_desc": "Create ODS spreadsheet data and return as binary",
            "desc": "Create ODS spreadsheet data in memory and return it as binary data.\n\n"
                "Use this action when you need to generate an ODS file without writing to disk — for "
                "example, to return the spreadsheet as an API response, store it in a database, or pass "
                "it to another processing step. The action returns the generated spreadsheet in `data` and "
                "the number of records in `record_count`.\n\n"
                "**Key Options**:\n"
                "- `worksheet` — the worksheet name (defaults to `Sheet1`)\n"
                "- `headers` — explicit column header names; if not provided, headers are auto-detected "
                "from the first record\n"
                "- `column_formats` — the display format of columns, such as `dd.mm.yyyy` or `#,##0.00`\n"
                "- `column_masks` — the display format of columns as masks, such as `DD.MM.YYYY` or `#.##0,00 €`",
            "action_code": DPAT_CREATE,
            "output_data_type": DPAD_CREATE_OUTPUT,
            "output_type": OdsGeneratedDataOutputDataType,
            "cls": "OdsDataProvider::OdsWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OdsWriteDataProvider::ConstructorOptions{"worksheet", "headers"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OdsWriteDataProvider::ConstructorOptions - ("path", "worksheet", "headers", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
    };
    # PROCESS_CONTROL: its init registers data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage OdsDataProvider Module

    @tableofcontents

    @section odsdataproviderintro OdsDataProvider Module Introduction

    <img src="ods-logo.svg" width="96" alt="OdsDataProvider module logo"/>

    @anchor OdsDataProviderintro

    The %OdsDataProvider module provides a data provider API for reading and writing ODS
    (OpenDocument Spreadsheet) files through the @ref dataproviderintro "DataProvider" API.
    ODS is the native spreadsheet format for LibreOffice Calc and other OpenDocument-compatible
    applications.

    Records are read from a sheet one row at a time as they are iterated, so sheets of any size are read in bounded
    memory; the runs of repeated rows and cells that spreadsheet applications write are not expanded.  The input (a
    location, a stream, or binary data) is copied once to a temporary file, in bounded memory, which is read for the
    record type, the records, the worksheet names, and the worksheet providers, and deleted with the last provider
    using it.

    Float, currency, and percentage cells are read as numbers (a currency cell is its amount, a percentage cell its
    fraction, such as \c 0.25 for 25%), boolean cells as booleans, date and time cells as dates, and other cells as
    their text.

    Date cells have no time zone in the file: a date cell is its clock time in the zone given with the \c timezone
    option (the local zone by default), whatever the zone of the JVM.  A clock time that does not exist in that zone,
    because clocks are put forward then, is moved later by the length of the gap (02:30 on the day clocks go from
    02:00 to 03:00 is 03:30); a clock time that occurs twice, when clocks are put back, is the earlier one.  A time
    cell is its clock time on 1899-12-31, the date that Excel time cells are read with; a time over 24 hours
    continues on the following days.

    A \c data_cells range without an end column (e.g., \c "b2") ends at the last header column, or, without headers,
    at the last cell with a value in each row.

    With the \c formula_field option, every record has an extra field with that name holding the formulas of the
    record's cells: a hash of the formula text in A1 notation (\c "SUM(B2:B4)" for the ODF formula
    \c "of:=SUM([.B2:.B4])"), as the \c profile action gives it, by the cell's reference in the sheet (\c "B5"), or
    @ref nothing if none of the cells holds a formula; a formula repeated over several columns or rows is given for
    the first of them.  Passing the field to
    @ref DataProvider::TabularProfiler::hasTotalsFormula() "TabularProfiler::hasTotalsFormula()" recognizes a totals
    row made of \c SUM formulas as the profile does.  A name that is a column of the sheet raises
    \c ODS-FORMULA-FIELD-ERROR.

    When the sheet has headers, the type of each column is inferred from its values in the first data rows
    (\c type_sample_rows, 100 by default; \c 0 reads every value as stored), as the spreadsheet profile classifies
    them: a column of whole numbers is an \c int column, of numbers a \c float column, of booleans a \c bool column,
    of dates and times a \c date column, and of text a \c string column; a column with values of different kinds, or
    with no values, is returned as stored.  The record type has the column types, and the values are converted to
    them: a whole number in an \c int column is an integer rather than a float.  The \c column_types option gives the
    type of columns by name: \c string, \c int, \c float, \c number, \c bool, \c date, or \c any; \c string
    converts numbers, booleans and dates to text, for example identifiers stored as numbers.  A later value that its
    column's type does not accept fails the read with \c ODS-COLUMN-TYPE-ERROR, which names the sheet, row, column,
    value and type, and the remedies:

    @code{.py}
    # an order number column that has text after the first 100 rows, and amounts as arbitrary-precision numbers
    OdsReadDataProvider dp("orders.ods", {
        "header_names": True,
        "column_types": {"Order No": "string", "Amount": "number"},
    });
    @endcode

    A formula whose result is an error, such as \c \#DIV/0!, \c \#N/A or \c Err:502, fails the read with
    \c ODS-CELL-ERROR by default, naming the sheet, cell, column and error.  With \c error_cells set to \c null,
    error cells have no value; with \c text, their value is the error's text in any column.  The \c error_field
    option returns the errors of each record in a field of their own, a hash of the error text by column, and accepts
    error cells, which are then read as no value unless \c error_cells is \c text.  Error cells are recognized as
    LibreOffice marks them (\c calcext:value-type="error"); OpenDocument itself has no error value type, so a file
    saved by a program that writes errors without this mark has text cells instead.

    The write provider writes numbers as float cells, booleans as boolean cells, dates as date cells with their date
    and clock time (with no time zone, as read above), no value as an empty cell, and other values as text.  Its
    \c column_formats option gives columns a display format code, as LibreOffice and Excel write them, which is
    written as an OpenDocument data style; the cells keep their real values:

    @code{.py}
    OdsWriteDataProvider dp("invoices.ods", {
        "headers": ("Invoice", "Date", "Amount", "Discount"),
        "column_formats": {
            "Date": "dd.mm.yyyy",
            "Amount": "#,##0.00;(#,##0.00)",
            "Discount": "0.0%",
        },
    });
    # the date is shown as 07.10.2026, the amount as (1,234.50) and the discount as 2.5%
    dp.createRecord({"Invoice": "INV-1", "Date": 2026-10-07, "Amount": -1234.5, "Discount": 0.025});
    dp.finishCreate();
    @endcode

    The format codes are those of the @ref ExcelDataProvider_writing_column_formats "ExcelDataProvider writer",
    and each code is shown the same way in both kinds of file.  A number in a column with a percent code is written
    as a percentage cell, which holds the fraction and is read back as a number.  An invalid or unsupported code, or
    a format for a column that is not written, raises \c ODS-WRITE-OPTION-ERROR naming the column and the problem.
    Each distinct code is one data style in the document, whatever the number of rows.

    The \c column_masks option gives columns their display format as masks of the @ref valuemaskintro "ValueMask"
    module, such as \c DD.MM.YYYY or <tt>#.##0,00 €</tt>, the masks that CSV files and the sheet contracts of
    Qorus design mode are read and written with, as for the
    @ref ExcelDataProvider_writing_column_masks "ExcelDataProvider writer": each mask becomes the display format code
    of its column, the separators are shown as the language of whoever opens the file uses them, and a mask without
    a display format raises \c ODS-WRITE-OPTION-ERROR naming the column and the reason.  The \c column_headers
    option gives header text that is not the column name, \c write_headers set to \c False writes no header row,
    and the \c timezone option gives the time zone whose wall-clock time dates are written in.  The \c sheets option
    writes the records to several worksheets, each chosen by a condition (see @ref OdsDataProvider_writing_sheets).

    The following classes are provided by this module:
    - @ref OdsDataProvider::OdsReadDataProvider "OdsReadDataProvider" - for reading ODS files
    - @ref OdsDataProvider::OdsReadDataProviderFactory "OdsReadDataProviderFactory" - factory for read providers
    - @ref OdsDataProvider::OdsWriteDataProvider "OdsWriteDataProvider" - for writing ODS files
    - @ref OdsDataProvider::OdsWriteDataProviderFactory "OdsWriteDataProviderFactory" - factory for write providers
    - @ref OdsDataProvider::OdsWorksheetReadDataProvider "OdsWorksheetReadDataProvider" - for reading specific worksheets
    - @ref OdsDataProvider::OdsListWorksheetsDataProvider "OdsListWorksheetsDataProvider" - for listing the
      worksheets of a spreadsheet (the \c list-worksheets action)

    @section OdsDataProvider_writing_sheets Writing Several Worksheets

    The \c sheets option writes the records to several worksheets: each worksheet is a hash with its name in
    \c worksheet, its columns in \c columns, and in \c when the condition of its records in DPQL with the fields
    of the record, such as <tt>\@kind == "order"</tt>.  A record is written to the first worksheet whose condition it
    matches, so a worksheet without a condition, listed last, takes every other record:

    @code{.py}
    OdsWriteDataProvider dp("orders.ods", {"sheets": (
        {"worksheet": "Orders", "columns": ("Id", "Amount"), "when": "@kind == \"order\"",
            "column_formats": {"Amount": "#,##0.00"}},
        {"worksheet": "Returns", "columns": ("Id", "Reason"), "when": "@kind == \"return\""},
        {"worksheet": "Other"},
    )});
    dp.createRecord({"kind": "order", "Id": 1, "Amount": 1234.5});
    dp.createRecord({"kind": "return", "Id": 2, "Reason": "damaged"});
    dp.createRecord({"kind": "note", "Id": 3, "Text": "call back"});
    dp.finishCreate();
    @endcode

    - the worksheets are written in the order given, and each one is created, also without records; a worksheet
      whose columns are given has its header row
    - a column that a record has no value for is an empty cell, and the other fields of the record, such as the
      \c kind field above, are not written to the worksheet; a worksheet without \c columns has the fields of the
      first record written to it
    - each worksheet can have its own \c column_headers, \c column_formats, \c column_masks and \c write_headers,
      which mean what the options of the same name mean; these options and \c worksheet and \c headers are then given
      for each worksheet only, while \c timezone applies to the document
    - a worksheet name is not empty and differs from the names of the other worksheets in more than case; unlike an
      Excel worksheet name, it can have more than 31 characters and any characters
    - with \c route set to \c "all", a record is written to every worksheet whose condition it matches, so a
      document can have a worksheet with every record and another with the returns
    - a record that matches no worksheet raises \c ODS-WRITE-ROUTE-ERROR, naming the record (its number among the
      records written) and the conditions of the worksheets, unless \c unmatched is \c "skip"; a skipped record is
      not counted; a condition that cannot be evaluated for a record, such as one with a field that the record does
      not have, raises \c ODS-WRITE-ROUTE-ERROR naming the record and the worksheet
    - as every error raised when a record is created, a route error reaches the caller of
      @ref DataProvider::AbstractDataProvider::createRecord() "createRecord()" as \c CREATE-RECORD-ERROR, whose
      description begins with the error code: <tt>ODS-WRITE-ROUTE-ERROR: data provider ...: record 3 matches no
      worksheet; ...</tt>
    - the \c write-data action returns the number of records written to each worksheet in \c sheet_counts, by
      worksheet name in document order (see @ref OdsDataProvider::OdsGeneratedDataInfo "OdsGeneratedDataInfo");
      with \c route \c "all", a record written to two worksheets is counted in each, while \c record_count counts
      it once

    @code{.py}
    hash<OdsGeneratedDataInfo> output = dp.finishCreate();
    # {"data": <ods>, "record_count": 120, "sheet_counts": {"Orders": 100, "Returns": 15, "Other": 5}}
    @endcode

    Records of different shapes are told apart with the DPQL operator \c exists, which tests whether the record has a
    field (@ref dpql_exists "exists", %DataProvider 3.11): below, a record without \c type does not match the first
    worksheet and is written to the next one, where <tt>\@type == "return"</tt> alone would raise
    \c ODS-WRITE-ROUTE-ERROR for it:

    @code{.py}
    OdsWriteDataProvider dp("returns.ods", {"sheets": (
        {"worksheet": "Returns", "when": "exists @type && @type == \"return\""},
        {"worksheet": "Other"},
    )});
    dp.createRecord({"type": "return", "id": 1});
    # no type: written to the Other worksheet
    dp.createRecord({"id": 2});
    dp.finishCreate();
    @endcode

    An invalid worksheet, an invalid condition, or a worksheet option for a column that is not written raises
    \c ODS-WRITE-OPTION-ERROR naming the worksheet.  As the conditions can use fields that are not written, the
    record type of the provider is open with \c sheets.

    @section OdsDataProvider_relnotes Release Notes

    @subsection OdsDataProvider_v1_0 OdsDataProvider v1.0
    - initial release
*/

#! contains all public definitions in the OdsDataProvider module
public namespace OdsDataProvider {
#! Application name
public const AppName = "ODS";
}

namespace Priv {
#! ODS logo
const OdsWhiteLogo = File::readTextFile(get_script_dir() + "/ods-logo.svg");
}
