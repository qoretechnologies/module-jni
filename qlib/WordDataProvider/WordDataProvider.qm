# minimum required Qore version
%requires qore >= 3.0
%modern

# supports using the DataProvider module
%requires(reexport) DataProvider >= 3.12
%requires FileLocationHandler
%requires Util

%module-cmd(jni) add-relative-classpath ./jar/qore-dataprovider-word.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/poi-5.5.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/poi-ooxml-5.5.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/poi-ooxml-full-5.5.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/commons-compress-1.28.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/commons-io-2.20.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/commons-codec-1.19.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/commons-lang3-3.18.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/commons-math3-3.6.1.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/curvesapi-1.08.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/xmlbeans-5.3.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/commons-collections4-4.5.0.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/log4j-api-2.24.3.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/log4j-to-slf4j-2.24.3.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/slf4j-api-2.0.16.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/slf4j-nop-2.0.16.jar
%module-cmd(jni) add-relative-classpath ../ExcelDataProvider/jar/SparseBitSet-1.3.jar

%module-cmd(jni) import org.qore.dataprovider.word.WordIterator
%module-cmd(jni) import org.qore.dataprovider.word.WordTemplate
%module-cmd(jni) import org.qore.dataprovider.word.WordWriter

module WordDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for reading and writing Word documents";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factories
        DataProvider::registerFactory(new WordReadDataProviderFactory());
        DataProvider::registerFactory(new WordWriteDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": WordDataProvider::AppName,
            "presentation_source_locale": "en",
            # Java calls are uncontrolled APIs (QDOM_UNCONTROLLED_API) that a governing sandbox refuses,
            # also from library code running for a sandboxed caller (qore#5741): sandboxed callers are refused
            # up front instead of failing in the middle of a call
            "external_io": True,
            "display_name": "Word Documents",
            "short_desc": "Read and write Microsoft Word documents",
            "desc": "Read and write Microsoft Word documents (.docx format)",
            "groups": (DataProvider::AppGroup::Documents,),
            "logo": WordLogo,
            "logo_file_name": "word-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WordDataProvider::AppName,
            "path": "/",
            "action": "read",
            "display_name": "Read Word Document File",
            "short_desc": "Read Word document from a specific file location",
            "desc": "Read Word document from a specific file location",
            "action_code": DPAT_FIND,
            "cls": "WordDataProvider::WordReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                WordReadDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                WordReadDataProvider::ConstructorOptions{"content_type", "table_index", "header_row"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                WordReadDataProvider::ConstructorOptions - ("path", "content_type", "table_index", "header_row",
                    "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WordDataProvider::AppName,
            "path": "/",
            "action": "read-data",
            "display_name": "Read Word Document Inline Data",
            "short_desc": "Read Word document inline data",
            "desc": "Read Word document inline data",
            "action_code": DPAT_FIND,
            "cls": "WordDataProvider::WordReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                WordReadDataProvider::ConstructorOptions{"data",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                WordReadDataProvider::ConstructorOptions{"content_type", "table_index", "header_row"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                WordReadDataProvider::ConstructorOptions - ("path", "content_type", "table_index", "header_row",
                    "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WordDataProvider::AppName,
            "path": "/",
            "action": "write",
            "display_name": "Write Word Document File",
            "short_desc": "Write data to a Word document file",
            "desc": "Write data to a Word document file at a specified path",
            "action_code": DPAT_CREATE,
            "cls": "WordDataProvider::WordWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                WordWriteDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                WordWriteDataProvider::ConstructorOptions{"content_type", "headers", "title"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WordDataProvider::AppName,
            "path": "/",
            "action": "write-data",
            "display_name": "Create Word Document Data",
            "short_desc": "Create Word document data and return as binary",
            "desc": "Create Word document data in memory and return it as binary data; useful for generating "
                "Word files without writing to disk",
            "action_code": DPAT_CREATE,
            "output_data_type": DPAD_CREATE_OUTPUT,
            "output_type": GeneratedDataOutputDataType,
            "cls": "WordDataProvider::WordWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                WordWriteDataProvider::ConstructorOptions{"content_type", "headers", "title"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WordDataProvider::AppName,
            "path": "/",
            "action": "inspect-template",
            "display_name": "Inspect Word Template",
            "short_desc": "Inspect Word Template",
            "desc": "Discover required scalar fields and repeating row mappings in a DOCX template.",
            "action_code": DPAT_API,
            "cls": "WordDataProvider::WordTemplateFieldsDataProvider",
            "output_type": WordTemplateFieldsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(WordTemplateRequestType::SourceFields),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": WordDataProvider::AppName,
            "path": "/",
            "action": "fill-template",
            "display_name": "Fill Word Template",
            "short_desc": "Fill Word Template",
            "desc": "Fill named text controls and repeating table rows. Returns DOCX bytes and optionally writes a location.",
            "action_code": DPAT_API,
            "cls": "WordDataProvider::WordFillTemplateDataProvider",
            "output_type": GeneratedDataOutputDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                WordTemplateRequestType::FillFields{"mappings",}, {"required": True, "preselected": True}
            ) + DataProviderActionCatalog::getActionOptionFromFields(WordTemplateRequestType::FillFields - "mappings"),
        });
    };
    # PROCESS_CONTROL: its init registers data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage WordDataProvider Module

    @tableofcontents

    @section worddataproviderintro WordDataProvider Module Introduction

    <img src="word-logo.svg" width="96" alt="WordDataProvider module logo"/>

    @anchor WordDataProviderintro

    The %WordDataProvider module provides a data provider API for reading and writing Microsoft Word documents
    through the @ref dataproviderintro "DataProvider" API. It supports the modern .docx format (Word 2007+)
    using Apache POI's XWPF library.

    The following classes are provided by this module:
    - @ref WordDataProvider::WordReadDataProvider "WordReadDataProvider" - for reading Word documents
    - @ref WordDataProvider::WordReadDataProviderFactory "WordReadDataProviderFactory" - factory for read providers
    - @ref WordDataProvider::WordWriteDataProvider "WordWriteDataProvider" - for writing Word documents
    - @ref WordDataProvider::WordWriteDataProviderFactory "WordWriteDataProviderFactory" - factory for write providers

    @par Sandbox access
    The app requires DataProvider 3.12 or later and declares <tt>external_io</tt> for its Java calls.
    Data provider consumers reject sandboxed callers with <tt>APP-SANDBOX-ACCESS-DENIED</tt>.

    @par File system restrictions
    With the \c jni module loaded, a restriction of the \c FILESYSTEM functional domain by parse options is only a
    boundary together with \c PO_NO_UNCONTROLLED_APIS: code that may use uncontrolled APIs can import Java classes
    such as those of \c java.io and \c java.nio itself.

    @par Request locations
    A request location of the file system, such as the \c template_path and \c path fields of the
    \c inspect-template and \c fill-template actions, is refused to code that is restricted from the
    \c FILESYSTEM functional domain (\c PERMISSION-DENIED), also when the provider was created by host code and
    lent to such code; see @ref Qore::SandboxManager::isLentToRestricted()
    "SandboxManager::isLentToRestricted()".  Such code that was lent the provider is also refused a location of
    another scheme with options in the location string, as options can name local files that the location's
    handler reads,
    and a location of a scheme without a handler.

    @section WordDataProvider_reading Reading Word Documents

    @subsection WordDataProvider_reading_paragraphs Reading Paragraphs

    @code{.py}
    %requires WordDataProvider

    # Read paragraphs from a file path
    WordReadDataProvider dp("document.docx", {"content_type": "paragraphs"});
    list<hash<auto>> paragraphs = map $1, dp.searchRecords();

    # Each record has:
    # - "text": The paragraph text content
    # - "style": The paragraph style (e.g., "Normal", "Heading1")
    @endcode

    @subsection WordDataProvider_reading_tables Reading Tables

    @code{.py}
    %requires WordDataProvider

    # Read table data from a document
    WordReadDataProvider dp("document.docx", {
        "content_type": "table",
        "table_index": 0,       # First table (0-based index)
        "header_row": True,     # First row contains headers
    });
    list<hash<auto>> rows = map $1, dp.searchRecords();

    # Read with explicit headers
    WordReadDataProvider dp2("document.docx", {
        "content_type": "table",
        "headers": ("Name", "Department", "Salary"),
    });
    @endcode

    @subsection WordDataProvider_reading_options Read Options

    - \c path: Path to the Word document
    - \c stream: Input stream for Word data
    - \c data: Binary Word document data
    - \c content_type: "paragraphs" (default) or "table"
    - \c table_index: Index of table to read (0-based, for table mode)
    - \c header_row: If \c True, first row of table contains headers
    - \c headers: List of header names to use

    @section WordDataProvider_writing Writing Word Documents

    @subsection WordDataProvider_writing_paragraphs Writing Paragraphs

    @code{.py}
    %requires WordDataProvider

    # Write paragraphs to a file
    WordWriteDataProvider dp("output.docx", {
        "content_type": "paragraphs",
        "title": "My Document",
    });

    dp.createRecord({"text": "First paragraph content", "style": "Normal"});
    dp.createRecord({"text": "Section Heading", "style": "Heading1"});
    dp.createRecord({"text": "More content here.", "style": "Normal"});

    dp.commit();  # Write the file
    @endcode

    @subsection WordDataProvider_writing_tables Writing Tables

    @code{.py}
    %requires WordDataProvider

    # Write table data to a file
    WordWriteDataProvider dp("output.docx", {
        "content_type": "table",
        "headers": ("Name", "Department", "Salary"),
        "title": "Employee Directory",
    });

    dp.createRecord({"Name": "Alice Smith", "Department": "Engineering", "Salary": "75000"});
    dp.createRecord({"Name": "Bob Johnson", "Department": "Marketing", "Salary": "65000"});

    dp.commit();  # Write the file
    @endcode

    @subsection WordDataProvider_writing_binary Writing to Binary

    @code{.py}
    %requires WordDataProvider

    # Create document in memory
    WordWriteDataProvider dp({
        "content_type": "paragraphs",
        "title": "In-Memory Document",
    });

    dp.createRecord({"text": "Some content"});

    # Get binary data instead of writing to file
    binary data = dp.getData();
    @endcode

    @subsection WordDataProvider_writing_options Write Options

    - \c path: Output file path
    - \c stream: Output stream
    - \c content_type: "paragraphs" (default) or "table"
    - \c headers: List of column headers (for table mode)
    - \c title: Optional document title (added as Heading1)

    @section WordDataProvider_templates Filling an approved DOCX template

    Use the Word actions <tt>inspect-template</tt> and <tt>fill-template</tt> with an existing transitional
    <tt>.docx</tt> file. In Word, set the Tag property of each control to a letter or underscore followed by
    letters, digits or underscores. A plain-text control occupies a single run in a paragraph. A repeating section
    in a table contains one repeating-section item with one prototype row. Tag its plain-text columns as well.

    @code{.py}
    WordTemplateFieldsDataProvider inspector();
    auto fields = inspector.doRequest({"template_path": letter_location}).fields;
    WordFillTemplateDataProvider filler();
    auto result = filler.doRequest({
        "template_path": letter_location,
        "mappings": {"customer": "Hill Stores", "lines": ({"item": "Tea", "quantity": 2},)},
    });
    binary letter = result.data;
    @endcode

    Both actions accept exactly one of <tt>template_path</tt> (a readable FileLocationHandler location) and
    <tt>template_data</tt> (the template bytes). Discovery returns each tag's <tt>type</tt> and
    <tt>required</tt> flag, plus <tt>fields</tt> for a row section. All tags require mappings. Supply single-line
    strings, numbers or booleans for scalar values and a list of records for a section. An empty list removes its
    prototype row. The fill action returns the DOCX in <tt>data</tt> with <tt>record_count</tt> equal to one.
    Its optional <tt>path</tt> writes the same bytes through FileLocationHandler after validation.

    The rendered text keeps the run style, and rows retain their cell and paragraph formatting. Other package
    parts, including static headers, footers, images and styles, retain their original contents. Word lays out
    the result when it opens it, so longer strings or extra rows can change line breaks and pagination.
    Legacy DOC, macro-enabled files, signed documents, external relationships, Word fields, data-bound controls,
    and controls in headers or footers are unsupported. The input package may contain up to 4096 parts and occupy
    up to 64 MiB, both before and after decompression. Both actions use the Word app's sandbox policy.

    @section WordDataProvider_styles Paragraph Styles

    When writing paragraphs, the following style names are supported:
    - \c "Normal": Regular paragraph text
    - \c "Heading1": Main heading (bold, 16pt)
    - \c "Heading2": Secondary heading (bold, 14pt)
    - \c "Heading3": Tertiary heading (bold, 12pt)

    @section WordDataProvider_errors Error Handling

    Common exceptions:
    - \c WORD-READ-OPTION-ERROR: Invalid read options or option conflicts
    - \c WORD-WRITE-OPTION-ERROR: Invalid write options or option conflicts

    @anchor WordDataProvider_relnotes

    @subpage worddataproviderreleasenotes
*/

/** @page worddataproviderreleasenotes WordDataProvider Release Notes

    @section WordDataProvider_v1_0 WordDataProvider Module Version 1.0
    - initial release
    - request locations of the file system are refused to code that is restricted from the \c FILESYSTEM
      functional domain, also when the provider was lent to it
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
*/

#! contains all public definitions in the WordDataProvider module
public namespace WordDataProvider {
#! Application name
public const AppName = "Word";
}

namespace Priv {
#! Word logo
const WordLogo = File::readTextFile(get_script_dir() + "/word-logo.svg");

#! Refuses a request location of the file system to code that a provider was lent to and that is restricted from it
/** FileLocationHandler refuses a location to calling code that is restricted from the functional domains of the
    location's handler (@ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()"), but
    inside a method of a provider that the host lent to such code, the code that the provider was lent to does not
    count for it; a request location is given by that code, so it is checked here with
    @ref Qore::SandboxManager::isLentToRestricted() "SandboxManager::isLentToRestricted()" before it is used
    (qore#7811).  The location's handler is resolved as FileLocationHandler resolves it: the scheme (\c file if none
    is given), and the options in the location string, which can name local files for other schemes.

    The code of this function is the same in each module that has it (see test/jni-provider-path-restricted.qtest).

    @param provider the name of the provider, for the error
    @param field the name of the request field, for the error
    @param location the location from the request

    @throw PERMISSION-DENIED the code that the provider was lent to, or the calling code, is restricted from the
    \c FILESYSTEM functional domain, and the location's handler uses the file system for the caller, the code that
    the provider was lent to gave options in the location string, or the location's scheme has no handler
*/
sub check_request_location(string provider, string field, string location) {
    if (!SandboxManager::isLentToRestricted(DOM_FILESYSTEM)) {
        return;
    }
    string scheme = (location =~ x/^(\w+):\/\//)[0] ?? "file";
    *hash<auto> opts;
    if (*string opt_str = (location =~ x/((?:{).*(?:}))$/)[0]) {
        try {
            auto v = parse_to_qore_value(opt_str);
            if (v.typeCode() == NT_HASH) {
                opts = v;
            } else if (v.strp()) {
                opts = {v: True};
            }
        } catch (hash<ExceptionInfo> ex) {
            # an option string that cannot be parsed is refused by FileLocationHandler when the location is used
        }
    }
    AbstractFileLocationHandler handler;
    try {
        handler = FileLocationHandler::getHandler(scheme);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != "SCHEME-ERROR") {
            rethrow;
        }
        # a scheme without a handler now could have one when FileLocationHandler resolves the location, which would
        # then not be judged here
        throw "PERMISSION-DENIED", sprintf("the calling code may not use the %y location in the %s request field "
            "%y, which has no handler, as it is restricted from the FILESYSTEM functional domain", scheme, provider,
            field);
    }
    # options in the location string can name local files that a handler reads for the caller with FileLocationHandler
    # (for example the swagger, certificate and key options of other schemes, or the options that the handler of a
    # conn location gives to the handler of its connection), and FileLocationHandler judges the code that the
    # provider was lent to as unrestricted, so a location with options is refused to such code; a calling code that
    # is restricted itself is judged by FileLocationHandler
    if ((handler.getCallerDomains(scheme, opts) & DOM_FILESYSTEM)
        || (opts && !SandboxManager::isCallerRestricted(DOM_FILESYSTEM))) {
        throw "PERMISSION-DENIED", sprintf("the calling code may not use this %y location in the %s request field "
            "%y, as it is restricted from the FILESYSTEM functional domain", scheme, provider, field);
    }
}
}
