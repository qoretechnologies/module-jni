# minimum required Qore version
%requires qore >= 3.0
%modern

# import Flyway and dependency JARs: must be added to the global classloader
# because Flyway uses JDBC connections that persist through thread pools
%module-cmd(jni) global-add-relative-classpath ./jar/flyway-core-10.20.0.jar
%module-cmd(jni) global-add-relative-classpath ./jar/flyway-database-postgresql-10.20.0.jar
%module-cmd(jni) global-add-relative-classpath ./jar/jackson-annotations-2.15.2.jar
%module-cmd(jni) global-add-relative-classpath ./jar/jackson-core-2.15.2.jar
%module-cmd(jni) global-add-relative-classpath ./jar/jackson-databind-2.15.2.jar
%module-cmd(jni) global-add-relative-classpath ./jar/jackson-dataformat-toml-2.15.2.jar
%module-cmd(jni) global-add-relative-classpath ./jar/jackson-datatype-jsr310-2.15.2.jar
%module-cmd(jni) global-add-relative-classpath ./jar/qore-dataprovider-flyway.jar

%module-cmd(jni) import org.qore.dataprovider.flyway.QoreFlywayRunner

# supports using the DataProvider module
%requires(reexport) DataProvider >= 3.12
# implements support for Flyway connections
%requires(reexport) ConnectionProvider
%requires Util

module FlywayDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Flyway database schema migration";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register connection schemes
        ConnectionSchemeCache::registerScheme("flyway", FlywayConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new FlywayDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": FlywayDataProvider::AppName,
            "presentation_source_locale": "en",
            # Java I/O that the Qore sandbox does not see (qore#5632): Flyway opens the JDBC URL and scans the
            # filesystem migration locations itself
            "external_io": True,
            "display_name": "Flyway",
            "short_desc": "Flyway database schema migration",
            "desc": "Manage database schema migrations using [Flyway](https://flywaydb.org/).\n\n"
                "**Capabilities**:\n"
                "- Run pending SQL migrations against a database\n"
                "- View migration history and status\n"
                "- Validate applied migrations against available scripts\n"
                "- Clean and repair the schema history table\n\n"
                "Supports PostgreSQL and other JDBC-accessible databases for DevOps and CI/CD "
                "pipelines.",
            "groups": (DataProvider::AppGroup::Databases,),
            "scheme": "flyway",
            "logo": FlywayLogo,
            "logo_file_name": "flyway-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FlywayDataProvider::AppName,
            "path": "/migrate",
            "action": "migrate",
            "display_name": "Run Flyway Migrations",
            "short_desc": "Run pending database migrations",
            "desc": "Run all pending database schema migrations.\n\nExecutes migration scripts "
                "in version order. Each migration is applied within a transaction and recorded "
                "in the Flyway schema history table.\n\n**Note**: migrations are one-way — once "
                "applied, they cannot be undone without using `clean`.",
            "action_code": DPAT_API,
            "output_type": FlywayMigrateDataProvider::ResponseType,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions{"url", "user", "password",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions - ("url", "user", "password")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FlywayDataProvider::AppName,
            "path": "/info",
            "action": "info",
            "display_name": "Get Flyway Migration Info",
            "short_desc": "Get information about all migrations",
            "desc": "Get information about all applied and pending database migrations.\n\n"
                "Returns a list of migration records showing version, description, type, state, "
                "and execution details. Useful for monitoring migration status in CI/CD "
                "pipelines.",
            "action_code": DPAT_FIND,
            "output_type": FlywayInfoRecordDataType,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions{"url", "user", "password",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions - ("url", "user", "password")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FlywayDataProvider::AppName,
            "path": "/validate",
            "action": "validate",
            "display_name": "Validate Flyway Migrations",
            "short_desc": "Validate applied migrations against available ones",
            "desc": "Validate applied Flyway migrations against available migration scripts",
            "action_code": DPAT_API,
            "output_type": FlywayValidateOutputDataType,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions{"url", "user", "password",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions - ("url", "user", "password")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FlywayDataProvider::AppName,
            "path": "/clean",
            "action": "clean",
            "display_name": "Clean Flyway Schema",
            "short_desc": "Drop all objects in the configured schemas",
            "desc": "Drop all objects in the configured schemas; this is a destructive operation",
            "action_code": DPAT_API,
            "output_type": FlywaySuccessOutputDataType,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions{"url", "user", "password",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions - ("url", "user", "password")
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": FlywayDataProvider::AppName,
            "path": "/repair",
            "action": "repair",
            "display_name": "Repair Flyway Schema History",
            "short_desc": "Repair the Flyway schema history table",
            "desc": "Repair the Flyway schema history table by removing failed migration entries "
                "and aligning checksums",
            "action_code": DPAT_API,
            "output_type": FlywaySuccessOutputDataType,

            "options": DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions{"url", "user", "password",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                FlywayDataProvider::ConstructorOptions - ("url", "user", "password")
            ),
        });
    };
    # PROCESS_CONTROL: its init registers connection scheme and data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage FlywayDataProvider Module

    @tableofcontents

    @section flywaydataproviderintro FlywayDataProvider Module Introduction

    <img src="flyway-logo.svg" width="96" alt="FlywayDataProvider module logo"/>

    The %FlywayDataProvider module provides a data provider API for Flyway database schema migration.

    This data provider provides Flyway functionality with the \c flyway factory and data provider with the
    same name, supporting database migration, validation, info, clean, and repair operations
    (class @ref FlywayDataProvider::FlywayDataProvider "FlywayDataProvider").

    @par Sandbox access
    The app requires DataProvider 3.12 or later and declares <tt>external_io</tt> for its Java calls.
    Data provider consumers reject sandboxed callers with <tt>APP-SANDBOX-ACCESS-DENIED</tt>.

    \c locations other than directories (ex: \c classpath:), and a \c url with driver properties, are refused to
      sandboxed code (\c JNI-SANDBOX-ERROR).

    \c locations other than \c classpath: locations are refused to calling code that is restricted from the
    \c FILESYSTEM functional domain (\c PERMISSION-DENIED), as a directory location (\c filesystem:, the default
    for a location without a prefix) names local files that Flyway reads and executes as SQL; see
    @ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()".  \c classpath: locations
    are not refused for this: they name resources of the classpath that the host set up, not paths of the file
    system.
    A connection that host code lent to such code creates its data provider only from the members and options that
    its creator gave it (\c ConnectionProvider::AbstractConnection::getLentDataProviderSource()).

    @section flywaydataprovider_examples Flyway Data Provider Examples

    These examples are with \c qdp, the command-line interface to the Data Provider API.

    @par API Example: Run Migrations
    @verbatim qdp 'flyway{url=jdbc:postgresql://localhost/mydb,user=myuser,password=secret,locations=filesystem:/path/to/sql}/migrate' request
    @endverbatim

    @par API Example: Get Migration Info
    @verbatim qdp 'flyway{url=jdbc:postgresql://localhost/mydb,user=myuser,password=secret,locations=filesystem:/path/to/sql}/info' search
    @endverbatim

    @anchor flywaydataprovider_relnotes

    @subpage flywaydataproviderreleasenotes
*/

/** @page flywaydataproviderreleasenotes FlywayDataProvider Release Notes

    @section flywaydataprovider_v1_0 FlywayDataProvider Module Version 1.0
    - initial release
    - \c locations other than \c classpath: locations are refused to calling code that is restricted from the
      \c FILESYSTEM functional domain, and a lent connection creates its data provider only from the members and
      options that its creator gave it (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
*/

#! Contains all public definitions in the FlywayDataProvider module
public namespace FlywayDataProvider {
#! Flyway application name
public const AppName = "Flyway";
}

namespace Priv {
#! Flyway logo
const FlywayLogo = File::readTextFile(get_script_dir() + "/flyway-logo.svg");

#! Returns the locations with the \c filesystem: prefix added to a location without a prefix
/** Flyway trims a location (Java's \c String.trim(): the characters up to U+0020) before it reads its prefix, so the
    location is trimmed the same way here, and the trimmed value is what Flyway is given: a location is classified as
    Flyway classifies it (qore#7811)

    @param locations the locations as given in the options
*/
list<string> sub get_flyway_locations(*softlist<auto> locations) {
    list<string> rv = ();
    foreach auto location in (locations) {
        string loc = location.toString();
        loc =~ s/^[\x01-\x20]+//;
        loc =~ s/[\x01-\x20]+$//;
        rv += loc =~ /:/ ? loc : "filesystem:" + loc;
    }
    return rv;
}

#! Refuses directory locations to calling code that is restricted from the file system (qore#7811)
/** Flyway reads the SQL files of the directories and executes them, and the module's code runs with its own
    %Program's options, so the restrictions of the calling code are checked here before Flyway is configured
    (@ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()").  A location other than
    a \c classpath: location is checked: a \c classpath: location names resources of the classpath that the host
    set up, which Java resolves within its entries, not paths of the file system.  A connection that the host lent
    creates its data provider from the options that its creator gave
    (\c ConnectionProvider::AbstractConnection::getLentDataProviderSource()).

    @param locations the locations with their prefixes (see get_flyway_locations())

    @throw PERMISSION-DENIED the calling code is restricted from the \c FILESYSTEM functional domain
*/
sub check_locations(list<string> locations) {
    if (!(map 1, locations, $1 !~ /^classpath:/i)) {
        return;
    }
    if (SandboxManager::isCallerRestricted(DOM_FILESYSTEM)) {
        throw "PERMISSION-DENIED", "the calling code may not use the flyway option \"locations\" with a location "
            "other than a classpath: location, which names local files that Flyway reads and executes, as it is "
            "restricted from the FILESYSTEM functional domain";
    }
}

#! Returns a Flyway runner for the given options
/** @param copts the options: \c url, \c user and \c password, and the optional \c locations, \c schemas and
    \c table

    @return a Flyway runner configured with all options
*/
QoreFlywayRunner sub get_flyway_runner(hash<auto> copts) {
    # prefix locations with "filesystem:" if no prefix is present
    list<string> locations = get_flyway_locations(copts.locations);
    # directory locations name local files that Flyway reads and executes: before they are used (qore#7811)
    check_locations(locations);
    # both checks are made before Flyway is configured (qore#5742)
    # driver properties in the JDBC URL ("?name=value", ";name=value", or key-value forms such as "(name=value)") can
    # name classes for the driver to load
    if (copts.url =~ /[?;=(&]/) {
        Jni::org::qore::jni::check_class_option("flyway", "url", "sets JDBC driver properties, which can name Java "
            "classes for the driver to load");
    }
    # a location other than a directory (ex: "classpath:") makes Flyway load the Java migration classes that it finds
    # there
    if (map 1, locations, $1 !~ /^filesystem:/i) {
        Jni::org::qore::jni::check_class_option("flyway", "locations", "names a location from which Flyway loads "
            "Java migration classes");
    }
    list<string> schemas = map $1.toString(), copts.schemas ?? ();
    return copts.table
        ? new QoreFlywayRunner(copts.url, copts.user, copts.password, locations, schemas, copts.table)
        : new QoreFlywayRunner(copts.url, copts.user, copts.password, locations, schemas);
}
}
