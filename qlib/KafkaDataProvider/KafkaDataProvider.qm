# minimum required Qore version
%requires qore >= 3.0
%modern

# import Kafka Java Client Library: JAR must be added to the global classloader
%module-cmd(jni) global-add-relative-classpath ./jar/kafka-clients-3.9.0.jar
%module-cmd(jni) global-add-relative-classpath ./jar/slf4j-api-2.0.16.jar
%module-cmd(jni) global-add-relative-classpath ./jar/slf4j-nop-2.0.16.jar
%module-cmd(jni) global-add-relative-classpath ./jar/zstd-jni-1.5.6-9.jar
%module-cmd(jni) global-add-relative-classpath ./jar/lz4-java-1.8.0.jar
%module-cmd(jni) global-add-relative-classpath ./jar/snappy-java-1.1.10.7.jar
%module-cmd(jni) global-add-relative-classpath ./jar/qore-dataprovider-kafka.jar

# implements a data provider for Kafka functionality
%requires(reexport) DataProvider >= 3.12
# implements support for Kafka connections
%requires(reexport) ConnectionProvider
%requires AsyncApi >= 1.0
%requires FileLocationHandler
%requires Util

%try-module json >= 1.5
%define NoJson
%endtry

%try-module yaml
%define NoYaml
%endtry

module KafkaDataProvider {
    version = "2.1";
    desc = "user module providing a data provider API for Kafka messaging";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register connection schemes
        ConnectionSchemeCache::registerScheme("kafka", KafkaConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new KafkaDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": KafkaDataProvider::AppName,
            "presentation_source_locale": "en",
            # Java I/O that the Qore sandbox does not see (qore#5632): the Kafka client connects to the bootstrap
            # servers and to the brokers they return, and reads its key stores itself
            "external_io": True,
            "display_name": "Kafka",
            "short_desc": "Kafka messaging",
            "desc": "Kafka messaging",
            "groups": (DataProvider::AppGroup::Messaging,),
            "scheme": "kafka",
            "logo": KafkaLogoWhite,
            "logo_file_name": "kafka-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KafkaDataProvider::AppName,
            "path": "/consumer",
            "action": "msg-received",
            "display_name": "Kafka Message Received",
            "short_desc": "A Kafka message is received",
            "desc": "A Kafka message is received; react to an Kafka message",
            "action_code": DPAT_EVENT,
            "action_val": KafkaConsumerDataProvider::EVENT_KAFKA_MESSAGE,
            "output_type": KafkaEventRecvDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KafkaConsumerDataProvider::ConstructorOptions{"topics",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                KafkaConsumerDataProvider::ConstructorOptions - "topics"
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": KafkaDataProvider::AppName,
            "path": "/producer",
            "action": "send-msg",
            "display_name": "Send Kafka Message",
            "short_desc": "Send a Kafka message",
            "desc": "Send a Kafka message",
            "action_code": DPAT_API,
            "output_type": KafkaMessageResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                KafkaProducerDataProvider::ConstructorOptions
            ) + DataProviderActionCatalog::getActionOptionFromFields(KafkaEventDataType::Fields),
        });
    };
    # THREAD_CONTROL: the module starts its own background tasks
    # PROCESS_CONTROL: its init registers connection scheme and data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "THREAD_CONTROL,PROCESS_CONTROL";
}

/** @mainpage KafkaDataProvider Module

    @tableofcontents

    @section kafkadataproviderintro KafkaDataProvider Module Introduction

    <img src="kafka-logo.svg" width="96" alt="KafkaDataProvider module logo"/>

    The %KafkaDataProvider module provides a data provider API for sending and receiving Kafka messages.

    This data provider provides Kafka functionality with the \c Kafka factory and data provider with the same name,
    supporting asynchronous Kafka events and messaging (class @ref KafkaDataProvider::KafkaDataProvider "KafkaDataProvider").

    @section kafkadataprovider_examples Kafka Data Provider Examples

    These examples are with \c qdp, the command-line interface to the Data Provider API.

    @par API Example: Send a Message
    @verbatim qdp 'Kafka{xxx}/producer' send message 'xxx'
    @endverbatim

    @par API Example: Listen for Messages
    @verbatim qdp 'Kafka{xxx}'/consumer ix
    @endverbatim

    @anchor kafkadataprovider_relnotes

    @subpage kafkadataproviderreleasenotes
*/

/** @page kafkadataproviderreleasenotes KafkaDataProvider Release Notes

    @section kafkadataprovider_v2_1 KafkaDataProvider v2.1
    - <b>Behavior change</b>: the data providers of a connection that host code lent to code restricted from a domain of
      its clients are created only from the members and options that its creator gave it, also when that code creates
      them itself from the connection or with library code: such code can give them no options (also none that name no
      path, such as \c topics or the consumer and producer options) and change none of the connection's members
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
    - <b>Behavior change</b>: KafkaDataProviderBase::configureAsyncApiOptions(), and the producer and consumer that a
      KafkaDataProvider creates for the data context of the thread, refuse \c validator and \c asyncapi locations of
      the file system to code restricted from the \c FILESYSTEM functional domain that the host lent the data
      provider to, also a location with options in the location string or of a scheme without a handler; the
      producer and consumer of a KafkaDataProvider take the options that its creator gave it
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
    - the consumer delivers records at least once: it commits a record only after every observer has accepted it,
      and a refused record is delivered again after a back-off instead of stopping the consumer and being lost, so
      an observer can see a record twice (see @ref kafkaconsumerdataprovider_delivery;
      <a href="https://github.com/qoretechnologies/qore/issues/6395">issue 6395</a>)
    - the app declares \c external_io (@ref DataProvider::DataProviderAppInfo "DataProviderAppInfo"): its Java code does
      network or filesystem I/O that the sandbox does not control, so data provider consumers refuse it to sandboxed
      callers (\c APP-SANDBOX-ACCESS-DENIED); the module requires \c DataProvider 3.12 or later
    - the client options that name a class other than Kafka's own (the \c *.class options, serializers and
      deserializers, and \c sasl.jaas.config login modules) are refused to sandboxed code (\c JNI-SANDBOX-ERROR)
    - the \c sasl.kerberos.kinit.cmd client option, which names a command that the Kafka client runs, is refused to
      sandboxed code (\c JNI-SANDBOX-ERROR) unless it is the default \c /usr/bin/kinit
    - added source-owned connection option catalogs in all twelve standard locales; unchanged inherited
      presentation keeps its original producer identity, including HTTP/REST options and allowed values
    - added record headers: the producer sends the \c headers of a request (a string value as its UTF-8 bytes, a
      binary value as it is), and the consumer delivers the headers of a record as a hash of header names to values,
      a value that is valid UTF-8 as a string and any other value as a binary
    - the \c key of a producer request is optional; a record without a key is distributed over the topic's
      partitions by the producer, and a \c partition is honored with or without a key
    - fixed the runtime classpath to include the committed \c lz4-java dependency already used by the compile
      classpath, preventing LZ4-compressed records from depending on an unrelated classloader having loaded it first
    - added AsyncAPI 3.0 validation support for producer request values and consumer event values via the
      \c asyncapi, \c validator, and \c asyncapi_channel options; \c validator accepts AsyncAPI schema file data or
      a schema location

    @section kafkadataprovider_v1_0 KafkaDataProvider v1.0
    - initial release
*/

#! Contains all public definitions in the KafkaDataProvider module
public namespace KafkaDataProvider {
#! Kafka application name
public const AppName = "Kafka";
}

namespace Priv {
#! Kafka logo (white version)
const KafkaLogoWhite = File::readTextFile(get_script_dir() + "/kafka-logo.svg");

#! A token of the module's own code: a data provider created with one takes its options from its creator (qore#7811)
/** Only the module's code can create an object of this class, as its namespace is not exported, so a constructor
    variant that takes one cannot be called by other code: such a variant is called by the module's code with the
    options that the creator of a parent object or connection gave it, which are not checked again for the code that
    the object was lent to
*/
class CreatorOptions {
}

#! Refuses a request location of the file system to code that a provider was lent to and that is restricted from it
/** FileLocationHandler refuses a location to calling code that is restricted from the functional domains of the
    location's handler (@ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()"), but
    inside a method of a provider that the host lent to such code, the code that the provider was lent to does not
    count for it; a request location is given by that code, so it is checked here with
    @ref Qore::SandboxManager::isLentToRestricted() "SandboxManager::isLentToRestricted()" before it is used
    (qore#7811).  The location's handler is resolved as FileLocationHandler resolves it: the scheme (\c file if none
    is given), and the options in the location string, which can name local files for other schemes.

    The code of this function is the same in each module that has it (see test/jni-provider-path-restricted.qtest).

    @param provider the name of the provider, for the error
    @param field the name of the request field, for the error
    @param location the location from the request

    @throw PERMISSION-DENIED the code that the provider was lent to, or the calling code, is restricted from the
    \c FILESYSTEM functional domain, and the location's handler uses the file system for the caller, the code that
    the provider was lent to gave options in the location string, or the location's scheme has no handler
*/
sub check_request_location(string provider, string field, string location) {
    if (!SandboxManager::isLentToRestricted(DOM_FILESYSTEM)) {
        return;
    }
    string scheme = (location =~ x/^(\w+):\/\//)[0] ?? "file";
    *hash<auto> opts;
    if (*string opt_str = (location =~ x/((?:{).*(?:}))$/)[0]) {
        try {
            auto v = parse_to_qore_value(opt_str);
            if (v.typeCode() == NT_HASH) {
                opts = v;
            } else if (v.strp()) {
                opts = {v: True};
            }
        } catch (hash<ExceptionInfo> ex) {
            # an option string that cannot be parsed is refused by FileLocationHandler when the location is used
        }
    }
    AbstractFileLocationHandler handler;
    try {
        handler = FileLocationHandler::getHandler(scheme);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != "SCHEME-ERROR") {
            rethrow;
        }
        # a scheme without a handler now could have one when FileLocationHandler resolves the location, which would
        # then not be judged here
        throw "PERMISSION-DENIED", sprintf("the calling code may not use the %y location in the %s request field "
            "%y, which has no handler, as it is restricted from the FILESYSTEM functional domain", scheme, provider,
            field);
    }
    # options in the location string can name local files that a handler reads for the caller with FileLocationHandler
    # (for example the swagger, certificate and key options of other schemes, or the options that the handler of a
    # conn location gives to the handler of its connection), and FileLocationHandler judges the code that the
    # provider was lent to as unrestricted, so a location with options is refused to such code; a calling code that
    # is restricted itself is judged by FileLocationHandler
    if ((handler.getCallerDomains(scheme, opts) & DOM_FILESYSTEM)
        || (opts && !SandboxManager::isCallerRestricted(DOM_FILESYSTEM))) {
        throw "PERMISSION-DENIED", sprintf("the calling code may not use this %y location in the %s request field "
            "%y, as it is restricted from the FILESYSTEM functional domain", scheme, provider, field);
    }
}
}
