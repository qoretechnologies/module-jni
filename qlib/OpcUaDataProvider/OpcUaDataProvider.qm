# minimum required Qore version
%requires qore >= 3.0
%modern

# import Eclipse Milo OPC UA SDK JARs (1.1.4): must be added to the global classloader
%module-cmd(jni) global-add-relative-classpath ./jar/milo-sdk-client-1.1.4.jar
%module-cmd(jni) global-add-relative-classpath ./jar/milo-sdk-core-1.1.4.jar
%module-cmd(jni) global-add-relative-classpath ./jar/milo-sdk-server-1.1.4.jar
%module-cmd(jni) global-add-relative-classpath ./jar/milo-stack-core-1.1.4.jar
%module-cmd(jni) global-add-relative-classpath ./jar/milo-transport-1.1.4.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-buffer-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-channel-fsm-1.0.2.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-codec-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-common-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-handler-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-resolver-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-transport-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/netty-transport-native-unix-common-4.1.133.Final.jar
%module-cmd(jni) global-add-relative-classpath ./jar/bcprov-jdk18on-1.84.jar
%module-cmd(jni) global-add-relative-classpath ./jar/bcpkix-jdk18on-1.84.jar
%module-cmd(jni) global-add-relative-classpath ./jar/bcutil-jdk18on-1.84.jar
%module-cmd(jni) global-add-relative-classpath ./jar/strict-machine-1.0.0.jar
%module-cmd(jni) global-add-relative-classpath ./jar/jspecify-1.0.0.jar
%module-cmd(jni) global-add-relative-classpath ./jar/slf4j-api-2.0.18.jar
%module-cmd(jni) global-add-relative-classpath ./jar/slf4j-nop-2.0.18.jar
# first-party OPC UA schema resolver (compiled from src/java/org/qore/dataprovider/opcua)
%module-cmd(jni) global-add-relative-classpath ./jar/qore-dataprovider-opcua.jar

%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.OpcUaClient
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.OpcUaClientConfigBuilder
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.DiscoveryClient
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.identity.AnonymousProvider
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.identity.UsernameProvider
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.identity.X509IdentityProvider
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.subscriptions.OpcUaSubscription
%module-cmd(jni) import org.eclipse.milo.opcua.sdk.client.subscriptions.OpcUaMonitoredItem
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.AttributeId
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.NodeIds
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.StatusCodes
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.security.SecurityPolicy
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.ByteString
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.DataValue
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.DateTime
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.LocalizedText
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.NodeId
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.QualifiedName
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.StatusCode
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.Variant
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.builtin.unsigned.UInteger
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.enumerated.BrowseDirection
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.enumerated.TimestampsToReturn
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.Argument
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.BrowseDescription
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.BrowseResult
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.CallMethodRequest
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.HistoryReadValueId
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.ReadRawModifiedDetails
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.ReadValueId
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.ReferenceDescription
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.ViewDescription
%module-cmd(jni) import org.eclipse.milo.opcua.stack.core.types.structured.WriteValue
%module-cmd(jni) import org.qore.dataprovider.opcua.GenericServer
%module-cmd(jni) import org.qore.dataprovider.opcua.AddressSpaceSchema
%module-cmd(jni) import org.qore.dataprovider.opcua.NodeSet2Importer
%module-cmd(jni) import org.qore.dataprovider.opcua.OpcUaEndpointSelector
%module-cmd(jni) import org.qore.dataprovider.opcua.OpcUaDataChangeListener
%module-cmd(jni) import org.qore.dataprovider.opcua.SchemaResolver
%module-cmd(jni) import org.qore.dataprovider.opcua.ValueCodec
%module-cmd(jni) import java.io.ByteArrayInputStream
%module-cmd(jni) import java.lang.reflect.Method
%module-cmd(jni) import java.security.KeyStore
%module-cmd(jni) import java.util.ArrayList
%module-cmd(jni) import java.util.List
%module-cmd(jni) import java.util.concurrent.TimeUnit

# implements a data provider for OPC UA functionality
%requires(reexport) DataProvider >= 3.12
# implements support for OPC UA connections
%requires(reexport) ConnectionProvider
# implements file/resource location handling for offline NodeSet2 import
%requires FileLocationHandler
%requires Util
module OpcUaDataProvider {
    version = "1.10.0";
    desc = "user module providing a data provider API for OPC UA servers";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register connection schemes
        ConnectionSchemeCache::registerScheme("opcua", OpcUaConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("opcuatcp", OpcUaConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("opcuahttps", OpcUaConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new OpcUaDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": OpcUaDataProvider::AppName,
            "presentation_source_locale": "en",
            # Java I/O that the Qore sandbox does not see (qore#5632): the Milo OPC UA client connects to the server
            # and to the endpoints it returns itself
            "external_io": True,
            "display_name": "OPC UA",
            "short_desc": "OPC UA server for industrial communication and IoT",
            "desc": "OPC UA (Open Platform Communications Unified Architecture) server for industrial "
                "communication, supporting node value reading/writing, address space browsing, "
                "data change subscriptions, and method calls",
            "groups": (DataProvider::AppGroup::Iot,),
            "scheme": "opcuatcp",
            "logo": OpcUaLogo,
            "logo_file_name": "opc-ua-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions

        # event: data change
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "data-change",
            "display_name": "OPC UA Data Change",
            "short_desc": "A monitored OPC UA node value has changed",
            "desc": "This event is raised when the value of a monitored OPC UA node changes, "
                "including the new value, status code, and timestamps",
            "action_code": DPAT_EVENT,
            "action_val": OpcUaDataProvider::EVENT_OPCUA_DATA_CHANGE,
            "output_type": OpcUaDataChangeEventDataType,
        });

        # event: connected
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "connected",
            "display_name": "OPC UA Connected",
            "short_desc": "Client connected or reconnected to the OPC UA server",
            "desc": "This event is raised when the client connects or reconnects to the OPC UA server",
            "action_code": DPAT_EVENT,
            "action_val": OpcUaDataProvider::EVENT_OPCUA_CONNECTED,
            "output_type": OpcUaConnectedEventDataType,
        });

        # event: disconnected
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "disconnected",
            "display_name": "OPC UA Disconnected",
            "short_desc": "Client disconnected from the OPC UA server",
            "desc": "This event is raised when the client is disconnected from the OPC UA server",
            "action_code": DPAT_EVENT,
            "action_val": OpcUaDataProvider::EVENT_OPCUA_DISCONNECTED,
            "output_type": OpcUaDisconnectedEventDataType,
        });

        # message: write value
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "write-value",
            "display_name": "Write OPC UA Node Value",
            "short_desc": "Write a value to an OPC UA node",
            "desc": "Write a value to an OPC UA node on the server",
            "action_code": DPAT_SEND_MESSAGE,
            "action_val": OpcUaDataProvider::MESSAGE_WRITE_VALUE,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpcUaWriteMessageDataType::Fields{"node_id", "value"}, {
                    "required": True,
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                OpcUaWriteMessageDataType::Fields{"data_type",}
            ),
        });

        # API: read value
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "read-value",
            "display_name": "Read OPC UA Node Value",
            "short_desc": "Read a value from an OPC UA node",
            "desc": "Read the current value from an OPC UA node on the server",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "node_id": {
                    "display_name": "Node ID",
                    "type": StringType,
                    "desc": "The OPC UA node ID to read (e.g., `ns=2;s=Temperature`)",
                    "example_value": "ns=2;s=Temperature",
                },
            }, {
                "required": True,
                "preselected": True,
            }),
            "output_type": OpcUaReadResponseDataType,
        });

        # API: browse nodes
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "browse-nodes",
            "display_name": "Browse OPC UA Address Space",
            "short_desc": "Browse the OPC UA server address space",
            "desc": "Browse the OPC UA server address space to discover available nodes",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "node_id": {
                    "display_name": "Node ID",
                    "type": SoftStringOrNothingType,
                    "desc": "The node ID to browse from; defaults to the Root node (`ns=0;i=84`)",
                    "example_value": "ns=0;i=84",
                },
            }) + DataProviderActionCatalog::getActionOptionFromFields({
                "direction": {
                    "display_name": "Direction",
                    "type": SoftStringOrNothingType,
                    "desc": "Browse direction: `Forward`, `Inverse`, or `Both`; defaults to "
                        "`Forward`",
                    "allowed_values": (
                        <AllowedValueInfo>{"value": "Forward", "display_name": "Forward"},
                        <AllowedValueInfo>{"value": "Inverse", "display_name": "Inverse"},
                        <AllowedValueInfo>{"value": "Both", "display_name": "Both"},
                    ),
                    "preselected": True,
                },
                "max_results": {
                    "display_name": "Max Results",
                    "type": SoftIntOrNothingType,
                    "desc": "Maximum number of references to return; `0` or omitted means no limit",
                    "preselected": True,
                },
            }),
            "output_type": OpcUaBrowseResponseDataType,
        });

        # API: call method
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "call-method",
            "display_name": "Call OPC UA Method",
            "short_desc": "Call a method on an OPC UA server object",
            "desc": "Call a method on an OPC UA server object node with optional input arguments",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "object_id": {
                    "display_name": "Object ID",
                    "type": StringType,
                    "desc": "The node ID of the object that owns the method",
                },
                "method_id": {
                    "display_name": "Method ID",
                    "type": StringType,
                    "desc": "The node ID of the method to call",
                },
            }, {
                "required": True,
                "preselected": True,
            }) + DataProviderActionCatalog::getActionOptionFromFields({
                "arguments": {
                    "display_name": "Arguments",
                    "type": SoftListOrNothingType,
                    "desc": "The input arguments for the method call",
                },
            }),
            "output_type": OpcUaCallMethodResponseDataType,
        });

        # API: read multiple values
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "read-values",
            "display_name": "Read Multiple OPC UA Node Values",
            "short_desc": "Read values from multiple OPC UA nodes in a single request",
            "desc": "Read current values from multiple OPC UA nodes in a single batch request "
                "for improved performance",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "node_ids": {
                    "display_name": "Node IDs",
                    "type": SoftAutoListType,
                    "desc": "List of OPC UA node IDs to read (e.g., `ns=2;s=Temperature`)",
                },
            }, {
                "required": True,
                "preselected": True,
            }),
            "output_type": OpcUaReadValuesResponseDataType,
        });

        # message: write multiple values
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "write-values",
            "display_name": "Write Multiple OPC UA Node Values",
            "short_desc": "Write values to multiple OPC UA nodes",
            "desc": "Write values to multiple OPC UA nodes in a single batch request",
            "action_code": DPAT_SEND_MESSAGE,
            "action_val": OpcUaDataProvider::MESSAGE_WRITE_VALUES,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                OpcUaWriteValuesMessageDataType::Fields{"values",}, {
                    "required": True,
                    "preselected": True,
                }
            ),
        });

        # API: read node attributes
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "read-attributes",
            "display_name": "Read OPC UA Node Attributes",
            "short_desc": "Read attributes from an OPC UA node",
            "desc": "Read node attributes including display name, description, data type, "
                "access level, and current value",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "node_id": {
                    "display_name": "Node ID",
                    "type": StringType,
                    "desc": "The OPC UA node ID to read attributes from",
                },
            }, {
                "required": True,
                "preselected": True,
            }),
            "output_type": OpcUaReadAttributesResponseDataType,
        });

        # API: read history
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "read-history",
            "display_name": "Read OPC UA Historical Data",
            "short_desc": "Read historical data from an OPC UA node",
            "desc": "Read historical data values from an OPC UA node with configurable time range "
                "and maximum values",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "node_id": {
                    "display_name": "Node ID",
                    "type": StringType,
                    "desc": "The OPC UA node ID to read history from",
                },
            }, {
                "required": True,
                "preselected": True,
            }) + DataProviderActionCatalog::getActionOptionFromFields({
                "start_time": {
                    "display_name": "Start Time",
                    "type": SoftDateOrNothingType,
                    "desc": "The start time for the historical data range",
                },
                "end_time": {
                    "display_name": "End Time",
                    "type": SoftDateOrNothingType,
                    "desc": "The end time for the historical data range",
                },
                "max_values": {
                    "display_name": "Max Values",
                    "type": SoftIntOrNothingType,
                    "desc": "Maximum number of values to return; 0 or omitted means no limit",
                },
            }),
            "output_type": OpcUaHistoryReadResponseDataType,
        });

        # API: discover endpoints
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "discover-endpoints",
            "display_name": "Discover OPC UA Endpoints",
            "short_desc": "Discover available endpoints on an OPC UA server",
            "desc": "Discover available endpoints on the OPC UA server including security "
                "policies and transport profiles",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "url": {
                    "display_name": "Discovery URL",
                    "type": SoftStringOrNothingType,
                    "desc": "The OPC UA server URL to discover endpoints on; if omitted, the "
                        "connection URL is used",
                    "example_value": "opc.tcp://localhost:4840",
                },
            }),
            "output_type": OpcUaEndpointDescriptionDataType,
        });

        # API: get server status
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": OpcUaDataProvider::AppName,
            "path": "/",
            "action": "get-server-status",
            "display_name": "Get OPC UA Server Status",
            "short_desc": "Get the current status of the OPC UA server",
            "desc": "Get the current server status including state, start time, build "
                "info, and product information",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "node_id": {
                    "display_name": "Server Node ID",
                    "type": SoftStringOrNothingType,
                    "desc": "The server object node ID; defaults to the standard "
                        "ServerStatus node (`ns=0;i=2259`)",
                },
            }),
            "output_type": OpcUaServerStatusDataType,
        });
    };
    # PROCESS_CONTROL: its init registers connection scheme and data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage OpcUaDataProvider Module

    @tableofcontents

    @section opcuadataproviderintro OpcUaDataProvider Module Introduction

    <img src="opc-ua-logo.svg" width="96" alt="OpcUaDataProvider module logo"/>

    The %OpcUaDataProvider module provides a data provider API for OPC UA (Open Platform Communications
    Unified Architecture) servers, supporting industrial communication and IoT use cases.

    This data provider provides OPC UA functionality with the \c opcua factory and data provider with the
    same name, supporting data change subscriptions, value reading/writing, address space browsing,
    and method calls (class @ref OpcUaDataProvider::OpcUaDataProvider "OpcUaDataProvider").

    Features supported include:
    - <b>Data change subscriptions</b>: monitor node values for changes with configurable sampling and
      publishing intervals
    - <b>Read values</b>: read single or multiple node values in batch
    - <b>Write values</b>: write single or multiple node values in batch
    - <b>Read attributes</b>: read node metadata (display name, data type, access level, etc.)
    - <b>Browse address space</b>: discover available nodes with server-side pagination
    - <b>Call methods</b>: invoke methods on OPC UA server objects
    - <b>Historical data</b>: read raw historical data with time range filtering
    - <b>Server discovery</b>: discover available endpoints and server status
    - <b>Security</b>: configurable security policies (None, Basic256Sha256, Aes128_Sha256_RsaOaep,
      Aes256_Sha256_RsaPss) and message security modes (None, Sign, SignAndEncrypt)
    - <b>Authentication</b>: Anonymous, Username/Password, and X.509 Certificate authentication
    - <b>Connection lifecycle</b>: connected/disconnected events with auto-reconnect
    - <b>SSL/TLS</b>: keystore and truststore configuration for secure connections
    - <b>Cooperative cancellation</b>: all blocking operations support thread/program cancellation

    @par Sandbox access
    Connection option labels and descriptions are localized in all twelve standard locales.

    The app requires DataProvider 3.12 or later and declares <tt>external_io</tt> for its Java calls.
    Data provider consumers reject sandboxed callers with <tt>APP-SANDBOX-ACCESS-DENIED</tt>.

    @section opcuadataproviderexamples OPC UA Data Provider Examples

    These examples are with \c qdp, the command-line interface to the Data Provider API.

    @par API Example: Read a Node Value
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request read-value 'node_id=ns=2;s=Temperature'
    @endverbatim

    @par API Example: Read Multiple Node Values
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request read-values 'node_ids=(ns=0;i=2258,ns=0;i=2259)'
    @endverbatim

    @par API Example: Read Node Attributes
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request read-attributes 'node_id=ns=0;i=2258'
    @endverbatim

    @par API Example: Write a Node Value
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' send write-value 'node_id=ns=2;s=SetPoint,value=22.5'
    @endverbatim

    @par API Example: Browse the Address Space
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request browse-nodes 'node_id=ns=0;i=84'
    @endverbatim

    @par API Example: Read Historical Data
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request read-history 'node_id=ns=2;s=Temperature,start_time=2026-03-01,end_time=2026-03-15'
    @endverbatim

    @par API Example: Discover Server Endpoints
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request discover-endpoints
    @endverbatim

    @par API Example: Get Server Status
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840}' request get-server-status
    @endverbatim

    @par API Example: Listen for Data Changes
    @verbatim qdp 'opcua{url=opc.tcp://localhost:4840,monitored_nodes=(ns=2;s=Temperature)}' listen
    @endverbatim

    @par Generic Runtime Security
    \c OpcUaServerRuntime uses an anonymous \c SecurityPolicy.None endpoint and rejects non-loopback
    \c bind_address and \c hostname values.  Use loopback addresses such as \c 127.0.0.1,
    \c localhost, or \c ::1 when embedding the runtime.  When a Qore network sandbox is active,
    \c start() checks the configured TCP bind address and port before the Java/Milo listener is opened.

    @par Generic Runtime History Retention
    The generic runtime retains implicit in-memory history only for historizing variables.  The
    \c max_history_values option caps retained values per variable; the default is 1024 and 0 disables
    implicit history retention.  Runtime callbacks may still return explicit values for \c history-read.

    @anchor opcuadataproviderrelnotes

    @subpage opcuadataproviderreleasenotes
*/

/** @page opcuadataproviderreleasenotes OpcUaDataProvider Release Notes

    @section opcuadataproviderv1100 OpcUaDataProvider Module Version 1.10.0
    - initial release
    - <b>Behavior change</b>: the options of OpcUaConnection name local files (the keystore and truststore, and the
      schema and NodeSet2 locations), so for code restricted from the \c FILESYSTEM functional domain that the host lent
      the connection to, its data provider is created only from the members and options that its creator gave it (also
      none that name no path, such as the monitored nodes), and its runtime options are confined in the same way
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
    - importNodeSet2() refuses a location of the file system to code restricted from the \c FILESYSTEM functional
      domain that the host lent the data provider to, also a location with options in the location string
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
*/

#! contains all public definitions in the OpcUaDataProvider module
public namespace OpcUaDataProvider {
#! OPC UA application name
public const AppName = "OpcUA";
}

namespace Priv {
#! OPC UA logo
const OpcUaLogo = File::readTextFile(get_script_dir() + "/opc-ua-logo.svg");

#! Refuses a request location of the file system to code that a provider was lent to and that is restricted from it
/** FileLocationHandler refuses a location to calling code that is restricted from the functional domains of the
    location's handler (@ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()"), but
    inside a method of a provider that the host lent to such code, the code that the provider was lent to does not
    count for it; a request location is given by that code, so it is checked here with
    @ref Qore::SandboxManager::isLentToRestricted() "SandboxManager::isLentToRestricted()" before it is used
    (qore#7811).  The location's handler is resolved as FileLocationHandler resolves it: the scheme (\c file if none
    is given), and the options in the location string, which can name local files for other schemes.

    The code of this function is the same in each module that has it (see test/jni-provider-path-restricted.qtest).

    @param provider the name of the provider, for the error
    @param field the name of the request field, for the error
    @param location the location from the request

    @throw PERMISSION-DENIED the code that the provider was lent to, or the calling code, is restricted from the
    \c FILESYSTEM functional domain, and the location's handler uses the file system for the caller, the code that
    the provider was lent to gave options in the location string, or the location's scheme has no handler
*/
sub check_request_location(string provider, string field, string location) {
    if (!SandboxManager::isLentToRestricted(DOM_FILESYSTEM)) {
        return;
    }
    string scheme = (location =~ x/^(\w+):\/\//)[0] ?? "file";
    *hash<auto> opts;
    if (*string opt_str = (location =~ x/((?:{).*(?:}))$/)[0]) {
        try {
            auto v = parse_to_qore_value(opt_str);
            if (v.typeCode() == NT_HASH) {
                opts = v;
            } else if (v.strp()) {
                opts = {v: True};
            }
        } catch (hash<ExceptionInfo> ex) {
            # an option string that cannot be parsed is refused by FileLocationHandler when the location is used
        }
    }
    AbstractFileLocationHandler handler;
    try {
        handler = FileLocationHandler::getHandler(scheme);
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != "SCHEME-ERROR") {
            rethrow;
        }
        # a scheme without a handler now could have one when FileLocationHandler resolves the location, which would
        # then not be judged here
        throw "PERMISSION-DENIED", sprintf("the calling code may not use the %y location in the %s request field "
            "%y, which has no handler, as it is restricted from the FILESYSTEM functional domain", scheme, provider,
            field);
    }
    # options in the location string can name local files that a handler reads for the caller with FileLocationHandler
    # (for example the swagger, certificate and key options of other schemes, or the options that the handler of a
    # conn location gives to the handler of its connection), and FileLocationHandler judges the code that the
    # provider was lent to as unrestricted, so a location with options is refused to such code; a calling code that
    # is restricted itself is judged by FileLocationHandler
    if ((handler.getCallerDomains(scheme, opts) & DOM_FILESYSTEM)
        || (opts && !SandboxManager::isCallerRestricted(DOM_FILESYSTEM))) {
        throw "PERMISSION-DENIED", sprintf("the calling code may not use this %y location in the %s request field "
            "%y, as it is restricted from the FILESYSTEM functional domain", scheme, provider, field);
    }
}
}
