# minimum required Qore version
%requires qore >= 1.0
%modern

# supports using the DataProvider module
%requires(reexport) DataProvider >= 3.12
%requires FileLocationHandler
%requires Util
%requires ValueMask

%module-cmd(jni) add-relative-classpath ./jar/qore-dataprovider-excel.jar
%module-cmd(jni) add-relative-classpath ./jar/poi-5.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/poi-ooxml-5.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/poi-ooxml-full-5.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-compress-1.28.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-io-2.20.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-codec-1.19.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-lang3-3.18.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-math3-3.6.1.jar
%module-cmd(jni) add-relative-classpath ./jar/curvesapi-1.08.jar
%module-cmd(jni) add-relative-classpath ./jar/xmlbeans-5.3.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-collections4-4.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/log4j-api-2.24.3.jar
%module-cmd(jni) add-relative-classpath ./jar/log4j-to-slf4j-2.24.3.jar
%module-cmd(jni) add-relative-classpath ./jar/slf4j-api-2.0.16.jar
%module-cmd(jni) add-relative-classpath ./jar/slf4j-nop-2.0.16.jar
%module-cmd(jni) add-relative-classpath ./jar/SparseBitSet-1.3.jar

%module-cmd(jni) import org.qore.dataprovider.excel.ExcelIterator
%module-cmd(jni) import org.qore.dataprovider.excel.ExcelFile
%module-cmd(jni) import org.qore.dataprovider.excel.ExcelGridReader
%module-cmd(jni) import org.qore.dataprovider.excel.ExcelWriter

module ExcelDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for reading and writing Excel spreadsheets";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factories
        DataProvider::registerFactory(new ExcelReadDataProviderFactory());
        DataProvider::registerFactory(new ExcelWriteDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ExcelDataProvider::AppName,
            "presentation_source_locale": "en",
            # Java calls are uncontrolled APIs (QDOM_UNCONTROLLED_API) that a governing sandbox refuses,
            # also from library code running for a sandboxed caller (qore#5741): sandboxed callers are refused
            # up front instead of failing in the middle of a call
            "external_io": True,
            "display_name": "Excel Spreadsheets",
            "short_desc": "Read and write Excel spreadsheets",
            "desc": "Read and write Excel spreadsheets",
            "groups": (DataProvider::AppGroup::Spreadsheets,),
            "logo": ExcelWhiteLogo,
            "logo_file_name": "excel-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "read",
            #"subtype": "csvread",
            "display_name": "Read Excel Spreadsheet File",
            "short_desc": "Read Excel spreadsheet from a specific file location",
            "desc": "Read Excel spreadsheet from a specific file location",
            "action_code": DPAT_FIND,
            "cls": "ExcelDataProvider::ExcelReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"worksheet", "data_cells", "header_cells",
                    "header_names"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions - ("path", "worksheet", "data_cells", "header_cells",
                    "header_names", "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "profile",
            "display_name": "Profile Excel Spreadsheet",
            "short_desc": "Describe the layout and columns of every sheet of an Excel spreadsheet",
            "desc": "Describes how every sheet of an Excel spreadsheet (`.xlsx` or `.xls`) is laid out, so it can be "
                "read correctly before an integration is built around it.\n\n"
                "**Detects:**\n"
                "- hidden sheets, named ranges, merged cells, and formulas\n"
                "- the header row, title rows and banners above it, and the data region\n"
                "- totals and subtotal rows and blank-row gaps\n"
                "- each column's type with a confidence and counter-examples\n"
                "- dates and numbers stored as text in a local format, and identifiers with leading zeros\n\n"
                "Sample values are redacted to their shape by default (`redact`), so a profile can be shared "
                "without the data itself.",
            "action_code": DPAT_API,
            "cls": "ExcelDataProvider::ExcelProfileDataProvider",
            "output_type": TabularWorkbookProfileDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TabularProfileRequestDataType::Fields{"path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TabularProfileRequestDataType::Fields - ("path",)
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "list-worksheets",
            "display_name": "List Excel Worksheets",
            "short_desc": "List the worksheets of an Excel spreadsheet",
            "desc": "Lists the worksheets of an Excel spreadsheet (`.xlsx` or `.xls`) in workbook order, so the "
                "worksheet to read can be chosen.\n\n"
                "Each worksheet is listed with its name, its 0-based `index`, which the `worksheet` read option "
                "accepts as well as the name, and whether it is `hidden`; hidden and very hidden worksheets are "
                "listed where they are in the workbook.",
            "action_code": DPAT_API,
            "cls": "ExcelDataProvider::ExcelListWorksheetsDataProvider",
            "output_type": ExcelListWorksheetsDataProvider::ResponseType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWorksheetListRequestDataType::Fields{"path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWorksheetListRequestDataType::Fields{"data",}
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "read-data",
            #"subtype": "excelread",
            "display_name": "Read Excel Spreadsheet Inline Data",
            "short_desc": "Read Excel spreadsheet inline data",
            "desc": "Read Excel spreadsheet inline data",
            "action_code": DPAT_FIND,
            "cls": "ExcelDataProvider::ExcelReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"data",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"worksheet", "data_cells", "header_cells",
                    "header_names"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions - ("path", "worksheet", "data_cells", "header_cells",
                    "header_names", "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "write",
            "display_name": "Write Excel Spreadsheet File",
            "short_desc": "Write data to an Excel spreadsheet file",
            "desc": "Write data to an Excel spreadsheet file at a specified path",
            "action_code": DPAT_CREATE,
            "cls": "ExcelDataProvider::ExcelWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions{"worksheet", "headers", "format"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions - ("path", "worksheet", "headers", "format", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "write-data",
            "display_name": "Create Excel Spreadsheet Data",
            "short_desc": "Create Excel spreadsheet data and return as binary",
            "desc": "Create Excel spreadsheet data in memory and return it as binary data; useful for generating "
                "Excel files without writing to disk",
            "action_code": DPAT_CREATE,
            "output_data_type": DPAD_CREATE_OUTPUT,
            "output_type": ExcelGeneratedDataOutputDataType,
            "cls": "ExcelDataProvider::ExcelWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions{"worksheet", "headers", "format"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions - ("path", "worksheet", "headers", "format", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
    };
}

/** @mainpage ExcelDataProvider Module

    @tableofcontents

    @section exceldataproviderintro ExcelDataProvider Module Introduction

    <img src="excel-logo.svg" width="96" alt="ExcelDataProvider module logo"/>

    @anchor ExcelDataProviderintro

    The %ExcelDataProvider module provides a data provider API for reading and writing Excel spreadsheets
    through the @ref dataproviderintro "DataProvider" API. It supports both modern Excel formats (.xlsx,
    Excel 2007+) and legacy formats (.xls, Excel 97-2003).

    Records are read from an .xlsx worksheet one row at a time as they are iterated, so worksheets of any size, up
    to Excel's limit of 1048576 rows, are read in bounded memory; only the workbook's shared string table is held
    in memory.  An .xls workbook, whose format holds at most 65536 rows, is loaded in memory.  The input (a location,
    a stream, or binary data) is copied once to a temporary file, in bounded memory, which is read for the record
    type, the records, the worksheet names, and the worksheet providers, and deleted with the last provider using it.

    The following classes are provided by this module:
    - @ref ExcelDataProvider::ExcelReadDataProvider "ExcelReadDataProvider" - for reading Excel files
    - @ref ExcelDataProvider::ExcelReadDataProviderFactory "ExcelReadDataProviderFactory" - factory for read providers
    - @ref ExcelDataProvider::ExcelWriteDataProvider "ExcelWriteDataProvider" - for writing Excel files
    - @ref ExcelDataProvider::ExcelWriteDataProviderFactory "ExcelWriteDataProviderFactory" - factory for write providers
    - @ref ExcelDataProvider::ExcelWorksheetReadDataProvider "ExcelWorksheetReadDataProvider" - for reading specific worksheets
    - @ref ExcelDataProvider::ExcelListWorksheetsDataProvider "ExcelListWorksheetsDataProvider" - for listing the
      worksheets of a workbook (the \c list-worksheets action)

    @section ExcelDataProvider_reading Reading Excel Files

    @subsection ExcelDataProvider_reading_basic Basic Reading

    @code{.py}
    %requires ExcelDataProvider

    # Read from a file path
    ExcelReadDataProvider dp("data.xlsx", {"header_names": True});
    list<hash<auto>> records = map $1, dp.searchRecords();

    # Read from a stream
    FileInputStream fis("data.xlsx");
    ExcelReadDataProvider dp2(fis, {"header_names": True});

    # Read from binary data
    binary data = File::readBinaryFile("data.xlsx");
    ExcelReadDataProvider dp3({"data": data, "header_names": True});
    @endcode

    @subsection ExcelDataProvider_reading_options Read Options

    - \c path: Path to the Excel file
    - \c stream: Input stream for Excel data
    - \c data: Binary Excel data
    - \c worksheet: Name of the worksheet to read (default: first sheet)
    - \c header_names: If \c True, use first row as header names
    - \c header_cells: Cell range for headers (e.g., "a1:e1" or just "1" for row 1)
    - \c data_cells: Cell range for data (e.g., "a2:e100"); a range without an end column (e.g., "b2") ends at the
      last header column, or, without headers, at the last cell with a value in each row
    - \c headers: List of header names to use
    - \c tolwr: Convert header names to lowercase
    - \c timezone: Timezone for date values
    - \c ignore_empty: If \c True, skip empty rows and continue to the end of \c data_cells or the last row of the
      worksheet; by default reading stops at the first empty row
    - \c formula_field: the name of an extra field of every record holding the formulas of the record's cells: a
      hash of the formula text, without the leading \c "=", as the \c profile action gives it, by the cell's
      reference in the worksheet (\c "B5"), or @ref nothing if none of the cells holds a formula; passing the field
      to @ref DataProvider::TabularProfiler::hasTotalsFormula() "TabularProfiler::hasTotalsFormula()" recognizes a
      totals row made of \c SUM formulas as the profile does; a name that is a column of the worksheet raises
      \c EXCEL-FORMULA-FIELD-ERROR
    - \c type_sample_rows: the number of data rows read to infer the type of each column (default 100; \c 0 reads
      every value as stored); see @ref ExcelDataProvider_reading_types
    - \c column_types: the type of columns whose type is given rather than inferred
    - \c error_cells: how error cells are read: \c fail (the default), \c null or \c text; see
      @ref ExcelDataProvider_reading_errors
    - \c error_field: the name of an extra field of every record holding the errors of the record's cells

    @subsection ExcelDataProvider_reading_types Typed Columns

    When the worksheet has headers, the type of each column is inferred from its values in the first data rows
    (\c type_sample_rows, 100 by default), as the spreadsheet profile classifies them: a column of whole numbers is an
    \c int column, of numbers a \c float column, of booleans a \c bool column, of dates a \c date column, and of
    text a \c string column; a column with values of different kinds, or with no values, is returned as stored.  The
    record type has the column types, and the values are converted to them: a whole number in an \c int column is an
    integer rather than a float.

    The \c column_types option gives the type of columns by name: \c string, \c int, \c float, \c number,
    \c bool, \c date, or \c any; \c string converts numbers, booleans and dates to text, for example identifiers
    stored as numbers.  A later value that its column's type does not accept fails the read with
    \c EXCEL-COLUMN-TYPE-ERROR, which names the worksheet, row, column, value and type, and the remedies:

    @code{.py}
    # an order number column that has text after the first 100 rows, and amounts as arbitrary-precision numbers
    ExcelReadDataProvider dp("orders.xlsx", {
        "header_names": True,
        "column_types": {"Order No": "string", "Amount": "number"},
    });
    @endcode

    @subsection ExcelDataProvider_reading_errors Error Cells

    A cell with an error, such as \c \#DIV/0! or \c \#N/A, or a formula whose result is an error, fails the read
    with \c EXCEL-CELL-ERROR by default, naming the worksheet, cell, column and error.  With \c error_cells set to
    \c null, error cells have no value; with \c text, their value is the error's text in any column.  The
    \c error_field option returns the errors of each record in a field of their own, a hash of the error text by
    column, and accepts error cells, which are then read as no value unless \c error_cells is \c text:

    @code{.py}
    ExcelReadDataProvider dp("rates.xlsx", {"header_names": True, "error_field": "_errors"});
    # {"Item": "a", "Ratio": NOTHING, "_errors": {"Ratio": "#DIV/0!"}}
    @endcode

    @subsection ExcelDataProvider_reading_multisheet Multi-Sheet Access

    @code{.py}
    ExcelReadDataProvider dp("workbook.xlsx");

    # List all worksheets
    list<string> sheets = dp.getChildProviderNames();

    # Access specific worksheet
    AbstractDataProvider sheet = dp.getChildProvider("Sheet2");
    list<hash<auto>> records = map $1, sheet.searchRecords();
    @endcode

    The \c list-worksheets action lists the worksheets with their 0-based position, which the \c worksheet option
    accepts as well as the name, and whether they are hidden (including very hidden worksheets, which only a macro
    can show):

    @code{.py}
    ExcelListWorksheetsDataProvider lister();
    hash<auto> rv = lister.doRequest({"path": "workbook.xlsx"});
    # rv: {"worksheets": ({"name": "Orders", "index": 0, "hidden": False},
    #                     {"name": "Lookup", "index": 1, "hidden": True})}
    @endcode

    @section ExcelDataProvider_writing Writing Excel Files

    @subsection ExcelDataProvider_writing_basic Basic Writing

    @code{.py}
    %requires ExcelDataProvider

    # Write to a file
    ExcelWriteDataProvider dp("output.xlsx", {
        "worksheet": "Data",
        "headers": ("Name", "Age", "City"),
    });

    dp.createRecord({"Name": "Alice", "Age": 30, "City": "New York"});
    dp.createRecord({"Name": "Bob", "Age": 25, "City": "Boston"});

    dp.commit();  # Write the file
    @endcode

    @subsection ExcelDataProvider_writing_options Write Options

    - \c path: Output file path
    - \c stream: Output stream
    - \c worksheet: Worksheet name (default: "Sheet1")
    - \c headers: List of column headers
    - \c format: Output format - "xlsx" (default) or "xls"
    - \c streaming: Use streaming mode for large files (reduces memory usage)
    - \c column_formats: The display format of columns by header name (see
      @ref ExcelDataProvider_writing_column_formats)
    - \c column_masks: The display format of columns as masks, such as \c DD.MM.YYYY or <tt>#.##0,00 €</tt> (see
      @ref ExcelDataProvider_writing_column_masks)
    - \c column_headers: The header text of columns whose header is not their name
    - \c write_headers: Set to \c False to write no header row
    - \c timezone: The time zone whose wall-clock time dates are written in; if not given, a date is written as
      its own wall-clock time
    - \c sheets: The worksheets to write, each with the condition of its records (see
      @ref ExcelDataProvider_writing_sheets)
    - \c route: With \c sheets, \c "first" (the default) to write a record to the first worksheet whose condition it
      matches, or \c "all" to write it to every one
    - \c unmatched: With \c sheets, \c "fail" (the default) to fail the write with a record that matches no
      worksheet, or \c "skip" to skip it

    @subsection ExcelDataProvider_writing_column_formats Column Display Formats

    The \c column_formats option gives columns a display format code, as Excel and LibreOffice write them, so
    that whoever opens the file sees each value as intended.  The cells keep their real values: a date stays a
    date and a number a number; only the way they are shown changes.

    @code{.py}
    ExcelWriteDataProvider dp("invoices.xlsx", {
        "headers": ("Invoice", "Date", "Amount", "Discount"),
        "column_formats": {
            "Date": "dd.mm.yyyy",
            "Amount": "#,##0.00;(#,##0.00)",
            "Discount": "0.0%",
        },
    });
    # the date is shown as 07.10.2026, the amount as (1,234.50) and the discount as 2.5%
    dp.createRecord({"Invoice": "INV-1", "Date": 2026-10-07, "Amount": -1234.5, "Discount": 0.025});
    dp.finishCreate();
    @endcode

    Format codes are written as in Excel and LibreOffice:
    - numbers: \c 0 (a digit that is always shown), \c # (a digit shown when significant), \c , between digits
      (thousands grouping), \c , after the last digit (divide by 1000), \c . (the decimal point), and \c E+00
      (scientific notation); up to three sections for positive, negative and zero values separated by \c ;,
      such as <tt>#,##0.00;(#,##0.00)</tt> or <tt>#,##0.00;#,##0.00-</tt>
    - percentages: a \c % in each section, such as \c 0.0%; the value is a fraction, so \c 0.25 is shown as
      \c 25.0%
    - dates and times: \c yy or \c yyyy (year), \c m, \c mm, \c mmm or \c mmmm (month as a number or a name),
      \c d or \c dd (day), \c ddd or \c dddd (weekday name), \c h or \c hh (hour), \c m or \c mm directly after an
      hour or before a second (minute), \c s or \c ss (second), \c .0 to \c .000 after the second (fractions of a
      second), and \c AM/PM
    - text: \c @

    Text in a code is written in double quotes (<tt>"EUR"</tt>), escaped with a backslash (<tt>\\x</tt>), as a
    currency symbol in brackets (<tt>[$€-407]</tt>), or as itself for <tt>$ - + / ( ) :</tt>, spaces and symbols
    such as \c €; a section can start with a color such as <tt>[Red]</tt>.

    Only codes that an Excel cell style and an OpenDocument data style show the same way are accepted, so the
    same codes can be given to the @ref odsdataproviderintro "OdsDataProvider" writer.  An invalid or unsupported
    code (\c General, fractions, fill characters, conditions, or elapsed times), or a format for a column that is
    not written, raises \c EXCEL-WRITE-OPTION-ERROR naming the column and the problem.  A value that its column's
    code does not show, such as a string in a number column, is written without the format.  Each distinct code
    is one cell style in the workbook, whatever the number of rows.

    @subsection ExcelDataProvider_writing_column_masks Column Masks

    The \c column_masks option gives columns their display format as masks of the @ref valuemaskintro "ValueMask"
    module, the masks that CSV files (see the \c mask field attribute of @ref csvutilintro "CsvUtil") and the sheet
    contracts of Qorus design mode are read and written with, so one mask describes a column in every kind of file.
    Each mask becomes the display format code of its column (see
    @ref ValueMask::ValueMask::toSpreadsheetFormat() "ValueMask::toSpreadsheetFormat()"), and the cells keep their
    real values.  The records and every column option name the columns as the records do; \c column_headers only
    changes the text of the header row.

    @code{.py}
    ExcelWriteDataProvider dp("rejects.xlsx", {
        "worksheet": "Rejected Lines",
        "headers": ("po", "date", "amount", "share"),
        "column_headers": {"po": "PO Number", "date": "Order Date", "amount": "Amount", "share": "Share"},
        "column_masks": {"date": "DD.MM.YYYY", "amount": "#.##0,00 €", "share": "0.#%"},
        "timezone": "Europe/Prague",
    });
    dp.createRecord({"po": "PO-1", "date": 2026-11-02T10:00:00Z, "amount": 1234.5, "share": 0.125});
    dp.finishCreate();
    @endcode

    A spreadsheet shows a cell differently from text in these ways:
    - the group separator and decimal mark are shown as the language of whoever opens the file uses them; the
      mask's separators only say whether digits are grouped and how many decimals are shown, so
      <tt>#.##0,00</tt> and <tt>#,##0.00</tt> give the same display format
    - \c Mon shows the month name in the language of whoever opens the file, as the cell holds a real date
    - a final \c # shows at most 10 decimals, and a whole number with the decimal mark after it (\c 12.)

    A mask without a display format raises \c EXCEL-WRITE-OPTION-ERROR naming the column and the reason: \c ZZ
    (a cell holds no UTC offset), \c MON (there is no upper-case month name), \c sss not directly after \c SS.,
    a minute that is not directly after an hour or before the seconds, and a numeric month that is.  A column
    cannot have both a mask and a format code in \c column_formats.

    A cell holds a date and time without a time zone: a date is written as its own wall-clock time, or with the
    \c timezone option as the wall-clock time in that time zone.

    @subsection ExcelDataProvider_writing_sheets Writing Several Worksheets

    The \c sheets option writes the records to several worksheets: each worksheet is a hash with its name in
    \c worksheet, its columns in \c columns, and in \c when the condition of its records in DPQL with the fields
    of the record, such as <tt>\@kind == "order"</tt>.  A record is written to the first worksheet whose condition it
    matches, so a worksheet without a condition, listed last, takes every other record:

    @code{.py}
    ExcelWriteDataProvider dp("orders.xlsx", {"sheets": (
        {"worksheet": "Orders", "columns": ("Id", "Amount"), "when": "@kind == \"order\"",
            "column_formats": {"Amount": "#,##0.00"}},
        {"worksheet": "Returns", "columns": ("Id", "Reason"), "when": "@kind == \"return\""},
        {"worksheet": "Other"},
    )});
    dp.createRecord({"kind": "order", "Id": 1, "Amount": 1234.5});
    dp.createRecord({"kind": "return", "Id": 2, "Reason": "damaged"});
    dp.createRecord({"kind": "note", "Id": 3, "Text": "call back"});
    dp.finishCreate();
    @endcode

    - the worksheets are written in the order given, and each one is created, also without records; a worksheet
      whose columns are given has its header row
    - a column that a record has no value for is an empty cell, and the other fields of the record, such as the
      \c kind field above, are not written to the worksheet; a worksheet without \c columns has the fields of the
      first record written to it
    - each worksheet can have its own \c column_headers, \c column_formats, \c column_masks and \c write_headers,
      which mean what the options of the same name mean; these options and \c worksheet and \c headers are then given
      for each worksheet only, while \c format, \c streaming and \c timezone apply to the workbook
    - a worksheet name has at most 31 characters, none of <tt>: \\ / ? * [ ]</tt>, does not begin or end with an
      apostrophe, and differs from the names of the other worksheets in more than case
    - with \c route set to \c "all", a record is written to every worksheet whose condition it matches, so a
      workbook can have a worksheet with every record and another with the returns
    - a record that matches no worksheet raises \c EXCEL-WRITE-ROUTE-ERROR, naming the record (its number among the
      records written) and the conditions of the worksheets, unless \c unmatched is \c "skip"; a skipped record is
      not counted; a condition that cannot be evaluated for a record, such as one with a field that the record does
      not have, raises \c EXCEL-WRITE-ROUTE-ERROR naming the record and the worksheet
    - as every error raised when a record is created, a route error reaches the caller of
      @ref DataProvider::AbstractDataProvider::createRecord() "createRecord()" as \c CREATE-RECORD-ERROR, whose
      description begins with the error code: <tt>EXCEL-WRITE-ROUTE-ERROR: data provider ...: record 3 matches no
      worksheet; ...</tt>
    - the \c write-data action returns the number of records written to each worksheet in \c sheet_counts, by
      worksheet name in workbook order (see @ref ExcelDataProvider::ExcelGeneratedDataInfo "ExcelGeneratedDataInfo");
      with \c route \c "all", a record written to two worksheets is counted in each, while \c record_count counts
      it once

    @code{.py}
    hash<ExcelGeneratedDataInfo> output = dp.finishCreate();
    # {"data": <xlsx>, "record_count": 120, "sheet_counts": {"Orders": 100, "Returns": 15, "Other": 5}}
    @endcode

    Records of different shapes are told apart with the DPQL operator \c exists, which tests whether the record has a
    field (@ref dpql_exists "exists", %DataProvider 3.11): below, a record without \c type does not match the first
    worksheet and is written to the next one, where <tt>\@type == "return"</tt> alone would raise
    \c EXCEL-WRITE-ROUTE-ERROR for it:

    @code{.py}
    ExcelWriteDataProvider dp("returns.xlsx", {"sheets": (
        {"worksheet": "Returns", "when": "exists @type && @type == \"return\""},
        {"worksheet": "Other"},
    )});
    dp.createRecord({"type": "return", "id": 1});
    # no type: written to the Other worksheet
    dp.createRecord({"id": 2});
    dp.finishCreate();
    @endcode

    An invalid worksheet, an invalid condition, or a worksheet option for a column that is not written raises
    \c EXCEL-WRITE-OPTION-ERROR naming the worksheet.  As the conditions can use fields that are not written, the
    record type of the provider is open with \c sheets.

    @subsection ExcelDataProvider_writing_formats Output Formats

    The write provider supports two formats:
    - \c xlsx: Modern Excel format (Excel 2007+, default)
    - \c xls: Legacy Excel format (Excel 97-2003)

    @code{.py}
    # Write legacy .xls format
    ExcelWriteDataProvider dp("legacy.xls", {"format": "xls"});
    @endcode

    @section ExcelDataProvider_datatypes Supported Data Types

    The module automatically handles the following Qore data types:
    - Strings
    - Integers and floats (as numeric cells)
    - Booleans
    - Dates (with timezone support)
    - Formulas (read: evaluates to result; write: as calculated value)

    @section ExcelDataProvider_errors Error Handling

    Common exceptions:
    - \c EXCEL-READ-OPTION-ERROR: Invalid read options or option conflicts
    - \c EXCEL-WRITE-OPTION-ERROR: Invalid write options or option conflicts
    - \c EXCEL-WRITE-ROUTE-ERROR: With the \c sheets write option, a record matches no worksheet, or the condition
      of a worksheet cannot be evaluated for a record; it is raised as \c CREATE-RECORD-ERROR, whose description
      begins with \c EXCEL-WRITE-ROUTE-ERROR (see @ref ExcelDataProvider_writing_sheets)
    - \c EXCEL-INVALID-LOCATION: Invalid cell range format
    - \c EXCEL-FORMULA-FIELD-ERROR: The \c formula_field option is empty or the name of a column
    - \c EXCEL-COLUMN-TYPE-ERROR: A value is not a value of its column's type
      (see @ref ExcelDataProvider_reading_types)
    - \c EXCEL-CELL-ERROR: A cell is an error, such as \c \#DIV/0!, and error cells are not accepted
      (see @ref ExcelDataProvider_reading_errors)

    @section ExcelDataProvider_relnotes Release Notes

    @subsection ExcelDataProvider_v1_1 ExcelDataProvider v1.1
    - the app declares \c external_io (@ref DataProvider::DataProviderAppInfo "DataProviderAppInfo"): its Java
      calls are uncontrolled APIs (\c QDOM_UNCONTROLLED_API), which a governing sandbox refuses, also from library
      code running for a sandboxed caller (qore#5741), so data provider consumers and the constructors of its data
      provider classes refuse sandboxed callers up front (\c APP-SANDBOX-ACCESS-DENIED) instead of failing in the
      middle of a call; the module requires \c DataProvider 3.12 or later
    - `preserve_empty_rows` lets the reader keep empty records, including trailing empty rows, when checking exports
    - added the \c header_row write option to place column headers after blank leading rows, including in
      individual worksheets of a multi-sheet workbook
    - added the \c list-worksheets action and
      @ref ExcelDataProvider::ExcelListWorksheetsDataProvider "ExcelListWorksheetsDataProvider": the worksheets of a
      workbook in order, each with its 0-based index, which the \c worksheet read option accepts, and whether it is
      hidden
    - added the \c column_masks write option: the display format of each column as a mask of the
      @ref valuemaskintro "ValueMask" module, such as \c DD.MM.YYYY or <tt>#.##0,00 €</tt>, the masks that CSV
      files and Qorus sheet contracts are read and written with (see @ref ExcelDataProvider_writing_column_masks)
    - added the \c column_headers write option, for header text that is not the column name, the
      \c write_headers write option, to write no header row, and the \c timezone write option, whose wall-clock
      time dates are written in
    - a date is written as its own wall-clock time, as by the @ref odsdataproviderintro "OdsDataProvider" writer;
      before, it was written as the wall-clock time of the time zone of the Java virtual machine
    - added the \c column_formats write option: a display format code for each column, such as \c dd.mm.yyyy,
      <tt>#,##0.00</tt> or \c 0.0%, written as a cell style while the cells keep their dates and numbers (see
      @ref ExcelDataProvider_writing_column_formats)
    - an unknown worksheet raises \c EXCEL-WORKSHEET-NOT-FOUND, naming the worksheet and listing the worksheets of
      the file, instead of a Java exception
    - added the \c worksheet_pattern read option: a regular expression that the name of exactly one worksheet must
      match, for files whose worksheet name changes from file to file; no match raises
      \c EXCEL-WORKSHEET-NOT-FOUND and more than one raises \c EXCEL-WORKSHEET-AMBIGUOUS
    - the \c worksheet option is documented to accept a 0-based position, and the \c ignore_empty option declares
      its default (\c false: reading stops at the first empty row) and that behavior in its option metadata
    - added @ref ExcelDataProvider::ExcelWriteDataProvider "ExcelWriteDataProvider" for writing Excel files
    - added @ref ExcelDataProvider::ExcelWriteDataProviderFactory "ExcelWriteDataProviderFactory"
    - added support for XLS (Excel 97-2003) format in both read and write operations
    - added \c tolwr option to convert header names to lowercase
    - added \c header_names option that defaults to row 1 when no \c header_cells specified
    - added \c data option to read from binary data
    - added \c streaming option for memory-efficient large file writes
    - added mutual exclusion validation for conflicting options
    - fixed namespace in ExcelReadDataProviderFactory (was incorrectly CsvUtil)
    - fixed typos in option names and comments
    - fixed Java error message for unknown worksheet
    - fixed resource leak in getWorksheets() methods
    - added the \c ignore_empty read option to continue reading past empty rows
    - fixed reading with no header options, or with \c headers and no \c data_cells, returning no data; data now
      starts on the first row
    - fixed cell ranges past column \c Z being rejected or accepted in the wrong order (ex: \c "z1:aa10")
    - fixed a \c data_cells range wider than the header range raising a Java index error
    - fixed the \c headers and \c header_names conflict check being skipped for the path and stream constructors
    - fixed @ref ExcelDataProvider::ExcelWorksheetReadDataProvider "ExcelWorksheetReadDataProvider" ignoring the
      \c data option and reading paths directly as local files instead of resolving them as file locations
    - fixed streaming writes (\c streaming) failing when no \c headers are given
    - fixed @ref ExcelDataProvider::ExcelReadDataProvider "ExcelReadDataProvider" failing with an empty-file error
      when the worksheet names or the provider info were requested after the record type or the records, or when
      the provider was used after acquiring a worksheet provider; this broke the \c read-data application action in
      Qorus
    - added @ref ExcelDataProvider::ExcelProfileDataProvider "ExcelProfileDataProvider" and the \c profile
      application action, which describe the layout and column types of every sheet, including hidden sheets,
      named ranges, merged cells, and formulas
    - fixed reading a \c data_cells range without an end column and without headers never ending; each row is read
      to its last cell with a value
    - records are read from .xlsx worksheets one row at a time, so worksheets with millions of rows are read in
      bounded memory instead of loading the workbook in memory
    - the input of the read data provider is copied to a temporary file instead of being read into memory
    - updated copyright to 2026
    - added the \c formula_field read option, which returns the formulas of each record's cells in a field of the
      record, as the \c profile action gives them, so a totals row made only of \c SUM formulas is recognized when
      the file is read as it is when the file is profiled; the formulas of an .xlsx worksheet, including shared
      formulas, are read as it is streamed
    - <b>columns are typed</b>: when a worksheet has headers, the type of each column is inferred from its first 100
      data rows, as the spreadsheet profile infers it, and the record type and the values have it, so a whole number
      in a column of whole numbers is read as an integer instead of a float; a later value of another type fails the
      read with \c EXCEL-COLUMN-TYPE-ERROR, naming the remedies; the new \c type_sample_rows read option sets the
      number of rows sampled (\c 0 reads every value as stored, as before), and the new \c column_types option
      gives the type of columns (see @ref ExcelDataProvider_reading_types)
    - <b>error cells fail the read</b>: a cell with an error, such as \c \#DIV/0!, raises \c EXCEL-CELL-ERROR
      instead of being read silently as no value; the new \c error_cells read option reads error cells as no
      value or as the error's text, and the new \c error_field option returns the errors of each record in a field of
      their own (see @ref ExcelDataProvider_reading_errors)
    - fixed the record type of a worksheet provider failing after a search of the worksheet
    - fixed a worksheet provider (@ref ExcelDataProvider::ExcelWorksheetReadDataProvider "ExcelWorksheetReadDataProvider")
      returning no records when searched a second time; each search now reads the worksheet with an iterator of its
      own, and a provider created from its own input (a location, a stream, or data) copies it once to a temporary
      file, deleted with the provider
    - fixed a worksheet provider created without input failing with a Java exception; it has no records

    - the \c profile action reads an .xlsx workbook one sheet at a time as it is streamed, keeping the rows up to
      \c max_rows and counting the others, so a workbook of any size is profiled in bounded memory; before, the
      workbook was loaded in memory; .xls workbooks are still read in memory
    - added the \c sheets write option, to write records to several worksheets, each with its own columns and
      column options, chosen for each record by a DPQL condition, and the \c route and \c unmatched options, for
      records that match several worksheets or none; the \c write-data action returns the number of records written
      to each worksheet (see @ref ExcelDataProvider_writing_sheets)
    - a worksheet written with its columns and no records has its header row; before, it was empty
    - an invalid \c worksheet write option raises \c EXCEL-WRITE-OPTION-ERROR; before, a name of more than 31
      characters was cut short to its first 31, and a name with a character that worksheet names cannot have raised
      a Java exception

    @subsection ExcelDataProvider_v1_0 ExcelDataProvider v1.0
    - initial release
*/

#! contains all public definitions in the ExcelDataProvider module
public namespace ExcelDataProvider {
#! Application name
public const AppName = "Excel";
}

namespace Priv {
#! Excel logo
const ExcelWhiteLogo = File::readTextFile(get_script_dir() + "/excel-logo.svg");
}
