# minimum required Qore version
%requires qore >= 1.0
%modern

# supports using the DataProvider module
%requires(reexport) DataProvider >= 3.9
%requires FileLocationHandler
%requires Util

%module-cmd(jni) add-relative-classpath ./jar/qore-dataprovider-excel.jar
%module-cmd(jni) add-relative-classpath ./jar/poi-5.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/poi-ooxml-5.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/poi-ooxml-full-5.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-compress-1.28.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-io-2.20.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-codec-1.19.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-lang3-3.18.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-math3-3.6.1.jar
%module-cmd(jni) add-relative-classpath ./jar/curvesapi-1.08.jar
%module-cmd(jni) add-relative-classpath ./jar/xmlbeans-5.3.0.jar
%module-cmd(jni) add-relative-classpath ./jar/commons-collections4-4.5.0.jar
%module-cmd(jni) add-relative-classpath ./jar/log4j-api-2.24.3.jar
%module-cmd(jni) add-relative-classpath ./jar/log4j-to-slf4j-2.24.3.jar
%module-cmd(jni) add-relative-classpath ./jar/slf4j-api-2.0.16.jar
%module-cmd(jni) add-relative-classpath ./jar/slf4j-nop-2.0.16.jar
%module-cmd(jni) add-relative-classpath ./jar/SparseBitSet-1.3.jar

%module-cmd(jni) import org.qore.dataprovider.excel.ExcelIterator
%module-cmd(jni) import org.qore.dataprovider.excel.ExcelFile
%module-cmd(jni) import org.qore.dataprovider.excel.ExcelGridReader
%module-cmd(jni) import org.qore.dataprovider.excel.ExcelWriter

module ExcelDataProvider {
    version = "1.1";
    desc = "user module providing a data provider API for reading and writing Excel spreadsheets";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factories
        DataProvider::registerFactory(new ExcelReadDataProviderFactory());
        DataProvider::registerFactory(new ExcelWriteDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ExcelDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "Excel Spreadsheets",
            "short_desc": "Read and write Excel spreadsheets",
            "desc": "Read and write Excel spreadsheets",
            "groups": (DataProvider::AppGroup::Spreadsheets,),
            "logo": ExcelWhiteLogo,
            "logo_file_name": "excel-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "read",
            #"subtype": "csvread",
            "display_name": "Read Excel Spreadsheet File",
            "short_desc": "Read Excel spreadsheet from a specific file location",
            "desc": "Read Excel spreadsheet from a specific file location",
            "action_code": DPAT_FIND,
            "cls": "ExcelDataProvider::ExcelReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"worksheet", "data_cells", "header_cells",
                    "header_names"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions - ("path", "worksheet", "data_cells", "header_cells",
                    "header_names", "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "profile",
            "display_name": "Profile Excel Spreadsheet",
            "short_desc": "Describe the layout and columns of every sheet of an Excel spreadsheet",
            "desc": "Describes how every sheet of an Excel spreadsheet (`.xlsx` or `.xls`) is laid out, so it can be "
                "read correctly before an integration is built around it.\n\n"
                "**Detects:**\n"
                "- hidden sheets, named ranges, merged cells, and formulas\n"
                "- the header row, title rows and banners above it, and the data region\n"
                "- totals and subtotal rows and blank-row gaps\n"
                "- each column's type with a confidence and counter-examples\n"
                "- dates and numbers stored as text in a local format, and identifiers with leading zeros\n\n"
                "Sample values are redacted to their shape by default (`redact`), so a profile can be shared "
                "without the data itself.",
            "action_code": DPAT_API,
            "cls": "ExcelDataProvider::ExcelProfileDataProvider",
            "output_type": TabularWorkbookProfileDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                TabularProfileRequestDataType::Fields{"path",}, {
                    "preselected": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                TabularProfileRequestDataType::Fields - ("path",)
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "read-data",
            #"subtype": "excelread",
            "display_name": "Read Excel Spreadsheet Inline Data",
            "short_desc": "Read Excel spreadsheet inline data",
            "desc": "Read Excel spreadsheet inline data",
            "action_code": DPAT_FIND,
            "cls": "ExcelDataProvider::ExcelReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"data",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions{"worksheet", "data_cells", "header_cells",
                    "header_names"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelReadDataProvider::ConstructorOptions - ("path", "worksheet", "data_cells", "header_cells",
                    "header_names", "stream", "data"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "write",
            "display_name": "Write Excel Spreadsheet File",
            "short_desc": "Write data to an Excel spreadsheet file",
            "desc": "Write data to an Excel spreadsheet file at a specified path",
            "action_code": DPAT_CREATE,
            "cls": "ExcelDataProvider::ExcelWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions{"path",}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions{"worksheet", "headers", "format"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions - ("path", "worksheet", "headers", "format", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ExcelDataProvider::AppName,
            "path": "/",
            "action": "write-data",
            "display_name": "Create Excel Spreadsheet Data",
            "short_desc": "Create Excel spreadsheet data and return as binary",
            "desc": "Create Excel spreadsheet data in memory and return it as binary data; useful for generating "
                "Excel files without writing to disk",
            "action_code": DPAT_CREATE,
            "output_data_type": DPAD_CREATE_OUTPUT,
            "output_type": GeneratedDataOutputDataType,
            "cls": "ExcelDataProvider::ExcelWriteDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions{"worksheet", "headers", "format"}, {
                    "preselected": True,
                    "loc": "constructor",
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ExcelWriteDataProvider::ConstructorOptions - ("path", "worksheet", "headers", "format", "stream"), {
                    "loc": "constructor",
                }
            ),
        });
    };
}

/** @mainpage ExcelDataProvider Module

    @tableofcontents

    @section exceldataproviderintro ExcelDataProvider Module Introduction

    <img src="excel-logo.svg" width="96" alt="ExcelDataProvider module logo"/>

    @anchor ExcelDataProviderintro

    The %ExcelDataProvider module provides a data provider API for reading and writing Excel spreadsheets
    through the @ref dataproviderintro "DataProvider" API. It supports both modern Excel formats (.xlsx,
    Excel 2007+) and legacy formats (.xls, Excel 97-2003).

    Records are read from an .xlsx worksheet one row at a time as they are iterated, so worksheets of any size, up
    to Excel's limit of 1048576 rows, are read in bounded memory; only the workbook's shared string table is held
    in memory.  An .xls workbook, whose format holds at most 65536 rows, is loaded in memory.  The input (a location,
    a stream, or binary data) is copied once to a temporary file, in bounded memory, which is read for the record
    type, the records, the worksheet names, and the worksheet providers, and deleted with the last provider using it.

    The following classes are provided by this module:
    - @ref ExcelDataProvider::ExcelReadDataProvider "ExcelReadDataProvider" - for reading Excel files
    - @ref ExcelDataProvider::ExcelReadDataProviderFactory "ExcelReadDataProviderFactory" - factory for read providers
    - @ref ExcelDataProvider::ExcelWriteDataProvider "ExcelWriteDataProvider" - for writing Excel files
    - @ref ExcelDataProvider::ExcelWriteDataProviderFactory "ExcelWriteDataProviderFactory" - factory for write providers
    - @ref ExcelDataProvider::ExcelWorksheetReadDataProvider "ExcelWorksheetReadDataProvider" - for reading specific worksheets

    @section ExcelDataProvider_reading Reading Excel Files

    @subsection ExcelDataProvider_reading_basic Basic Reading

    @code{.py}
    %requires ExcelDataProvider

    # Read from a file path
    ExcelReadDataProvider dp("data.xlsx", {"header_names": True});
    list<hash<auto>> records = map $1, dp.searchRecords();

    # Read from a stream
    FileInputStream fis("data.xlsx");
    ExcelReadDataProvider dp2(fis, {"header_names": True});

    # Read from binary data
    binary data = File::readBinaryFile("data.xlsx");
    ExcelReadDataProvider dp3({"data": data, "header_names": True});
    @endcode

    @subsection ExcelDataProvider_reading_options Read Options

    - \c path: Path to the Excel file
    - \c stream: Input stream for Excel data
    - \c data: Binary Excel data
    - \c worksheet: Name of the worksheet to read (default: first sheet)
    - \c header_names: If \c True, use first row as header names
    - \c header_cells: Cell range for headers (e.g., "a1:e1" or just "1" for row 1)
    - \c data_cells: Cell range for data (e.g., "a2:e100"); a range without an end column (e.g., "b2") ends at the
      last header column, or, without headers, at the last cell with a value in each row
    - \c headers: List of header names to use
    - \c tolwr: Convert header names to lowercase
    - \c timezone: Timezone for date values
    - \c ignore_empty: If \c True, skip empty rows and continue to the end of \c data_cells or the last row of the
      worksheet; by default reading stops at the first empty row
    - \c formula_field: the name of an extra field of every record holding the formulas of the record's cells: a
      hash of the formula text, without the leading \c "=", as the \c profile action gives it, by the cell's
      reference in the worksheet (\c "B5"), or @ref nothing if none of the cells holds a formula; passing the field
      to @ref DataProvider::TabularProfiler::hasTotalsFormula() "TabularProfiler::hasTotalsFormula()" recognizes a
      totals row made of \c SUM formulas as the profile does; a name that is a column of the worksheet raises
      \c EXCEL-FORMULA-FIELD-ERROR

    @subsection ExcelDataProvider_reading_multisheet Multi-Sheet Access

    @code{.py}
    ExcelReadDataProvider dp("workbook.xlsx");

    # List all worksheets
    list<string> sheets = dp.getChildProviderNames();

    # Access specific worksheet
    AbstractDataProvider sheet = dp.getChildProvider("Sheet2");
    list<hash<auto>> records = map $1, sheet.searchRecords();
    @endcode

    @section ExcelDataProvider_writing Writing Excel Files

    @subsection ExcelDataProvider_writing_basic Basic Writing

    @code{.py}
    %requires ExcelDataProvider

    # Write to a file
    ExcelWriteDataProvider dp("output.xlsx", {
        "worksheet": "Data",
        "headers": ("Name", "Age", "City"),
    });

    dp.createRecord({"Name": "Alice", "Age": 30, "City": "New York"});
    dp.createRecord({"Name": "Bob", "Age": 25, "City": "Boston"});

    dp.commit();  # Write the file
    @endcode

    @subsection ExcelDataProvider_writing_options Write Options

    - \c path: Output file path
    - \c stream: Output stream
    - \c worksheet: Worksheet name (default: "Sheet1")
    - \c headers: List of column headers
    - \c format: Output format - "xlsx" (default) or "xls"
    - \c streaming: Use streaming mode for large files (reduces memory usage)
    - \c column_formats: The display format of columns by header name (see
      @ref ExcelDataProvider_writing_column_formats)

    @subsection ExcelDataProvider_writing_column_formats Column Display Formats

    The \c column_formats option gives columns a display format code, as Excel and LibreOffice write them, so
    that whoever opens the file sees each value as intended.  The cells keep their real values: a date stays a
    date and a number a number; only the way they are shown changes.

    @code{.py}
    ExcelWriteDataProvider dp("invoices.xlsx", {
        "headers": ("Invoice", "Date", "Amount", "Discount"),
        "column_formats": {
            "Date": "dd.mm.yyyy",
            "Amount": "#,##0.00;(#,##0.00)",
            "Discount": "0.0%",
        },
    });
    # the date is shown as 07.10.2026, the amount as (1,234.50) and the discount as 2.5%
    dp.createRecord({"Invoice": "INV-1", "Date": 2026-10-07, "Amount": -1234.5, "Discount": 0.025});
    dp.finishCreate();
    @endcode

    Format codes are written as in Excel and LibreOffice:
    - numbers: \c 0 (a digit that is always shown), \c # (a digit shown when significant), \c , between digits
      (thousands grouping), \c , after the last digit (divide by 1000), \c . (the decimal point), and \c E+00
      (scientific notation); up to three sections for positive, negative and zero values separated by \c ;,
      such as <tt>#,##0.00;(#,##0.00)</tt> or <tt>#,##0.00;#,##0.00-</tt>
    - percentages: a \c % in each section, such as \c 0.0%; the value is a fraction, so \c 0.25 is shown as
      \c 25.0%
    - dates and times: \c yy or \c yyyy (year), \c m, \c mm, \c mmm or \c mmmm (month as a number or a name),
      \c d or \c dd (day), \c ddd or \c dddd (weekday name), \c h or \c hh (hour), \c m or \c mm directly after an
      hour or before a second (minute), \c s or \c ss (second), \c .0 to \c .000 after the second (fractions of a
      second), and \c AM/PM
    - text: \c @

    Text in a code is written in double quotes (<tt>"EUR"</tt>), escaped with a backslash (<tt>\\x</tt>), as a
    currency symbol in brackets (<tt>[$€-407]</tt>), or as itself for <tt>$ - + / ( ) :</tt>, spaces and symbols
    such as \c €; a section can start with a color such as <tt>[Red]</tt>.

    Only codes that an Excel cell style and an OpenDocument data style show the same way are accepted, so the
    same codes can be given to the @ref odsdataproviderintro "OdsDataProvider" writer.  An invalid or unsupported
    code (\c General, fractions, fill characters, conditions, or elapsed times), or a format for a column that is
    not written, raises \c EXCEL-WRITE-OPTION-ERROR naming the column and the problem.  A value that its column's
    code does not show, such as a string in a number column, is written without the format.  Each distinct code
    is one cell style in the workbook, whatever the number of rows.

    @subsection ExcelDataProvider_writing_formats Output Formats

    The write provider supports two formats:
    - \c xlsx: Modern Excel format (Excel 2007+, default)
    - \c xls: Legacy Excel format (Excel 97-2003)

    @code{.py}
    # Write legacy .xls format
    ExcelWriteDataProvider dp("legacy.xls", {"format": "xls"});
    @endcode

    @section ExcelDataProvider_datatypes Supported Data Types

    The module automatically handles the following Qore data types:
    - Strings
    - Integers and floats (as numeric cells)
    - Booleans
    - Dates (with timezone support)
    - Formulas (read: evaluates to result; write: as calculated value)

    @section ExcelDataProvider_errors Error Handling

    Common exceptions:
    - \c EXCEL-READ-OPTION-ERROR: Invalid read options or option conflicts
    - \c EXCEL-WRITE-OPTION-ERROR: Invalid write options or option conflicts
    - \c EXCEL-INVALID-LOCATION: Invalid cell range format
    - \c EXCEL-FORMULA-FIELD-ERROR: The \c formula_field option is empty or the name of a column

    @section ExcelDataProvider_relnotes Release Notes

    @subsection ExcelDataProvider_v1_1 ExcelDataProvider v1.1
    - added the \c column_formats write option: a display format code for each column, such as \c dd.mm.yyyy,
      <tt>#,##0.00</tt> or \c 0.0%, written as a cell style while the cells keep their dates and numbers (see
      @ref ExcelDataProvider_writing_column_formats)
    - an unknown worksheet raises \c EXCEL-WORKSHEET-NOT-FOUND, naming the worksheet and listing the worksheets of
      the file, instead of a Java exception
    - added the \c worksheet_pattern read option: a regular expression that the name of exactly one worksheet must
      match, for files whose worksheet name changes from file to file; no match raises
      \c EXCEL-WORKSHEET-NOT-FOUND and more than one raises \c EXCEL-WORKSHEET-AMBIGUOUS
    - the \c worksheet option is documented to accept a 0-based position, and the \c ignore_empty option declares
      its default (\c false: reading stops at the first empty row) and that behavior in its option metadata
    - added @ref ExcelDataProvider::ExcelWriteDataProvider "ExcelWriteDataProvider" for writing Excel files
    - added @ref ExcelDataProvider::ExcelWriteDataProviderFactory "ExcelWriteDataProviderFactory"
    - added support for XLS (Excel 97-2003) format in both read and write operations
    - added \c tolwr option to convert header names to lowercase
    - added \c header_names option that defaults to row 1 when no \c header_cells specified
    - added \c data option to read from binary data
    - added \c streaming option for memory-efficient large file writes
    - added mutual exclusion validation for conflicting options
    - fixed namespace in ExcelReadDataProviderFactory (was incorrectly CsvUtil)
    - fixed typos in option names and comments
    - fixed Java error message for unknown worksheet
    - fixed resource leak in getWorksheets() methods
    - added the \c ignore_empty read option to continue reading past empty rows
    - fixed reading with no header options, or with \c headers and no \c data_cells, returning no data; data now
      starts on the first row
    - fixed cell ranges past column \c Z being rejected or accepted in the wrong order (ex: \c "z1:aa10")
    - fixed a \c data_cells range wider than the header range raising a Java index error
    - fixed the \c headers and \c header_names conflict check being skipped for the path and stream constructors
    - fixed @ref ExcelDataProvider::ExcelWorksheetReadDataProvider "ExcelWorksheetReadDataProvider" ignoring the
      \c data option and reading paths directly as local files instead of resolving them as file locations
    - fixed streaming writes (\c streaming) failing when no \c headers are given
    - fixed @ref ExcelDataProvider::ExcelReadDataProvider "ExcelReadDataProvider" failing with an empty-file error
      when the worksheet names or the provider info were requested after the record type or the records, or when
      the provider was used after acquiring a worksheet provider; this broke the \c read-data application action in
      Qorus
    - added @ref ExcelDataProvider::ExcelProfileDataProvider "ExcelProfileDataProvider" and the \c profile
      application action, which describe the layout and column types of every sheet, including hidden sheets,
      named ranges, merged cells, and formulas
    - fixed reading a \c data_cells range without an end column and without headers never ending; each row is read
      to its last cell with a value
    - records are read from .xlsx worksheets one row at a time, so worksheets with millions of rows are read in
      bounded memory instead of loading the workbook in memory
    - the input of the read data provider is copied to a temporary file instead of being read into memory
    - updated copyright to 2026
    - added the \c formula_field read option, which returns the formulas of each record's cells in a field of the
      record, as the \c profile action gives them, so a totals row made only of \c SUM formulas is recognized when
      the file is read as it is when the file is profiled; the formulas of an .xlsx worksheet, including shared
      formulas, are read as it is streamed

    @subsection ExcelDataProvider_v1_0 ExcelDataProvider v1.0
    - initial release
*/

#! contains all public definitions in the ExcelDataProvider module
public namespace ExcelDataProvider {
#! Application name
public const AppName = "Excel";
}

namespace Priv {
#! Excel logo
const ExcelWhiteLogo = File::readTextFile(get_script_dir() + "/excel-logo.svg");
}
