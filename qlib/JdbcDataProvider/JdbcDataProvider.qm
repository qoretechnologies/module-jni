# minimum required Qore version
%requires qore >= 3.0
%modern

# import custom JDBC helper JAR: must be added to the global classloader
# because JDBC connections persist through thread pools
%module-cmd(jni) global-add-relative-classpath ./jar/qore-dataprovider-jdbc.jar

%module-cmd(jni) import org.qore.dataprovider.jdbc.JdbcSchemaIntrospector
%module-cmd(jni) import org.qore.dataprovider.jdbc.JdbcQueryExecutor
%module-cmd(jni) import org.qore.dataprovider.jdbc.JdbcTypeMapper

# import JDK built-in JDBC classes
%module-cmd(jni) import java.sql.DriverManager

# supports using the DataProvider module
%requires(reexport) DataProvider >= 3.12
# implements support for JDBC connections
%requires(reexport) ConnectionProvider
%requires Util

module JdbcDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for JDBC database access";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register connection schemes
        ConnectionSchemeCache::registerScheme("jdbc-dp", JdbcConnection::ConnectionScheme);

        # register the data provider factory
        DataProvider::registerFactory(new JdbcDataProviderFactory());

        # register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": JdbcDataProvider::AppName,
            "presentation_source_locale": "en",
            # Java I/O that the Qore sandbox does not see (qore#5632): the JDBC driver connects to the destinations
            # of the URL itself
            "external_io": True,
            "display_name": "JDBC Database",
            "short_desc": "JDBC database access",
            "desc": "Access any JDBC-compatible database with schema introspection and SQL "
                "execution.\n\n"
                "**Capabilities**:\n"
                "- Execute SQL queries with parameterized arguments\n"
                "- Execute DDL and DML statements (CREATE, INSERT, UPDATE, DELETE)\n"
                "- Browse database tables and introspect column metadata\n"
                "- Dynamic column type mapping from SQL types to Qore types\n\n"
                "Database-specific JDBC drivers can be loaded with the `classpath` and "
                "`driver_class` connection options, or made available with JNI classpath "
                "configuration before the provider is created.\n\n"
                "**Supported databases**: PostgreSQL, Oracle, MySQL, SQL Server, and any "
                "database with a JDBC driver.",
            "groups": (DataProvider::AppGroup::Databases,),
            "scheme": "jdbc-dp",
            "logo": JdbcLogo,
            "logo_file_name": "jdbc-dp-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JdbcDataProvider::AppName,
            "path": "/query",
            "action": "query",
            "display_name": "Execute SQL Query",
            "short_desc": "Execute a SQL query and return results",
            "desc": "Execute a SQL query and return the result rows.\n\nUse `?` placeholders in "
                "the SQL string and provide arguments in the `args` list for parameterized "
                "queries.\n\n**Example**: `SELECT * FROM orders WHERE status = ? AND total > ?` "
                "with `args` = `(\"shipped\", 100.0)`",
            "action_code": DPAT_FIND,
            "output_type": JdbcQueryResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                JdbcQueryRequestDataType::Fields{"sql",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                JdbcQueryRequestDataType::Fields{"args",}, {
                    "preselected": True,
                }
            ),
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": JdbcDataProvider::AppName,
            "path": "/exec",
            "action": "exec",
            "display_name": "Execute SQL Statement",
            "short_desc": "Execute a SQL statement",
            "desc": "Execute a SQL statement (DDL or DML) and return the number of affected "
                "rows.\n\nUse for `INSERT`, `UPDATE`, `DELETE`, `CREATE TABLE`, and other "
                "non-query statements.\n\n**Example**: `INSERT INTO users (name, email) VALUES "
                "(?, ?)` with `args` = `(\"Alice\", \"alice@example.com\")`",
            "action_code": DPAT_API,
            "output_type": JdbcQueryResponseDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                JdbcQueryRequestDataType::Fields{"sql",}, {
                    "preselected": True,
                    "required": True,
                }
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                JdbcQueryRequestDataType::Fields{"args",}, {
                    "preselected": True,
                }
            ),
        });
    };
    # PROCESS_CONTROL: its init registers connection scheme and data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage JdbcDataProvider Module

    @tableofcontents

    @section jdbcdataproviderintro JdbcDataProvider Module Introduction

    <img src="jdbc-dp-logo.svg" width="96" alt="JdbcDataProvider module logo"/>

    The %JdbcDataProvider module provides a data provider API for JDBC database access.

    This data provider provides JDBC functionality with the \c jdbc-dp factory and data provider with
    the same name, supporting database table browsing, SQL query execution, and SQL statement execution
    (class @ref JdbcDataProvider::JdbcDataProvider "JdbcDataProvider").

    Database-specific JDBC drivers must be available to the JVM before a JDBC connection is opened.
    Pass \c classpath and, when the driver is not auto-registered by the JVM, \c driver_class in the
    provider or connection options.  Drivers can also be made available with the \c QORE_JNI_CLASSPATH
    environment variable or JNI classpath configuration.

    @par Sandbox access
    The app requires DataProvider 3.12 or later and declares <tt>external_io</tt> for its Java calls.
    Data provider consumers reject sandboxed callers with <tt>APP-SANDBOX-ACCESS-DENIED</tt>.

    The \c classpath and \c driver_class options, and a \c url with driver properties, are refused to sandboxed
      code (\c JNI-SANDBOX-ERROR).

    Code restricted from the \c DATABASE or \c FILESYSTEM functional domain cannot create a data provider from options
    (\c PERMISSION-DENIED), as it cannot create a connection: the options (the URL, for example of a file database, and
    the \c classpath, which names local files that Java loads as code) name what the data provider uses.  The data
    providers of a connection that host code lent to such code are created only from the members and options that the
    connection's creator gave it (JdbcConnection::getDataProviderSource()), also when such code creates them itself or
    with library code.

    @section jdbcdataprovider_examples JDBC Data Provider Examples

    These examples are with \c qdp, the command-line interface to the Data Provider API.

    @par API Example: List Tables
    @verbatim qdp 'jdbc-dp{url=jdbc:postgresql://localhost/mydb,user=myuser,password=secret,classpath=/usr/share/java/postgresql.jar,driver_class=org.postgresql.Driver}/tables' children
    @endverbatim

    @par API Example: Execute Query
    @verbatim qdp 'jdbc-dp{url=jdbc:postgresql://localhost/mydb,user=myuser,password=secret}/query' request sql="SELECT * FROM users"
    @endverbatim

    @par API Example: Execute Statement
    @verbatim qdp 'jdbc-dp{url=jdbc:postgresql://localhost/mydb,user=myuser,password=secret}/exec' request sql="INSERT INTO users (name) VALUES ('test')"
    @endverbatim

    @anchor jdbcdataprovider_relnotes

    @subpage jdbcdataproviderreleasenotes
*/

/** @page jdbcdataproviderreleasenotes JdbcDataProvider Release Notes

    @section jdbcdataprovider_v1_0 JdbcDataProvider Module Version 1.0
    - initial release
    - <b>Behavior change</b>: code restricted from the \c DATABASE or \c FILESYSTEM functional domain cannot create a
      JdbcDataProvider from options, as it cannot create a JdbcConnection: the options (the URL, for example of a file
      database, and the \c classpath of the driver, which names local files that Java loads as code) name what it uses
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
    - <b>Behavior change</b>: the data providers of a connection that host code lent to code restricted from a domain of
      its clients are created only from the members and options that its creator gave it, also when that code creates
      them itself from the connection or with library code: such code can give them no options (also none that name no
      path, such as \c url or \c user) and change none of the connection's members
      (<a href="https://github.com/qoretechnologies/qore/issues/7811">issue 7811</a>)
*/

#! Contains all public definitions in the JdbcDataProvider module
public namespace JdbcDataProvider {
#! JDBC data provider application name
public const AppName = "JdbcDP";
}

namespace Priv {

#! Refuses a data provider that code restricted from the domains of its connections creates itself (qore#7811)
/** A data provider of the module connects to a database, and its options (the URL, for example of a file database,
    and the classpath of the driver) name what it uses, as the options of a JdbcConnection do: code restricted from the
    domains of the connection (\c DATABASE and \c FILESYSTEM) cannot create the connection, and so it cannot create
    the data provider itself either; such code uses the data provider of a connection that the host lent it
    (JdbcConnection::getDataProvider()), which is created with the options of the connection's creator (see
    JdbcConnection::getDataProviderSource())

    @throw PERMISSION-DENIED the calling code is restricted from the \c DATABASE or \c FILESYSTEM functional domain
*/
sub check_creator() {
    list<string> denied = ();
    if (SandboxManager::isCallerRestricted(DOM_DATABASE)) {
        denied += "DATABASE";
    }
    if (SandboxManager::isCallerRestricted(DOM_FILESYSTEM)) {
        denied += "FILESYSTEM";
    }
    if (denied) {
        throw "PERMISSION-DENIED", sprintf("code restricted from the %s functional domain%s cannot create a jdbc-dp "
            "data provider itself; use the data provider of a connection that the host provides",
            denied.join(" and "), denied.size() > 1 ? "s" : "");
    }
}

#! Adds JDBC driver classpath entries and optionally instantiates the driver class
/** @param copts connection options; supports optional \c classpath and \c driver_class keys

    @note Instantiating the driver class triggers the static JDBC driver registration used by
    java.sql.DriverManager for drivers that are not otherwise discovered.
*/
sub prepareJdbcDriver(hash<auto> copts) {
    # both options make Java load code that the sandbox does not control: before either is used (qore#5742)
    if (copts.classpath) {
        Jni::org::qore::jni::check_class_option("jdbc-dp", "classpath");
    }
    if (copts.driver_class) {
        Jni::org::qore::jni::check_class_option("jdbc-dp", "driver_class");
    }
    # driver properties in the URL ("?name=value", ";name=value", or key-value forms such as "(name=value)") are
    # interpreted by the driver, and some name classes for it to load
    if (copts.url =~ /[?;=(&]/) {
        Jni::org::qore::jni::check_class_option("jdbc-dp", "url", "sets JDBC driver properties, which can name "
            "Java classes for the driver to load");
    }
    if (copts.classpath) {
        list<string> paths = copts.classpath.split(",");
        foreach string path in (paths) {
            path = trim(path);
            if (path.val()) {
                Program::issueModuleCmd("jni", "add-classpath " + path);
            }
        }
    }

    if (copts.driver_class) {
        load_class(copts.driver_class).getConstructor().newInstance();
    }
}

#! JDBC logo
const JdbcLogo = File::readTextFile(get_script_dir() + "/jdbc-dp-logo.svg");
}
