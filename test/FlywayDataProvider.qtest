%modern

%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ConnectionProvider
%requires Util
%requires jni
%ifdef FLYWAY_TEST_DRIVER_CLASSPATH
# Flyway's global loader must also see the test database driver.
%module-cmd(jni) global-add-classpath $JDBC_DB_CLASSPATH
%endif
%requires FlywayDataProvider

%exec-class FlywayDataProviderTest

public class FlywayDataProviderTest inherits QUnit::Test {
    private {
        #! the schema managed by the tests: clean drops every object in the schemas Flyway manages
        const Schema = "qore_flyway_test";

        string test_data_dir;
        *string jdbc_url;
        *string jdbc_user;
        *string jdbc_password;
        #! the database driver is on Flyway's global classpath
        bool driver_classpath;
    }

    constructor() : Test("FlywayDataProviderTest", "1.0", \ARGV) {
        # Get absolute path for test data directory
        string script_dir = get_script_dir();
        if (script_dir == ".") {
            script_dir = getcwd();
        }
        test_data_dir = script_dir + "/flyway-test-data/sql";

        # the connection is a jdbc datasource string, as for the jdbc driver tests (ex:
        # "jdbc:user/pass@ignored{url=postgresql://host:5432/db,classpath=/path/postgresql.jar}")
        if (ENV.QORE_DB_CONNSTR_JDBC_PGSQL) {
            hash<auto> ds = parse_datasource(ENV.QORE_DB_CONNSTR_JDBC_PGSQL);
            string url = ds.options.url ?? ds.db;
            jdbc_url = url =~ /^jdbc:/ ? url : "jdbc:" + url;
            jdbc_user = ds.user;
            jdbc_password = ds.pass;
        }
%ifdef FLYWAY_TEST_DRIVER_CLASSPATH
        driver_classpath = True;
%endif

        addTestCase("factory test", \testFactory());
        addTestCase("child providers", \testChildProviders());
        addTestCase("action registration", \testActionRegistration());
        addTestCase("negative: missing url", \testNegativeMissingUrl());
        addTestCase("negative: missing user", \testNegativeMissingUser());
        addTestCase("migrate and info", \testMigrateAndInfo());
        addTestCase("validate", \testValidate());
        addTestCase("validation failure response", \testValidationFailure());
        addTestCase("clean and repair", \testCleanAndRepair());
        addTestCase("schemas and history table options", \testSchemasAndTable());

        # execute tests and set program return value
        set_return_value(main());
    }

    private checkConnection() {
        if (!jdbc_url) {
            testSkip("no JDBC connection available (QORE_DB_CONNSTR_JDBC_PGSQL not set)");
        }
        if (!driver_classpath) {
            testSkip("the database driver is not on Flyway's global classpath (run with "
                "-DFLYWAY_TEST_DRIVER_CLASSPATH and JDBC_DB_CLASSPATH set to the driver)");
        }
    }

    private hash<auto> getOptions(string location = "filesystem:" + test_data_dir) {
        return {
            "url": jdbc_url,
            "user": jdbc_user,
            "password": jdbc_password,
            "locations": (location,),
            # a schema of its own, so that clean cannot drop the objects of the database's default schema
            "schemas": (Schema,),
        };
    }

    private testFactory() {
        FlywayDataProviderFactory factory();
        assertEq("flyway", factory.getInfo().name);
    }

    private testChildProviders() {
        checkConnection();
        FlywayDataProvider dp(getOptions());
        # Verify child provider names
        list<string> children = dp.getChildProviderNames();
        assertTrue(children.size() >= 5);
        assertTrue(inlist("migrate", children));
        assertTrue(inlist("info", children));
        assertTrue(inlist("validate", children));
        assertTrue(inlist("clean", children));
        assertTrue(inlist("repair", children));
    }

    private testActionRegistration() {
        assertEq(True, DataProviderActionCatalog::getApp("Flyway").val());
        hash<string, hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionHash("Flyway");
        assertEq(FlywayMigrateDataProvider::ResponseType, actions.migrate.output_type);
        assertEq(FlywayValidateOutputDataType, actions.validate.output_type);
        assertEq(FlywaySuccessOutputDataType, actions.clean.output_type);
        assertEq(FlywaySuccessOutputDataType, actions.repair.output_type);
    }

    private testNegativeMissingUrl() {
        assertThrows("FLYWAY-CONSTRUCTOR-ERROR", sub () {
            new FlywayDataProvider({
                "user": "test",
                "password": "test",
            });
        });
    }

    private testNegativeMissingUser() {
        assertThrows("FLYWAY-CONSTRUCTOR-ERROR", sub () {
            new FlywayDataProvider({
                "url": "jdbc:postgresql://localhost/test",
            });
        });
    }

    private testMigrateAndInfo() {
        checkConnection();
        FlywayDataProvider dp(getOptions());

        # Clean first to ensure a fresh state
        AbstractDataProvider cleanDp = dp.getChildProvider("clean");
        cleanDp.doRequest(NOTHING);

        # Run migrate
        AbstractDataProvider migrateDp = dp.getChildProvider("migrate");
        auto result = migrateDp.doRequest(NOTHING);
        assertTrue(result instanceof list);
        assertEq(2, result.size());
        assertEq("1", result[0].version);
        assertEq("2", result[1].version);
        assertTrue(result[0].filepath.endsWith("V1__create_test_table.sql"));
        assertEq(result, migrateDp.getResponseType().acceptsValue(result));
        assertEq((), migrateDp.doRequest(NOTHING));
        assertThrows("TYPE-VALUE-ERROR", sub () { migrateDp.doRequest({}); });

        # Check info: when Flyway creates the schema it manages, it records the creation before the migrations
        # ("<< Flyway Schema Creation >>", without a version)
        AbstractDataProvider infoDp = dp.getChildProvider("info");
        list<hash<auto>> records = map $1, infoDp.searchRecords();
        assertEq(("1", "2"), map $1.version, records, $1.version);
        assertEq((), map $1, records, !$1.version && $1.type != "SCHEMA");
        assertEq(("SUCCESS",), keys (map {$1.state: True}, records));
    }

    private testValidate() {
        checkConnection();
        FlywayDataProvider dp(getOptions());

        AbstractDataProvider validateDp = dp.getChildProvider("validate");
        auto result = validateDp.doRequest(NOTHING);
        assertTrue(result.validationSuccessful);
        assertEq((), result.invalidMigrations);
        assertEq(NOTHING, result.errorDetails);
        assertEq(result, validateDp.getResponseType().acceptsValue(result));
    }

    private testValidationFailure() {
        checkConnection();
        TmpDir changed();
        foreach string filename in ("V1__create_test_table.sql", "V2__add_email_column.sql") {
            string content = File::readTextFile(test_data_dir + DirSep + filename);
            if (filename.startsWith("V1")) {
                content += "\nselect 1;\n";
            }
            File f();
            f.open2(changed.path + DirSep + filename, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(content);
            f.close();
        }
        FlywayDataProvider dp(getOptions("filesystem:" + changed.path));
        AbstractDataProvider provider = dp.getChildProvider("validate");
        hash<auto> result = provider.doRequest(NOTHING);
        assertFalse(result.validationSuccessful);
        assertEq(1, result.invalidMigrations.size());
        assertEq("1", result.invalidMigrations[0].version);
        assertTrue(result.invalidMigrations[0].errorDetails.contains("checksum mismatch"));
        assertTrue(result.errorDetails.val());
        assertEq(result, provider.getResponseType().acceptsValue(result));
    }

    private testCleanAndRepair() {
        checkConnection();
        FlywayDataProvider dp(getOptions());

        # Clean
        AbstractDataProvider cleanDp = dp.getChildProvider("clean");
        auto result = cleanDp.doRequest(NOTHING);
        assertEq({"success": True}, result);
        assertEq(result, cleanDp.getResponseType().acceptsValue(result));

        # Repair
        AbstractDataProvider repairDp = dp.getChildProvider("repair");
        result = repairDp.doRequest(NOTHING);
        assertEq({"success": True}, result);
        assertEq(result, repairDp.getResponseType().acceptsValue(result));

        # Final clean to leave the database in a clean state
        cleanDp = dp.getChildProvider("clean");
        cleanDp.doRequest(NOTHING);
    }

    #! migrations and the history table are in the configured schema, and clean drops the objects of that schema only
    private testSchemasAndTable() {
        checkConnection();
        # a table in the default schema of the database
        Datasource ds(ENV.QORE_DB_CONNSTR_JDBC_PGSQL);
        ds.open();
        ds.execRaw("create table if not exists qore_flyway_sentinel (id int)");
        ds.commit();
        on_exit {
            ds.rollback();
            ds.execRaw("drop table if exists qore_flyway_sentinel");
            ds.commit();
        }
        string tables_sql = sprintf("select table_name from information_schema.tables where table_schema = '%s' "
            "order by 1", Schema);
        # the tables in the default schema that the tests could create or drop; other tables are not compared, as
        # the database may be shared
        string default_schema_sql = "select table_name from information_schema.tables where table_schema = "
            "current_schema() and table_name in ('flyway_test', 'qore_flyway_history', 'flyway_schema_history', "
            "'qore_flyway_sentinel') order by 1";
        list<auto> default_tables = ds.select(default_schema_sql).table_name;
        assertTrue(inlist("qore_flyway_sentinel", default_tables));

        FlywayDataProvider dp(getOptions() + {"table": "qore_flyway_history"});
        dp.getChildProvider("clean").doRequest(NOTHING);
        assertEq(2, dp.getChildProvider("migrate").doRequest(NOTHING).size());
        assertEq(("flyway_test", "qore_flyway_history"), ds.select(tables_sql).table_name);
        # the migrations did not change the default schema
        assertEq(default_tables, ds.select(default_schema_sql).table_name);

        dp.getChildProvider("clean").doRequest(NOTHING);
        assertEq((), ds.select(tables_sql).table_name);
        # neither did clean
        assertEq(default_tables, ds.select(default_schema_sql).table_name);
    }
}
