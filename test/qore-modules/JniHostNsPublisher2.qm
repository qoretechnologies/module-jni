%modern

module JniHostNsPublisher2 {
    version = "1.0";
    desc = "test module that publishes into a namespace the loading program also declares";
    author = "Qore Technologies, s.r.o.";
}

/*  Fixture for JniLegacyPackageHostSymbols.qtest.

    ::JniHostNs models a namespace the *host program* owns and this module merely publishes
    into; ::JniHostNsOnly models one where every member really did come from this module.
    Loading this module before the host declares its own symbols makes this module the single
    contributing module of both.
*/

public namespace JniHostNs {
public class ModuleOwned2 {
    static string who() {
        return "module2";
    }
}
}

public namespace JniHostNsOnly2 {
public class OnlyModule2 {
    static string who() {
        return "module-only2";
    }
}
}
