%modern

module JniShadowModule {
    version = "1.0";
    desc = "test module declaring a class at the same namespace path as the loading program";
    author = "Qore Technologies, s.r.o.";
}

/*  This module exists to cover canonical Java classloader routing when two Programs in the
    same process hold different classes at the same namespace path.  It declares
    JniShadowNs::Sub::Target, which jni.qtest also declares in its own Program with a
    different implementation.

    The second top-level namespace is required: a module contributing to a single root
    namespace owns that namespace, and dynamic Java classes for its classes are then exposed
    only under the canonical qoremod.<mod>.<rest> binary name, which makes the legacy
    qore.<X>.<Y> form fail outright instead of resolving to the wrong class.
*/

public namespace JniShadowNs {
public namespace Sub {
public class Target {
    static string who() {
        return "module";
    }
}
}
}

public namespace JniShadowOther {
public class Filler {
    static string tag() {
        return "filler";
    }
}
}
