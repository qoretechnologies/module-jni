# -*- mode: qore; indent-tabs-mode: nil -*-
# JniCtxList.qm - test module that Java lists the qoremod.JniCtxList package of, whose initialization code makes a
# Java call in another Program (test/jni-context-direct-calls.qtest)

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%requires JniCtxHelper

module JniCtxList {
    version = "1.0";
    desc = "test module for the thread's Java context during class loading (qore#6551)";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        # a Java call in the helper module's Program, made while Java lists the classes of this module
        JniCtxHelper::touch();
    };
}

public namespace JniCtxList {
    #! a class of the package that Java lists, which loads this module
    public class Probe {
        int value() {
            return 1;
        }
    }
}
