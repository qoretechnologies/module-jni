#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ConnectionProvider
%requires KafkaDataProvider
%requires AsyncApi

%exec-class KafkaDataProviderTest

public class KafkaDataProviderTest inherits QUnit::Test {
    private {
        #! The Kafka connection for the integration test, if one is configured
        KafkaConnection kafka_conn;

        #! The error raised when a configured Kafka connection could not be set up
        *hash<ExceptionInfo> setup_error;

        const AsyncApiChannel = "messages";

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! The maximum time to wait for a produced message to be consumed
        const ConsumeTimeout = 30s;
    }

    constructor() : Test("KafkaDataProviderTest Test", "1.0", \ARGV, MyOpts) {
        addTestCase("AsyncAPI options", \asyncApiOptionsTest());
        addTestCase("AsyncAPI validation", \asyncApiValidationTest());
        addTestCase("AsyncAPI option validation", \asyncApiOptionValidationTest());
        addTestCase("factory child option forwarding", \factoryChildOptionForwardingTest());
        addTestCase("action registration", \actionRegistrationTest());
        addTestCase("event data types", \eventDataTypeTest());
        addTestCase("Kafka integration test", \kafkaIntegrationTest());
        addTestCase("Kafka record headers", \kafkaHeadersTest());

        # the integration test runs only when a broker is configured; a configured broker that cannot be used
        # fails the test instead of skipping it
        *string conn_url = m_options.conn ?? ENV.KAFKA_CONNECTION;
        if (conn_url.val()) {
            try {
                kafka_conn = new KafkaConnection("test-kafka", "Kafka integration test connection", conn_url);
            } catch (hash<ExceptionInfo> ex) {
                setup_error = ex;
            }
        }

        set_return_value(main());
    }

    asyncApiOptionsTest() {
        checkAsyncApiProviderOptions(KafkaDataProvider::ConstructorOptions, "parent");
        checkAsyncApiProviderOptions(KafkaProducerDataProvider::ConstructorOptions, "producer");
        checkAsyncApiProviderOptions(KafkaConsumerDataProvider::ConstructorOptions, "consumer");

        hash<auto> conn_opts = KafkaConnection::ConnectionScheme.options;
        assertTrue(conn_opts.hasKey("asyncapi"), "connection should have 'asyncapi' option");
        assertTrue(conn_opts.hasKey("asyncapi_channel"),
            "connection should have 'asyncapi_channel' option");
        assertTrue(conn_opts.hasKey("validator"), "connection should have 'validator' option");
        assertEq("string", conn_opts.asyncapi.type);
        assertEq("string", conn_opts.asyncapi_channel.type);
        assertEq("file-as-string", conn_opts.validator.type);
        assertTrue(conn_opts.validator.freeform, "connection validator should allow freeform locations");

        hash<auto> opts = {
            "bootstrap.servers": "localhost:9092",
            "asyncapi": "file:///tmp/schema.yaml",
            "asyncapi_channel": AsyncApiChannel,
            "validator": createAsyncApiSchemaSource(),
        };
        KafkaDataProviderBase::removeAsyncApiOptions(\opts);
        assertEq("localhost:9092", opts."bootstrap.servers");
        assertFalse(opts.hasKey("asyncapi"), "asyncapi option should be stripped");
        assertFalse(opts.hasKey("asyncapi_channel"), "asyncapi_channel option should be stripped");
        assertFalse(opts.hasKey("validator"), "validator option should be stripped");
    }

    asyncApiValidationTest() {
        KafkaDataProvider prov(createConnection());
        prov.configureAsyncApiOptions({
            "validator": createAsyncApiSchemaSource(),
            "asyncapi_channel": AsyncApiChannel,
        });

        assertTrue(prov.getAsyncApiValidator() instanceof AsyncApi::AsyncApi3Schema,
            "provider should retain AsyncAPI validator");
        assertEq(AsyncApiChannel, prov.getAsyncApiChannel());

        auto outgoing = {"message": "hello"};
        hash<auto> headers;
        prov.validateOutgoingMessage(\outgoing, \headers);
        assertEq("hello", outgoing.message);

        auto incoming = {"message": "received"};
        prov.validateIncomingMessage(\incoming);
        assertEq("received", incoming.message);

        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            auto invalid = {"unexpected": True};
            hash<auto> invalid_headers;
            prov.validateOutgoingMessage(\invalid, \invalid_headers);
        });

        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            auto invalid = {"unexpected": True};
            prov.validateIncomingMessage(\invalid);
        });

        prov.clearAsyncApiValidator();
        *AsyncApi::AsyncApi3Schema cleared_validator = prov.getAsyncApiValidator();
        *string cleared_channel = prov.getAsyncApiChannel();
        assertFalse(exists cleared_validator, "validator should be cleared");
        assertFalse(exists cleared_channel, "channel should be cleared");

        string tmp_dir = make_tmp_dir();
        on_exit remove_tree(tmp_dir);
        string schema_path = tmp_dir + "/kafka-schema.yaml";
        File f();
        f.open2(schema_path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(createAsyncApiSchemaSource());
        f.close();

        KafkaDataProvider location_prov(createConnection());
        location_prov.configureAsyncApiOptions({
            "validator": schema_path,
            "asyncapi_channel": AsyncApiChannel,
        });
        assertTrue(location_prov.getAsyncApiValidator() instanceof AsyncApi::AsyncApi3Schema,
            "provider should load AsyncAPI validator from a file location");
    }

    asyncApiOptionValidationTest() {
        KafkaDataProvider prov(createConnection());
        string schema = createAsyncApiSchemaSource();

        assertThrows("CONSTRUCTOR-ERROR", sub () {
            prov.configureAsyncApiOptions({"validator": schema});
        });
        assertNoAsyncApiConfig(prov);
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            prov.configureAsyncApiOptions({"asyncapi_channel": AsyncApiChannel});
        });
        assertNoAsyncApiConfig(prov);
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            prov.configureAsyncApiOptions({
                "validator": {},
                "asyncapi_channel": AsyncApiChannel,
            });
        });
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            prov.configureAsyncApiOptions({
                "validator": schema,
                "asyncapi": "file:///tmp/schema.yaml",
                "asyncapi_channel": AsyncApiChannel,
            });
        });
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            prov.configureAsyncApiOptions({"asyncapi": ""});
        });
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            prov.configureAsyncApiOptions({
                "validator": "",
                "asyncapi_channel": AsyncApiChannel,
            });
        });
    }

    factoryChildOptionForwardingTest() {
        hash<auto> root_opts = KafkaDataProvider::ConstructorOptions;
        assertTrue(root_opts.hasKey("topics"), "root factory should expose consumer 'topics' option");
        assertTrue(root_opts.hasKey("group.id"), "root factory should expose consumer 'group.id' option");
        assertTrue(root_opts.hasKey("acks"), "root factory should expose producer 'acks' option");
        assertFalse(root_opts.topics.required ?? False,
            "root factory should not require consumer-only 'topics' for producer providers");
        assertTrue(KafkaConsumerDataProvider::ConstructorOptions.topics.required,
            "consumer provider should still require 'topics'");

        KafkaDataProvider consumer_root({
            "server": "localhost:9092",
            "topics": ("qore-test-topic",),
            "group.id": "qore-test-group",
            "auto.offset.reset": "earliest",
        });
        *DataProvider::AbstractDataProvider consumer = consumer_root.getChildProviderEx("consumer");
        assertTrue(exists consumer, "root factory forwards consumer-only options to /consumer");

        KafkaDataProvider producer_root({
            "server": "localhost:9092",
        });
        *DataProvider::AbstractDataProvider producer = producer_root.getChildProviderEx("producer");
        assertTrue(exists producer, "root factory can create /producer without consumer-only topics");
    }

    actionRegistrationTest() {
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(KafkaDataProvider::AppName);
        assertTrue(exists actions, "should have actions registered for Kafka app");
        assertEq(2, actions.size(), "should have 2 actions");

        hash<string, hash<DataProviderActionInfo>> action_map;
        foreach hash<DataProviderActionInfo> action in (actions) {
            action_map{action.action} = action;
        }

        assertTrue(action_map.hasKey("msg-received"), "should have 'msg-received' action");
        assertTrue(action_map."msg-received".options.hasKey("asyncapi"),
            "consumer action should expose 'asyncapi' option");
        assertTrue(action_map."msg-received".options.hasKey("asyncapi_channel"),
            "consumer action should expose 'asyncapi_channel' option");
        assertTrue(action_map."msg-received".options.hasKey("validator"),
            "consumer action should expose 'validator' option");

        assertTrue(action_map.hasKey("send-msg"), "should have 'send-msg' action");
        assertTrue(action_map."send-msg".options.hasKey("asyncapi"),
            "producer action should expose 'asyncapi' option");
        assertTrue(action_map."send-msg".options.hasKey("asyncapi_channel"),
            "producer action should expose 'asyncapi_channel' option");
        assertTrue(action_map."send-msg".options.hasKey("validator"),
            "producer action should expose 'validator' option");
    }

    private checkAsyncApiProviderOptions(hash<auto> opts, string provider) {
        assertTrue(opts.hasKey("asyncapi"), sprintf("%s provider should have 'asyncapi' option", provider));
        assertTrue(opts.hasKey("asyncapi_channel"),
            sprintf("%s provider should have 'asyncapi_channel' option", provider));
        assertTrue(opts.hasKey("validator"), sprintf("%s provider should have 'validator' option", provider));
        assertDataProviderOptionType(opts.asyncapi, "string");
        assertDataProviderOptionType(opts.asyncapi_channel, "string");
        assertDataProviderFileLocationOption(opts.validator, "validator");
    }

    private assertDataProviderOptionType(hash<DataProviderOptionInfo> opt, string name) {
        assertEq(1, opt.type.size(), sprintf("option should have one data provider type for %y", name));
        assertEq(name, opt.type[0].getName());
    }

    private assertDataProviderFileLocationOption(hash<DataProviderOptionInfo> opt, string name) {
        assertDataProviderOptionType(opt, "string");
        assertTrue(opt.type[0].getTag(DTT_FromFile) ?? False,
            sprintf("%s option should allow file data", name));
        assertTrue(opt.type[0].getTag(DTT_FromLocation) ?? False,
            sprintf("%s option should allow locations", name));
    }

    kafkaIntegrationTest() {
        if (setup_error) {
            throw setup_error.err, sprintf("the configured Kafka connection could not be set up: %s",
                setup_error.desc), setup_error.arg;
        }
        if (!kafka_conn) {
            testSkip("no Kafka connection configured (set KAFKA_CONNECTION or use -c)");
        }

        string topic = "qore-test-" + get_random_string(12);

        # produce before the consumer subscribes; the consumer reads from the earliest offset of a new consumer
        # group, so it receives the messages however long its group join takes
        KafkaProducerDataProvider producer(kafka_conn);
        hash<auto> md1 = producer.doRequest({
            "topic": topic,
            "key": "key-1",
            "value": "value-1",
        });
        assertEq(topic, md1.topic, "the first message is sent to the requested topic");
        assertEq(0, md1.partition, "the first message is sent to the only partition");
        assertEq(0, md1.offset, "the first message has the first offset of a new topic");
        assertEq(5, md1.serialized_key_size, "the serialized key size is reported");
        assertEq(7, md1.serialized_value_size, "the serialized value size is reported");
        assertEq(Type::Date, md1.timestamp.type(), "the send timestamp is reported");

        hash<auto> md2 = producer.doRequest({
            "topic": topic,
            "partition": 0,
            "key": "key-2",
            "value": "value-2",
        });
        assertEq(0, md2.partition, "an explicit partition is used");
        assertEq(1, md2.offset, "the second message follows the first");

        KafkaConsumerDataProvider consumer(kafka_conn, {
            "topics": (topic,),
            "group.id": "qore-test-" + get_random_string(12),
            "auto.offset.reset": "earliest",
        });
        on_exit consumer.stopEvents();

        Queue msg_queue();
        KafkaTestObserver obs(msg_queue);
        consumer.registerObserver(obs);
        consumer.observersReady();

        auto received = msg_queue.get(ConsumeTimeout);
        assertTrue(exists received, "the consumer receives the first message");
        assertEq(topic, received.topic, "the first message arrives on the topic");
        assertEq("key-1", received.key, "the first message key arrives");
        assertEq("value-1", received.value, "the first message value arrives");
        assertEq(0, received.partition, "the first message arrives from the only partition");
        assertEq(0, received.offset, "the first message arrives with its offset");
        assertEq("CreateTime", received.timestamp_type, "the producer's timestamp is used");

        received = msg_queue.get(ConsumeTimeout);
        assertTrue(exists received, "the consumer receives the second message");
        assertEq("key-2", received.key, "the second message key arrives");
        assertEq("value-2", received.value, "the second message value arrives");
        assertEq(1, received.offset, "the second message arrives in order");

        # stopping the consumer ends its polling thread
        consumer.stopEvents();
        assertEq(0, msg_queue.size(), "no other messages arrive");
    }

    eventDataTypeTest() {
        # a message to send may carry headers, and needs no key
        hash<auto> send_fields = KafkaEventDataType.getFields();
        assertTrue(send_fields.hasKey("headers"), "a message to send has headers");
        assertThrows("MISSING-VALUE-ERROR", \KafkaEventDataType.acceptsValue(), {"value": "v"});
        hash<auto> req = KafkaEventDataType.acceptsValue({
            "topic": "t",
            "value": "v",
            "headers": {"correlation_id": "c-1", "raw": <0001ff>},
        });
        assertEq({"correlation_id": "c-1", "raw": <0001ff>}, req.headers, "headers are accepted as given");
        assertFalse(req.hasKey("key"), "a message without a key is accepted without one");
        assertThrows("RUNTIME-TYPE-ERROR", \KafkaEventDataType.acceptsValue(),
            {"topic": "t", "value": "v", "headers": "not a hash"});

        # a received message has headers too
        assertTrue(KafkaEventRecvDataType.getFields().hasKey("headers"), "a received message has headers");
    }

    #! Record headers are sent with a message and delivered with it
    /** A string header value is sent as its UTF-8 bytes and delivered as a string; a value that is not valid UTF-8
        is delivered as the binary it was sent as; a message without a key is sent and delivered without one.
    */
    kafkaHeadersTest() {
        if (setup_error) {
            throw setup_error.err, sprintf("the configured Kafka connection could not be set up: %s",
                setup_error.desc), setup_error.arg;
        }
        if (!kafka_conn) {
            testSkip("no Kafka connection configured (set KAFKA_CONNECTION or use -c)");
        }

        string topic = "qore-test-headers-" + get_random_string(12);
        KafkaProducerDataProvider producer(kafka_conn);
        producer.doRequest({
            "topic": topic,
            "key": "key-1",
            "value": "value-1",
            "headers": {
                "correlation_id": "corr-1",
                "operation": "placeOrder",
                "content-type": "application/json",
                # "č" is two bytes of UTF-8
                "text": "přílišč",
                # not valid UTF-8
                "raw": <00ff80fe>,
            },
        });
        # no key and no headers
        producer.doRequest({
            "topic": topic,
            "value": "value-2",
        });

        KafkaConsumerDataProvider consumer(kafka_conn, {
            "topics": (topic,),
            "group.id": "qore-test-" + get_random_string(12),
            "auto.offset.reset": "earliest",
        });
        on_exit consumer.stopEvents();

        Queue msg_queue();
        KafkaTestObserver obs(msg_queue);
        consumer.registerObserver(obs);
        consumer.observersReady();

        hash<auto> received = msg_queue.get(ConsumeTimeout);
        assertEq("value-1", received.value);
        assertEq("key-1", received.key);
        assertEq({
            "correlation_id": "corr-1",
            "operation": "placeOrder",
            "content-type": "application/json",
            "text": "přílišč",
            "raw": <00ff80fe>,
        }, received.headers, "headers arrive: UTF-8 text as strings, other bytes as binary");
        assertEq(Type::String, received.headers.text.type(), "a UTF-8 header value is a string");
        assertEq(Type::Binary, received.headers.raw.type(), "a header value that is not UTF-8 is a binary");

        received = msg_queue.get(ConsumeTimeout);
        assertEq("value-2", received.value);
        assertNothing(received.key, "a message sent without a key has none");
        assertEq({}, received.headers, "a message sent without headers has none");
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set the Kafka connection URL (ex: kafka://localhost:9092)",
            OptionColumn);
    }

    private assertNoAsyncApiConfig(KafkaDataProvider prov) {
        *AsyncApi::AsyncApi3Schema validator = prov.getAsyncApiValidator();
        *string channel = prov.getAsyncApiChannel();
        assertFalse(exists validator, "failed config should not retain validator");
        assertFalse(exists channel, "failed config should not retain channel");
    }

    private KafkaConnection createConnection() {
        return new KafkaConnection("test-kafka", "Kafka test connection", "kafka://localhost:9092");
    }

    private static AsyncApi::AsyncApi3Schema createAsyncApiSchema() {
        return new AsyncApi::AsyncApi3Schema("", {
            "asyncapi": "3.0.0",
            "info": {
                "title": "Kafka Data Provider Test API",
                "version": "1.0.0",
            },
            "channels": {
                AsyncApiChannel: {
                    "address": "qore.test",
                    "messages": {
                        "message": {
                            "$ref": "#/components/messages/TestMessage",
                        },
                    },
                },
            },
            "operations": {
                "sendMessage": {
                    "action": "send",
                    "channel": {
                        "$ref": "#/channels/messages",
                    },
                    "messages": (
                        {
                            "$ref": "#/channels/messages/messages/message",
                        },
                    ),
                },
                "receiveMessage": {
                    "action": "receive",
                    "channel": {
                        "$ref": "#/channels/messages",
                    },
                    "messages": (
                        {
                            "$ref": "#/channels/messages/messages/message",
                        },
                    ),
                },
            },
            "components": {
                "messages": {
                    "TestMessage": {
                        "payload": {
                            "$ref": "#/components/schemas/TestPayload",
                        },
                    },
                },
                "schemas": {
                    "TestPayload": {
                        "type": "object",
                        "required": ("message",),
                        "additionalProperties": False,
                        "properties": {
                            "message": {
                                "type": "string",
                            },
                        },
                    },
                },
            },
        });
    }

    private static string createAsyncApiSchemaSource() {
        return sprintf("asyncapi: 3.0.0
info:
  title: Kafka Data Provider Test API
  version: 1.0.0
channels:
  %s:
    address: qore.test
    messages:
      message:
        $ref: '#/components/messages/TestMessage'
operations:
  sendMessage:
    action: send
    channel:
      $ref: '#/channels/%s'
    messages:
      - $ref: '#/channels/%s/messages/message'
  receiveMessage:
    action: receive
    channel:
      $ref: '#/channels/%s'
    messages:
      - $ref: '#/channels/%s/messages/message'
components:
  messages:
    TestMessage:
      payload:
        $ref: '#/components/schemas/TestPayload'
  schemas:
    TestPayload:
      type: object
      required:
        - message
      additionalProperties: false
      properties:
        message:
          type: string
", AsyncApiChannel, AsyncApiChannel, AsyncApiChannel, AsyncApiChannel, AsyncApiChannel);
    }
}

class KafkaTestObserver inherits Observer {
    private {
        Queue queue;
    }

    constructor(Queue queue) {
        self.queue = queue;
    }

    update(string event_id, hash<auto> data) {
        if (event_id == KafkaConsumerDataProvider::EVENT_KAFKA_MESSAGE) {
            queue.push(data);
        }
    }
}
