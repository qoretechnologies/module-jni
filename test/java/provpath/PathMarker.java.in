package org.qore.jni.test.provpath;

//! a class of a jar that test/jni-provider-path-restricted.qtest gives provider classpath options
/** Each jar of the test has a class of its own (generated from test/java/provpath/PathMarker.java.in), and is on no
    classpath, so the class can only be loaded through an option that adds that jar; its static initializer records
    each class loader that ran it in a system property of its own, so that a test case sees whether the option that
    it gave made Java load and run the jar's code, whatever the other test cases did.
*/
public class @PROVPATH_CLASS@ {
    //! the system property that counts the class loaders that ran the static initializer
    public static final String PROPERTY = "org.qore.jni.test.provpath.@PROVPATH_CLASS@.loaded";

    static {
        // the system properties are shared by the class loaders, each of which has its own copy of the class
        synchronized (System.getProperties()) {
            int count = Integer.getInteger(PROPERTY, 0);
            System.setProperty(PROPERTY, Integer.toString(count + 1));
        }
    }

    //! creates the object, as a JDBC driver class is instantiated
    public @PROVPATH_CLASS@() {
    }

    //! creates the object, as a JMS connection factory class is instantiated with its URL
    public @PROVPATH_CLASS@(String url) {
    }
}
