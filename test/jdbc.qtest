%modern

%prepend-module-path "${SCRIPT_DIR}/../build"
%requires jni
%requires QUnit
%requires FsUtil

%module-cmd(jni) import java.sql.Types

%exec-class Main

public class Main inherits QUnit::Test {
    private {
        const MyOpts = Opts + {
            "connstr": "c,conn=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("jdbc test", "1.0", \ARGV, MyOpts) {
        addTestCase("pgsqlTest", \pgsqlTest());
        addTestCase("oracleTest", \oracleTest());
        addTestCase("firebirdTest", \firebirdTest());
        addTestCase("pgsqlMultipleResultsTest", \pgsqlMultipleResultsTest());
        addTestCase("mssqlMultipleResultsTest", \mssqlMultipleResultsTest());
        addTestCase("mssqlLostConnectionTest", \mssqlLostConnectionTest());
        addTestCase("mssqlClassLoadReportTest", \mssqlClassLoadReportTest());
        addTestCase("mssqlDescribeTest", \mssqlDescribeTest());
        addTestCase("integers keep their value and sign on every server", \integerBindTest());
        addTestCase("execRaw() executes the SQL as given, and its effects last for the session", \execRawTest());
        addTestCase("Oracle date and time values and row ids are Qore values", \oracleDateTimeTest());

        # execute tests and set program return value
        set_return_value(main());
    }

    private auto getColumn(auto result, string name) {
        string cname = result.columnNames().contains(name) ? name : name.upr();
        return result.getColumn(cname);
    }

    private list asList(auto value) {
        return value.type() == Type::List ? value : value.toList();
    }

    private bool isMissingColumnarApi(hash<ExceptionInfo> ex) {
        return ex.err == "METHOD-DOES-NOT-EXIST" || ex.err == "UNKNOWN-METHOD";
    }

    private oracleTest() {
        *AbstractDatasource ds = getConnection("QORE_DB_CONNSTR_JDBC_ORACLE");
        if (!ds) {
            testSkip("no jdbc connection available");
        }

        auto v = ds.getServerVersion();
        assertTrue(exists v);
        v = ds.getClientVersion();
        assertTrue(exists v);
        assertEq("Oracle", ds.getDriverRealName());

        # create table
        ds.exec("create table jdbc_test (input_1 number(1), input_2 varchar2(20))");
        on_error ds.rollback();
        on_success ds.commit();
        on_exit ds.exec("drop table jdbc_test");

        doTestIntern(ds);
    }

    private pgsqlTest() {
        *AbstractDatasource ds = getConnection("QORE_DB_CONNSTR_JDBC_PGSQL");
        if (!ds) {
            testSkip("no jdbc connection available");
        }

        auto v = ds.getServerVersion();
        assertTrue(exists v);
        v = ds.getClientVersion();
        assertTrue(exists v);
        assertEq("PostgreSQL", ds.getDriverRealName());

        # create table
        ds.exec("create table jdbc_test (input_1 numeric(1), input_2 varchar(20))");
        on_error ds.rollback();
        on_success ds.commit();
        on_exit ds.exec("drop table jdbc_test");

        doTestIntern(ds);
    }

    private firebirdTest() {
        *AbstractDatasource ds = getConnection("QORE_DB_CONNSTR_JDBC_FIREBIRD");
        if (!ds) {
            testSkip("no jdbc connection available");
        }

        auto v = ds.getServerVersion();
        assertTrue(exists v);
        v = ds.getClientVersion();
        assertTrue(exists v);
        assertRegex("^Firebird", ds.getDriverRealName());

        # create table
        ds.exec("create table jdbc_test (input_1 numeric(1), input_2 varchar(20))");
        ds.commit();
        on_error ds.rollback();
        on_success ds.commit();
        on_exit ds.exec("drop table jdbc_test");

        doTestIntern(ds);
    }

    private bool hasColumnar(AbstractDatasource ds) {
        return (ds.getCapabilities() & DBI_CAP_HAS_COLUMNAR_SELECT) != 0;
    }

    #! pgjdbc returns a result for every statement; it raises the errors of later statements when executing
    private pgsqlMultipleResultsTest() {
        *AbstractDatasource ds = getConnection("QORE_DB_CONNSTR_JDBC_PGSQL");
        if (!ds) {
            testSkip("no jdbc connection available");
        }
        ds.execRaw("create temporary table jdbc_multi_test (id integer)");
        ds.commit();
        on_exit ds.rollback();

        assertEq({"query0": {"a": (1,)}, "query1": {"b": (2,)}}, ds.select("select 1 as a; select 2 as b"));
        assertEq({"query0": 1, "query1": 2}, ds.exec("insert into jdbc_multi_test values (1); "
            "insert into jdbc_multi_test values (2), (3)"));
        assertEq({"query0": 1, "query1": {"count": (4,)}}, ds.exec("insert into jdbc_multi_test values (4); "
            "select count(*) as count from jdbc_multi_test"));
        # statements without a count (pgjdbc reports 0) and updates of no rows are left out
        assertEq({"a": (1,)}, ds.select("set local search_path = public; select 1 as a"));
        assertEq(3, ds.exec("update jdbc_multi_test set id = id where id < 0; "
            "update jdbc_multi_test set id = id where id < 4"));
        assertNothing(ds.execRaw("update jdbc_multi_test set id = id where id < 0; "
            "update jdbc_multi_test set id = id where id < 0"));
        # a single statement is unchanged
        assertEq(0, ds.exec("update jdbc_multi_test set id = id where id < 0"));
        # execRaw() (a plain java.sql.Statement) returns the same results as exec() (a prepared statement)
        compareExecRaw(ds, ("select 1 as a; select 2 as b",
            "update jdbc_multi_test set id = id where id < 0; update jdbc_multi_test set id = id where id < 4",
            "update jdbc_multi_test set id = id where id < 0; update jdbc_multi_test set id = id where id < 0",
            "set local search_path = public; select 1 as a",
            "update jdbc_multi_test set id = id where id < 3; select count(*) as count from jdbc_multi_test",
            "update jdbc_multi_test set id = id where id < 0"));

        # selectRows(), selectRow() and selectColumnar() skip update counts and require one result set
        assertEq(({"id": 1}, {"id": 2}), ds.selectRows("update jdbc_multi_test set id = id; "
            "select id from jdbc_multi_test where id < 3 order by id"));
        assertEq({"count": 4}, ds.selectRow("update jdbc_multi_test set id = id; "
            "select count(*) as count from jdbc_multi_test"));
        assertThrows("JDBC-SELECT-ROWS-ERROR", "returned more than one result set; use select\\(\\) or exec\\(\\)",
            sub () { ds.selectRows("select 1 as a; select 2 as b"); });
        assertThrows("JDBC-SELECT-ROW-ERROR", "returned more than one result set", sub () {
            ds.selectRow("select 1 as a; select 2 as b");
        });
        if (hasColumnar(ds)) {
            assertEq((1, 2, 3, 4), map int($1), asList(getColumn(ds.selectColumnar("update jdbc_multi_test set "
                "id = id; select id from jdbc_multi_test order by id"), "id")));
            assertThrows("JDBC-SELECT-COLUMNAR-ERROR", "returned more than one result set", sub () {
                ds.selectColumnar("select 1 as a; select 2 as b");
            });
        }

        # SQLStatement: counts before the result set, then all counts once it has been read
        {
            SQLStatement stmt(ds);
            stmt.prepare("insert into jdbc_multi_test values (5); select id from jdbc_multi_test order by id; "
                "insert into jdbc_multi_test values (6), (7)");
            stmt.exec();
            assertEq(1, stmt.affectedRows());
            assertEq({"id": (1, 2, 3, 4, 5)}, stmt.getOutput());
            assertEq(3, stmt.affectedRows());
            stmt.prepare("select 1 as a; select 2 as b");
            stmt.exec();
            assertTrue(stmt.next());
            assertThrows("JDBC-RESULTSET-ERROR", "returned more than one result set", \stmt.next());
        }
        assertEq(7, ds.selectRow("select count(*) as count from jdbc_multi_test").count);

        # pgjdbc raises the error of a later statement when executing (last: it aborts the transaction)
        assertThrows("JNI-ERROR", "division by zero", sub () { ds.select("select 1 as a; select 1/0 as b"); });
    }

    #! mssql-jdbc reports the error of a later statement only when its result is reached, so it was lost before
    private mssqlMultipleResultsTest() {
        *AbstractDatasource ds = getConnection("QORE_DB_CONNSTR_JDBC_MSSQL");
        if (!ds) {
            testSkip("no jdbc connection available");
        }
        assertEq("Microsoft SQL Server", ds.getDriverRealName());
        ds.execRaw("if object_id('jdbc_multi_test') is not null drop table jdbc_multi_test; "
            "create table jdbc_multi_test (id int)");
        ds.execRaw("if object_id('jdbc_multi_proc') is not null drop procedure jdbc_multi_proc");
        ds.execRaw("create procedure jdbc_multi_proc as begin set nocount on; select 1 as a; select 2 as b; end");
        ds.execRaw("if object_id('jdbc_multi_error_proc') is not null drop procedure jdbc_multi_error_proc");
        ds.execRaw("create procedure jdbc_multi_error_proc as begin set nocount on; select 1 as a; "
            "raiserror('jdbc later failure', 16, 1); end");
        ds.commit();
        on_exit {
            ds.rollback();
            ds.execRaw("drop table jdbc_multi_test; drop procedure jdbc_multi_proc; "
                "drop procedure jdbc_multi_error_proc");
            ds.commit();
        }

        assertEq({"query0": {"a": (1,)}, "query1": {"b": (2,)}}, ds.select("select 1 as a; select 2 as b"));
        assertEq({"query0": 1, "query1": {"c": (1,)}}, ds.exec("insert into jdbc_multi_test values (1); "
            "select count(*) as c from jdbc_multi_test"));
        assertEq(1, ds.exec("update jdbc_multi_test set id = id where id < 0; "
            "update jdbc_multi_test set id = id where id < 2"));
        # a procedure returning two result sets
        assertEq({"query0": {"a": (1,)}, "query1": {"b": (2,)}}, ds.select("exec jdbc_multi_proc"));
        # execRaw() (a plain java.sql.Statement) returns the same results as exec() (a prepared statement)
        compareExecRaw(ds, ("select 1 as a; select 2 as b",
            "update jdbc_multi_test set id = id where id < 0; update jdbc_multi_test set id = id where id < 2",
            "exec jdbc_multi_proc",
            "update jdbc_multi_test set id = id; select count(*) as c from jdbc_multi_test",
            "update jdbc_multi_test set id = id where id < 0"));
        # set nocount on: no result at all
        assertEq(-1, ds.exec("set nocount on; update jdbc_multi_test set id = id"));

        # selectRows(), selectRow() and selectColumnar() skip update counts and require one result set
        assertEq(({"id": 1},), ds.selectRows("update jdbc_multi_test set id = id; select id from jdbc_multi_test"));
        assertEq({"id": 1}, ds.selectRow("update jdbc_multi_test set id = id; select id from jdbc_multi_test"));
        assertThrows("JDBC-SELECT-ROWS-ERROR", "returned more than one result set", sub () {
            ds.selectRows("exec jdbc_multi_proc");
        });
        assertThrows("JDBC-SELECT-ROW-ERROR", "returned more than one result set", sub () {
            ds.selectRow("select 1 as a; select 2 as b");
        });
        if (hasColumnar(ds)) {
            assertThrows("JDBC-SELECT-COLUMNAR-ERROR", "returned more than one result set", sub () {
                ds.selectColumnar("exec jdbc_multi_proc");
            });
        }

        # SQLStatement
        {
            SQLStatement stmt(ds);
            stmt.prepare("insert into jdbc_multi_test values (2); select id from jdbc_multi_test order by id");
            stmt.exec();
            assertEq(1, stmt.affectedRows());
            assertEq({"id": (1, 2)}, stmt.getOutput());
            stmt.prepare("exec jdbc_multi_proc");
            stmt.exec();
            assertTrue(stmt.next());
            assertThrows("JDBC-RESULTSET-ERROR", "returned more than one result set", \stmt.next());
        }
        ds.commit();

        # errors of later statements are raised; they were lost before
        assertThrows("JNI-ERROR", "Divide by zero", sub () { ds.select("select 1 as a; select 1/0 as b"); });
        ds.rollback();
        assertThrows("JNI-ERROR", "jdbc later failure", sub () { ds.select("exec jdbc_multi_error_proc"); });
        ds.rollback();
        assertThrows("JNI-ERROR", "jdbc later failure", sub () { ds.selectRow("exec jdbc_multi_error_proc"); });
        ds.rollback();
        assertThrows("JNI-ERROR", "Divide by zero", sub () {
            ds.exec("update jdbc_multi_test set id = id where id < 0; insert into jdbc_multi_test values (1/0)");
        });
        ds.rollback();
        assertEq(2, ds.selectRow("select count(*) as c from jdbc_multi_test").c);
    }

    #! a statement interrupted by a lost connection is executed again only when it cannot have taken effect
    private mssqlLostConnectionTest() {
        *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_MSSQL");
        if (!ds) {
            testSkip("no jdbc connection available");
        }
        Datasource observer = getConnection("QORE_DB_CONNSTR_JDBC_MSSQL");
        # KILL cannot be executed in a transaction
        observer.setAutoCommit(True);
        string table = "jdbc_lost_connection_test";
        observer.execRaw(sprintf("if object_id('%s') is not null drop table %s; create table %s (id int)", table,
            table, table));
        # executed in reverse order: the rollback releases the locks the drop waits for
        on_exit observer.execRaw(sprintf("drop table %s", table));
        on_exit ds.rollback();
        code kill_session = sub () {
            observer.execRaw(sprintf("kill %d", ds.selectRow("select @@spid as spid").spid));
        };

        code count = int sub () {
            return observer.selectRow(sprintf("select count(*) as c from %s", table)).c;
        };

        # a datasource in auto-commit mode: the server may have committed the statement before the connection was
        # lost, so it never runs twice; the error is raised and the datasource is reconnected
        ds.setAutoCommit(True);
        kill_session();
        assertThrows("JNI-ERROR", sub () { ds.exec(sprintf("insert into %s values (1)", table)); });
        assertEq(0, count());
        assertEq(1, ds.exec(sprintf("insert into %s values (1)", table)));
        assertEq(1, count());
        ds.setAutoCommit(False);

        # a read outside a transaction also runs in auto-commit mode and is not executed again
        kill_session();
        assertThrows("JNI-ERROR", sub () { ds.select("select 1 as a"); });
        assertEq({"a": (1,)}, ds.select("select 1 as a"));

        # the first statement of a transaction: the SQL Server driver finds the lost connection when the transaction
        # is started (setAutoCommit(false) sends "set implicit_transactions on" to the server), before the statement
        # is sent, so the transaction is started on a new connection and the statement runs there, once
        kill_session();
        assertEq(1, ds.exec(sprintf("insert into %s values (2)", table)));
        ds.commit();
        assertEq(2, count());
        assertEq(1, observer.selectRow(sprintf("select count(*) as c from %s where id = 2", table)).c);

        # an explicit transaction is started on a new connection the same way
        kill_session();
        ds.beginTransaction();
        assertEq(1, ds.exec(sprintf("insert into %s values (3)", table)));
        ds.commit();
        assertEq(3, count());

        # a prepared statement starting a transaction: its handles belong to the lost connection, so it is prepared
        # again on the new connection, with its arguments
        SQLStatement stmt(ds);
        on_exit stmt.close();
        stmt.prepare("insert into " + table + " values (%v)");
        stmt.bind(4);
        kill_session();
        stmt.exec();
        assertEq(1, stmt.affectedRows());
        stmt.commit();
        assertEq(4, count());
        assertEq(1, observer.selectRow(sprintf("select count(*) as c from %s where id = 4", table)).c);

        # in an active transaction the work is lost: reported, never replayed
        ds.exec(sprintf("insert into %s values (5)", table));
        kill_session();
        assertThrows("JDBC-TRANSACTION-ERROR", sub () { ds.exec(sprintf("insert into %s values (6)", table)); });
        ds.rollback();
        assertEq(4, count());
    }

    private doTestIntern(auto ds) {
        # insert a row with all null values
        int rows_affected = ds.exec("insert into jdbc_test (input_1, input_2) values (%v, %v)");
        assertEq(1, rows_affected);

        hash<auto> q = ds.selectRow("select * from jdbc_test");
        assertEq({"input_1": NULL, "input_2": NULL}, q);

        rows_affected = ds.exec("delete from jdbc_test");
        assertEq(1, rows_affected);

        rows_affected = ds.exec("insert into jdbc_test (input_1, input_2) values (%v, %v)", 1, "test");
        q = ds.selectRow("select * from jdbc_test");
        assertEq({"input_1": 1, "input_2": "test"}, q);

        q = ds.select("select * from jdbc_test");
        assertEq({"input_1": (1,), "input_2": ("test",)}, q);

        list<auto> rows = ds.selectRows("select * from jdbc_test");
        assertEq(({"input_1": 1, "input_2": "test"},), rows);

        rows_affected = ds.exec("insert into jdbc_test (input_1, input_2) values (%v, %v)", 2, "next");
        assertEq(1, rows_affected);
        rows_affected = ds.exec("insert into jdbc_test (input_1, input_2) values (%v, %v)", 3, "last");
        assertEq(1, rows_affected);

        try {
            auto columnar = ds.selectColumnar("select input_1, input_2 from jdbc_test order by input_1");
            assertEq(3, columnar.numRows());
            assertEq(2, columnar.numCols());
            assertEq((1, 2, 3), map int($1), asList(getColumn(columnar, "input_1")));
            assertEq(("test", "next", "last"), asList(getColumn(columnar, "input_2")));

            SQLStatement stmt(ds);
            stmt.prepare("select input_1, input_2 from jdbc_test order by input_1");
            stmt.exec();
            on_exit stmt.commit();

            auto columnar_stmt = stmt;
            auto first = columnar_stmt.fetchColumnar(2);
            auto rest = columnar_stmt.fetchColumnar(-1);
            assertEq(2, first.numRows());
            assertEq(1, rest.numRows());
            assertEq((1, 2), map int($1), asList(getColumn(first, "input_1")));
            assertEq((3,), map int($1), asList(getColumn(rest, "input_1")));
            assertEq(("test", "next"), asList(getColumn(first, "input_2")));
            assertEq(("last",), asList(getColumn(rest, "input_2")));
        } catch (hash<ExceptionInfo> ex) {
            if (!isMissingColumnarApi(ex)) {
                rethrow;
            }
        }

        rows_affected = ds.exec("delete from jdbc_test");
        assertEq(3, rows_affected);
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"jdbc:user/pass@driver?...\")", OptionColumn);
    }

    #! SQLStatement::describe() describes the result columns with the type of the values returned
    private mssqlDescribeTest() {
        *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_MSSQL");
        if (!ds) {
            testSkip("no jdbc connection available");
        }
        ds.execRaw("if object_id('jdbc_describe_test') is not null drop table jdbc_describe_test; "
            "create table jdbc_describe_test (id int not null, name varchar(20), price decimal(10,2), flag bit, "
            "ratio float, data varbinary(16), created datetime2, uid uniqueidentifier, ts datetimeoffset)");
        ds.exec("insert into jdbc_describe_test values (1, 'name', 1.50, 1, 0.5, %v, %v, newid(), "
            "sysdatetimeoffset())", <0102>, 2026-10-21T10:15:30);
        ds.commit();
        on_exit {
            ds.rollback();
            ds.execRaw("drop table jdbc_describe_test");
            ds.commit();
        }

        SQLStatement stmt(ds);
        on_exit stmt.close();
        stmt.prepare("select * from jdbc_describe_test");
        stmt.exec();
        hash<auto> desc = stmt.describe();
        assertEq(("id", "name", "price", "flag", "ratio", "data", "created", "uid", "ts"), keys desc);
        assertEq({"name": "id", "type": NT_INT, "maxsize": 10, "native_type": "int", "internal_id": Types::INTEGER,
            "nullable": False}, desc.id);
        assertEq(20, desc.name.maxsize);
        assertEq(("decimal", 10, 2, NT_NUMBER), (desc.price.native_type, desc.price.precision, desc.price.scale,
            desc.price.type));
        assertEq(16, desc.data.maxsize);
        # datetimeoffset values (microsoft.sql.DateTimeOffset) are dates
        assertEq(NT_DATE, desc.ts.type);

        # the described type of each column is the type of its value
        assertTrue(stmt.next());
        hash<auto> row = stmt.fetchRow();
        foreach string col in (keys row) {
            assertEq(row{col}.typeCode(), desc{col}.type, col);
        }
        assertFalse(stmt.next());
        assertEq(desc, stmt.describe());

        stmt.prepare("update jdbc_describe_test set flag = 0");
        stmt.exec();
        assertEq({}, stmt.describe());
    }

    #! the SQL Server driver's classes are imported without reporting a class that cannot be loaded
    /** The driver's antlr dependency (for its \c useFmtOnly option) is optional and usually absent; a class that needs
        it is reachable from \c SQLServerException only through private members, whose classes are not imported.  The
        jni module reports a class that cannot be loaded once per process, on stderr, so the import and an SQL error,
        whose exception argument is a \c SQLServerException, are checked in a process of their own.
    */
    private mssqlClassLoadReportTest() {
        *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_MSSQL");
        if (!ds) {
            testSkip("no jdbc connection available");
        }
        if (!Qore::Option::HAVE_SYSTEM) {
            testSkip("system() is not available on this platform");
        }
        TmpFile tmp(NOTHING, ".qr");
        tmp.file.write(sprintf("%%modern\n%%prepend-module-path \"%s\"\n%%requires jni\n",
            dirname(get_module_hash().jni.filename)) + "
Datasource ds(ENV.QORE_DB_CONNSTR_JDBC_MSSQL);
try {
    ds.select(\"select * from jdbc_class_load_report_no_such_table\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"error: %s\\n\", ex.arg.fullType());
}
Program p(PO_NEW_STYLE);
p.loadModule(\"jni\");
p.issueModuleCmd(\"jni\", \"add-classpath \" + parse_datasource(ENV.QORE_DB_CONNSTR_JDBC_MSSQL).options.classpath);
p.issueModuleCmd(\"jni\", \"import com.microsoft.sqlserver.jdbc.SQLServerException\");
printf(\"imported\\n\");
");
        tmp.file.close();
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? ENV.QORE_EXECUTABLE ?? QORE_ARGV[0] ?? ARGV[0];
        # the JVM launcher must not write its "Picked up ..." banner into the output
        string output = trim(backquote(sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "'%s' '%s' 2>&1; echo exit=$?", qore_bin, tmp.path)));
        assertEq("error: object<SQLServerException>\nimported\nexit=0", output);
    }

    #! An integer is bound with its value: a small one was bound as a TINYINT (setByte()), which SQL Server stores
    #! unsigned, so -1 was stored as 255
    private integerBindTest() {
        list<int> values = (100, -1, -4, -128, 127, 128, 200, -32769, 40000, -2147483649, 9223372036854775807);
        int found = 0;
        foreach string var in (("QORE_DB_CONNSTR_JDBC_MSSQL", "QORE_DB_CONNSTR_JDBC_PGSQL",
                "QORE_DB_CONNSTR_JDBC_ORACLE")) {
            *Datasource ds = getConnection(var);
            if (!ds) {
                continue;
            }
            ++found;
            string table = sprintf("jdbc_int_bind_%d_%d", getpid(), now_us().getEpochSeconds() % 100000);
            string type = var == "QORE_DB_CONNSTR_JDBC_ORACLE" ? "number(20)" : "numeric(20)";
            ds.exec(sprintf("create table %s (id integer not null, n %s)", table, type));
            ds.commit();
            on_exit {
                ds.rollback();
                ds.exec("drop table " + table);
                ds.commit();
            }
            # a prepared statement executed once per value: SQL Server takes the type of each parameter from its first
            # execution, here a small positive value, which was bound as an unsigned TINYINT
            SQLStatement stmt(ds);
            stmt.prepare(sprintf("insert into %s (id, n) values (%%v, %%v)", table));
            foreach int v in (values) {
                stmt.execArgs(($#, v));
            }
            stmt.close();
            ds.commit();
            list<auto> stored = ds.select(sprintf("select n from %s order by id", table)).n;
            assertEq(values, (map $1.toInt(), stored), var);
            # and an update of all rows with array binds
            list<int> negated = map -$1, values;
            ds.exec(sprintf("update %s set n = %%v where id = %%v", table), negated, range(values.size()));
            ds.commit();
            stored = ds.select(sprintf("select n from %s order by id", table)).n;
            assertEq(negated, (map $1.toInt(), stored), var + ": array binds");
        }
        if (!found) {
            testSkip("no jdbc connection available");
        }
    }

    #! execRaw() runs the SQL with a plain java.sql.Statement: SQL Server ran it as a prepared statement in a scope of
    #! its own (sp_prepexec), which dropped a #temp table and reset SET options when it ended, and the SQL was parsed
    #! for placeholders, so that a "%" outside a string raised JDBC-PARSE-ERROR
    private execRawTest() {
        int found = 0;
        {
            *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_MSSQL");
            if (ds) {
                ++found;
                on_exit ds.rollback();
                ds.execRaw("create table #jdbc_raw_test (id int)");
                # the #temp table is used by prepared statements and is dropped when the session ends
                assertEq(1, ds.exec("insert into #jdbc_raw_test values (%v)", 7));
                assertEq({"id": 7}, ds.selectRow("select id from #jdbc_raw_test where id = %v", 7));
                {
                    SQLStatement stmt(ds);
                    stmt.prepare("select count(*) as c from #jdbc_raw_test");
                    stmt.exec();
                    assertEq({"c": (1,)}, stmt.getOutput());
                }
                ds.execRaw("drop table #jdbc_raw_test");
                # a SET option lasts for the session
                ds.execRaw("set lock_timeout 4321");
                assertEq(4321, ds.selectRow("select @@lock_timeout as t").t);
                ds.execRaw("set lock_timeout -1");
                # the SQL is not parsed for placeholders
                assertEq({"r": (3,)}, ds.execRaw("select 7 % 4 as r"));
            }
        }
        {
            *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_PGSQL");
            if (ds) {
                ++found;
                on_exit ds.rollback();
                assertEq({"r": (3,)}, ds.execRaw("select 7 % 4 as r"));
            }
        }
        {
            *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_ORACLE");
            if (ds) {
                ++found;
                on_exit ds.rollback();
                compareExecRaw(ds, ("select 1 as a from dual", "begin null; end;"));
            }
        }
        if (!found) {
            testSkip("no jdbc connection available");
        }
    }

    #! Oracle's driver returns its own classes for TIMESTAMP (oracle.sql.TIMESTAMP), TIMESTAMP WITH TIME ZONE
    #! (TIMESTAMPTZ), TIMESTAMP WITH LOCAL TIME ZONE (TIMESTAMPLTZ) and ROWID (ROWID) from getObject(), which were
    #! returned as Java objects and described as objects; they are read as dates and strings
    private oracleDateTimeTest() {
        *Datasource ds = getConnection("QORE_DB_CONNSTR_JDBC_ORACLE");
        if (!ds) {
            testSkip("no jdbc connection available");
        }
        string table = sprintf("jdbc_dt_%d_%d", getpid(), now_us().getEpochSeconds());
        ds.execRaw(sprintf("create table %s (id number(2), ts timestamp(6), tstz timestamp(6) with time zone, "
            "tsltz timestamp(6) with local time zone, d date)", table));
        on_exit {
            ds.rollback();
            ds.execRaw("drop table " + table);
            ds.commit();
        }
        ds.execRaw(sprintf("insert into %s values (1, timestamp '2026-03-04 05:06:07.123456', "
            "timestamp '2026-03-04 05:06:07.123456 +02:00', timestamp '2026-03-04 05:06:07.123456 +02:00', "
            "to_date('2026-03-04 05:06:07', 'YYYY-MM-DD HH24:MI:SS'))", table));
        ds.execRaw(sprintf("insert into %s (id) values (2)", table));
        ds.commit();

        # a time zone is kept as the same point in time
        date tz = 2026-03-04T05:06:07.123456+02:00;
        string sql = sprintf("select ts, tstz, tsltz, d, rowid as rid from %s order by id", table);

        hash<auto> h = ds.select(sql);
        # the first row of the columns
        checkDateTimeRow((map {$1.key: $1.value[0]}, h.pairIterator()), tz, "select");
        list<hash<auto>> rows = ds.selectRows(sql);
        assertEq(2, rows.size());
        checkDateTimeRow(rows[0], tz, "selectRows");
        # NULL values
        assertEq({"ts": NULL, "tstz": NULL, "tsltz": NULL, "d": NULL}, rows[1] - "rid", "selectRows NULL");
        assertEq(Type::String, rows[1].rid.type(), "selectRows NULL row id");
        checkDateTimeRow(ds.selectRow(sql + " fetch first 1 rows only"), tz, "selectRow");
        {
            SQLStatement stmt(ds);
            stmt.prepare(sql);
            stmt.exec();
            # the column types
            hash<auto> desc = stmt.describe();
            foreach string col in (("ts", "tstz", "tsltz", "d")) {
                assertEq(NT_DATE, desc{col}.type, "describe " + col);
            }
            assertEq(NT_STRING, desc.rid.type, "describe rid");
            assertTrue(stmt.next());
            checkDateTimeRow(stmt.fetchRow(), tz, "SQLStatement");
        }
        if (hasColumnar(ds)) {
            auto r = ds.selectColumnar(sql);
            # a timestamp column holds the microseconds since the epoch, a list column dates
            hash<auto> row = (map {$1: getColumn(r, $1)[0]}, ("ts", "tstz", "tsltz", "d", "rid"));
            map row{$1} = row{$1}.typeCode() == NT_INT ? toDate(row{$1}) : row{$1}, ("ts", "tstz", "tsltz", "d");
            checkDateTimeRow(row, tz, "selectColumnar");
            # NULL values
            assertEq(NULL, getColumn(r, "ts")[1] ?? NULL, "selectColumnar NULL");
        }
    }

    # returns the local date of a number of microseconds since the epoch
    private static date toDate(int us) {
        return localtime(us / 1000000) + microseconds(us % 1000000);
    }

    private checkDateTimeRow(hash<auto> row, date tz, string label) {
        # TIMESTAMP and DATE have no time zone: the values are local
        assertEq(Type::Date, row.ts.type(), label + " ts");
        assertEq("2026-03-04 05:06:07.123456", row.ts.format("YYYY-MM-DD HH:mm:SS.xx"), label + " ts");
        assertEq(Type::Date, row.d.type(), label + " d");
        assertEq("2026-03-04 05:06:07", row.d.format("YYYY-MM-DD HH:mm:SS"), label + " d");
        # TIMESTAMP WITH (LOCAL) TIME ZONE: the same point in time
        foreach string col in (("tstz", "tsltz")) {
            assertEq(Type::Date, row{col}.type(), label + " " + col);
            assertEq(tz.getEpochSeconds(), row{col}.getEpochSeconds(), label + " " + col);
            assertEq(123456, row{col}.microseconds(), label + " " + col);
        }
        # an Oracle row id: 18 characters of its base 64 encoding
        assertRegex("^[A-Za-z0-9+/]{18}$", row.rid ?? "", label + " rid");
    }

    #! asserts that execRaw() returns the same results as exec() for each SQL string, which must not change the data
    private compareExecRaw(AbstractDatasource ds, list<string> sqls) {
        foreach string sql in (sqls) {
            assertEq(ds.exec(sql), ds.execRaw(sql), sql);
        }
    }

    private *Datasource getConnection(string var) {
        if (!ENV{var}.val()) {
            return;
        }
        Datasource ds(ENV{var});
        if (ds.getDriverName() != "jdbc") {
            throw "JDBC-TEST-CONNECTION-ERROR", sprintf("%s must select the jdbc driver", var);
        }
        ds.open();
        return ds;
    }
}
