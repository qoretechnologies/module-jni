#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

# The release of a Program's jni data must never throw a C++ exception into libqore (qore#6773): when the release of
# the save-object callback raised a Qore exception, for example in the destructor of an object that only the callback
# held, JniExternalProgramData::doDeref() threw a pointer to a C++ exception out of the Program's teardown, which no
# handler caught, and the process was terminated.  The exception is now reported as unhandled on stderr, and the
# process continues; with a Qore library that has AbstractQoreProgramExternalDataEx (qore#6786), the module raises it
# to the code that deletes the Program instead (qore#6917).  A debug build of the module tells which behaviour it has
# (Jni::org::qore::jni::dbg_jni_program_data_sink()); with a release build, the behaviour is taken from the output of
# the first case, and all cases must show the same one (a release build checks only that the behaviour is
# consistent, not which one the module should have).  An exception raised when the callback is replaced is raised
# to the caller of set_save_object_callback(); it was reported as unhandled instead.
#
# Each case runs test/jni-doderef-no-throw-child.q in a new process, as the failure terminated the process.

%modern

%requires QUnit
%requires Util
%exec-class JniDoDerefNoThrowTest

class JniDoDerefNoThrowTest inherits QUnit::Test {
    private {
        #! True if the module raises the exceptions of the release to the code that deletes the Program (qore#6917),
        #! False if it reports them as unhandled; NOTHING if the module is not a debug build, which cannot tell, until
        #! the first case that checks the release sets it from its output
        *bool sink;

        #! the reason that sink is NOTHING
        *string sink_unknown;
    }

    constructor() : QUnit::Test("JNI Program data release does not throw", "1.0") {
        addTestCase("regression: the Program is deleted", \deleteCase());
        addTestCase("regression: the Program goes out of scope", \scopeCase());
        addTestCase("regression: nested destructor exceptions", \nestedCase());
        addTestCase("regression: many Programs, with the garbage collection hint", \manyCase());
        addTestCase("coverage: a pending cancellation stays pending", \cancelCase());
        addTestCase("regression: the callback is replaced", \replaceCase());
        addTestCase("regression: the callback is removed", \clearCase());
        addTestCase("regression: the object's class belongs to the released Program", \childClassCase());
        addTestCase("negative: a callback that raises nothing", \okCase());
        addTestCase("negative: the release of the class loader raises an error", \releaseFailCase());
        set_return_value(main());
    }

    globalSetUp() {
        string out = runChild("sink");
        string line = getLine(out, "sink: ");
        if (line == "sink: True") {
            sink = True;
        } else if (line == "sink: False") {
            sink = False;
        } else if (line.equalPartial("sink: unknown: ")) {
            sink_unknown = line.substr(15);
        } else {
            throw "TEST-ERROR", sprintf("unexpected output of the sink case: %s", out);
        }
    }

    deleteCase() {
        string out = runChild("delete");
        checkReleased(out, "delete", "User", ("DOREF-TEST-ERROR: destructor of delete",));
    }

    scopeCase() {
        string out = runChild("scope");
        checkReleased(out, "scope", "User", ("DOREF-TEST-ERROR: destructor of scope",));
    }

    nestedCase() {
        string out = runChild("nested");
        checkReleased(out, "nested", "User", ("DOREF-TEST-ERROR: destructor of outer",
            "DOREF-TEST-ERROR: destructor of inner"));
    }

    manyCase() {
        # the garbage collection hint runs in every 20th release of a Program's jni data in the process, so in one of
        # these releases
        string out = runChild("many");
        list<string> descs = ();
        for (int i = 1; i <= 25; ++i) {
            descs += sprintf("DOREF-TEST-ERROR: destructor of many-%d", i);
        }
        # reported as unhandled, each description is followed by the end of its line, as many-1 starts many-10
        checkReleased(out, "many", "User", descs, map $1 + "\n", descs);
    }

    cancelCase() {
        # the garbage collection hint runs in one of the 25 releases, in a thread with a pending cancellation, which
        # must not be raised there, where it would be reported as an unhandled exception; libqore itself defers a
        # pending cancellation in the destructor of a Program object, so this case passes without the module's own
        # deferral too: it checks that the releases in a cancelled thread report nothing and that the thread completes
        string out = runChild("cancel");
        assertEq("wait: THREAD-CANCELLED", getLine(out, "wait: "), out);
        # the thread completed the releases; a raised cancellation stays pending, so this does not show that none was
        # raised
        assertEq("pending after: True", getLine(out, "pending after: "), out);
        assertFalse(out =~ /unhandled QORE/, out);
        assertFalse(out =~ /^caught: /m, out);
        assertEq("after: cancel", getLine(out, "after: "), out);
    }

    #! the error of the release of the class loader of the Program, which the destructor of the jni data raises, is
    #! handled as the other exceptions of the release (qore#6917)
    releaseFailCase() {
        string out = runChild("release-fail");
        string unsupported = getLine(out, "release: unsupported: ");
        if (unsupported) {
            testSkip("the jni module is not a debug build: %s", unsupported.substr(22));
        }
        assertEq(1, countOf(out, "quiet destructor"), out);
        checkReleased(out, "release-fail", "System", ("JNI-ERROR: dbg_jni_fail_point(): an error is raised when the "
            "class loader of the Program is released",));
    }

    childClassCase() {
        # the code of the released Program cannot run when its jni data is released, so the destructor call fails;
        # that exception is reported in the same way
        string out = runChild("child-class");
        checkReleased(out, "child-class", "System", ("PROGRAM-ERROR: ",), ("\nPROGRAM-ERROR: ",));
    }

    replaceCase() {
        checkCaught("replace");
    }

    clearCase() {
        checkCaught("clear");
    }

    okCase() {
        string out = runChild("ok");
        assertEq(1, countOf(out, "quiet destructor"), out);
        assertFalse(out =~ /DOREF-TEST-ERROR/, out);
        assertFalse(out =~ /unhandled QORE/, out);
        assertFalse(out =~ /^caught: /m, out);
        assertEq("after: ok", getLine(out, "after: "), out);
    }

    #! checks the cases where the callback is replaced or removed while the Program is alive: the old callback is
    #! released in set_save_object_callback(), whose caller gets the exception, and nothing raises an exception when
    #! the Program is released
    private checkCaught(string case_name) {
        string out = runChild(case_name);
        assertEq("caught: DOREF-TEST-ERROR: destructor of " + case_name, getLine(out, "caught: "), out);
        assertEq(1, countOf(out, "DOREF-TEST-ERROR"), out);
        assertFalse(out =~ /unhandled QORE/, out);
        assertEq("after: " + case_name, getLine(out, "after: "), out);
    }

    #! checks the exceptions of the release of the Program's jni data: raised to the code that deletes the Program
    #! with a sink (qore#6917), else reported as unhandled
    /** @param descs the start of the error and description of each exception, in the order raised
        @param reported_descs the strings that the output has once each when the exceptions are reported as unhandled;
        if not given, \a descs
    */
    private checkReleased(string out, string case_name, string kind, list<string> descs,
            *list<string> reported_descs) {
        if (!exists sink) {
            # a release build cannot tell which behaviour it has: it is taken from this output, and all cases must
            # then show the same one
            bool caught = (out =~ /^caught: /m);
            bool unhandled = (out =~ /unhandled QORE/);
            assertTrue(caught != unhandled, sprintf("the exceptions of the release are either raised or reported "
                "(module not a debug build: %s): %s", sink_unknown, out));
            sink = caught;
        }
        if (sink) {
            checkCaughtRelease(out, case_name, descs);
        } else {
            checkReported(out, case_name, kind, reported_descs ?? descs);
        }
    }

    #! checks that each exception was raised to the code that deletes the Program, in order, that none was reported
    #! as unhandled, and that the process continued
    private checkCaughtRelease(string out, string case_name, list<string> descs) {
        list<string> caught = map $1, out.split("\n"), $1.equalPartial("caught: ");
        assertEq(descs.size(), caught.size(), out);
        foreach string desc in (descs) {
            string line = caught[$#] ?? "";
            assertTrue(line.equalPartial("caught: " + desc), sprintf("%y starts with %y: %s", line, desc, out));
            if (desc =~ /destructor of/) {
                # the whole description
                assertEq("caught: " + desc, line, out);
            }
        }
        assertFalse(out =~ /unhandled QORE/, out);
        assertFalse(out =~ /terminate called/, out);
        assertEq("after: " + case_name, getLine(out, "after: "), out);
    }

    #! checks that each exception was reported as unhandled once, that the caller got no exception, and that the
    #! process continued
    private checkReported(string out, string case_name, string kind, list<string> descs) {
        assertEq(descs.size(), countOf(out, "unhandled QORE " + kind + " exception"), out);
        assertEq(0, countOf(out, "unhandled QORE " + (kind == "User" ? "System" : "User") + " exception"), out);
        foreach string desc in (descs) {
            assertEq(1, countOf(out, desc), out);
        }
        assertFalse(out =~ /^caught: /m, out);
        assertFalse(out =~ /terminate called/, out);
        assertEq("after: " + case_name, getLine(out, "after: "), out);
    }

    #! returns the first line of the output that starts with the prefix, or an empty string
    private static string getLine(string out, string prefix) {
        foreach string line in (out.split("\n")) {
            if (line.equalPartial(prefix)) {
                return line;
            }
        }
        return "";
    }

    #! returns the number of times that the string appears in the output
    private static int countOf(string out, string str) {
        int count = 0;
        int pos = 0;
        while ((pos = out.find(str, pos)) >= 0) {
            ++count;
            pos += str.size();
        }
        return count;
    }

    #! runs the child with the case and returns its output (stdout and stderr), checking that it exited with status 0
    private string runChild(string case_name) {
        string child = normalize_dir(get_script_dir() + "/jni-doderef-no-throw-child.q");
        # the variables that make the JVM print a notice on startup are removed, as the output of the child is checked
        string cmd = sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS %s -b --enable-debug %s "
            "%s 2>&1", shellQuote(QORE_ARGV[0]), shellQuote(child), case_name);
        int rc;
        string out = backquote(cmd, \rc);
        assertEq(0, rc, "exit code: " + out);
        return out;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
