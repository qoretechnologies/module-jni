%modern
%requires jni
%module-cmd(jni) import java.lang.StringBuilder

module JniUcTrustedLibFixture {
    version = "1.0";
    desc = "a library module trusted with uncontrolled APIs that uses Java code";
    author = "Qore Technologies";
    url = "http://qore.org";
    license = "MIT";
    domains = "UNCONTROLLED_API";
}

public namespace JniUcTrustedLibFixture {
#! returns "ok" if the Java code of the module ran: a Java class that its directive imported, and a class that it loads
public string sub run() {
    string sb = (new StringBuilder("ok")).toString();
    string name = load_class("java.lang.StringBuffer").getName();
    return (sb == "ok" && name == "java.lang.StringBuffer") ? "ok" : sprintf("wrong result: %y %y", sb, name);
}
}
