#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

# A classpath entry that is only a wildcard with no directory part, such as "*.jar", is the matching files in the
# JVM's user.dir, as any relative entry is (qore#6740): the class loader raised a NullPointerException for it, which
# was printed as an unhandled exception, and the entry was not added.  Under a sandbox, the entry is checked as it is
# used: in the JVM's user.dir, not in the current directory of the process.
#
# A wildcard that matches no file adds nothing; the class loader printed a debug message for it unconditionally, which
# it now prints only if the qore.QoreURLClassLoader.debug Java system property is "true" (qore#6819).
#
# Each case runs test/jni-classpath-wildcard-child.q in a new directory that holds the test jar, which is then the
# JVM's user.dir, as the user.dir of a JVM cannot change once it has started.

%modern

%requires QUnit
%requires Util
%exec-class JniClasspathWildcardTest

class JniClasspathWildcardTest inherits QUnit::Test {
    public {
        #! the name of the test jar, in the directory of this script
        const TestJarName = "qore-jni-test.jar";
    }

    constructor() : QUnit::Test("JNI classpath with a bare wildcard entry", "1.0") {
        addTestCase("regression: add-classpath", \addClasspath());
        addTestCase("coverage: add-relative-classpath", \addRelativeClasspath());
        addTestCase("regression: global-add-classpath", \globalAddClasspath());
        addTestCase("coverage: global-add-relative-classpath", \globalAddRelativeClasspath());
        addTestCase("regression: the jdbc classpath option", \jdbcClasspathOption());
        addTestCase("regression: QORE_JNI_CLASSPATH", \envClasspath());
        addTestCase("regression: the sandbox checks a bare wildcard in the JVM's user.dir", \sandbox());
        addTestCase("regression: no debug message without the debug property", \debugDisabled());
        addTestCase("coverage: a debug message with the debug property as a JVM option", \debugJvmOption());
        addTestCase("coverage: a debug message with the debug property set with set-property",
            \debugSetProperty());
        set_return_value(main());
    }

    addClasspath() {
        checkCase("add-classpath", (
            "result: add-classpath: the jar in user.dir is added: OK",
            "result: add-classpath: the class is loaded: OK",
            "result: add-classpath with ./: the jar in user.dir is added: OK",
            "result: add-classpath after a change of the current directory: the jar in user.dir is added: OK",
            "result: add-classpath with a wildcard that matches no file: the jar in user.dir is added: OK",
        ));
    }

    #! a bare wildcard of a relative classpath is the matching files in the script directory
    addRelativeClasspath() {
        checkCase("add-relative-classpath", (
            "result: add-relative-classpath: the jar in the script directory is added: OK",
            "result: add-relative-classpath: the class is loaded: OK",
        ));
    }

    globalAddClasspath() {
        checkCase("global-add-classpath", (
            "result: global-add-classpath: no test jar before: OK",
            "result: global-add-classpath: the jar in user.dir is added for a new Program: OK",
            "result: global-add-classpath: the class is loaded in a new Program: OK",
        ));
    }

    globalAddRelativeClasspath() {
        checkCase("global-add-relative-classpath", (
            "result: global-add-relative-classpath: no test jar before: OK",
            "result: global-add-relative-classpath: the jar in the script directory is added for a new Program: OK",
            "result: global-add-relative-classpath: the class is loaded in a new Program: OK",
        ));
    }

    jdbcClasspathOption() {
        checkCase("jdbc", (
            "result: jdbc classpath option: no test jar before: OK",
            "result: jdbc classpath option: the jar in user.dir is added: OK",
            "result: jdbc classpath option: the class is loaded: OK",
        ));
    }

    envClasspath() {
        checkCase("env", (
            "result: QORE_JNI_CLASSPATH: the jar in user.dir is added: OK",
            "result: QORE_JNI_CLASSPATH: the class is loaded: OK",
        ), "QORE_JNI_CLASSPATH='*.jar'");
    }

    sandbox() {
        # qore#7832: with a jni module that reports it, the child's sandbox, which restricts the filesystem, refuses
        # Java code although it allows uncontrolled APIs; this process does not load the module, so the child checks
        # it, asserts the refusal and skips the rest
        string out = runInTempDir("sandbox", "");
        if (out =~ /^result: sandbox: skipped \(qore#7832/m) {
            assertEq(("result: sandbox: refused (qore#7832): OK",),
                (select out.split("\n"), $1 =~ /^result: / && $1 !~ /: skipped/), out);
            testSkip("qore#7832: a sandbox that restricts the filesystem refuses Java code, so the bare wildcard is "
                "not checked against it");
        }
        checkCase("sandbox", (
            "result: sandbox: allowed user.dir: OK",
            "result: sandbox: user.dir not allowed: OK",
            "result: sandbox: user.dir not allowed, the current directory allowed: OK",
            "result: sandbox: user.dir allowed, the current directory not allowed: OK",
        ), "", out);
    }

    #! the class loader printed a debug message for a wildcard that matches no file unconditionally (qore#6819)
    debugDisabled() {
        string out = checkCase("debug", ("result: debug: a wildcard that matches no file adds nothing: OK",));
        assertFalse(out =~ /QoreURLClassLoader DEBUG/, "a debug message was printed: " + out);
    }

    #! the debug message is printed if the qore.QoreURLClassLoader.debug system property is set as a JVM option
    debugJvmOption() {
        string out = checkCase("debug", ("result: debug: a wildcard that matches no file adds nothing: OK",),
            "QORE_JNI_JVM_ARGS=-Dqore.QoreURLClassLoader.debug=true");
        assertRegex("(?m)^QoreURLClassLoader DEBUG: no matching files for classpath element '.*\\*\\.zip'$", out);
    }

    #! the debug message is printed if the qore.QoreURLClassLoader.debug system property is set at runtime
    debugSetProperty() {
        string out = checkCase("debug set-property",
            ("result: debug: a wildcard that matches no file adds nothing: OK",));
        assertRegex("(?m)^QoreURLClassLoader DEBUG: no matching files for classpath element '.*\\*\\.zip'$", out);
    }

    #! runs a case of the child and checks its results, and that it printed no Java exception, and returns its output
    /** No debug message of the class loader is expected, except in the \c debug cases, whose callers check it
        \a out is the output of a run of the case if the caller already ran it
    */
    private string checkCase(string name, list<string> expected, string env = "", *string out) {
        if (!exists out) {
            out = runInTempDir(name, env);
        }
        if (out =~ /^result: [^:]+: skipped/m) {
            testSkip(trim(out));
        }
        list<string> lines = select out.split("\n"), $1 =~ /^result: /;
        assertEq(expected, lines, out);
        assertFalse(out =~ /NullPointerException/, "a NullPointerException was printed: " + out);
        assertFalse(out =~ /unhandled QORE System exception/, "an unhandled exception was printed: " + out);
        # the add-classpath case adds a wildcard that matches no file, for which a debug message was printed
        if (name !~ /^debug/) {
            assertFalse(out =~ /QoreURLClassLoader DEBUG/, "a debug message was printed: " + out);
        }
        return out;
    }

    #! runs the child in a new directory with the test jar, a subdirectory "rel" with another copy of it and an empty
    #! subdirectory "other", and returns its output
    private string runInTempDir(string name, string env) {
        string dir = tmp_location() + DirSep + sprintf("jni-classpath-wildcard-%d-%d", getpid(),
            now_us().durationMicroseconds());
        list<string> files = (dir + DirSep + TestJarName, dir + DirSep + "rel" + DirSep + TestJarName);
        list<string> dirs = (dir + DirSep + "rel", dir + DirSep + "other", dir);
        on_exit {
            foreach string file in (files) {
                unlink(file);
            }
            foreach string d in (dirs) {
                rmdir(d);
            }
        }
        foreach string d in (reverse(dirs)) {
            if (mkdir(d, 0700)) {
                throw "TEST-ERROR", sprintf("cannot create directory %y: %s", d, strerror());
            }
        }
        binary jar = ReadOnlyFile::readBinaryFile(get_script_dir() + DirSep + TestJarName);
        foreach string file in (files) {
            File f();
            f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(jar);
        }

        # an absolute path, as the child runs in another directory; the variables that make the JVM print a notice
        # on startup are removed, as the whole output of the child is checked, and so are the variables that could
        # add the test jar to the classpath or set the JVM's user.dir, so that the child's classpath and user.dir are
        # only those of the case
        string child = normalize_dir(get_script_dir() + "/jni-classpath-wildcard-child.q");
        string cmd = sprintf("cd %s && env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "-u QORE_JNI_CLASSPATH -u QORE_JNI_JVM_ARGS %s %s -b --enable-debug %s %s 2>&1", shellQuote(dir), env,
            shellQuote(QORE_ARGV[0]), shellQuote(child), name);
        int rc;
        string out = backquote(cmd, \rc);
        assertEq(0, rc, "exit code: " + out);
        return out;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
