    }

    urlSetterTest() {
        checkSkip(ss_jar, "singlestore");
        FakeDbServer s = server("mysql-ok");
        FakeDbServer other = server("mysql-ok", "127.0.0.2");
        int port = s.getPort();
        Program p = sandboxed(port, "nothing sub set_url(Datasource ds, string url) { ds.setOption(\"url\", url); }");
        hash<auto> h = {"type": "jdbc", "user": "u", "pass": "pw", "db": "jdbc:qore-none:x"};
        # restricted code sets the URL of a trusted datasource, and trusted code opens it: the connection is
        # restricted by the setter's sandbox
        Datasource ds(h);
        p.callFunction("set_url", ds, ssUrl(port));
        ds.open();
        on_exit ds.close();
        assertEq(1, s.tlsHandshakes(), "restricted: TLS with verify-full");
        # another destination than the setter's sandbox allows
        Datasource ds2(h);
        p.callFunction("set_url", ds2, sprintf("jdbc:singlestore://127.0.0.2:%d/db", other.getPort()));
        assertThrows("NETWORK-ACCESS-DENIED", "127\\.0\\.0\\.2", \ds2.open());
        assertEq(0, other.acceptCount(), "no connection to the denied destination");
        # a driver without a profile
        Datasource ds3(h);
        p.callFunction("set_url", ds3, sprintf("jdbc:postgresql://127.0.0.1:%d/db", port));
        assertThrows("NETWORK-ACCESS-DENIED", "not supported", \ds3.open());
        # trusted code sets the URL again: the last setter decides
        ds3.setOption("url", sprintf("jdbc:singlestore://127.0.0.2:%d/db", other.getPort()));
        try {
            ds3.open();
            ds3.close();
        } catch (hash<ExceptionInfo> ex) {
            assertNRegex("NETWORK-ACCESS-DENIED", ex.err, "a trusted URL is not restricted");
        }
        assertEq(1, other.acceptCount(), "the trusted URL connects");
    }

    urlSetterBarrierTest() {
        checkSkip(ss_jar, "singlestore");
        FakeDbServer s = server("mysql-ok");
        int port = s.getPort();
        # a plain URL: a restricted connection is forced to verify-full TLS, which fails with the fake server's
        # certificate, and an unrestricted one connects
        string url = sprintf("jdbc:singlestore://127.0.0.1:%d/db", port);
        hash<auto> h = {"type": "jdbc", "user": "u", "pass": "pw", "db": "jdbc:qore-none:x"};
        # trusted code that runs code for sandboxed code under a policy barrier or as a system-policy capability
        Program t(PO_NEW_STYLE);
        t.parse("code sub barrier(code c) { return sub () { SandboxManager::callWithSystemPolicy(c); }; }\n"
            "code sub capability(code c) { return SandboxManager::createSystemPolicyCall(c); }\n"
            "code sub opener(string url, reference<string> r) { return sub () { try { Datasource ds({\"type\": "
            "\"jdbc\", \"user\": \"u\", \"pass\": \"pw\", \"db\": url}); ds.open(); ds.close(); r = \"ok\"; } catch "
            "(hash<ExceptionInfo> ex) { r = \"error\"; } }; }\n"
            "code sub setter(Datasource ds, string url) { return sub () { ds.setOption(\"url\", url); }; }",
            "jni-jdbc-driver-sandbox-barrier");
        Program p = sandboxed(port, "nothing sub call(code c) { c(); }");
        # the URL's setter is judged as the thread is when it opens the connection in the same context
        foreach string kind in (("barrier", "capability")) {
            string thread_result;
            p.callFunction("call", t.callFunction(kind, t.callFunction("opener", url, \thread_result)));
            Datasource ds(h);
            p.callFunction("call", t.callFunction(kind, t.callFunction("setter", ds, url)));
            assertEq(url, ds.getOptionHash().url, kind + ": the url was set");
            string setter_result;
            try {
                ds.open();
                ds.close();
                setter_result = "ok";
            } catch (hash<ExceptionInfo> ex) {
                setter_result = "error";
            }
            assertEq(thread_result, setter_result, kind + ": the setter is judged as the thread is");
        }
        # the capability is not governed: neither the thread nor the setter is restricted
        {
            Datasource ds(h);
            p.callFunction("call", t.callFunction("capability", t.callFunction("setter", ds, url)));
            ds.open();
            ds.close();
        }
        # a limits-only sandbox (uncontrolled APIs allowed): the URL that its code sets does not restrict the
        # connection, also when a refusing sandbox governs the code that calls it
        SandboxManager lim();
        if (!lim.hasCallableMethod("setUncontrolledApiPolicy")) {
            return;
        }
        lim.setNetworkDefaultPolicy(True);
        call_object_method(lim, "setUncontrolledApiPolicy", True);
        Program l(PO_NEW_STYLE);
        l.setSandboxManager(lim);
        l.parse("code sub setter(Datasource ds, string url) { return sub () { ds.setOption(\"url\", url); }; }",
            "jni-jdbc-driver-sandbox-limits");
        {
            Datasource ds(h);
            l.callFunction("setter", ds, url)();
            ds.open();
            ds.close();
        }
        string thread_result;
        p.callFunction("call", t.callFunction("barrier", t.callFunction("opener", url, \thread_result)));
        Datasource ds(h);
        p.callFunction("call", t.callFunction("barrier", l.callFunction("setter", ds, url)));
        string setter_result;
        try {
            ds.open();
            ds.close();
            setter_result = "ok";
        } catch (hash<ExceptionInfo> ex) {
            setter_result = "error";
        }
        assertEq(thread_result, setter_result, "limits-only inside a barrier for sandboxed code");
    }

    ssDatabaseTest() {
