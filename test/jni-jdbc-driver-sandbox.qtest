    ssClientKeyTest() {
        checkSkip(ss_jar, "singlestore");
        # the JVM's client key store, which the driver presents to every server without a keyStore option
        System::setProperty("javax.net.ssl.keyStore", get_script_dir() + "jdbc-fake-server.p12");
        on_exit System::clearProperty("javax.net.ssl.keyStore");
        System::setProperty("javax.net.ssl.keyStorePassword", "qore-fake");
        on_exit System::clearProperty("javax.net.ssl.keyStorePassword");
        System::setProperty("javax.net.ssl.keyStoreType", "PKCS12");
        on_exit System::clearProperty("javax.net.ssl.keyStoreType");
        FakeDbServer s = server("mysql-ok");
        int port = s.getPort();
        # a trusted connection presents it: the server sees a client certificate
        assertEq("ok", trusted().callFunction("open_db", ssUrl(port, "db", "&sslMode=verify-full")), "trusted");
        assertEq(1, s.tlsHandshakes(), "trusted: TLS");
        assertEq(1, s.clientCertificates(), "trusted: the JVM's client certificate");
        # a restricted connection is made, and presents no client certificate
        assertEq("ok", sandboxed(port).callFunction("open_db", ssUrl(port)), "restricted");
        assertEq(2, s.tlsHandshakes(), "restricted: TLS");
        assertEq(1, s.clientCertificates(), "restricted: no client certificate");
        # the module's empty key store is deleted: the next restricted connection recreates it
        int deleted = deleteEmptyKeyStores();
        assertTrue(deleted > 0, "the empty key store was found");
        assertEq("ok", sandboxed(port).callFunction("open_db", ssUrl(port)), "restricted after the deletion");
        assertEq(3, s.tlsHandshakes(), "restricted after the deletion: TLS");
        assertEq(1, s.clientCertificates(), "restricted after the deletion: no client certificate");
        # its contents are replaced: they are restored
        assertTrue(overwriteEmptyKeyStores() > 0, "the empty key store was overwritten");
        assertEq("ok", sandboxed(port).callFunction("open_db", ssUrl(port)), "restricted after the overwrite");
        assertEq(1, s.clientCertificates(), "restricted after the overwrite: no client certificate");
        # the directory is replaced by another one with the same name (ex: a temporary file cleaner removed it and
        # someone created it again), which cannot be written and holds a key store with a client key: it is not used
        list<string> dirs = map dirname($1), emptyKeyStores();
        assertTrue(dirs.size() > 0, "the empty key store directory was found");
        binary key = ReadOnlyFile::readBinaryFile(get_script_dir() + "jdbc-fake-server.p12");
        # registered first, so that a failure part of the way still restores and removes everything
        on_exit {
            foreach string dir in (dirs) {
                foreach string d in ((dir, dir + ".old")) {
                    try { chmod(d, 0700); } catch () {}
                    try { unlink(d + DirSep + "empty.p12"); } catch () {}
                    try { rmdir(d); } catch () {}
                }
            }
        }
        foreach string dir in (dirs) {
            # the old directory is renamed away, not removed: its inode stays in use, so the new directory cannot
            # get the same one (ext4 reuses a freed inode at once, which would make it the "same" directory)
            rename(dir, dir + ".old");
            mkdir(dir, 0700);
            File out();
            out.open2(dir + DirSep + "empty.p12", O_CREAT | O_WRONLY | O_TRUNC, 0600);
            out.write(key);
            out.close();
            chmod(dir, 0500);
        }
        assertEq("ok", sandboxed(port).callFunction("open_db", ssUrl(port)), "restricted after the replacement");
        assertEq(1, s.clientCertificates(), "restricted after the replacement: no client certificate");
        foreach string dir in (dirs) {
            assertEq(key, ReadOnlyFile::readBinaryFile(dir + DirSep + "empty.p12"), "the replaced directory is not used");
        }
    }

    ssKeyStorePermissionTest() {
        checkSkip(ss_jar, "singlestore");
        FakeDbServer s = server("mysql-ok");
        int port = s.getPort();
        Program p = sandboxed(port);
        assertEq("ok", p.callFunction("open_db", ssUrl(port)), "restricted");
        list<string> before = emptyKeyStores();
        assertTrue(before.size() > 0, "the empty key store was found");
        # the module's own directory, with its inode, gives the group access: it is not used again
        on_exit {
            foreach string f in (before) {
                try { chmod(dirname(f), 0700); } catch () {}
            }
        }
        hash<string, int> inodes;
        foreach string f in (before) {
            string dir = dirname(f);
            inodes{dir} = hstat(dir).inode;
            chmod(dir, 0750);
        }
        assertEq("ok", p.callFunction("open_db", ssUrl(port)), "restricted after the chmod");
        assertEq(0, s.clientCertificates(), "no client certificate");
        list<string> after = emptyKeyStores();
        assertTrue(after.size() > before.size(), "a new directory was created");
        foreach string f in (before) {
            string dir = dirname(f);
            hash<auto> st = hstat(dir);
            assertEq(inodes{dir}, st.inode, "the directory keeps its inode");
            assertEq(0750, st.mode & 0777, "the 0750 directory is left as it is");
        }
    }

    #! returns the files of the module's empty client key stores in the JVM's temporary directory
    private static list<string> emptyKeyStores() {
        string tmp = System::getProperty("java.io.tmpdir");
        list<string> rv = ();
        Dir d();
        d.chdir(tmp);
        # the directories that the module creates (Files.createTempDirectory(): the prefix and digits), not the
        # ".old" directories of the replacement case
        foreach string dn in (d.listDirs("^qore-jni-jdbc-keystore-[0-9]+$")) {
            string f = tmp + DirSep + dn + DirSep + "empty.p12";
            if (is_file(f)) {
                rv += f;
            }
        }
        return rv;
    }

    #! deletes the module's empty key stores and returns how many were deleted
    private static int deleteEmptyKeyStores() {
        list<string> l = emptyKeyStores();
        map unlink($1), l;
        return l.size();
    }

    #! replaces the contents of the module's empty key stores with the test's key store, which has a client key
    private static int overwriteEmptyKeyStores() {
        list<string> l = emptyKeyStores();
        binary key = ReadOnlyFile::readBinaryFile(get_script_dir() + "jdbc-fake-server.p12");
        foreach string f in (l) {
            File out();
            out.open2(f, O_WRONLY | O_TRUNC);
            out.write(key);
            out.close();
        }
        return l.size();
    }

    reconnectTest() {
        checkSkip(ss_jar, "singlestore");
        FakeDbServer s = server("mysql-ok");
        int port = s.getPort();
        Program p = sandboxed(port, "string sub open_ds(Datasource ds) { try { ds.open(); return \"ok\"; } catch (hash<ExceptionInfo> ex) "
            "{ return ex.err + \": \" + ex.desc; } }\n"
            "string sub exec_ds(Datasource ds, string sql) { try { ds.exec(sql); return \"ok\"; } "
            "catch (hash<ExceptionInfo> ex) { return ex.err + \": \" + ex.desc; } "
            "on_exit try { ds.rollback(); } catch () {} }");
        # trusted code creates the datasource, sandboxed code opens it: a restricted connection
        Datasource ds({"type": "jdbc", "user": "u", "pass": "pw", "db": ssUrl(port, "db", "&useServerPrepStmts=false")});
        assertEq("ok", p.callFunction("open_ds", ds));
        assertEq(1, s.acceptCount());
        # the connection is lost; trusted code's statement reconnects
        s.dropClients();
        try {
            ds.exec("select 1");
        } catch (hash<ExceptionInfo> ex) {
            # the fake server's error for the statement on the new connection
            assertRegex("qore-fake-mysql-query", ex.desc, "the statement ran on the new connection");
        }
        on_exit try { ds.rollback(); } catch () {}
        assertTrue(s.awaitAcceptCount(2, 30000) >= 2, "reconnected");
        assertEq(s.acceptCount(), s.tlsHandshakes(), "every new connection is restricted: TLS with verify-full");
        # the new connection is still restricted: sandboxed SQL is screened
        int queries = s.getQueries().size();
        assertRegex("^JNI-SANDBOX-ERROR: .*LOCAL INFILE",
            p.callFunction("exec_ds", ds, "LOAD DATA LOCAL INFILE '/etc/passwd' INTO TABLE t"));
        assertEq(queries, s.getQueries().size(), "the statement did not reach the server");
    }

    trustedSharedTest() {
        checkSkip(ss_jar, "singlestore");
        FakeDbServer s = server("mysql-ok");
        int port = s.getPort();
        # trusted code opens the connection without TLS: not restricted (qore#6142)
        Datasource ds({"type": "jdbc", "user": "u", "pass": "pw",
            "db": sprintf("jdbc:singlestore://127.0.0.1:%d/db?useServerPrepStmts=false", port)});
        ds.open();
        on_exit ds.close();
        assertEq(0, s.tlsHandshakes());
        Program p = sandboxed(port, "string sub exec_ds(Datasource ds, string sql) { try { ds.exec(sql); return \"ok\"; } "
            "catch (hash<ExceptionInfo> ex) { return ex.err + \": \" + ex.desc; } "
            "on_exit try { ds.rollback(); } catch () {} }");
        foreach string sql in (("LOAD DATA LOCAL INFILE '/etc/passwd' INTO TABLE t",
                "LOAD DATA {d LOCAL} INFILE '/etc/passwd' INTO TABLE t")) {
            assertRegex("^JNI-SANDBOX-ERROR: .*LOCAL INFILE", p.callFunction("exec_ds", ds, sql), sql);
        }
        assertEq((), s.getQueries(), "no statement reached the server");
        # trusted code's own SQL is not screened
        try {
            ds.exec("LOAD DATA LOCAL INFILE '/nonexistent-qore-test' INTO TABLE t");
        } catch (hash<ExceptionInfo> ex) {
        }
        ds.rollback();
        assertEq(1, s.getQueries().size(), "trusted SQL reached the server");
    }

    connectTargetsTest() {
        if (!supported) {
            testSkip("the jni module was built without the prerequisites of the per-driver jdbc sandbox enforcement");
        }
        # QDBI_METHOD_GET_CONNECT_TARGETS: the Qore side of qore#5747; a Qore library that has it declares
        # DBI_CAP_LOCAL_ONLY
        if (!haveDbiSandboxCheck()) {
            testSkip("the Qore library does not check the connect targets of DBI drivers (qore#5747)");
        }
        # not reached with a Qore library without the check; the mode is tested when that library is available
        fail("the Qore side of qore#5747 is not expected yet; extend this test");
    }
}
