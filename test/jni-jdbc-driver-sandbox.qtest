        t.parse("%requires jni\n%module-cmd(jni) import org.qore.jni.jdbc.JdbcConnectGuard\n"
            "int sub count() { return JdbcConnectGuard::registeredCount(); }", "jni-jdbc-driver-registry");
        assertEq(0, t.callFunction("count"));
    }

    rsUserTest() {
        checkSkip(rs_jar, "redshift");
        FakeDbServer s = server("pg");
        # the driver's default user is the name of the process owner
        Program p = sandboxed(s.getPort(), "string sub open_nouser(string url) { try { Datasource ds({\"type\": \"jdbc\", \"db\": url}); "
            "ds.open(); return \"ok\"; } catch (hash<ExceptionInfo> ex) { return ex.err + \": \" + ex.desc; } }");
        assertRefused(p.callFunction("open_nouser", sprintf("jdbc:redshift://127.0.0.1:%d/dev", s.getPort())), Denied,
            "user", (s,), "no user");
        assertRefused(p.callFunction("open_nouser", sprintf("jdbc:redshift://127.0.0.1:%d/dev?user=", s.getPort())),
            Denied, "user", (s,), "an empty user");
        # uid is not the user that the driver sends: the driver's default user (the process owner) would be sent
        assertRefused(p.callFunction("open_nouser", sprintf("jdbc:redshift://127.0.0.1:%d/dev?uid=x", s.getPort())),
            Denied, "uid|user", (s,), "uid only");
        # the user as an option
        assertReached(p.callFunction("open_nouser", sprintf("jdbc:redshift://127.0.0.1:%d/dev?user=u", s.getPort())),
            "SSL", s, "the user in the URL");
    }

