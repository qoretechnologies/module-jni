#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires QUnit
%requires jni
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.GovernedProgramProbe

%exec-class JniSandboxTrustedHostCallback

#! A trusted host with a permissive sandbox manager on every Program (qorus#1088)
/** The trusted manager restricts nothing and is attached before the jni module is loaded.  The test cases run in
    order: the first ones run before any restricting sandbox has used Java in the process, the later ones after.
*/
class JniSandboxTrustedHostCallback inherits QUnit::Test {
    public {
        const NotGoverned = "cannot call into a Qore Program other than the one of the calling code";

        #! the refusal of Java code under the tenant's sandbox, which trusts its code with uncontrolled APIs but
        #! restricts the filesystem and the network (qore#7832)
        const SandboxRefused = "^ERR: INVALID-FUNCTION-ACCESS: the sandbox that governs the calling code restricts "
            "FILESYSTEM \\(PO_NO_FILESYSTEM\\), NETWORK \\(PO_NO_NETWORK\\), which uncontrolled API .* "
            "\\(qore#7832\\)$";

        const SvcSource = "package q1088;
import org.qore.jni.QoreJavaApi;
public class Svc {
    public Svc() {
    }
    public String viaSave(String v) throws Throwable {
        return (String)QoreJavaApi.callStaticMethodSave(\"JApi\", \"ping\", v);
    }
}
";

        #! the interface Program that defines the Java class and the Qore API that it calls back
        const JSource = "
public class JApi {
    static string ping(string v) {
        return \"J:\" + v;
    }
}

object sub make_svc(string src) {
    QoreJavaCompiler compiler(get_class_loader(), NOTHING);
    on_exit compiler.close();
    object out = compiler.compile(\"q1088.Svc\", src);
    Class cls = out.cls;
    return cls.getDeclaredConstructor().newInstance();
}

string sub own_call(object o, string v) {
    return o.viaSave(v);
}
";

        #! the server code, which calls the Java service object directly
        const SSource = "
string sub call_direct(object o, string v) {
    return o.viaSave(v);
}

auto sub call_args(object o, string m, softlist<auto> a) {
    return call_object_method_args(o, m, a);
}
";

        #! a Kotlin compile with the compiler, its class loader and the calling code in one Program
        const KSource = "
auto sub kx_compile(hash<auto> src) {
    object comp = new QoreKotlinCompiler();
    return comp.compile(src, NOTHING);
}

auto sub kx_compile_loader(hash<auto> src) {
    object comp = new QoreKotlinCompiler(jni::get_class_loader(), NOTHING);
    return comp.compile(src, NOTHING);
}

object sub kx_get_compiler() {
    return new QoreKotlinCompiler(jni::get_class_loader(), NOTHING);
}

auto sub kx_call_object(object o, string m, softlist<auto> a) {
    return call_object_method_args(o, m, a);
}
";

        const TenantSource = "
string sub tenant_fn() {
    return \"tenant\";
}

string sub reach(object loader, string fn) {
    return GovernedProgramProbe::callIn(loader, fn);
}

string sub own() {
    return GovernedProgramProbe::callIn(get_class_loader(), \"tenant_fn\");
}
";
    }

    private {
        int seq = 0;
    }

    constructor() : QUnit::Test("trusted host callback under a sandbox manager", "1.0") {
        addTestCase("before: B direct call into Java service", \caseB());
        addTestCase("before: B via call_object_method_args", \caseBArgs());
        addTestCase("before: A no-arg compiler in Program", \caseA1());
        addTestCase("before: A get_class_loader compiler in Program", \caseA2());
        addTestCase("before: A compiler object called directly", \caseA3());
        addTestCase("before: A compiler object via callFunction", \caseA4());
        addTestCase("restricting sandbox uses Java", \poison());
        addTestCase("after: B direct call into Java service", \caseB());
        addTestCase("after: B via call_object_method_args", \caseBArgs());
        addTestCase("after: A no-arg compiler in Program", \caseA1());
        addTestCase("after: A get_class_loader compiler in Program", \caseA2());
        addTestCase("after: A compiler object called directly", \caseA3());
        addTestCase("after: A compiler object via callFunction", \caseA4());
        addTestCase("negative: restricted cannot reach the host", \negHost());
        addTestCase("negative: restricted cannot reach another tenant", \negTenant());
        addTestCase("negative: a sandbox that refuses uncontrolled APIs cannot use jni", \negExactPolicy());
        set_return_value(main());
    }

    caseB() {
        Program j = getTrusted(JSource);
        Program s = getTrusted(SSource);
        object svc = j.callFunction("make_svc", SvcSource);
        assertEq("J:own", attempt(string sub () { return j.callFunction("own_call", svc, "own"); }));
        assertEq("J:direct", attempt(string sub () { return s.callFunction("call_direct", svc, "direct"); }));
    }

    caseBArgs() {
        Program j = getTrusted(JSource);
        Program s = getTrusted(SSource);
        object svc = j.callFunction("make_svc", SvcSource);
        assertEq("J:args", attempt(string sub () { return s.callFunction("call_args", svc, "viaSave", "args"); }));
    }

    caseA1() {
        Program k = getKotlin();
        string n = className();
        assertEq(n, attempt(string sub () { return k.callFunction("kx_compile", {n: "class " + n + " {}"}).firstKey(); }));
    }

    caseA2() {
        Program k = getKotlin();
        string n = className();
        assertEq(n, attempt(string sub () {
            return k.callFunction("kx_compile_loader", {n: "class " + n + " {}"}).firstKey();
        }));
    }

    caseA3() {
        Program k = getKotlin();
        string n = className();
        object comp = k.callFunction("kx_get_compiler");
        assertEq(n, attempt(string sub () { return comp.compile({n: "class " + n + " {}"}, NOTHING).firstKey(); }));
    }

    caseA4() {
        Program k = getKotlin();
        string n = className();
        object comp = k.callFunction("kx_get_compiler");
        assertEq(n, attempt(string sub () {
            return k.callFunction("kx_call_object", comp, "compile", ({n: "class " + n + " {}"}, NOTHING)).firstKey();
        }));
    }

    poison() {
        Program t = getTenant();
        # a restricting sandbox's own Java call: this marks governed Java as used in the process
        string rv = attempt(string sub () { return t.callFunction("own"); });
        if (sandboxClassesRefused()) {
            # qore#7832: the tenant's sandbox restricts the filesystem and the network, so it refuses its own Java
            # call; no restricting sandbox can use Java, so the state that governed Java leaves is set with the module
            # command that sets it (the Java threads of the process reach no Program by a Program pointer from now on),
            # and the "after" cases run in it
            assertRegex(SandboxRefused, rv, rv);
            Program::issueModuleCmd("jni", "set-java-thread-policy strict");
            return;
        }
        assertEq("ok: tenant", rv);
    }

    negHost() {
        Program t = getTenant();
        string rv = attempt(string sub () { return t.callFunction("reach", get_class_loader(), "host_fn"); });
        if (sandboxClassesRefused()) {
            # qore#7832: the tenant's sandbox refuses the Java call before it can reach the host, and also its own
            assertRegex(SandboxRefused, rv, rv);
            rv = attempt(string sub () { return t.callFunction("own"); });
            assertRegex(SandboxRefused, rv, rv);
            return;
        }
        assertRegex(NotGoverned, rv, rv);
        assertEq("ok: tenant", attempt(string sub () { return t.callFunction("own"); }));
    }

    negTenant() {
        Program t = getTenant();
        Program other = getTenant();
        if (sandboxClassesRefused()) {
            # qore#7832: the other tenant's sandbox refuses get_class_loader(), so no tenant loader can be handed to
            # the first tenant
            string rv = attempt(string sub () { return other.callFunction("tenant_loader").className(); });
            assertRegex(SandboxRefused, rv, rv);
            testSkip("qore#7832: the tenants' sandbox trusts them with uncontrolled APIs but restricts the filesystem "
                "and the network, so it refuses their Java code; no tenant can reach another through Java");
        }
        object loader = other.callFunction("tenant_loader");
        string rv = attempt(string sub () { return t.callFunction("reach", loader, "tenant_fn"); });
        assertRegex(NotGoverned, rv, rv);
    }

    negExactPolicy() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.setNetworkDefaultPolicy(True);
        sm.blockPrivateNetworks();
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        string rv = attempt(string sub () {
            p.loadModule("jni");
            p.parse("string sub f() { return get_class_loader().getClass().getName(); }", "exact");
            return p.callFunction("f");
        });
        assertRegex("^ERR: INVALID-FUNCTION-ACCESS: ", rv, rv);
    }

    #! Returns True if a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem or the network
    #! refuses Java code (qore#7832)
    private static bool sandboxClassesRefused() {
        return get_module_hash().jni.info.sandbox_uncontrolled_api_classes ?? False;
    }

    private string className() {
        return sprintf("B%d", ++seq);
    }

    #! returns the value as a string or the error, so that each failure records its exact text
    private static string attempt(code c) {
        try {
            return c();
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("ERR: %s: %s", ex.err, ex.desc);
        }
    }

    #! a manager that restricts nothing
    private static SandboxManager getTrustedManager() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(True);
        sm.setUncontrolledApiPolicy(True);
        return sm;
    }

    #! a trusted Program: its manager is attached before the jni module is loaded
    private static Program getTrusted(string src) {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(getTrustedManager());
        JniSandboxTrustedHostCallback::initJava(p);
        p.parse(src, "trusted");
        return p;
    }

    private static initJava(Program p) {
        p.loadModule("jni");
        p.issueModuleCmd("jni", "add-classpath " + getBuildDir() + "/qore-jni-compiler.jar");
        p.issueModuleCmd("jni", "import org.qore.jni.*");
        p.issueModuleCmd("jni", "import java.lang.Class");
        p.issueModuleCmd("jni", "import org.qore.jni.compiler.QoreJavaCompiler");
        p.issueModuleCmd("jni", "import org.qore.jni.compiler.CompilerOutput");
    }

    #! returns the Kotlin home with a usable compiler, as the build finds it
    private static *string getKotlinHome() {
        list<string> homes = ENV.KOTLIN_HOME
            ? (ENV.KOTLIN_HOME,)
            : ("/opt/kotlin", "/opt/kotlinc", "/usr/share/qore/java/kotlin");
        foreach string home in (homes) {
            if (is_file(home + "/lib/kotlin-stdlib.jar") && is_file(home + "/lib/kotlin-compiler.jar")) {
                return home;
            }
        }
    }

    #! a Program with Java and Kotlin set up; in CI a missing compiler is an error, so this coverage cannot silently go
    private Program getKotlin() {
        *string home = getKotlinHome();
        if (!home) {
            if (ENV.CI) {
                throw "KOTLIN-ERROR", "the Kotlin compiler is required in CI";
            }
            testSkip("Kotlin not available");
        }
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(getTrustedManager());
        JniSandboxTrustedHostCallback::initJava(p);
        bool have_embeddable = False;
        string sdir = home + "/lib/scripting";
        if (is_dir(sdir)) {
            Dir kd();
            kd.chdir(sdir);
            list<string> jars = sort(kd.listFiles("\\.jar$") ?? ());
            have_embeddable = boolean(select jars, $1 =~ /^kotlin-compiler-embeddable.*\.jar$/);
            if (have_embeddable) {
                map p.issueModuleCmd("jni", "global-add-classpath " + sdir + "/" + $1), jars;
                Dir ld();
                ld.chdir(home + "/lib");
                *list<string> annotations = ld.listFiles("^annotations-.*\\.jar$");
                if (annotations) {
                    p.issueModuleCmd("jni", "global-add-classpath " + home + "/lib/" + (sort(annotations))[0]);
                }
                if (is_file(home + "/lib/kotlin-reflect.jar")) {
                    p.issueModuleCmd("jni", "global-add-classpath " + home + "/lib/kotlin-reflect.jar");
                }
            }
        }
        if (!have_embeddable) {
            p.issueModuleCmd("jni", "global-add-classpath " + home + "/lib/kotlin-compiler.jar");
        }
        p.issueModuleCmd("jni", "global-add-classpath " + home + "/lib/kotlin-stdlib.jar");
        p.issueModuleCmd("jni", "import org.qore.jni.compiler.QoreKotlinCompiler");
        p.issueModuleCmd("jni", "import org.qore.jni.compiler.QoreKotlinCompilerException");
        p.parse(KSource, "kotlin");
        return p;
    }

    #! a Program that a restricting sandbox governs; attached after the setup, which reads the jars
    private static Program getTenant() {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.loadModule("jni");
        p.issueModuleCmd("jni", "add-classpath " + get_script_dir() + "/qore-jni-test.jar");
        p.issueModuleCmd("jni", "import org.qore.jni.test.GovernedProgramProbe");
        p.parse(TenantSource + "object sub tenant_loader() { return get_class_loader(); }\n", "tenant");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.setNetworkDefaultPolicy(True);
        sm.blockPrivateNetworks();
        # a tenant that can call Java at all: without this, the jni module refuses it
        sm.setUncontrolledApiPolicy(True);
        p.setSandboxManager(sm);
        return p;
    }

    private static string getBuildDir() {
        return get_script_dir() + "/../build";
    }
}

string sub host_fn() {
    return "host";
}
