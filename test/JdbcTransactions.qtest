%modern
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires jni
%requires QUnit
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
# JdbcCursorTest uses the org.qore.lang wrapper classes, which are provided by qore-jni.jar
%module-cmd(jni) add-relative-classpath ../build/qore-jni.jar
%module-cmd(jni) import org.qore.jni.test.JdbcTransactionDriver
%module-cmd(jni) import org.qore.jni.test.JdbcCursorTest
%exec-class JdbcTransactionsTest

class JdbcTransactionsTest inherits QUnit::Test {
    constructor() : Test("JDBC transaction boundaries", "1.0", \ARGV) {
        addTestCase("pooled reads and transaction boundaries", \boundaries());
        addTestCase("prepared writes commit and rollback", \prepared());
        addTestCase("explicit and empty transactions", \explicitTransactions());
        addTestCase("Qore auto-commit", \autoCommit());
        addTestCase("failed transaction boundaries discard connection", \failures());
        addTestCase("failed initial mode closes connection", \openFailure());
        addTestCase("statement cleanup failures", \cleanupFailures());
        addTestCase("prepared begin failure does not execute", \preparedBeginFailure());
        addTestCase("non-query output and invalid fetches", \nonQueryOutput());
        addTestCase("batch counts, unknown counts and overflow", \batchCounts());
        addTestCase("repeated execution failures preserve exceptions and release handles", \repeatedFailures());
        addTestCase("lost connection: the first statement of a transaction runs again", \lostFirstStatement());
        addTestCase("lost connection: a prepared statement starting a transaction runs again",
            \lostFirstPreparedStatement());
        addTestCase("lost connection: an auto-commit statement never runs twice", \lostAutoCommit());
        addTestCase("lost connection: an active transaction is reported lost", \lostActiveTransaction());
        addTestCase("lost connection: a released statement is prepared again", \lostReleasedStatement());
        addTestCase("lost connection at transaction start: the statement runs once on a new connection",
            \lostAtTransactionStart());
        addTestCase("lost connection at transaction start: an explicit transaction is started on a new connection",
            \lostAtExplicitTransactionStart());
        addTestCase("lost connection at transaction start: a prepared statement runs once on a new connection",
            \lostAtPreparedTransactionStart());
        addTestCase("lost connection at transaction start and again when the statement is executed",
            \lostAtTransactionStartAndExecution());
        addTestCase("lost connection at transaction start: a failed reconnection is raised",
            \lostAtTransactionStartReconnectFails());
        addTestCase("lost connection at transaction start: failed statement cleanup is raised",
            \lostAtTransactionStartCleanupFails());
        addTestCase("lost connection: a failed validity check is not a lost connection", \lostValidityCheckFails());
        addTestCase("result sets survive Java native-call boundaries", \cursorLifetime());
        set_return_value(main());
    }

    private DatasourcePool pool() {
        JdbcTransactionDriver::reset();
        return new DatasourcePool({"type": "jdbc", "db": "qore-transaction-test:fixture",
            "options": {"min": 1, "max": 1}});
    }

    private boundaries() {
        DatasourcePool ds = pool();
        assertEq(1, ds.select("read"));
        assertFalse(ds.inTransaction());
        ds.exec("write");
        assertEq(0, JdbcTransactionDriver::durable());
        assertEq(1, ds.select("read"));
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        ds.select("read");
        ds.execRaw("write");
        ds.rollback();
        assertEq(1, JdbcTransactionDriver::durable());
        ds.select("read");
        assertEq(("connect", "auto:true", "execute:read:true", "statement.close", "auto:false",
            "execute:write:false", "statement.close", "execute:read:false", "statement.close", "commit",
            "auto:true", "execute:read:true", "statement.close", "auto:false", "plain:write", "execute:write:false",
            "statement.close", "rollback", "auto:true", "execute:read:true", "statement.close"),
            JdbcTransactionDriver::events());
    }

    private prepared() {
        DatasourcePool ds = pool();
        SQLStatement stmt(ds);
        stmt.prepare("write");
        stmt.exec();
        assertEq(0, JdbcTransactionDriver::durable());
        stmt.rollback();
        assertEq(0, JdbcTransactionDriver::durable());
        stmt.exec();
        assertEq(0, JdbcTransactionDriver::durable());
        stmt.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        assertEq(1, ds.select("read"));
        assertFalse(ds.inTransaction());
    }

    private explicitTransactions() {
        DatasourcePool ds = pool();
        ds.beginTransaction();
        ds.beginTransaction();
        ds.select("read");
        ds.commit();
        ds.commit();
        ds.rollback();
        assertEq(("connect", "auto:true", "auto:false", "execute:read:false", "statement.close", "commit",
            "auto:true", "auto:false", "commit", "auto:true", "auto:false", "rollback", "auto:true"),
            JdbcTransactionDriver::events());
    }

    private autoCommit() {
        JdbcTransactionDriver::reset();
        Datasource ds("jdbc:@qore-transaction-test:fixture");
        ds.setAutoCommit(True);
        ds.exec("write");
        assertEq(1, JdbcTransactionDriver::durable());
        SQLStatement stmt(ds);
        stmt.prepare("write");
        stmt.exec();
        stmt.commit();
        assertEq(2, JdbcTransactionDriver::durable());
        assertFalse(inlist("auto:false", JdbcTransactionDriver::events()));
    }

    private failures() {
        foreach string failure in ("auto:false", "commit", "rollback", "auto:true") {
            DatasourcePool ds = pool();
            if (failure != "auto:false") {
                ds.exec("write");
            }
            JdbcTransactionDriver::failNext(failure);
            assertThrows("JNI-ERROR", "injected " + failure, sub () {
                if (failure == "auto:false") {
                    ds.exec("write");
                } else if (failure == "rollback") {
                    ds.rollback();
                } else {
                    ds.commit();
                }
            });
            list<string> events = JdbcTransactionDriver::events();
            assertEq("close", events[-1]);
            assertEq(failure == "auto:true" ? 1 : 0, JdbcTransactionDriver::durable());
            assertEq(1, ds.select("read"));
            events = JdbcTransactionDriver::events();
            assertEq(("connect", "auto:true", "execute:read:true", "statement.close"), events[-4 .. -1]);
        }
    }

    private cleanupFailures() {
        DatasourcePool ds = pool();
        JdbcTransactionDriver::failNext("statement.close");
        assertThrows("JNI-ERROR", "injected statement.close", sub () { ds.exec("write"); });
        ds.rollback();
        assertEq(0, JdbcTransactionDriver::durable());
        SQLStatement stmt(ds);
        stmt.prepare("write");
        stmt.exec();
        JdbcTransactionDriver::failNext("statement.close");
        assertThrows("JNI-ERROR", "injected statement.close", \stmt.close());
        stmt.rollback();
        assertEq(0, JdbcTransactionDriver::durable());
        assertEq(1, ds.select("read"));
    }

    private preparedBeginFailure() {
        DatasourcePool ds = pool();
        SQLStatement stmt(ds);
        stmt.prepare("write");
        JdbcTransactionDriver::failNext("auto:false");
        assertThrows("JNI-ERROR", "injected auto:false", \stmt.exec());
        assertEq(("connect", "auto:true", "auto:false", "statement.close", "close"),
            JdbcTransactionDriver::events());
        assertEq(0, JdbcTransactionDriver::durable());
        assertEq(1, ds.select("read"));
    }

    private nonQueryOutput() {
        DatasourcePool ds = pool();
        SQLStatement stmt(ds);
        stmt.prepare("write");
        stmt.exec();
        assertEq(NOTHING, stmt.getOutput());
        assertThrows("JDBC-RESULTSET-ERROR", \stmt.next());
        assertThrows("JDBC-RESULTSET-ERROR", \stmt.fetchRow());
        assertThrows("JDBC-RESULTSET-ERROR", \stmt.fetchRows());
        assertThrows("JDBC-RESULTSET-ERROR", \stmt.fetchColumns());
        stmt.rollback();
        assertEq(0, JdbcTransactionDriver::durable());
    }

    private openFailure() {
        JdbcTransactionDriver::reset();
        JdbcTransactionDriver::failNext("auto:true");
        assertThrows("JNI-ERROR", "injected auto:true", sub () {
            Datasource ds("jdbc:@qore-transaction-test:fixture");
            ds.open();
        });
        assertEq(("connect", "auto:true", "close"), JdbcTransactionDriver::events());
    }

    private batchCounts() {
        DatasourcePool ds = pool();
        assertEq(3, ds.exec("known %v", (1, 2)));
        assertEq(20100, ds.exec("known %v", 1 .. 200));
        assertEq(-1, ds.exec("unknown %v", (1, 2)));
        assertEq(0, ds.exec("known %v", ()));
        assertThrows("JDBC-BATCH-COUNT-ERROR", sub () { ds.exec("overflow %v", (1, 2)); });
        assertThrows("JDBC-BATCH-COUNT-ERROR", sub () { ds.exec("invalid %v", (1, 2)); });
        ds.rollback();
    }

    private repeatedFailures() {
        DatasourcePool ds = pool();
        for (int i = 0; i < 40; ++i) {
            JdbcTransactionDriver::failNext("execute:write:false");
            assertThrows("JNI-ERROR", "injected execute:write:false", sub () { ds.exec("write"); });
            ds.rollback();
        }
        assertEq(0, JdbcTransactionDriver::durable());
        assertEq(1, ds.select("read"));
    }

    private lostFirstStatement() {
        # the first statement of a transaction: the server rolls the lost attempt back, so it runs once more on the
        # new connection, which keeps the requested transaction
        DatasourcePool ds = pool();
        JdbcTransactionDriver::loseConnectionAt("execute:write:false", True);
        assertEq(1, ds.exec("write"));
        assertEq(2, JdbcTransactionDriver::count("execute:write:false"));
        assertEq(2, JdbcTransactionDriver::count("connect"));
        assertEq(0, JdbcTransactionDriver::durable());
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());

        # execRaw() executes its SQL with a plain java.sql.Statement, which is created again and executed once more
        JdbcTransactionDriver::loseConnectionAt("execute:write:false", True);
        assertEq(1, ds.execRaw("write"));
        assertEq(4, JdbcTransactionDriver::count("execute:write:false"));
        assertEq(3, JdbcTransactionDriver::count("connect"));
        # both executions used a plain Statement
        assertEq(2, JdbcTransactionDriver::count("plain:write"));
        ds.commit();
        assertEq(2, JdbcTransactionDriver::durable());
    }

    private lostFirstPreparedStatement() {
        # a prepared statement starting a transaction is replayed the same way, with its SQL and arguments
        DatasourcePool ds = pool();
        SQLStatement stmt(ds);
        stmt.prepare("write");
        JdbcTransactionDriver::loseConnectionAt("execute:write:false", True);
        stmt.exec();
        assertEq(1, stmt.affectedRows());
        assertEq(2, JdbcTransactionDriver::count("execute:write:false"));
        stmt.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        # the statement stays usable on the new connection
        stmt.exec();
        stmt.commit();
        assertEq(2, JdbcTransactionDriver::durable());
    }

    private lostAutoCommit() {
        # auto-commit mode: the server may have committed the lost attempt, so it never runs twice; the connection
        # is re-established and the error is raised
        JdbcTransactionDriver::reset();
        Datasource auto_ds("jdbc:@qore-transaction-test:fixture");
        auto_ds.setAutoCommit(True);
        JdbcTransactionDriver::loseConnectionAt("execute:write:true", True);
        assertThrows("JNI-ERROR", "injected connection loss", sub () { auto_ds.exec("write"); });
        assertEq(1, JdbcTransactionDriver::count("execute:write:true"));
        assertEq(1, JdbcTransactionDriver::durable());
        assertEq(1, auto_ds.exec("write"));
        assertEq(2, JdbcTransactionDriver::durable());

        # a read outside a transaction also runs in auto-commit mode and is not executed again
        DatasourcePool ds = pool();
        JdbcTransactionDriver::loseConnectionAt("execute:read:true", False);
        assertThrows("JNI-ERROR", "injected connection loss", sub () { ds.select("read"); });
        assertEq(1, JdbcTransactionDriver::count("execute:read:true"));
        assertEq(1, ds.select("read"));
    }

    private lostActiveTransaction() {
        # in an active transaction the earlier work is lost with the session: reported, never replayed
        DatasourcePool ds = pool();
        ds.exec("write");
        JdbcTransactionDriver::loseConnectionAt("execute:write:false", True);
        assertThrows("JDBC-TRANSACTION-ERROR", sub () { ds.exec("write"); });
        assertEq(2, JdbcTransactionDriver::count("execute:write:false"));
        ds.rollback();
        assertEq(0, JdbcTransactionDriver::durable());
        assertEq(1, ds.exec("write"));
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());
    }

    private lostReleasedStatement() {
        # a statement holding the transaction is released when another call on the datasource loses the
        # connection; executed again, it is prepared on the new connection
        JdbcTransactionDriver::reset();
        Datasource single("jdbc:@qore-transaction-test:fixture");
        SQLStatement other(single);
        other.prepare("write");
        other.exec();
        JdbcTransactionDriver::loseConnectionAt("execute:read:false", False);
        assertThrows("JDBC-TRANSACTION-ERROR", sub () { single.select("read"); });
        other.exec();
        assertEq(1, other.affectedRows());
        other.commit();
        # the first write was lost with the transaction; only the second one was committed
        assertEq(1, JdbcTransactionDriver::durable());
        assertEq(2, JdbcTransactionDriver::count("execute:write:false"));
    }

    private lostAtTransactionStart() {
        # the request starting the transaction finds the connection lost: the connection was in auto-commit mode, so
        # no work is pending, and the statement has not been sent, so the transaction is started on a new connection
        # and the statement runs there, once
        DatasourcePool ds = pool();
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        assertEq(1, ds.exec("write"));
        assertEq(("connect", "auto:true", "auto:false", "close", "connect", "auto:false", "execute:write:false",
            "statement.close"), JdbcTransactionDriver::events());
        assertTrue(ds.inTransaction());
        assertEq(0, JdbcTransactionDriver::durable());
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        assertEq(1, ds.select("read"));
        assertFalse(ds.inTransaction());
    }

    private lostAtExplicitTransactionStart() {
        JdbcTransactionDriver::reset();
        Datasource single("jdbc:@qore-transaction-test:fixture");
        single.open();
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        single.beginTransaction();
        assertTrue(single.inTransaction());
        # the transaction is used on the new connection
        assertEq(1, single.select("read"));
        single.execRaw("write");
        assertEq(("connect", "auto:true", "auto:false", "close", "connect", "auto:false", "execute:read:false",
            "statement.close", "plain:write", "execute:write:false", "statement.close"),
            JdbcTransactionDriver::events());
        single.commit();
        assertEq(1, JdbcTransactionDriver::durable());
    }

    private lostAtPreparedTransactionStart() {
        # the statement's JDBC handles belong to the lost connection: they are released, and the statement is
        # prepared again on the new connection with its SQL and arguments
        DatasourcePool ds = pool();
        SQLStatement stmt(ds);
        stmt.prepare("write");
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        stmt.exec();
        assertEq(1, stmt.affectedRows());
        assertEq(("connect", "auto:true", "auto:false", "statement.close", "close", "connect", "auto:false",
            "execute:write:false"), JdbcTransactionDriver::events());
        assertEq(0, JdbcTransactionDriver::durable());
        stmt.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        # the statement stays usable on the new connection
        stmt.exec();
        stmt.commit();
        assertEq(2, JdbcTransactionDriver::durable());
        assertEq(2, JdbcTransactionDriver::count("connect"));
    }

    private lostAtTransactionStartAndExecution() {
        # the new connection is lost again when the statement is executed: the replay rule applies (the attempt ran
        # in the transaction, which the server rolls back), so the statement is executed once more, once
        DatasourcePool ds = pool();
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        JdbcTransactionDriver::loseConnectionAt("execute:write:false", True);
        assertEq(1, ds.exec("write"));
        assertEq(2, JdbcTransactionDriver::count("execute:write:false"));
        assertEq(3, JdbcTransactionDriver::count("connect"));
        assertEq(0, JdbcTransactionDriver::durable());
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());
    }

    private lostAtTransactionStartReconnectFails() {
        # the new connection cannot be established: the lost connection's error is raised, followed by the
        # reconnection error; the statement is not executed and the next call uses a new connection
        DatasourcePool ds = pool();
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        JdbcTransactionDriver::failNext("connect");
        assertErrorChain(sub () { ds.exec("write"); }, ("injected connection loss", "injected connect"));
        assertFalse(ds.inTransaction());
        assertEq(0, JdbcTransactionDriver::count("execute:write:false"));
        assertEq(1, ds.exec("write"));
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        assertEq(1, JdbcTransactionDriver::count("execute:write:false"));
    }

    private lostAtTransactionStartCleanupFails() {
        # releasing the handles of a statement of the lost connection fails: the errors are raised, the statement is
        # not executed and the connection is discarded
        DatasourcePool ds = pool();
        SQLStatement stmt(ds);
        stmt.prepare("write");
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        JdbcTransactionDriver::failNext("statement.close");
        assertErrorChain(\stmt.exec(), ("injected connection loss", "injected statement.close"));
        assertEq(0, JdbcTransactionDriver::count("execute:write:false"));
        assertEq(1, JdbcTransactionDriver::count("connect"));
        assertEq(0, JdbcTransactionDriver::durable());
        stmt.exec();
        stmt.commit();
        assertEq(1, JdbcTransactionDriver::durable());
        assertEq(1, JdbcTransactionDriver::count("execute:write:false"));
    }

    private lostValidityCheckFails() {
        # the connection is lost only if it is reported invalid; if the check itself fails, the original error is
        # raised, followed by the error of the check, and nothing is executed again
        DatasourcePool ds = pool();
        JdbcTransactionDriver::loseConnectionAt("auto:false", False);
        JdbcTransactionDriver::failNext("isValid");
        assertErrorChain(sub () { ds.exec("write"); }, ("injected connection loss", "injected isValid"));
        assertEq(0, JdbcTransactionDriver::count("execute:write:false"));
        assertEq(1, JdbcTransactionDriver::count("connect"));
        assertEq(1, ds.exec("write"));
        ds.commit();
        assertEq(1, JdbcTransactionDriver::durable());

        # the same for a statement lost when it is executed
        JdbcTransactionDriver::loseConnectionAt("execute:write:false", True);
        JdbcTransactionDriver::failNext("isValid");
        assertErrorChain(sub () { ds.exec("write"); }, ("injected connection loss", "injected isValid"));
        assertEq(2, JdbcTransactionDriver::count("execute:write:false"));
        ds.rollback();
        assertEq(1, JdbcTransactionDriver::durable());
    }

    #! asserts that the call raises exactly the given chain of JNI-ERROR exceptions, in order
    /** @param call the call that must raise the errors
        @param descs a regular expression for the description of each error
    */
    private assertErrorChain(code call, list<string> descs) {
        *hash<ExceptionInfo> ex;
        # only the call is in the try block, so that a failed assertion is not caught as the expected error
        try {
            call();
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        foreach string desc in (descs) {
            assertEq("JNI-ERROR", ex.err, desc);
            assertRegex(desc, ex.desc);
            ex = ex.next;
        }
        assertNothing(ex, "no further errors");
    }

    private cursorLifetime() {
        DatasourcePool ds = pool();
        assertEq(({"id": 11}, {"id": 22}), JdbcCursorTest::readRows(ds, "multi:rs=id:11,22"));
        assertEq((), JdbcCursorTest::readRows(ds, "multi:rs=id:"));
        assertFalse(ds.inTransaction());
    }
}
