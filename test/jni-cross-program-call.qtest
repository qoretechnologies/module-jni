#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires jni
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.SandboxIo
%module-cmd(jni) import org.qore.jni.test.CrossProgramCalls
%module-cmd(jni) import java.lang.reflect.Method
%module-cmd(jni) import java.util.ArrayList
%module-cmd(jni) import java.util.function.Consumer
%requires QUnit
%requires Util

%exec-class JniCrossProgramCallTest

#! the source of the Program that owns the Java objects of the tests
const OwnerSource = "
%requires jni
%module-cmd(jni) import java.util.ArrayList
%module-cmd(jni) import java.util.function.Consumer
%module-cmd(jni) import org.qore.jni.test.CrossProgramCalls
%module-cmd(jni) import org.qore.jni.test.CrossProgramStatic

# a top-level variable: thread-local, and closure-bound in the functions that use it
string tl = \"owner\";
our list<auto> seen = ();

sub read_tl() {
    seen += tl;
    tl = \"written by the callback\";
}

# the policy answers in the code that Java calls back, and a closure created there that is called later
our Queue probes();
sub probe() {
    probes.push({
        \"isSandboxed\": SandboxManager::isSandboxed(),
        \"isGoverned\": SandboxManager::isGoverned(),
        \"later\": bool sub () { return SandboxManager::isSandboxed(); },
    });
}

object sub make_list(int n = 1) {
    ArrayList l();
    for (int i = 0; i < n; ++i) {
        l.add(\"x\");
    }
    return l;
}

object sub make_consumer(string what) {
    code c = what == \"tl\" ? sub () { read_tl(); } : \\probe();
    return cast<Consumer>(implement_interface(new QoreInvocationHandler(
        sub (object method, *list<auto> args) { c(); }), load_class(\"java/util/function/Consumer\")));
}

# a Java closure (a QoreClosureMarker object) created in this Program, which calls back the given code of this Program
code sub make_java_closure(string what) {
    code c = what == \"tl\" ? sub () { read_tl(); } : \\probe();
    return CrossProgramCalls::makeForwarder(c);
}

# a Java closure created in this Program that returns QoreSandbox.isSandboxed() for the code that calls it
code sub make_sandbox_query() {
    return CrossProgramCalls::makeSandboxQuery();
}

# a Consumer whose callback makes a cross-Program Java call of its own (l2.forEach(c2) on objects of another
# Program), and then reads and writes this Program's top-level variable
object sub make_nested_consumer(object l2, object c2) {
    return cast<Consumer>(implement_interface(new QoreInvocationHandler(
        sub (object method, *list<auto> args) {
            l2.forEach(c2);
            read_tl();
        }), load_class(\"java/util/function/Consumer\")));
}

# a Consumer whose callback only sets the given marker, which belongs to the test, not to this Program
object sub make_marked_consumer(Queue ran) {
    return cast<Consumer>(implement_interface(new QoreInvocationHandler(
        sub (object method, *list<auto> args) { ran.push(True); }), load_class(\"java/util/function/Consumer\")));
}

# an object of a Java class that this Program loaded
object sub make_calls_object() {
    return new CrossProgramCalls();
}

# a child Program, which inherits the Java class that only this Program imports: its static method, called by the
# child's code, belongs to this Program
Program sub make_static_caller() {
    Program child(PO_NEW_STYLE);
    child.parse(\"int sub call_answer() { return CrossProgramStatic::answer(); }\", \"static-caller\");
    return child;
}

# a call of the Java method made by the owner itself
sub own_call(object l, object c) {
    l.forEach(c);
}

int sub own_size_loop(object l, int n) {
    int s;
    for (int i = 0; i < n; ++i) {
        s += l.size();
    }
    return s;
}

auto sub call_code(code c) {
    return c();
}

list<auto> sub get_seen() {
    return seen;
}

code sub get_tl_ref() {
    return \\get_tl();
}

*string sub get_tl() {
    return tl;
}

sub reset() {
    seen = ();
    tl = \"owner\";
}

hash<auto> sub get_probe() {
    return probes.get();
}

# a global object whose destructor blocks the Program's teardown until the test releases it
class Blocker {
    private {
        Queue events;
        Queue release;
    }

    constructor(Queue events, Queue release) {
        self.events = events;
        self.release = release;
    }

    destructor() {
        events.push(\"entered\");
        release.get();
    }
}

our *Blocker blocker;
sub set_blocker(Queue events, Queue release) {
    blocker = new Blocker(events, release);
}
";

#! the source of a Program that calls the Java methods of the owner's objects
const CallerSource = "
string tl = \"caller\";

sub call_via_java(object l, object c) {
    l.forEach(c);
}

*string sub get_tl() {
    return tl;
}

auto sub call_code(code c) {
    return c();
}

*string sub accept_catching(object c) {
    return CrossProgramCalls::acceptCatching(c);
}

*string sub accept_catching_on_java_thread(object c) {
    return CrossProgramCalls::acceptCatchingOnJavaThread(c);
}
";

#! the source of a sandboxed Program that calls the Java methods of trusted objects
const SandboxedSource = "
sub call_via_java(object l, object c) {
    l.forEach(c);
}
bool sub query_static() {
    return SandboxIo::isSandboxed();
}
bool sub query_via_method(object m) {
    return m.invoke(NOTHING);
}
object sub capture_static() {
    return SandboxIo::capture();
}
object sub capture_via_method(object m) {
    return m.invoke(NOTHING);
}
sub check_file_static(string path) {
    SandboxIo::checkFile(path, False);
}
sub check_file_via_method(object m, string path) {
    m.invoke(NOTHING, path, False);
}
auto sub call_code(code c) {
    return c();
}
";

#! Java instance methods of an object of another Program run in that Program (qore#6183, qore#6185)
/** A Java instance call enters the object's Program like any other call into a Program: Qore code that Java calls
    back during the call sees the thread-local data of its own Program, the calling code stays visible to the
    sandbox, and the Program's entry handler runs for the call
*/
class JniCrossProgramCallTest inherits QUnit::Test {
    constructor() : QUnit::Test("JNI cross-Program instance calls", "1.0", \ARGV) {
        addTestCase("a callback reads and writes the owner's thread-local variables", \testThreadLocal());
        addTestCase("a callback on a background thread uses the owner's thread-local data", \testThreadLocalThread());
        addTestCase("a callback is governed by the sandbox of the caller", \testSandboxedCallback());
        addTestCase("the default sandbox refuses the Java method", \testDefaultSandbox());
        addTestCase("Java's sandbox query sees the caller's sandbox", \testJavaQuery());
        addTestCase("Java's file check applies the caller's policy", \testJavaFileCheck());
        addTestCase("the owner's entry handler runs once per cross-Program call", \testEntryHandler());
        addTestCase("an exception from the entry handler stops the Java call", \testEntryHandlerException());
        addTestCase("a Java exception leaves the owner's Program", \testJavaException());
        addTestCase("an exception from the exit handler reaches the caller", \testExitHandlerException());
        addTestCase("an object whose Program was deleted stays callable", \testDeletedProgram());
        addTestCase("an object whose Program is being torn down cannot be called", \testTornDownProgram());
        addTestCase("the owner deleted in the jni context lookup of a call", \testDeleteInContextLookup());
        addTestCase("deleting the owner waits for a Java call in progress", \testDeleteWaitsForCall());
        addTestCase("an owner being parsed by another thread cannot be called", \testParsingProgram());
        addTestCase("the owner's thread initialization code runs on a thread's first call", \testThreadInit());
        addTestCase("a call from a Java thread uses the owner's thread-local data", \testJavaThread());
        addTestCase("an owner with a sandbox of its own", \testSandboxedOwner());
        addTestCase("a nested cross-Program call from a callback", \testNestedCall());
        addTestCase("a Java closure uses the thread-local data of its Program", \testJavaClosureThreadLocal());
        addTestCase("a Java closure is governed by the sandbox of its caller", \testJavaClosureSandbox());
        addTestCase("a Java closure whose Program was deleted stays callable", \testJavaClosureDeletedProgram());
        addTestCase("a callback whose Program was deleted is refused", \testDeletedProgramCallback());
        addTestCase("a static method of an inherited class enters only the class's Program",
            \testStaticMethodEntersProgram());
        addTestCase("a static method of a deleted Program's class", \testStaticMethodDeletedProgram());
        addTestCase("a Java closure sets the thread's Java context after a cross-Program call",
            \testJavaContextRestored());
        addTestCase("a Java closure sets the thread's Java context after a Program-loaded class's method",
            \testJavaContextRestoredLoadedClass());
        addTestCase("a callback's Program deleted before its entry", \testCallbackDeleteBeforeEntry());
        addTestCase("a Java thread's context is restored after a cross-Program call",
            \testJavaThreadContextRestored());
        addTestCase("the owner deleted before the entry of a call", \testDeleteBeforeEntry());
        set_return_value(main());
    }

    #! returns a new owner Program
    private Program getOwner(int opts = PO_NEW_STYLE) {
        Program owner(opts);
        owner.parse(OwnerSource, "owner");
        owner.run();
        return owner;
    }

    #! returns a new caller Program
    private Program getCaller() {
        Program caller(PO_NEW_STYLE);
        caller.parse(CallerSource, "caller");
        caller.run();
        return caller;
    }

    #! returns True if the core can allow uncontrolled APIs to a sandbox and refuses them at run time (qore#5741)
    private bool hasUncontrolledApiPolicy() {
        return (new SandboxManager()).hasCallableMethod("setUncontrolledApiPolicy");
    }

    #! returns a sandboxed Program that may use uncontrolled APIs, or skips the test on a core without the policy
    private Program getSandboxed(*code setup) {
        if (!hasUncontrolledApiPolicy()) {
            testSkip("the core has no uncontrolled API policy for sandboxes (qore#5741)");
        }
        SandboxManager sm();
        call_object_method(sm, "setUncontrolledApiPolicy", True);
        if (setup) {
            setup(sm);
        }
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm);
        p.parse(SandboxedSource, "sandboxed");
        return p;
    }

    #! Returns True if a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem or the network
    #! refuses Java code (qore#7832)
    private static bool sandboxClassesRefused() {
        return get_module_hash().jni.info.sandbox_uncontrolled_api_classes ?? False;
    }

    #! returns a sandboxed Program that may use uncontrolled APIs and whose sandbox allows all I/O
    /** with qore#7832, a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem or the
        network (as a new SandboxManager does) refuses Java code; the test cases whose subject is which sandbox governs
        the code, not what it restricts, use this sandbox with the feature
    */
    private Program getSandboxedAllowAll() {
        return getSandboxed(sub (SandboxManager sm) {
            sm.setFilesystemDefaultPolicy(True);
            sm.setNetworkDefaultPolicy(True);
        });
    }

    #! returns the sandboxed Program of the test cases whose subject is which sandbox governs the code
    /** with qore#7832, asserts first that the sandbox of getSandboxed(), which restricts the filesystem and the
        network, refuses the Java method that the function calls with the arguments, and returns a Program whose
        sandbox allows all I/O
    */
    private Program getGovernedSandboxed(string func, softlist<auto> args, string method) {
        Program sandboxed = getSandboxed();
        if (!sandboxClassesRefused()) {
            return sandboxed;
        }
        assertThrows("INVALID-FUNCTION-ACCESS", "restricts FILESYSTEM.*NETWORK.*" + method + ".*qore#7832",
            \sandboxed.callFunction(), (func,) + args, "qore#7832: a sandbox that restricts I/O refuses " + method);
        return getSandboxedAllowAll();
    }

    testThreadLocal() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "tl");

        # control: the owner calls the Java method
        owner.callFunction("own_call", l, c);
        assertEq(("owner",), owner.callFunction("get_seen"));
        assertEq("written by the callback", owner.callFunction("get_tl"));
        owner.callFunction("reset");

        # another Program calls the same Java method, twice
        caller.callFunction("call_via_java", l, c);
        caller.callFunction("call_via_java", l, c);
        assertEq(("owner", "written by the callback"), owner.callFunction("get_seen"),
            "the callback reads the owner's variable");
        assertEq("written by the callback", owner.callFunction("get_tl"), "the write reaches the owner");
        assertEq("caller", caller.callFunction("get_tl"), "the caller's variable is not changed");

        # this Program calls it
        owner.callFunction("reset");
        l.forEach(c);
        assertEq(("owner",), owner.callFunction("get_seen"), "a call from the test's Program");
        assertEq("written by the callback", owner.callFunction("get_tl"));
    }

    testThreadLocalThread() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "tl");

        # on a new thread, the thread-local variables of each Program are its own for the thread
        Queue q();
        background sub () {
            try {
                caller.callFunction("call_via_java", l, c);
                caller.callFunction("call_via_java", l, c);
                q.push({
                    "seen": owner.callFunction("get_seen"),
                    "owner_tl": owner.callFunction("get_tl"),
                    "caller_tl": caller.callFunction("get_tl"),
                });
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        hash<auto> h = q.get();
        assertEq(NOTHING, h.err, "no exception: " + (h.err ? sprintf("%s: %s", h.err, h.desc) : ""));
        assertEq((NOTHING, "written by the callback"), h.seen, "the second callback reads the first one's write");
        assertEq("written by the callback", h.owner_tl, "the write reaches the owner's data of the thread");
        assertEq(NOTHING, h.caller_tl, "the caller's data of the thread is not changed");

        # the owner's data of this thread is not changed
        assertEq("owner", owner.callFunction("get_tl"));
    }

    testSandboxedCallback() {
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "probe");
        Program sandboxed = getGovernedSandboxed("call_via_java", (l, c), "ArrayList::forEach");

        sandboxed.callFunction("call_via_java", l, c);
        hash<auto> h = owner.callFunction("get_probe");
        assertTrue(h.isSandboxed, "isSandboxed() in the callback");
        assertTrue(h.isGoverned, "isGoverned() in the callback");
        assertTrue(h.later(), "a closure created in the callback keeps the sandbox");

        # control: the owner calls the Java method
        owner.callFunction("own_call", l, c);
        h = owner.callFunction("get_probe");
        assertFalse(h.isSandboxed, "isSandboxed() in the owner's call");
        assertFalse(h.isGoverned, "isGoverned() in the owner's call");
        assertFalse(h.later(), "a closure created in the owner's call");
    }

    testDefaultSandbox() {
        if (!hasUncontrolledApiPolicy()) {
            testSkip("the core has no uncontrolled API policy for sandboxes (qore#5741)");
        }
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "probe");
        Program sandboxed(PO_NEW_STYLE);
        sandboxed.setSandboxManager(new SandboxManager());
        sandboxed.parse(SandboxedSource, "sandboxed");
        assertThrows("INVALID-FUNCTION-ACCESS", "uncontrolled API method",
            \sandboxed.callFunction(), ("call_via_java", l, c));
    }

    testJavaQuery() {
        Program sandboxed = getGovernedSandboxed("query_static", (), "SandboxIo::isSandboxed");
        Method is_sandboxed = load_class("org.qore.jni.test.SandboxIo").getMethod("isSandboxed");
        Method capture = load_class("org.qore.jni.test.SandboxIo").getMethod("capture");

        assertFalse(is_sandboxed.invoke(NOTHING), "trusted");
        assertTrue(sandboxed.callFunction("query_static"), "static: no Program switch");
        assertTrue(sandboxed.callFunction("query_via_method", is_sandboxed), "an instance call of a trusted object");

        foreach string f in ("capture_static", "capture_via_method") {
            object policy = f == "capture_static"
                ? sandboxed.callFunction(f)
                : sandboxed.callFunction(f, capture);
            on_exit policy.close();
            # trusted code uses the Policy that the sandboxed call captured
            assertTrue(policy.isSandboxed(), f);
        }
    }

    testJavaFileCheck() {
        Program sandboxed = getSandboxed(sub (SandboxManager sm) { sm.setFilesystemDefaultPolicy(False); });
        Method check_file;
        foreach Method m in (load_class("org.qore.jni.test.SandboxIo").getMethods()) {
            if (m.getName() == "checkFile") {
                check_file = m;
                break;
            }
        }
        assertEq("checkFile", check_file.getName());
        # only the policy answer: the check does no I/O
        string path = tmp_location() + DirSep + "jni-cross-program-call-denied";
        if (sandboxClassesRefused()) {
            # qore#7832: a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem refuses
            # Java code, so Java's file check cannot be reached from the sandboxed code; a sandbox that does not
            # restrict the filesystem would have no policy to apply
            assertThrows("INVALID-FUNCTION-ACCESS", "restricts FILESYSTEM.*SandboxIo::checkFile.*qore#7832",
                \sandboxed.callFunction(), ("check_file_static", path), "static");
            assertThrows("INVALID-FUNCTION-ACCESS", "restricts FILESYSTEM.*Method::invoke.*qore#7832",
                \sandboxed.callFunction(), ("check_file_via_method", check_file, path), "an instance call");
            testSkip("qore#7832: the sandbox that restricts the filesystem refuses Java code, so Java's file check "
                "cannot apply its policy");
        }
        assertThrows("FILESYSTEM-ACCESS-DENIED", \sandboxed.callFunction(), ("check_file_static", path), "static");
        string err;
        try {
            sandboxed.callFunction("check_file_via_method", check_file, path);
        } catch (hash<ExceptionInfo> ex) {
            # the exception raised by the invoked method, or Method.invoke()'s wrapper of it
            err = ex.err;
            for (*hash<ExceptionInfo> e = ex; e; e = e.next) {
                if (e.err == "FILESYSTEM-ACCESS-DENIED" || e.desc =~ /FILESYSTEM-ACCESS-DENIED/) {
                    err = "FILESYSTEM-ACCESS-DENIED";
                    break;
                }
            }
        }
        assertEq("FILESYSTEM-ACCESS-DENIED", err, "an instance call of a trusted object");
    }

    testEntryHandler() {
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        Counter entries();
        owner.setThreadEntryHandler(sub () { entries.inc(); });
        on_exit owner.setThreadEntryHandler();

        assertEq(1, l.size());
        assertEq(1, entries.getCount(), "a cross-Program call enters the owner");
        for (int i = 0; i < 5; ++i) {
            l.size();
        }
        assertEq(6, entries.getCount(), "once per call");

        # calls within the owner do not enter it again
        assertEq(10, owner.callFunction("own_size_loop", l, 10));
        assertEq(7, entries.getCount(), "the owner's own calls");

        # a callback made during a cross-Program call is not another entry
        object c = owner.callFunction("make_consumer", "tl");
        object l3 = owner.callFunction("make_list", 3);
        Program caller = getCaller();
        int before = entries.getCount();
        caller.callFunction("call_via_java", l3, c);
        assertEq(before + 1, entries.getCount(), "one entry for a call with three callbacks");
    }

    testEntryHandlerException() {
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        bool fail_entry = True;
        owner.setThreadEntryHandler(sub () {
            if (fail_entry) {
                throw "ENTRY-ERROR", "entry refused";
            }
        });
        on_exit owner.setThreadEntryHandler();

        assertThrows("ENTRY-ERROR", "entry refused", sub () { l.add("y"); });
        fail_entry = False;
        assertEq(1, l.size(), "the Java method did not run");
    }

    testJavaException() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "tl");
        Counter entries();
        Counter exits();
        owner.setThreadEntryHandler(sub () { entries.inc(); }, sub (auto v) { exits.inc(); });
        on_exit owner.setThreadEntryHandler();

        # a Java exception raised in a cross-Program call leaves the owner's Program
        assertThrows("JNI-ERROR", "IndexOutOfBoundsException", sub () { l.get(5); }, NOTHING,
            "the Java exception reaches the caller");
        assertEq(1, entries.getCount(), "the call entered the owner");
        assertEq(1, exits.getCount(), "the owner was left");

        # the thread's context is restored: a later cross-Program call still sees the owner's data
        owner.callFunction("reset");
        caller.callFunction("call_via_java", l, c);
        assertEq(("owner",), owner.callFunction("get_seen"));
        assertEq("caller", caller.callFunction("get_tl"));
        assertEq(entries.getCount(), exits.getCount(), "each entry is left");
    }

    testExitHandlerException() {
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        bool fail_exit = True;
        owner.setThreadEntryHandler(NOTHING, sub (auto v) {
            if (fail_exit) {
                throw "EXIT-ERROR", "exit failed";
            }
        });
        on_exit owner.setThreadEntryHandler();

        # the exit handler runs after the Java method, and its exception reaches the caller
        assertThrows("EXIT-ERROR", "exit failed", sub () { l.add("y"); });
        fail_exit = False;
        assertEq(2, l.size(), "the Java method ran");
    }

    testDeletedProgram() {
        Program p = getOwner();
        object l = p.callFunction("make_list");
        delete p;
        # the deleted Program has no jni context any more, so the call runs in the context of the calling Program
        # (jni_get_context()) and does not enter the deleted Program
        assertEq(1, l.size());
        l.add("y");
        assertEq(2, l.size());
    }

    testTornDownProgram() {
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        # the destructor of the owner's global object reports here that the teardown has started, and the thread
        # deleting the owner reports here if the deletion failed before
        Queue events();
        Queue release();
        owner.callFunction("set_blocker", events, release);

        Queue done();
        background sub () {
            try {
                delete owner;
                done.push(True);
            } catch (hash<ExceptionInfo> ex) {
                events.push(ex);
                done.push(ex);
            }
        }();
        on_exit release.push(True);
        auto event = events.get();
        assertEq("entered", event, "the teardown runs the destructor of the owner's global object");
        if (event == "entered") {
            assertThrows("PROGRAM-ERROR", sub () { l.size(); });
            release.push(True);
            assertEq(True, done.get());
        }
    }

    #! returns True if the jni module is a debug build with the context gate
    private bool hasContextGate() {
        try {
            call_function("Jni::org::qore::jni::dbg_jni_set_context_gate");
            return True;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "NO-FUNCTION") {
                rethrow;
            }
            return False;
        }
    }

    #! sets or clears the one-shot gate run at the given point of a call ("lookup": between the lookup of a jni
    #! context and its use; "entry": between the check that a Program has jni data and the entry into it)
    private setContextGate(*code c, string point = "lookup") {
        call_function("Jni::org::qore::jni::dbg_jni_set_context_gate", c, point);
    }

    testDeleteInContextLookup() {
        if (!hasContextGate()) {
            testSkip("the jni module's context gate requires a debug build");
        }
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        bool deleted;
        # the owner is deleted on this thread exactly after the jni context of the call has been looked up: the
        # call holds the owner then, so its data is destroyed only when the call has left it
        setContextGate(sub () {
            delete owner;
            deleted = True;
        });
        on_exit setContextGate();
        assertEq(1, l.size(), "the call completes");
        assertTrue(deleted, "the gate ran in the call");
        # the owner is deleted: the object is called in the context of this Program
        assertEq(1, l.size(), "a call after the deletion");
    }

    testDeleteWaitsForCall() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list", 2);
        Queue events();
        # the first callback of the Java call starts the deletion of the owner on another thread, and waits until
        # that thread has started it; the second callback then still uses the owner's code and data, and the
        # deletion cannot have finished, as this thread is still in the owner
        # a call reference to the owner's function, which the deletion does not clear
        code get_tl = owner.callFunction("get_tl_ref");
        bool started;
        *string tl_in_call;
        bool finished_in_call;
        object each = cast<Consumer>(implement_interface(new QoreInvocationHandler(
            sub (object method, *list<auto> args) {
                if (!started) {
                    started = True;
                    background sub () {
                        events.push("deleting");
                        delete owner;
                        events.push("deleted");
                    }();
                    assertEq("deleting", events.get(), "the deletion has started");
                } else {
                    tl_in_call = get_tl();
                    finished_in_call = !events.empty();
                }
            }), load_class("java/util/function/Consumer")));
        caller.callFunction("call_via_java", l, each);
        assertEq("owner", tl_in_call, "the owner's data is intact during the call");
        assertFalse(finished_in_call, "the deletion had not finished during the Java call");
        assertEq("deleted", events.get(), "the deletion finishes after the call");
    }

    testParsingProgram() {
        Program owner = getOwner(PO_NEW_STYLE | PO_ALLOW_REPARSE);
        object l = owner.callFunction("make_list");
        Queue parsing();
        Queue release();
        Queue done();
        background sub () {
            try {
                # the parsed code is pending until it is committed: the Program is being parsed meanwhile
                owner.parsePending("sub added() {}", "pending");
                parsing.push(True);
                release.get();
                owner.parseCommit();
                done.push(True);
            } catch (hash<ExceptionInfo> ex) {
                parsing.push(ex);
                done.push(ex);
            }
        }();
        on_exit release.push(True);
        auto p = parsing.get();
        assertEq(True, p, "the parse is pending");
        if (p === True) {
            assertThrows("PROGRAM-ERROR", "parsing", sub () { l.size(); });
            release.push(True);
            assertEq(True, done.get(), "the parse is committed");
            assertEq(1, l.size(), "the call after the parse");
        }
    }

    testThreadInit() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list");
        Counter inits();
        owner.setThreadInit(sub () { inits.inc(); });
        Queue q();
        background sub () {
            try {
                l.size();
                int first = inits.getCount();
                l.size();
                caller.callFunction("call_code", int sub () { return l.size(); });
                q.push((first, inits.getCount()));
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        assertEq((1, 1), q.get(), "the thread initialization code runs once, on the thread's first call");
    }

    testJavaThread() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "tl");
        # a Java thread that Qore did not start makes the calls: the owner's data on that thread is its own
        hash<auto> h = SandboxIo::callOnJavaThread(hash<auto> sub () {
            caller.callFunction("call_via_java", l, c);
            caller.callFunction("call_via_java", l, c);
            return {
                "seen": owner.callFunction("get_seen"),
                "owner_tl": owner.callFunction("get_tl"),
                "caller_tl": caller.callFunction("get_tl"),
            };
        });
        assertEq((NOTHING, "written by the callback"), h.seen, "the second callback reads the first one's write");
        assertEq("written by the callback", h.owner_tl, "the write reaches the owner's data of the Java thread");
        assertEq(NOTHING, h.caller_tl, "the caller's data of the Java thread is not changed");
        assertEq("owner", owner.callFunction("get_tl"), "the owner's data of this thread is not changed");
    }

    testSandboxedOwner() {
        if (!hasUncontrolledApiPolicy()) {
            testSkip("the core has no uncontrolled API policy for sandboxes (qore#5741)");
        }
        SandboxManager sm();
        call_object_method(sm, "setUncontrolledApiPolicy", True);
        if (sandboxClassesRefused()) {
            # qore#7832: a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem or the
            # network (as a new SandboxManager does) refuses Java code, also the owner's module commands; the
            # subject of the case is that the owner's sandbox governs its callbacks, so its I/O policy is opened
            Program refused(PO_NEW_STYLE);
            refused.setSandboxManager(sm);
            assertThrows("JNI-SANDBOX-ERROR", "\"import\" module command.*0x200000000000", \refused.parse(),
                (OwnerSource, "sandboxed-owner"), "qore#7832: an owner whose sandbox restricts I/O");
            sm = new SandboxManager();
            call_object_method(sm, "setUncontrolledApiPolicy", True);
            sm.setFilesystemDefaultPolicy(True);
            sm.setNetworkDefaultPolicy(True);
        }
        Program owner(PO_NEW_STYLE);
        owner.setSandboxManager(sm);
        owner.parse(OwnerSource, "sandboxed-owner");
        owner.run();
        object l = owner.callFunction("make_list");
        object c = owner.callFunction("make_consumer", "probe");
        Program caller = getCaller();

        # trusted code calls the Java method of an object of the sandboxed owner: the owner's code that Java calls
        # back is governed by the owner's sandbox
        caller.callFunction("call_via_java", l, c);
        hash<auto> h = owner.callFunction("get_probe");
        assertTrue(h.isSandboxed, "isSandboxed() in the owner's callback");
        assertTrue(h.isGoverned, "isGoverned() in the owner's callback");
        assertTrue(h.later(), "a closure created in the owner's callback");

        # the owner's thread-local data is used as for a trusted owner
        object t = owner.callFunction("make_consumer", "tl");
        caller.callFunction("call_via_java", l, t);
        assertEq(("owner",), owner.callFunction("get_seen"));
        assertEq("caller", caller.callFunction("get_tl"));
    }

    testNestedCall() {
        Program a = getOwner();
        Program b = getOwner();
        Program caller = getCaller();
        # b's list and callback, called from a callback of a's Java call
        object lb = b.callFunction("make_list");
        object cb = b.callFunction("make_consumer", "tl");
        object la = a.callFunction("make_list");
        object ca = a.callFunction("make_nested_consumer", lb, cb);

        caller.callFunction("call_via_java", la, ca);
        assertEq(("owner",), b.callFunction("get_seen"), "the nested callback reads its own Program's data");
        assertEq("written by the callback", b.callFunction("get_tl"));
        assertEq(("owner",), a.callFunction("get_seen"), "after the nested call, the outer callback reads its data");
        assertEq("written by the callback", a.callFunction("get_tl"));
        assertEq("caller", caller.callFunction("get_tl"), "the caller's data is not changed");
    }

    testJavaClosureThreadLocal() {
        Program owner = getOwner();
        Program caller = getCaller();
        code jc = owner.callFunction("make_java_closure", "tl");

        # control: the owner calls the Java closure
        owner.callFunction("call_code", jc);
        assertEq(("owner",), owner.callFunction("get_seen"));
        owner.callFunction("reset");

        # another Program calls the Java closure, twice
        caller.callFunction("call_code", jc);
        caller.callFunction("call_code", jc);
        assertEq(("owner", "written by the callback"), owner.callFunction("get_seen"),
            "the callback reads the owner's variable");
        assertEq("written by the callback", owner.callFunction("get_tl"), "the write reaches the owner");
        assertEq("caller", caller.callFunction("get_tl"), "the caller's variable is not changed");
    }

    testJavaClosureSandbox() {
        Program sandboxed = getSandboxed();
        Program owner = getOwner();
        code query = owner.callFunction("make_sandbox_query");
        code jc = owner.callFunction("make_java_closure", "probe");

        if (sandboxClassesRefused()) {
            # qore#7832: a Java object used as a Qore closure runs Java code, which the sandbox that restricts the
            # filesystem and the network refuses to the code that it governs, as it refuses its Java method calls
            foreach code c in (query, jc) {
                assertThrows("JNI-SANDBOX-ERROR", "sandboxed code cannot call a Java object used as a Qore closure.*"
                    "restricts the filesystem or the network", \sandboxed.callFunction(), ("call_code", c),
                    "qore#7832: a sandbox that restricts I/O refuses the Java closure");
            }
            # the subject is which sandbox governs the code that the Java closure calls back: a sandbox that trusts the
            # code and allows all I/O
            sandboxed = getSandboxedAllowAll();
        }

        assertFalse(owner.callFunction("call_code", query), "Java's query for the owner's own call");
        assertTrue(sandboxed.callFunction("call_code", query), "Java's query for a sandboxed caller");

        sandboxed.callFunction("call_code", jc);
        hash<auto> h = owner.callFunction("get_probe");
        assertTrue(h.isSandboxed, "isSandboxed() in the owner's code called back by the Java closure");
        assertTrue(h.later(), "a closure created there keeps the sandbox");
    }

    testJavaClosureDeletedProgram() {
        Program owner = getOwner();
        code query = owner.callFunction("make_sandbox_query");
        delete owner;
        # the Program that created the Java closure is gone: the closure is called in the context of this Program
        assertFalse(query(), "the Java closure runs for this Program");
        assertFalse(query(), "a second call");
    }

    testDeletedProgramCallback() {
        Program owner = getOwner();
        Program caller = getCaller();
        # the marker that the callback's body would set: it belongs to the test, so it outlives the owner
        Queue ran();
        object c = owner.callFunction("make_marked_consumer", ran);

        # control: while the owner exists, the same calls reach the callback, whose body runs once for each
        assertEq(NOTHING, caller.callFunction("accept_catching", c), "no exception in Java for the calling Program");
        assertEq(NOTHING, caller.callFunction("accept_catching_on_java_thread", c),
            "no exception in Java on a Java thread");
        assertEq(2, ran.size(), "the callback's body ran once for each call");
        ran.clear();

        # the Java proxy outlives the Program whose code it calls back
        delete owner;

        # Java calls the proxy for another Program, and on a Java thread that Qore did not start: the callback's
        # Program has been deleted, so Java sees the PROGRAM-ERROR of the call of its code, which does not run
        string expected = "^org\\.qore\\.jni\\.QoreExceptionWrapper: PROGRAM-ERROR: .*has already been deleted";
        *string from_caller = caller.callFunction("accept_catching", c);
        assertRegex(expected, from_caller ?? "<no exception>", "Java's exception for the calling Program");
        *string from_java_thread = caller.callFunction("accept_catching_on_java_thread", c);
        assertRegex(expected, from_java_thread ?? "<no exception>", "Java's exception on a Java thread");
        assertTrue(ran.empty(), "the callback's body did not run");
    }

    testStaticMethodEntersProgram() {
        Program owner = getOwner();
        # the child's own code calls a static method of a Java class that the owner's code defined, which the child
        # inherited
        Program child = owner.callFunction("make_static_caller");
        Counter owner_entries();
        owner.setThreadEntryHandler(sub () { owner_entries.inc(); });
        on_exit owner.setThreadEntryHandler();
        Counter child_entries();
        child.setThreadEntryHandler(sub () { child_entries.inc(); });
        on_exit child.setThreadEntryHandler();
        assertEq(42, child.callFunction("call_answer"));
        # Qore enters the class's source Program for the static method; the child, which the thread is already in for
        # the call of its function, is not entered again
        assertEq(1, owner_entries.getCount(), "the static method call entered the class's Program once");
        assertEq(1, child_entries.getCount(), "the child was entered once, for the call of its function");

        # the thread's Java context is restored after the call: a Java-to-Qore call on this thread does not go
        # through the owner
        code forward = CrossProgramCalls::makeForwarder(string sub () { return "called back"; });
        assertEq("called back", forward());
        assertEq(1, owner_entries.getCount(), "a Java-to-Qore call after the static method call");
    }

    testStaticMethodDeletedProgram() {
        Program owner = getOwner();
        Program child = owner.callFunction("make_static_caller");
        assertEq(42, child.callFunction("call_answer"), "before the deletion");
        delete owner;
        # the class's Program has been deleted and its jni data destroyed: the static method is called in the context
        # of the calling code
        assertEq(42, child.callFunction("call_answer"), "after the deletion");
    }

    testJavaContextRestored() {
        Program owner = getOwner();
        Program caller = getCaller();
        object l = owner.callFunction("make_list");
        Counter entries();
        owner.setThreadEntryHandler(sub () { entries.inc(); });
        on_exit owner.setThreadEntryHandler();

        # a Java closure of this Program that Java runs by calling a Qore closure of this Program back
        # (QoreClosure.call(), which resolves the Program from the thread's Java context)
        code forward = CrossProgramCalls::makeForwarder(string sub () { return "called back"; });
        assertEq("called back", forward(), "control: before any cross-Program call");
        assertEq(0, entries.getCount(), "control: the owner was not entered");

        # a cross-Program call of the owner's Java object, made by this thread
        assertEq(1, l.size());
        assertEq(1, entries.getCount(), "the cross-Program call entered the owner");

        # the same Java-to-Qore call on this thread after the cross-Program call returned: the thread's Java context
        # is this Program's again, so the call does not go through the owner
        assertEq("called back", forward());
        assertEq(1, entries.getCount(), "the Java-to-Qore call after the cross-Program call did not enter the owner");

        # also after a cross-Program call made by another Program on this thread
        caller.callFunction("call_code", int sub () { return l.size(); });
        int n = entries.getCount();
        assertEq("called back", forward());
        assertEq(n, entries.getCount(), "after a call made by another Program");
    }

    testDeleteBeforeEntry() {
        if (!hasContextGate()) {
            testSkip("the jni module's context gate requires a debug build");
        }
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        bool deleted;
        # the owner is deleted on this thread after the call has found that the owner has jni data, and before it
        # enters the owner: the call then finds the owner deleted, and is made in the context of this Program, as for
        # an owner that had been deleted before the call
        setContextGate(sub () {
            delete owner;
            deleted = True;
        }, "entry");
        on_exit setContextGate();
        assertEq(1, l.size(), "the call completes");
        assertTrue(deleted, "the gate ran in the call");
        assertEq(1, l.size(), "a call after the deletion");
    }

    testJavaContextRestoredLoadedClass() {
        Program owner = getOwner();
        # an object of a Java class that the owner loaded: Qore makes the owner, the class's source Program, current
        # for calls of its methods, so the call sets the thread's Java context to the owner's
        object o = owner.callFunction("make_calls_object");
        Counter entries();
        owner.setThreadEntryHandler(sub () { entries.inc(); });
        on_exit owner.setThreadEntryHandler();
        code forward = CrossProgramCalls::makeForwarder(string sub () { return "called back"; });

        assertEq(7, o.value());
        int n = entries.getCount();
        # the thread's Java context is restored after the call: a Java-to-Qore call on this thread does not go
        # through the owner
        assertEq("called back", forward());
        assertEq(n, entries.getCount(), "a Java-to-Qore call after the call did not enter the owner");
    }

    testCallbackDeleteBeforeEntry() {
        if (!hasContextGate()) {
            testSkip("the jni module's context gate requires a debug build");
        }
        Program owner = getOwner();
        Program caller = getCaller();
        Queue ran();
        object c = owner.callFunction("make_marked_consumer", ran);
        bool deleted;
        # the owner is deleted on this thread after the callback's dispatcher has found that the owner has jni data,
        # and before it enters the owner: the dispatcher falls back as for an owner deleted before the call, and the
        # callback, code of the deleted owner, is refused with PROGRAM-ERROR, which Java sees
        setContextGate(sub () {
            delete owner;
            deleted = True;
        }, "entry");
        on_exit setContextGate();
        *string from_caller = caller.callFunction("accept_catching", c);
        assertTrue(deleted, "the gate ran in the callback");
        assertRegex("^org\\.qore\\.jni\\.QoreExceptionWrapper: PROGRAM-ERROR: .*has already been deleted",
            from_caller ?? "<no exception>", "Java's exception");
        assertTrue(ran.empty(), "the callback's body did not run");
    }

    testJavaThreadContextRestored() {
        Program owner = getOwner();
        object l = owner.callFunction("make_list");
        Program child = owner.callFunction("make_static_caller");
        code jc = owner.callFunction("make_java_closure", "tl");
        Counter entries();
        owner.setThreadEntryHandler(sub () { entries.inc(); });
        on_exit owner.setThreadEntryHandler();
        # on a Java thread, Java calls the first closure, which makes a call for the owner, and then the second one:
        # the thread's Java context, from which Java's call of the second closure takes its Program, is the one it had
        # before the call for the owner; the second closure's body records the entries made before it ran
        hash<string, code> calls = {
            "an instance method": sub () { l.size(); },
            "a static method": sub () { child.callFunction("call_answer"); },
            "a Java closure": sub () { jc(); },
        };
        foreach hash<auto> i in (calls.pairIterator()) {
            int after_first;
            int before_second;
            CrossProgramCalls::callBothOnJavaThread(sub () {
                i.value();
                after_first = entries.getCount();
            }, sub () {
                before_second = entries.getCount();
            });
            assertGt(0, after_first, i.key + ": the call for the owner entered it");
            assertEq(after_first, before_second, i.key + ": Java's next call into Qore did not enter the owner");
        }
    }
}
