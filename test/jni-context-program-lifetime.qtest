#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

# A thread that has obtained the jni module's global Java context Program must be able to use it until it is done
# with it: the module's shutdown deletes the Program (Globals::clearGlobalContext()), and a Java thread can be calling
# into Qore then, as the JVM still runs.  Globals::getJavaContextProgram() returned the Program with nothing keeping
# it alive, so a thread that obtained it just before the shutdown started used it while or after it was deleted (a
# debug build failed the assertion that the Program has jni data in jni_get_context_or_global(), or the thread used
# the jni data that the deletion had destroyed).  A caller now holds the Program (JniContextProgramHolder), and the
# shutdown deletes it once no other thread holds it (qore#6829).
#
# Each case runs test/jni-context-program-lifetime-child.q in a new process, as the module is shut down when the
# process exits.  A Java thread (org.qore.jni.test.ContextProgramLifetimeProbe) with no Qore Program context calls
# get_script_path(), which runs in the global context Program and returns its script path; in the "held" case, a debug
# build of the module holds the thread there once it has obtained the Program and its jni data
# (Jni::dbg_jni_set_context_program_hook()); the module's shutdown releases it once it has seen that the thread holds
# the Program, before it waits for it (Jni::dbg_jni_set_context_program_wait_hook()), so the thread uses the Program
# while the shutdown waits; without the hold, the thread would be released only after the deletion.  The
# thread calls the function again between the deletion of the Program and the destruction of the JVM
# (Jni::dbg_jni_set_shutdown_window_hook()), which fails, as no global context Program exists then (qore#6827).  With
# QORE_JNI_DBG_CONTEXT_PROGRAM_REPORT set, the module prints the number of global context Programs created and
# deleted, and the one created must have been deleted.  The test is skipped with a release build.

%modern

%requires QUnit
%requires Util
%exec-class JniContextProgramLifetimeTest

class JniContextProgramLifetimeTest inherits QUnit::Test {
    public {
        #! the result of get_script_path() in the global context Program
        const FirstOk = "probe: first: ok: ./Qore jni module global Program context";

        #! the Java exception that a call from Java raises once the global context Program has been deleted (the
        #! native method's handler raises a java.lang.Error, as no Qore exception can be raised in Java once the
        #! module's shutdown has started)
        const ShutdownError = "^probe: second: java\\.lang\\.Error: cannot raise the Qore exception of a JNI native "
            "method in Java; the Qore library or the jni module has been shut down$";
    }

    constructor() : QUnit::Test("JNI global context Program lifetime", "1.0") {
        addTestCase("regression: a thread holds the global context Program through the shutdown", \heldCase());
        addTestCase("positive: a call in the global context Program before the shutdown", \unheldCase());
        addTestCase("negative: no call in the global context Program", \noneCase());
        set_return_value(main());
    }

    heldCase() {
        string out = checkCase("held");
        # the shutdown saw that the thread held the Program, and released it before waiting for it; had it not seen
        # the thread, the thread would have been released only after the deletion, by the shutdown window hook
        assertEq("probe: released by: release", getLine(out, "probe: released by: "), out);
        # the thread obtained the Program before the shutdown started, and could use it until its call returned
        assertEq(FirstOk, getLine(out, "probe: first: "), out);
        # a call made once the Program is gone gets the error, and no Program
        assertRegex(ShutdownError, getLine(out, "probe: second: "), out);
    }

    unheldCase() {
        string out = checkCase("unheld");
        assertEq("probe: released by: none", getLine(out, "probe: released by: "), out);
        assertEq(FirstOk, getLine(out, "probe: first: "), out);
        assertRegex(ShutdownError, getLine(out, "probe: second: "), out);
    }

    noneCase() {
        string out = checkCase("none");
        assertEq("", getLine(out, "probe: "), out);
    }

    #! runs the child with the case and checks that the module's shutdown deleted the one global context Program
    #! created in the process; returns the output of the child
    private string checkCase(string case_name) {
        string out = runChild(case_name);
        assertEq("armed: " + case_name, getLine(out, "armed: "), out);
        assertFalse(out =~ /unhandled QORE/, out);
        assertFalse(out =~ /jni-dbg: the (shutdown window|context Program|context Program wait) hook/, out);
        if (getLine(out, "debug: ") != "debug: True") {
            assertEq("debug: False", getLine(out, "debug: "), out);
            testSkip("the jni module's debug diagnostics require a debug build");
        }
        # the one global context Program created when the module was initialized has been deleted
        assertEq("jni-dbg: global context Programs created: 1 deleted: 1", getLine(out, "jni-dbg: "), out);
        return out;
    }

    #! runs the child with the case and returns its output (stdout and stderr), checking that it exited with status 0
    private string runChild(string case_name) {
        string child = normalize_dir(get_script_dir() + "/jni-context-program-lifetime-child.q");
        # the variables that make the JVM print a notice on startup are removed, as the output of the child is checked
        string cmd = sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "QORE_JNI_DBG_CONTEXT_PROGRAM_REPORT=1 %s -b --enable-debug %s %s 2>&1", shellQuote(QORE_ARGV[0]),
            shellQuote(child), case_name);
        int rc;
        string out = backquote(cmd, \rc);
        assertEq(0, rc, "exit code: " + out);
        return out;
    }

    #! returns the first line of the output that starts with the prefix, or an empty string
    private static string getLine(string out, string prefix) {
        foreach string line in (out.split("\n")) {
            if (line.equalPartial(prefix)) {
                return line;
            }
        }
        return "";
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
