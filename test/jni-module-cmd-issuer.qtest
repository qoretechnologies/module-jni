#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires jni
%requires QUnit
%requires FsUtil

%exec-class JniModuleCmdIssuerTest

#! The jni module commands are judged by the restrictions of the code that issues them (qore#5699)
/** Needs a jni module built for module API 2.3 (QoreModuleCommandContext); with an older module it is skipped.
*/
class JniModuleCmdIssuerTest inherits QUnit::Test {
    private:internal {
        #! the issuer kinds: name -> restricting parse options, or -1 for a sandboxed issuer
        const Kinds = {
            "trusted": 0,
            "no-uncontrolled": PO_NO_UNCONTROLLED_APIS,
            "no-filesystem": PO_NO_FILESYSTEM,
            "no-embedded": PO_NO_EMBEDDED_LOGIC,
            "sandboxed": -1,
        };

        #! all restricted issuer kinds
        const AllRestricted = ("no-uncontrolled", "no-filesystem", "no-embedded", "sandboxed");

        #! the commands: the issuer kinds that are refused, and the results accepted for the other kinds; "java":
        #! the command runs Java code, which is refused as well to an issuer that restricts a class that Java code
        #! does not respect (PO_NO_FILESYSTEM) with a Qore library that refuses uncontrolled APIs for such classes
        #! (qore#7832)
        const Commands = {
            "import java.lang.StringBuilder": {"refused": ("no-uncontrolled", "sandboxed"), "allowed": ("ok",),
                "java": True},
            "import java.util.concurrent.*": {"refused": ("no-uncontrolled", "sandboxed"), "allowed": ("ok",),
                "java": True},
            "add-classpath /nonexistent-qore-test-dir": {"refused": ("no-uncontrolled", "no-filesystem", "sandboxed"),
                "allowed": ("ok",)},
            "add-relative-classpath nonexistent-qore-test-dir": {"refused": ("no-uncontrolled", "no-filesystem",
                "sandboxed"), "allowed": ("ok",)},
            "global-add-classpath /nonexistent-qore-test-dir": {"refused": AllRestricted, "allowed": ("ok",)},
            "global-add-relative-classpath nonexistent-qore-test-dir": {"refused": AllRestricted,
                "allowed": ("ok",)},
            "set-property org.qore.test.issuer.placeholder value": {"refused": AllRestricted, "allowed": ("ok",)},
            "register-shared-class qore.QoreTestIssuerPlaceholder": {"refused": AllRestricted, "allowed": ("ok",)},
            # the argument is not valid byte code: an allowed issuer gets the command's own error
            "define-class qore.QoreTestIssuerPlaceholder AAAA": {"refused": ("no-uncontrolled", "no-embedded",
                "sandboxed"), "allowed": ("JNI-DEFINE-CLASS-ERROR", "JNI-ERROR"), "java": True},
            "define-pending-class qore.QoreTestIssuerPlaceholder AAAA": {"refused": ("no-uncontrolled", "no-embedded",
                "sandboxed"), "allowed": ("ok", "JNI-DEFINE-CLASS-ERROR", "JNI-ERROR"), "java": True},
            # Kotlin scripting may not be installed
            "kotlin-eval 1": {"refused": ("no-uncontrolled", "no-embedded", "sandboxed"),
                "allowed": ("ok", "KOTLIN-SCRIPTING-NOT-AVAILABLE"), "java": True},
            "set-compat-types true": {"refused": (), "allowed": ("ok",)},
            "mark-module-injected QoreTestIssuerPlaceholder": {"refused": (), "allowed": ("ok",)},
        };

        #! the parse options of a Qorus workflow interface Program that is not sandboxed (Qorus' CommonParseOptions
        #! with PO_NO_GLOBAL_VARS): restricting (thread and process control), but without PO_NO_FILESYSTEM,
        #! PO_NO_UNCONTROLLED_APIS or PO_NO_EMBEDDED_LOGIC
        const QorusWorkflowParseOptions = PO_MODERN | PO_REQUIRE_OUR | PO_NO_TOP_LEVEL_STATEMENTS
            | PO_NO_THREAD_CONTROL | PO_NO_PROCESS_CONTROL | PO_NO_INHERIT_USER_FUNC_VARIANTS
            | PO_NO_INHERIT_GLOBAL_VARS | PO_NO_INHERIT_USER_CLASSES | PO_NO_INHERIT_USER_HASHDECLS
            | PO_ALLOW_WEAK_REFERENCES | PO_NO_INHERIT_PROGRAM_DATA | PO_NO_GLOBAL_VARS;

        #! the parse options of a Qorus service or job interface Program that is not sandboxed (CommonParseOptions)
        const QorusServiceParseOptions = QorusWorkflowParseOptions & ~PO_NO_GLOBAL_VARS;

        #! the parse options of a sandboxed Qorus interface Program (QorusSandboxParseOptions with PO_NO_MODULES)
        const QorusSandboxedParseOptions = (PO_LOCKDOWN & ~PO_NO_THREAD_CLASSES) | PO_NO_UNCONTROLLED_APIS;

        #! the module commands that Qorus interface code and the Qorus server use in an interface Program
        const QorusInterfaceCommands = (
            "set-compat-types false",
            "import java.lang.StringBuilder",
            "add-classpath /nonexistent-qore-test-dir",
            # the argument is not valid byte code, but a pending class is only defined when it is used
            "define-pending-class qore.QoreTestIssuerQorusPlaceholder AAAA",
        );

        #! the module commands that change state of the JVM that every Program shares: refused to the code of a
        #! trusted Qorus interface, whose parse options restrict it, allowed to Qorus' own code
        const QorusProcessWideCommands = (
            "set-property org.qore.test.issuer.qorus value",
            "global-add-classpath /nonexistent-qore-test-dir",
            "register-shared-class qore.QoreTestIssuerQorusPlaceholder",
        );
    }

    constructor() : QUnit::Test("JNI module command issuer", "1.0", \ARGV) {
        addTestCase("a directive is judged by the restrictions of its Program", \directiveTest());
        addTestCase("a command issued at run time is judged by its issuer", \runtimeTest());
        addTestCase("the module commands of a Qorus interface", \qorusPatternTest());
        addTestCase("a command issued by library module code is judged by the sandbox only", \libraryTest());
        addTestCase("a library module's own directive is judged by the sandbox only", \libraryDirectiveTest());
        addTestCase("the jdbc classpath option follows the rule of add-classpath", \jdbcOptionTest());
        addTestCase("the jdbc classpath option set by library module code is judged by the sandbox only",
            \libraryJdbcOptionTest());
        addTestCase("the jdbc classpath option that library module code sets for trusted code to open is judged by "
            "its setter", \libraryJdbcOptionSetterTest());
        addTestCase("a command replayed from compiled code is judged by its recorded restrictions and its loader",
            \replayTest());
        set_return_value(main());
    }

    #! Returns True if the jni module judges module commands by their issuer (module API 2.3)
    private static bool issuerAware() {
        hash<auto> jh = get_module_hash().jni;
        return jh.api_major > 2 || (jh.api_major == 2 && jh.api_minor >= 3);
    }

    #! Returns True if the Qore library refuses an issuer that restricts a class that the module's runtime does not
    #! enforce, such as PO_NO_FILESYSTEM, what it refuses to an issuer with PO_NO_UNCONTROLLED_APIS (qore#7832)
    /** The Qore library judges the issuer (the module hash of a binary module has "enforced_domains" then), whatever
        the jni module was built with
    */
    private static bool uncontrolledApiClassesRefused() {
        return exists get_module_hash().jni.enforced_domains;
    }

    #! Returns True if the jni module refuses Java code in a Program that restricts a class that Java code does not
    #! respect, as in a Program with PO_NO_UNCONTROLLED_APIS: its own checks of the target Program (qore#7832)
    private static bool uncontrolledApiEnforcement() {
        return get_module_hash().jni.info.uncontrolled_api_enforcement ?? False;
    }

    #! Returns a new Program of the given issuer kind
    private static Program getIssuer(string kind) {
        int po = Kinds{kind};
        Program p(PO_NEW_STYLE | (po > 0 ? po : 0));
        if (po < 0) {
            p.setSandboxManager(new SandboxManager());
        }
        return p;
    }

    directiveTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        on_exit Jni::java::lang::System::clearProperty("org.qore.test.issuer.placeholder");
        foreach hash<auto> c in (Commands.pairIterator()) {
            # a command that runs Java code is refused to a no-filesystem issuer with the restriction classes of
            # uncontrolled APIs (qore#7832)
            list<string> refused = c.value.refused;
            if (c.value.java && uncontrolledApiClassesRefused()) {
                refused += "no-filesystem";
            }
            foreach string kind in (keys Kinds) {
                Program p = getIssuer(kind);
                string err;
                try {
                    p.parse("%requires jni\n%module-cmd(jni) " + c.key + "\n", "jni-module-cmd-issuer");
                    err = "ok";
                } catch (hash<ExceptionInfo> ex) {
                    err = ex.err;
                }
                if (inlist(kind, refused)) {
                    assertEq("JNI-SANDBOX-ERROR", err, kind + ": " + c.key);
                } else {
                    assertTrue(inlist(err, c.value.allowed), kind + ": " + c.key + ": " + err);
                }
            }
        }
    }

    runtimeTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        string prop = "org.qore.test.issuer.runtime";
        string cmd = "set-property " + prop + " value";
        Program trusted_target(PO_NEW_STYLE);
        trusted_target.parse("%requires jni\n", "jni-module-cmd-issuer-target");
        foreach string kind in (("no-uncontrolled", "no-filesystem", "no-embedded", "sandboxed")) {
            Program p = getIssuer(kind);
            p.parse("%requires jni\n"
                "string sub self(string c) { try { Program::issueModuleCmd(\"jni\", c); return \"ok\"; } "
                "catch (hash<ExceptionInfo> ex) { return ex.err; } }\n"
                "string sub into(Program t, string c) { try { t.issueModuleCmd(\"jni\", c); return \"ok\"; } "
                "catch (hash<ExceptionInfo> ex) { return ex.err; } }\n", "jni-module-cmd-issuer-" + kind);
            # into its own Program: refused by the jni module for its issuer
            assertEq("JNI-SANDBOX-ERROR", p.callFunction("self", cmd), kind + ": into its own Program");
            # into a trusted Program: refused before the module is given the command
            assertEq("RUNTIME-COMMAND-ERROR", p.callFunction("into", trusted_target, cmd),
                kind + ": into a trusted Program");
        }
        assertEq(NOTHING, Jni::java::lang::System::getProperty(prop), "the refused commands set nothing");

        # a trusted issuer: allowed into a trusted Program; into a restricted Program, the target's own check refuses
        # what the target may not do
        trusted_target.issueModuleCmd("jni", cmd);
        on_exit Jni::java::lang::System::clearProperty(prop);
        assertEq("value", Jni::java::lang::System::getProperty(prop), "a trusted issuer");
        Program restricted_target = getIssuer("no-uncontrolled");
        restricted_target.parse("%requires jni\n", "jni-module-cmd-issuer-restricted-target");
        assertThrows("JNI-SANDBOX-ERROR", \restricted_target.issueModuleCmd(), ("jni", cmd),
            "a trusted issuer into a target that does not allow uncontrolled APIs");
        # a trusted issuer into a target without the filesystem: its parse options are not the issuer's
        Program nofs_target = getIssuer("no-filesystem");
        nofs_target.parse("%requires jni\n", "jni-module-cmd-issuer-nofs-target");
        # the command is allowed: no exception is raised
        string nofs_result;
        try {
            nofs_target.issueModuleCmd("jni", "add-classpath /nonexistent-qore-test-dir");
            nofs_result = "ok";
        } catch (hash<ExceptionInfo> ex) {
            nofs_result = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertEq("ok", nofs_result, "a trusted issuer into a target without the filesystem");
    }

    #! Returns the qcc compiler next to the qore binary that runs the test, or "qcc"
    private static string getQcc() {
        string dir = dirname(QORE_ARGV[0]);
        return ENV.QCC ?? (is_file(dir + "/qcc") ? dir + "/qcc" : "qcc");
    }

    #! Runs a shell command; returns its output and sets its exit status
    #! Runs the command with stderr merged into stdout; returns the output without the JVM's own notices
    /** The JVM prints "Picked up JAVA_TOOL_OPTIONS: ..." (or _JAVA_OPTIONS / JDK_JAVA_OPTIONS) to stderr when that
        environment variable is set, as in CI images; those lines are not the command's output and are removed so that
        the assertions match only what the command printed
    */
    private static string run(string cmd, reference<int> rc) {
        string out = backquote(cmd + " 2>&1", \rc);
        list<string> lines = select out.split("\n"),
            !($1 =~ /^Picked up (JAVA_TOOL_OPTIONS|_JAVA_OPTIONS|JDK_JAVA_OPTIONS):/);
        return lines.join("\n");
    }

    replayTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        TmpDir tmp("jni-module-cmd-issuer-");
        string qcc = getQcc();
        int rc;

        # a compiled program: the directive before %no-filesystem is replayed with the options in force at it
        string first = tmp.path + "/first.q";
        File f();
        f.open2(first, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("%modern\n%module-cmd(jni) add-classpath /nonexistent-qore-test-dir\n%no-filesystem\n"
            "printf(\"loaded\\n\");\n");
        f.close();
        string out = run(sprintf("%s -O0 -o %s/first %s", qcc, tmp.path, first), \rc);
        if (rc || !is_file(tmp.path + "/first")) {
            testSkip("qcc is not available or cannot compile the program: " + out);
        }
        out = run(tmp.path + "/first", \rc);
        assertEq(0, rc, "replayed directive before %no-filesystem: " + out);
        assertRegex("loaded", out, "the program ran");

        # the directive after %no-filesystem is refused already when the program is compiled
        string after = tmp.path + "/after.q";
        f.open2(after, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("%modern\n%no-filesystem\n%module-cmd(jni) add-classpath /nonexistent-qore-test-dir\n");
        f.close();
        out = run(sprintf("%s -O0 -o %s/after %s", qcc, tmp.path, after), \rc);
        assertTrue(rc != 0, "qcc refuses the directive after %no-filesystem");
        assertRegex("JNI-SANDBOX-ERROR", out, "the error is the jni module's");

        # a compiled module: its recorded command is replayed when it is loaded; loaded by name from the module path it
        # is library code (no parse options); loaded by a path that the loader chose, the loader's restrictions apply
        string qmod_dir = tmp.path + "/qmod";
        mkdir(qmod_dir);
        out = run(sprintf("%s -m -o %s/JniReplayFixture.qmod %s/jni-cmd-issuer-fixture/replay/JniReplayFixture.qm", qcc,
            qmod_dir, get_script_dir()), \rc);
        assertEq(0, rc, "qcc compiles the module: " + out);
        # the loader: ARGV[0] is the module to load, ARGV[1] the issuer kind of the loading Program
        string load = tmp.path + "/load.q";
        f.open2(load, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("%modern\nProgram p(PO_NEW_STYLE | (ARGV[1] == \"sandboxed\" ? 0 : PO_NO_UNCONTROLLED_APIS));\n"
            "if (ARGV[1] == \"sandboxed\") { p.setSandboxManager(new SandboxManager()); }\n"
            "try { p.loadModule(ARGV[0]); printf(\"loaded\\n\"); } catch (hash<ExceptionInfo> ex) { "
            "printf(\"%s: %s\\n\", ex.err, ex.desc); }\n");
        f.close();
        string qore = QORE_ARGV[0];
        # the loader kinds and the reason of the jni module's refusal (JNI-SANDBOX-ERROR), which the core reports in
        # the MODULE-LOAD-ERROR of the replay
        hash<string, string> reasons = {
            "no-uncontrolled": "the code that issued the command has parse options that forbid it",
            "sandboxed": "the command was issued by sandboxed code",
        };
        foreach hash<auto> i in (reasons.pairIterator()) {
            string kind = i.key;
            out = run(sprintf("QORE_MODULE_DIR=%s:%s %s %s JniReplayFixture %s", qmod_dir, ENV.QORE_MODULE_DIR, qore,
                load, kind), \rc);
            # as the directive of a source library module is (libraryDirectiveTest()): a module from the module path is
            # initialized as library code, with no parse options and no sandbox, whatever Program loads it first
            assertRegex("^loaded$", trim(out), kind + ": a library module: its replayed command is judged as library "
                "code: " + out);
            out = run(sprintf("%s %s %s/JniReplayFixture.qmod %s", qore, load, qmod_dir, kind), \rc);
            # a compiled module is native code: since qore#6776, the core refuses to load one from a path outside the
            # module path into a sandboxed Program (whose sandbox does not allow uncontrolled APIs), and a current core
            # also into a Program whose functional domains are restricted, before its recorded commands are replayed;
            # with an earlier core, the module is loaded and its replayed command is refused by the jni module for the
            # add-classpath command and the loader, not by another error
            if (trim(out) =~ /^LOAD-MODULE-ERROR: /) {
                assertRegex("^LOAD-MODULE-ERROR: cannot load binary module '[^']*/JniReplayFixture\\.qmod': code that "
                    "a sandbox governs or whose functional domains are restricted can load native code only from the "
                    "module path", trim(out), kind + ": a module chosen by path: the core refuses its native code: "
                    + out);
            } else {
                assertRegex("^MODULE-LOAD-ERROR: AOT module-command replay error .*%module-cmd\\(jni\\) add-classpath "
                    "/nonexistent-qore-test-dir: cannot use the \"add-classpath\" module command, which adds to the "
                    "Program's classpath: " + i.value, trim(out), kind + ": a module chosen by path: its replayed "
                    "command is refused: " + out);
            }
            assertFalse(trim(out) =~ /^loaded$/, kind + ": a module chosen by path is not loaded");
        }
    }

    jdbcOptionTest() {
        # the classpath option of the jdbc database driver follows the rule of add-classpath for the code that sets it;
        # sandboxed code that opens the connection itself is refused the connection first, as the jdbc driver does not
        # connect for code that a sandbox governs (qore#5747); a classpath that sandboxed code sets for trusted code to
        # open is tested in jni-jdbc-option-setter.qtest
        string src = "string sub open(string cp) { Datasource ds(\"jdbc:u/p@jdbc:qore-none://x{classpath=\" + cp "
            "+ \"}\"); try { ds.open(); return \"ok\"; } catch (hash<ExceptionInfo> ex) { return ex.err; } }";
        foreach hash<auto> c in ({"kind": "trusted", "expected": "JNI-ERROR"},
                {"kind": "no-filesystem", "expected": "JNI-SANDBOX-ERROR"},
                {"kind": "no-uncontrolled", "expected": "JNI-SANDBOX-ERROR"},
                {"kind": "sandboxed", "expected": "NETWORK-ACCESS-DENIED"}) {
            Program p = getIssuer(c.kind);
            p.parse("%requires jni\n" + src, "jni-module-cmd-issuer-jdbc-" + c.kind);
            assertEq(c.expected, p.callFunction("open", "/nonexistent-qore-test-dir"), c.kind);
        }
    }

    #! Runs jni-cmd-issuer-library.q in a process of its own for the issuer kind and case given; returns its result
    /** The fixture modules' directory is in QORE_MODULE_DIR, so the fixture modules are library code (a directory that
        the loading code adds with \c %prepend-module-path is not), and the Program of the issuer kind is the first to
        load them, so that the module's Program inherits that Program's parse options
    */
    private static string runLibrary(string kind, string which) {
        string dir = get_script_dir();
        string mdir = dir + "jni-cmd-issuer-fixture" + (exists ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");
        int rc;
        string out = run(sprintf("QORE_MODULE_DIR='%s' '%s' '%sjni-cmd-issuer-library.q' %s %s", mdir, QORE_ARGV[0],
            dir, kind, which), \rc);
        # the last line is the result; warnings precede it
        list<string> lines = select (out.split("\n")), $1 != "";
        return lines ? lines.last() : sprintf("no output (exit status %d)", rc);
    }

    libraryTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        # a library module (from the module path) issues commands from its own code, as the provider modules do; its
        # code has no parse options, also when the Program of a %no-filesystem loader, whose options its own Program
        # inherits, loads it first: only a sandbox that governs its caller restricts the command
        foreach hash<auto> c in ({"kind": "trusted", "expected": "ok"}, {"kind": "no-filesystem", "expected": "ok"},
                {"kind": "no-uncontrolled", "expected": "ok"}, {"kind": "sandboxed", "expected": "JNI-SANDBOX-ERROR"}) {
            assertEq(c.expected, runLibrary(c.kind, "cmd").split(":")[0], c.kind + " first loader");
        }
    }

    libraryJdbcOptionTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        # library module code that sets the jdbc classpath option is judged by the sandbox only, not by the parse options
        # that its Program inherited from the code that loaded it first (for example a %no-filesystem loader);
        # JNI-ERROR is the error of the jdbc driver that is not found after the option was accepted; the jdbc driver
        # does not connect for a sandboxed caller at all (qore#5747), which refuses it before the option is processed
        foreach hash<auto> c in ({"kind": "trusted", "expected": "JNI-ERROR"},
                {"kind": "no-filesystem", "expected": "JNI-ERROR"},
                {"kind": "no-uncontrolled", "expected": "JNI-ERROR"},
                {"kind": "sandboxed", "expected": "NETWORK-ACCESS-DENIED"}) {
            assertEq(c.expected, runLibrary(c.kind, "jdbc").split(":")[0], c.kind + " first loader");
        }
    }

    libraryJdbcOptionSetterTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        if (!(get_module_hash().jni.info.jdbc_option_setter ?? False)) {
            testSkip("the jni module was built for a Qore library that does not record the setters of datasource "
                "options");
        }
        # the option that library code sets for a sandboxed caller is refused also when trusted code opens the
        # connection, as the jdbc driver judges it by the code that set it (qore#5741)
        foreach hash<auto> c in ({"kind": "trusted", "expected": "JNI-ERROR"},
                {"kind": "no-filesystem", "expected": "JNI-ERROR"},
                {"kind": "no-uncontrolled", "expected": "JNI-ERROR"},
                {"kind": "sandboxed", "expected": "JNI-SANDBOX-ERROR"}) {
            assertEq(c.expected, runLibrary(c.kind, "jdbc-set").split(":")[0], c.kind + " first loader: set for "
                "trusted code to open");
        }
    }

    libraryDirectiveTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        # the directive has no parse options (decision A), and a module from the module path is initialized as library
        # code, with no sandbox, also when restricted or sandboxed code loads it first: every loader loads it
        foreach string kind in (keys Kinds) {
            assertEq("ok", runLibrary(kind, "directive"), kind + " first loader");
        }
    }

    #! returns a Program with the parse options given (by default those of a Qorus workflow interface) and the
    #! sandbox of a trusted Qorus interface: an allow-all manager, which trusts the code if trusting is True
    private static Program getQorusInterface(bool trusting, int po = QorusWorkflowParseOptions) {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(True);
        if (trusting) {
            call_object_method(sm, "setUncontrolledApiPolicy", True);
        }
        Program p(po);
        p.setSandboxManager(sm);
        return p;
    }

    #! returns the error of parsing a module command directive in the Program given, or "ok"
    private static string parseCmd(Program p, string cmd, *reference<string> desc) {
        try {
            p.parse("%requires jni\n%module-cmd(jni) " + cmd + "\n", "jni-module-cmd-issuer-qorus");
            return "ok";
        } catch (hash<ExceptionInfo> ex) {
            desc = ex.desc;
            return ex.err;
        }
    }

    #! returns the error of a module command that the code of this Program issues in the Program given, or "ok"
    private static string issueCmd(Program p, string cmd) {
        try {
            p.issueModuleCmd("jni", cmd);
            return "ok";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! the module commands of a Qorus interface that is not sandboxed: its Program has restricting parse options
    #! (thread and process control), but not the ones that refuse the commands it uses
    qorusPatternTest() {
        if (!issuerAware()) {
            testSkip("the jni module was built for a module API before 2.3");
        }
        if (!(new SandboxManager()).hasCallableMethod("setUncontrolledApiPolicy")) {
            testSkip("the Qore library has no uncontrolled-API policy of sandboxes");
        }
        on_exit Jni::java::lang::System::clearProperty("org.qore.test.issuer.qorus");
        # the directives of the interface code of workflows, services and jobs: allowed
        foreach int po in (QorusWorkflowParseOptions, QorusServiceParseOptions) {
            foreach string cmd in (QorusInterfaceCommands) {
                string desc;
                assertEq("ok", parseCmd(getQorusInterface(True, po), cmd, \desc),
                    sprintf("a Qorus interface (%x): %s: %s", po, cmd, desc));
            }
            # the commands that change state of the JVM that every Program shares are refused to the interface code:
            # its parse options restrict it (thread and process control), and such a command is refused to every
            # restricted issuer; the error says why
            foreach string cmd in (QorusProcessWideCommands) {
                string desc;
                assertEq("JNI-SANDBOX-ERROR", parseCmd(getQorusInterface(True, po), cmd, \desc),
                    sprintf("a Qorus interface (%x): %s", po, cmd));
                assertRegex("cannot use the \"" + cmd.split(" ")[0] + "\" module command.*the code that issued the "
                    "command has parse options that forbid", desc, "a Qorus interface: " + cmd + ": the reason");
            }
        }
        # a Qorus system service, whose Program has no restricting parse options: every command is allowed
        foreach string cmd in (QorusInterfaceCommands + QorusProcessWideCommands) {
            string desc;
            assertEq("ok", parseCmd(getQorusInterface(True, 0), cmd, \desc), "a Qorus system service: " + cmd + ": "
                + desc);
        }
        # a sandboxed Qorus interface, with the sandbox policy of Qorus' sandboxed interfaces, cannot load the module
        # at all: the core refuses it the module before the jni module can judge a command
        {
            SandboxManager sm();
            sm.setFilesystemDefaultPolicy(False);
            sm.setNetworkDefaultPolicy(True);
            sm.blockPrivateNetworks();
            Program p(QorusSandboxedParseOptions);
            p.setSandboxManager(sm);
            string desc;
            assertEq("PARSE-EXCEPTION", parseCmd(p, "set-compat-types false", \desc), "a sandboxed Qorus interface");
            assertRegex("PO_NO_MODULES", desc, "a sandboxed Qorus interface: the reason");
        }
        # the commands that the server's code issues into the interface Program: allowed
        {
            Program p = getQorusInterface(True);
            p.loadModule("jni");
            foreach string cmd in (QorusInterfaceCommands) {
                p.issueModuleCmd("jni", cmd);
            }
            # the import command runs (it is not refused): a class that does not exist is not found
            try {
                p.issueModuleCmd("jni", "import org.qore.test.QoreTestIssuerNoSuchClass");
                fail("a Qorus interface: an import of a class that does not exist: no exception");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("JNI-ERROR", ex.err, "a Qorus interface: an import of a class that does not exist");
                assertRegex("ClassNotFoundException", ex.desc, "a Qorus interface: the import ran");
            }
        }
        # the code of the Qorus server issues commands in locked-down Programs (mappers): a command of the Program's
        # own classpath and an import are allowed; a command that changes the classpath of every Program is refused
        # in a Program that does not allow uncontrolled APIs (Qorus issues it before it locks a Program down, and the
        # lockdown options of a Program with Java, Python or Kotlin field code allow uncontrolled APIs)
        {
            Program p(PO_LOCKDOWN & ~PO_NO_MODULES);
            p.loadModule("jni");
            assertEq("ok", issueCmd(p, "add-classpath /nonexistent-qore-test-dir"), "a lockdown Program: add-classpath");
            assertEq("ok", issueCmd(p, "import java.lang.StringBuilder"), "a lockdown Program: import");
            assertEq("JNI-SANDBOX-ERROR", issueCmd(p, "global-add-classpath /nonexistent-qore-test-dir"),
                "a lockdown Program: global-add-classpath");
            # the lockdown options of a Program that allows uncontrolled APIs still restrict the filesystem, the
            # network and external processes, which Java code does not respect: with the restriction classes of
            # uncontrolled APIs (qore#7832), the Program is refused Java code as one with PO_NO_UNCONTROLLED_APIS is
            # (the set of classes is pending a decision for Qorus' mapper Programs)
            Program fp(PO_LOCKDOWN & ~(PO_NO_MODULES | PO_NO_UNCONTROLLED_APIS));
            fp.loadModule("jni");
            assertEq(uncontrolledApiEnforcement() ? "JNI-SANDBOX-ERROR" : "ok",
                issueCmd(fp, "global-add-classpath /nonexistent-qore-test-dir"),
                "a lockdown Program that allows uncontrolled APIs: global-add-classpath");
        }
        # a Qorus interface whose sandbox does not trust the code (a Qorus without the uncontrolled-API policy of
        # trusted interfaces): only the commands that change the Program's own flags are allowed
        foreach string cmd in (QorusInterfaceCommands) {
            Program p = getQorusInterface(False);
            string err;
            try {
                p.parse("%requires jni\n%module-cmd(jni) " + cmd + "\n", "jni-module-cmd-issuer-qorus-untrusted");
                err = "ok";
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            assertEq(cmd =~ /^set-compat-types/ ? "ok" : "JNI-SANDBOX-ERROR", err,
                "a Qorus interface without the trust policy: " + cmd);
        }
    }
}
