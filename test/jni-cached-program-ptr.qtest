#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

# Java caches the pointers of Qore Programs: each org.qore.jni.QoreURLClassLoader has the pointer of the Program whose
# class loader it is, and Java passes it to the native methods that call into the Program or read its definitions
# (QoreJavaApi.callFunction(), callStaticMethod() and newObjectSave(), QoreObject.callMethod(), QoreClosure.call(), and
# the listing of the classes of a package and the generation of the byte code of a Java class for a Qore class).  The
# natives used the pointer as it was, while the Program can be deleted at any time: a native that received the pointer
# just before the Program was deleted used the freed Program, and the class loader of a QoreJavaCompiler, created with
# a copy of its parent's pointer, kept it after the Program was deleted, so that every later call through it used the
# freed Program.  The natives now validate the pointer against the registry of the Programs with jni data and hold the
# Program (jni::JniJavaProgramRef), and fail with an exception if it has been deleted; a compiler's class loader shares
# the pointer of its parent (QoreURLClassLoader.createDerived()), so that it is cleared with the parent's.
#
# Each case runs test/jni-cached-program-ptr-child.q in a new process: a Java thread whose class loader context has the
# pointer of a child Program calls into it (org.qore.jni.test.CachedProgramPtrProbe); in the "hook" cases, a debug build
# of the module holds the thread in the first native that receives the pointer (Jni::dbg_jni_set_java_program_ptr_hook();
# for the "class" API, the listing of the classes of the package, before the generation of the byte code) while the
# child Program is deleted.  Without the fix, the "hook" cases and the "wait" case with a QoreJavaCompiler
# class loader use the freed Program (valgrind reports invalid reads in QoreProgram::getExternalData(); without
# valgrind, the process can crash), and the "share" case reports that the copied pointer does not follow the parent's.
# The test is skipped with a release build.

%modern

%requires QUnit
%requires Util
%exec-class JniCachedProgramPtrTest

class JniCachedProgramPtrTest inherits QUnit::Test {
    public {
        #! the exception of a call into Qore through a class loader whose Program has been deleted (qore#6845)
        const ProgramDeleted = "^org\\.qore\\.jni\\.QoreURLClassLoader\\$ProgramDeletedException: ";

        #! the error of a native that received the pointer of a deleted Program
        const DeletedError = "the Qore Program of the Java class loader has been deleted";

        #! the error of a class load whose canonical class loader lookup received the pointer of a deleted Program:
        #! no canonical class loader is found, and the class is not found either
        const NsClassNotFound = "^java\\.lang\\.ClassNotFoundException: qore\\.PgmPtrNs\\.PgmPtrNsClass$";

        #! the APIs of the calls, with the result of a call while the child Program exists
        const LiveResults = {
            "function": "ok: child",
            "static": "ok: child",
            "new": "ok: qore.PgmPtrProbeClass",
            "class": "ok: qore.PgmPtrProbeClass",
            "nsclass": "ok: qore.PgmPtrNs.PgmPtrNsClass",
            "compile": "ok: pgmptr.Compiled",
            "method": "ok: child",
            "closure": "ok: child",
        };

        #! the result (a regular expression) of a call whose native received the pointer of the child Program that
        #! was then deleted; the error of the native, unless given here
        const HookResults = {
            "nsclass": NsClassNotFound,
        };

        #! the result (a regular expression) of a call whose native received the pointer of the child Program that
        #! then stopped being the pointer of the thread's class loader context; the error of the native, unless given
        #! here, by class loader context if it depends on it
        const HookClearResults = {
            "nsclass": {
                "context": NsClassNotFound,
                # the class is generated by the child Program's own class loader, whose pointer is valid: the
                # compiler's class loader, whose pointer was cleared, only delegates to it
                "compiler": "^ok: qore\\.PgmPtrNs\\.PgmPtrNsClass$",
            },
        };

        #! the result of a call made once the child Program has been deleted and the class loader's pointer cleared:
        #! a call into Qore fails, rather than being made in the global Java context Program, which no sandbox governs
        #! (qoretechnologies/qore#6845); a class load and a compilation find no class
        const ClearedResults = {
            "function": ProgramDeleted,
            "static": ProgramDeleted,
            "new": ProgramDeleted,
            "class": "^java\\.lang\\.ClassNotFoundException: qore\\.PgmPtrProbeClass$",
            "nsclass": NsClassNotFound,
            "compile": "^org\\.qore\\.jni\\.compiler\\.QoreJavaCompilerException: Compilation failed",
            "method": ProgramDeleted,
            "closure": ProgramDeleted,
        };

        #! the class loader contexts of the thread
        const Setups = ("context", "compiler");
    }

    constructor() : QUnit::Test("JNI Program pointers cached in Java", "1.0") {
        addTestCase("regression: a native receives the pointer of a Program being deleted", \hookCase());
        addTestCase("regression: a compiler's class loader is used after its Program has been deleted",
            \waitCompilerCase());
        addTestCase("regression: a compiler's class loader shares its parent's pointer", \shareCase());
        addTestCase("positive: calls while the Program exists", \liveCase());
        addTestCase("positive: a native held while the Program exists", \hookLiveCase());
        addTestCase("negative: the pointer is no longer the class loader's", \hookClearCase());
        addTestCase("negative: a class loader's cleared pointer", \waitContextCase());
        set_return_value(main());
    }

    hookCase() {
        foreach string setup in (Setups) {
            foreach string api in (keys LiveResults) {
                string result = checkCase("hook", setup, api);
                assertRegex(getExpected(HookResults, api, setup) ?? DeletedError, result,
                    sprintf("%s %s", setup, api));
            }
        }
    }

    waitCompilerCase() {
        foreach string api in (keys LiveResults) {
            string result = checkCase("wait", "compiler", api);
            assertRegex(ClearedResults{api}, result, api);
        }
    }

    shareCase() {
        string out = runChild("share", "context", "function");
        if (skipRelease(out)) {
            return;
        }
        assertEq("result: shared: true detached: true follows: true", getLine(out, "result: "), out);
    }

    liveCase() {
        foreach string setup in (Setups) {
            foreach hash<auto> i in (LiveResults.pairIterator()) {
                assertEq(i.value, checkCase("live", setup, i.key), sprintf("%s %s", setup, i.key));
            }
        }
    }

    hookLiveCase() {
        foreach string setup in (Setups) {
            foreach hash<auto> i in (LiveResults.pairIterator()) {
                assertEq(i.value, checkCase("hook-live", setup, i.key), sprintf("%s %s", setup, i.key));
            }
        }
    }

    hookClearCase() {
        foreach string setup in (Setups) {
            foreach string api in (keys LiveResults) {
                string result = checkCase("hook-clear", setup, api);
                assertRegex(getExpected(HookClearResults, api, setup) ?? DeletedError, result,
                    sprintf("%s %s", setup, api));
            }
        }
    }

    waitContextCase() {
        foreach string api in (keys LiveResults) {
            string result = checkCase("wait", "context", api);
            assertRegex(ClearedResults{api}, result, api);
        }
    }

    #! returns the expected result of the API with the class loader context from the table, or nothing
    private static *string getExpected(hash<auto> table, string api, string setup) {
        auto v = table{api};
        return v.typeCode() == NT_HASH ? v{setup} : v;
    }

    #! runs the child with the case and returns the result of the call, or an empty string with a release build
    private string checkCase(string case_name, string setup, string api) {
        string out = runChild(case_name, setup, api);
        if (skipRelease(out)) {
            return "";
        }
        # the thread's class loader context had the pointer of the child Program
        assertEq("ptr: True", getLine(out, "ptr: "), out);
        string result = getLine(out, "result: ");
        assertTrue(result.equalPartial("result: "), out);
        return result.substr(8);
    }

    #! returns True and skips the test with a release build of the module
    private bool skipRelease(string out) {
        if (getLine(out, "debug: ") != "debug: True") {
            assertEq("debug: False", getLine(out, "debug: "), out);
            testSkip("the jni module's debug hooks require a debug build");
            return True;
        }
        return False;
    }

    #! runs the child and returns its output (stdout and stderr), checking that it exited with status 0
    private string runChild(string case_name, string setup, string api) {
        string child = normalize_dir(get_script_dir() + "/jni-cached-program-ptr-child.q");
        # the variables that make the JVM print a notice on startup are removed, as the output of the child is checked
        string cmd = sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS %s -b --enable-debug %s "
            "%s %s %s 2>&1", shellQuote(QORE_ARGV[0]), shellQuote(child), case_name, setup, api);
        int rc;
        string out = backquote(cmd, \rc);
        assertEq(0, rc, sprintf("%s %s %s: exit code: %s", case_name, setup, api, out));
        assertFalse(out =~ /unhandled QORE/, out);
        assertFalse(out =~ /jni-dbg: the .* hook/, out);
        return out;
    }

    #! returns the first line of the output that starts with the prefix, or an empty string
    private static string getLine(string out, string prefix) {
        foreach string line in (out.split("\n")) {
            if (line.equalPartial(prefix)) {
                return line;
            }
        }
        return "";
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
