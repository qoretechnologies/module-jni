#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The shutdown signals (SIGTERM, SIGINT and SIGHUP) of a process with the JVM are handled by Qore, also with libjsig
# preloaded, and the JVM still handles its own synchronous signals.
#
# The JVM is started with reduced signals (-Xrs).  Without it, the JVM installs handlers for the shutdown signals and
# unblocks them in its threads, so a SIGTERM is delivered to a JVM thread rather than to the Qore signal thread: Qore
# signal handlers never ran, and the JVM ran System.exit(), which called C exit() on the JVM's VM Thread while Qore
# threads were running, so libqore aborted in its static destructors ("external native threads still active while
# stopping the cleanup worker") when a ThreadPool worker was active.
#
# Each case runs a child process, which sends the signal to itself once it is ready; the parent reads the child's
# output until the child has exited, so no case waits for a time.  A child that is never ended by its signal waits
# forever (the test runner's time limit is only a guard).

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"

%requires jni
%requires QUnit
%requires FsUtil

%exec-class JniSigtermLibjsigTest

class JniSigtermLibjsigTest inherits QUnit::Test {
    private:internal {
        #! the code of the child process after its parse directives; run with: <mode> <signal>
        /** modes:
            - \c handler: a Qore handler for the signal ends the ThreadPool worker, and the program ends normally
            - \c default: no Qore handler; Qore ends the process for the signal
            - \c npe: no signal; Java NullPointerExceptions raised by a field read in JIT-compiled code
        */
        const ChildSource = "
%module-cmd(jni) import org.qore.jni.test.JvmSignals
%module-cmd(jni) import java.lang.System

#! returns True if libjsig is mapped in the process
bool sub has_libjsig() {
    return (ReadOnlyFile::readTextFile(\"/proc/self/maps\") =~ /\\/libjsig\\./);
}

#! returns the signals that the process has handlers for (SigCgt in /proc/self/status) as a hex string
string sub caught_signals() {
    *string line = (ReadOnlyFile::readTextFile(\"/proc/self/status\") =~ x/^SigCgt:\\s*([0-9a-f]+)$/m)[0];
    return line ?? \"\";
}

#! raises NullPointerExceptions in JIT-compiled code, which checks references for null implicitly (with a fault)
sub npe() {
    # JvmSignals::read() is compiled by the JIT compilers in the loop (synchronously, as the parent runs the child
    # with -Xbatch), then called with null
    stdout.printf(\"npes: %d\\n\", JvmSignals::warmUpAndReadNull(500000, 1000));
    try {
        JvmSignals::readNull();
        stdout.print(\"readNull: no exception\\n\");
    } catch (hash<ExceptionInfo> ex) {
        stdout.printf(\"readNull: %s: %s\\n\", ex.err, ex.desc);
    }
    # safepoints, which compiled code polls with a load that faults when a safepoint is pending
    for (int i = 0; i < 5; ++i) {
        System::gc();
    }
}

#! sends the signal to the process while a ThreadPool worker runs
sub send_signal(string mode, int sig) {
    # a long-lived Qore thread with an external lifecycle: a ThreadPool worker that runs until the handler ends it
    ThreadPool tp(1, 1);
    Queue started();
    Queue stop();
    Queue done();
    tp.submit(sub () { started.push(1); stop.get(); });
    started.get();

    if (mode == \"handler\") {
        set_signal_handler(sig, sub (int s) {
            stdout.printf(\"handled: %d\\n\", s);
            stdout.sync();
            stop.push(1);
            done.push(1);
        });
    }
    stdout.print(\"ready\\n\");
    stdout.sync();
    kill(getpid(), sig);
    # in default mode, the process is ended by the signal while it waits here
    done.get();
    tp.stop();
}

# a Java call starts the JVM
stdout.printf(\"java: %s\\n\", System::getProperty(\"java.version\"));
stdout.printf(\"pid: %d\\n\", getpid());
stdout.printf(\"libjsig: %y\\n\", has_libjsig());
stdout.printf(\"sigcgt: %s\\n\", caught_signals());
JvmSignals::addShutdownHookMarker(\"java-shutdown-hook\");
stdout.sync();

if (ARGV[0] == \"npe\") {
    npe();
} else {
    send_signal(ARGV[0], ARGV[1].toInt());
}
stdout.print(\"exiting\\n\");
stdout.sync();
";

        #! the line that libqore writes before it aborts when it is torn down with an active ThreadPool worker
        const AbortLine = "external native threads still active";

        #! the JVM's synchronous signals: its handlers must be installed (SIGILL, SIGBUS, SIGFPE, SIGSEGV)
        const JvmHandledSignals = (SIGILL, SIGBUS, SIGFPE, SIGSEGV);

        #! the signals that Qore owns: the JVM must not install handlers for them
        const QoreOwnedSignals = (SIGHUP, SIGINT, SIGQUIT, SIGTERM);
    }

    private {
        #! the temporary directory with the child's script
        TmpDir tmp("jni-sigterm-libjsig-");

        #! the child's script
        string script;

        #! the path of libjsig.so of the JVM that this process runs, if found
        *string libjsig;
    }

    constructor() : Test("JniSigtermLibjsig", "1.0") {
        addTestCase("libjsig preloaded", \libjsigTest());
        addTestCase("without libjsig", \noLibjsigTest());
        addTestCase("implicit null checks with libjsig", \implicitNullCheckLibjsigTest());
        addTestCase("implicit null checks without libjsig", \implicitNullCheckNoLibjsigTest());

        set_return_value(main());
    }

    globalSetUp() {
        script = tmp.path + DirSep + "child.q";
        File f();
        f.open2(script, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(sprintf("%%modern\n%%prepend-module-path \"%s\"\n%%requires jni\n"
            "%%module-cmd(jni) add-classpath %s\n", dirname(get_module_hash().jni.filename),
            get_script_dir() + "qore-jni-test.jar") + ChildSource);
        f.close();
        libjsig = findLibjsig();
    }

    libjsigTest() {
        if (!libjsig) {
            testSkip("libjsig.so of the JVM was not found");
        }
        signalCases(libjsig, True);
    }

    noLibjsigTest() {
        signalCases("", False);
    }

    implicitNullCheckLibjsigTest() {
        if (!libjsig) {
            testSkip("libjsig.so of the JVM was not found");
        }
        npeCase(libjsig, True);
    }

    implicitNullCheckNoLibjsigTest() {
        npeCase("", False);
    }

    private:internal signalCases(string preload, bool with_libjsig) {
        checkProc();
        # the last case: the JVM option that turns reduced signals off is overridden by the module
        list<hash<auto>> cases = map ("sig": $1, "args": ""), (SIGTERM, SIGINT, SIGHUP);
        cases += {"sig": SIGTERM, "args": "-XX:-ReduceSignalUsage"};
        foreach hash<auto> c in (cases) {
            int sig = c.sig;
            hash<auto> res = run(preload, "handler", sig, c.args);
            checkLibjsig(res, with_libjsig);
            string label = sprintf("%s with a handler%s", SignalToName{sig}, c.args ? " and " + c.args : "");
            assertEq(-1, res.out.find(AbortLine), label + ": no abort");
            assertRegex("(^|\n)handled: " + sig + "\n", res.out, label + ": the Qore handler ran");
            assertEq(0, res.rc, label + ": exit status: " + res.out);
            assertRegex("(^|\n)exiting\n", res.out, label + ": the program ended normally");
            # the JVM is destroyed when the process ends normally, which runs its shutdown hooks
            assertRegex("(^|\n)exiting\njava-shutdown-hook\n", res.out, label + ": the JVM was destroyed at the end");
            checkHandlers(res);
        }

        # without a handler, Qore ends the process with _Exit(): the JVM's shutdown hooks do not run, as they do
        # when the JVM ends the process with System.exit(); Qore does not end a process that was started with
        # SIGTERM ignored (as with nohup), and the child would then wait forever
        if (isIgnored(SIGTERM)) {
            return;
        }
        hash<auto> res = run(preload, "default", SIGTERM);
        checkLibjsig(res, with_libjsig);
        assertRegex("(^|\n)ready\n", res.out, "SIGTERM without a handler: the child was ready");
        assertEq(-1, res.out.find(AbortLine), "SIGTERM without a handler: no abort");
        assertEq(-1, res.out.find("java-shutdown-hook"), "SIGTERM without a handler: Qore ended the process");
        assertEq(128 + SIGTERM, res.rc, "SIGTERM without a handler: exit status: " + res.out);
        assertEq(-1, res.out.find("exiting"), "SIGTERM without a handler: the program did not continue");
        checkHandlers(res);
    }

    #! checks that the JVM's own use of SIGSEGV still works with reduced signals
    /** This guards against side effects of reduced signals, with and without libjsig: it passes without the fix too.
        A NullPointerException raised by compiled code can come from the implicit null check (a SIGSEGV that the
        JVM's handler turns into the exception) or from code that the JIT compilers recompiled with an explicit check
        after earlier null calls
    */
    private:internal npeCase(string preload, bool with_libjsig) {
        checkProc();
        # -Xbatch makes compilation synchronous, so JvmSignals::read() is compiled before it is called with null;
        # compilations are logged to a file, as JVM threads writing to the child's output could split its lines
        string jit_log = tmp.path + DirSep + "jit.log";
        hash<auto> res = run(preload, "npe", 0, "-Xbatch -Xlog:jit+compilation=debug:file=" + jit_log);
        checkLibjsig(res, with_libjsig);
        assertEq(0, res.rc, "exit status: " + res.out);
        assertRegex("org\\.qore\\.jni\\.test\\.JvmSignals::read \\(", ReadOnlyFile::readTextFile(jit_log),
            "the JIT compiled the field read");
        assertRegex("(^|\n)npes: 1000\n", res.out, "each null call raised a NullPointerException");
        assertRegex("(^|\n)readNull: JNI-ERROR: java.lang.NullPointerException", res.out,
            "the NullPointerException is raised to Qore");
        assertRegex("(^|\n)exiting\n", res.out, "the program ended normally");
        checkHandlers(res);
    }

    #! checks the child's report of libjsig; skips the test case if a process without libjsig cannot be tested
    private:internal checkLibjsig(hash<auto> res, bool with_libjsig) {
        *string jsig = (res.out =~ x/(?:^|\n)libjsig: (True|False)\n/)[0];
        if (!exists jsig) {
            fail("the child did not report libjsig: " + res.out);
        }
        if (!with_libjsig && jsig == "True") {
            testSkip("libjsig is linked into qore, so a process without it cannot be tested");
        }
        assertEq(with_libjsig ? "True" : "False", jsig, "libjsig in the child");
    }

    #! checks the signals that the child has handlers for, which it reported after the JVM had started
    private:internal checkHandlers(hash<auto> res) {
        *string cgt = (res.out =~ x/(?:^|\n)sigcgt: ([0-9a-f]+)\n/)[0];
        if (!exists cgt) {
            fail("the child did not report its signal handlers: " + res.out);
        }
        # the standard signals (1 - 32) are in the low 32 bits
        int mask = strtoint(cgt.substr(-8), 16);
        foreach int sig in (JvmHandledSignals) {
            assertTrue((mask & (1 << (sig - 1))) != 0, sprintf("the JVM handles %s", SignalToName{sig}));
        }
        foreach int sig in (QoreOwnedSignals) {
            assertEq(0, mask & (1 << (sig - 1)), sprintf("the JVM leaves %s to Qore", SignalToName{sig}));
        }
    }

    #! runs the child and returns its exit status and output
    /** JVM options inherited from the environment are removed, so that only \a jvm_args are added to the module's
    */
    private:internal hash<auto> run(string preload, string mode, int sig, string jvm_args = "") {
        int rc;
        string out = backquote(sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "-u QORE_JNI_DISABLE_JIT -u QORE_JNI_JVM_ARGS -u QORE_JNI_DEBUG -u QORE_JNI_MIN_HEAP_SIZE "
            "-u QORE_JNI_MAX_HEAP_SIZE %sLD_PRELOAD=%s %s --enable-debug %s %s %d 2>&1",
            jvm_args ? "QORE_JNI_JVM_ARGS=" + shellQuote(jvm_args) + " " : "", shellQuote(preload),
            shellQuote(QORE_ARGV[0]), shellQuote(script), mode, sig), \rc);
        if (m_options.verbose > 2) {
            printf("mode %s sig %d preload %y JVM args %y: rc %d\n%s\n", mode, sig, preload, jvm_args, rc, out);
        }
        # with reduced signals, the JVM creates its attach socket at startup and removes it at exit() only, so a
        # child that Qore ended with _Exit() leaves it behind
        *string pid = (out =~ x/(?:^|\n)pid: ([0-9]+)\n/)[0];
        if (pid) {
            string sock = "/tmp/.java_pid" + pid;
            if (is_socket(sock)) {
                unlink(sock);
            }
        }
        return {"rc": rc, "out": out};
    }

    private:internal static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }

    #! skips the test case if the process cannot be inspected through /proc
    private:internal checkProc() {
        if (!is_file("/proc/self/status") || !is_file("/proc/self/maps")) {
            testSkip("no /proc file system");
        }
    }

    #! returns True if this process, and therefore the child, has the signal ignored
    private:internal static bool isIgnored(int sig) {
        *string ign = (ReadOnlyFile::readTextFile("/proc/self/status") =~ x/^SigIgn:\s*([0-9a-f]+)$/m)[0];
        return ign ? (strtoint(ign.substr(-8), 16) & (1 << (sig - 1))) != 0 : False;
    }

    #! returns the path of libjsig.so in the directory of the libjvm.so that this process has loaded
    private:internal static *string findLibjsig() {
        if (!is_file("/proc/self/maps")) {
            return;
        }
        *string jvm = (ReadOnlyFile::readTextFile("/proc/self/maps") =~ x/(\/\S*\/libjvm\.so)$/m)[0];
        if (!jvm) {
            return;
        }
        string path = dirname(jvm) + DirSep + "libjsig.so";
        return is_file(path) ? path : NOTHING;
    }
}
