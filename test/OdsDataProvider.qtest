    testColumnsPastZ() {
        assertEq(0, OdsReadDataProvider::getColumnIndex("a"));
        assertEq(0, OdsReadDataProvider::getColumnIndex("-"));
        assertEq(25, OdsReadDataProvider::getColumnIndex("Z"));
        assertEq(26, OdsReadDataProvider::getColumnIndex("aa"));
        assertEq(52, OdsReadDataProvider::getColumnIndex("bA"));

        # "z" < "aa" by column position even though it sorts after it as a string
        assertEq("aa", OdsReadDataProvider::parseRange("z1:aa10").end.column);
        assertThrows("ODS-INVALID-LOCATION", \OdsReadDataProvider::parseRange(), "aa1:z10");
        assertThrows("ODS-INVALID-LOCATION", \OdsReadDataProvider::parseRange(), "c1:B2");

        hash<auto> opts = {"header_cells": "z1", "data_cells": "aa2"};
        assertEq("aa", OdsReadDataProvider::processCellOptions(opts).data_cells.start.column);
        opts = {"header_cells": "aa1", "data_cells": "z2"};
        assertThrows("ODS-INVALID-LOCATION", \OdsReadDataProvider::processCellOptions(), opts);

        # read a sheet whose headers and data are in columns Y-AB
        hash<auto> rec = map {sprintf("c%d", $1): $1}, xrange(1, 29);
        OdsWriteDataProvider wdp({"headers": keys rec});
        wdp.createRecord(rec);
        OdsReadDataProvider dp({"data": wdp.getData(), "header_cells": "y1:ab1", "data_cells": "y2:ab2"});
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(({"c25": 25.0, "c26": 26.0, "c27": 27.0, "c28": 28.0},), records);
    }

