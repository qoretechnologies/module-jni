    #! the worksheet option selects by name (with case) or by 0-based position, and the
    #! worksheet_pattern option by a regular expression matching exactly one name
    testWorksheetSelection() {
        code<list<auto>(hash<auto>)> read = list<auto> sub (hash<auto> opts) {
            OdsReadDataProvider dp(test_data_dir + "/multi-sheet.ods", {"header_names": True} + opts);
            return map $1, dp.searchRecords();
        };
        list<auto> products = read({"worksheet": "Products"});
        assertTrue(products.size() > 0);
        assertEq(products, read({"worksheet": "1"}), "by position");
        assertEq(products, read({"worksheet_pattern": "^Prod"}), "by pattern");
        assertEq(products, read({"worksheet_pattern": "(?i)^products$"}), "by pattern without regard to case");
        assertEq(read({}), read({"worksheet_pattern": "^Users$"}), "the first worksheet");
        assertThrows("ODS-WORKSHEET-NOT-FOUND", read, ({"worksheet": "PRODUCTS"},),
            "names are matched with case");

        hash<ExceptionInfo> ex;
        try {
            read({"worksheet_pattern": "^(Users|Orders)$"});
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("ODS-WORKSHEET-AMBIGUOUS", ex.err);
        assertEq({"worksheet_pattern": "^(Users|Orders)$", "matches": ("Users", "Orders"),
            "available": ("Users", "Products", "Orders")}, ex.arg);
        assertThrows("ODS-WORKSHEET-NOT-FOUND", "Invoices", read, ({"worksheet_pattern": "Invoices"},));

        # the options conflict, and the pattern must be a valid regular expression
        assertThrows("ODS-READ-OPTION-ERROR", "worksheet_pattern", sub () {
            new OdsReadDataProvider(test_data_dir + "/multi-sheet.ods", {"worksheet": "Users",
                "worksheet_pattern": "^U"});
        });
        assertThrows("ODS-READ-OPTION-ERROR", "regular expression", sub () {
            new OdsReadDataProvider({"path": test_data_dir + "/multi-sheet.ods", "worksheet_pattern": "("})
                .searchRecords();
        });

        # the option metadata
        hash<auto> opts = OdsReadDataProvider::ConstructorOptions;
        assertEq(OI_Conflicts, AbstractDataProvider::getOptionInteractions(opts.worksheet_pattern)[0].kind);
        assertEq("worksheet", AbstractDataProvider::getOptionInteractions(opts.worksheet_pattern)[0].option);
        assertEq("worksheet_pattern", AbstractDataProvider::getOptionInteractions(opts.worksheet)[0].option);
        # ignore_empty: the default stops at the first empty row
        assertFalse(opts.ignore_empty.default_value);
        assertEq({"false": "stop", "true": "skip"}, opts.ignore_empty.metadata.empty_row_handling);
    }

