    testWorksheetOptionsCtor() {
        binary data = ReadOnlyFile::readBinaryFile(test_data_dir + "/multi-sheet.ods");
        string sheet = (new OdsReadDataProvider({"data": data})).getChildProviderNames()[1];

        # inline data
        OdsWorksheetReadDataProvider dp({"data": data, "worksheet": sheet, "header_names": True});
        list<hash<auto>> from_data = map $1, dp.searchRecords();
        assertTrue(from_data.size() > 0);

        # path, resolved as a file location
        dp = new OdsWorksheetReadDataProvider({"path": "file://" + test_data_dir + "/multi-sheet.ods",
            "worksheet": sheet, "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # stream
        dp = new OdsWorksheetReadDataProvider({"stream": new BinaryInputStream(data), "worksheet": sheet,
            "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # path constructor, resolved as a file location (plain path and file:// URL)
        dp = new OdsWorksheetReadDataProvider(test_data_dir + "/multi-sheet.ods", "name", sheet, {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());
        dp = new OdsWorksheetReadDataProvider("file://" + test_data_dir + "/multi-sheet.ods", "name", sheet,
            {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # only one input source is allowed
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            OdsWorksheetReadDataProvider wdp({"data": data, "path": test_data_dir + "/multi-sheet.ods"});
        });
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            OdsWorksheetReadDataProvider wdp({"data": data, "stream": new BinaryInputStream(data)});
        });
    }

    testWriteHeadersFromFirstRecord() {
        # the first record defines the columns and keeps its value types (it was previously copied down a row,
        # which turned its dates into strings); later records are written by those columns
        OdsWriteDataProvider dp();
        date d = 2026-01-02T00:00:00;
        dp.createRecord({"B": 1, "A": d, "F": True});
        dp.createRecord({"A": d + 1D, "C": "ignored", "B": 2, "F": False});
        dp.createRecord({"B": 3});

        OdsReadDataProvider rdp({"data": dp.getData(), "header_names": True});
        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(3, records.size());
        assertEq(("B", "A", "F"), keys records[0]);
        assertEq(1.0, records[0].B);
        assertEq("date", records[0].A.type());
        assertEq(d, records[0].A);
        assertEq(True, records[0].F);
        assertEq(2.0, records[1].B);
        assertEq(d + 1D, records[1].A);
        assertEq(False, records[1].F);
        assertEq(3.0, records[2].B);
        assertEq(NOTHING, records[2].A);
    }

    # runs the action the way an action runner does: the provider is built from the action's class and constructor
    # options, the records are created, and finishCreate() completes the action and returns the generated data
    testWriteDataAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("ODS", "write-data");
        assertEq(DPAD_CREATE_OUTPUT, action.output_data_type);
        assertFalse(exists action.options.stream);
        AbstractDataProvider prov = Class::forName(action.cls).newObject({"headers": ("Sku", "Qty")});
        prov.createRecordsBulkWithOptions({"recs": {"Sku": ("A-1", "B-2"), "Qty": (5, 7)}});
        hash<auto> output = prov.finishCreate();
        assertEq(output, action.output_type.acceptsValue(output));
        assertEq(2, output.record_count);
        assertEq(Type::Binary, output.data.type());
        assertEq("PK", output.data.substr(0, 2).toString());
        OdsReadDataProvider rdp({"data": output.data, "header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5.0}, {"Sku": "B-2", "Qty": 7.0}), (map $1, rdp.searchRecords()));
    }

    testWriterRecordType() {
        # the headers option defines the columns
        OdsWriteDataProvider dp({"headers": ("Sku", "Qty")});
        assertEq(("Sku", "Qty"), keys dp.getRecordType());
        assertEq(("Sku", "Qty"), keys dp.getCreateRecordTypeWithOptions());
        # without headers, the first record's keys define the columns: an open record type
        dp = new OdsWriteDataProvider();
        assertNothing(dp.getRecordType());
        assertEq({}, dp.getOrNothingRecordTypeWithOptions());
    }

    testReadEmptyRows() {
        # a header row, two data rows separated by an empty row, and two trailing empty rows
        OdsWriteDataProvider wdp({"headers": ("Sku", "Qty")});
        wdp.createRecord({"Sku": "A-1", "Qty": 5});
        wdp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        wdp.createRecord({"Sku": "B-2", "Qty": 7});
        wdp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        wdp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        binary data = wdp.getData();

        # default: reading stops at the first empty row
        OdsReadDataProvider dp({"data": data, "header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5.0},), (map $1, dp.searchRecords()));

        # ignore_empty: empty rows are skipped, trailing empty rows end the iteration
        dp = new OdsReadDataProvider({"data": data, "header_names": True, "ignore_empty": True});
        assertEq(({"Sku": "A-1", "Qty": 5.0}, {"Sku": "B-2", "Qty": 7.0}), (map $1, dp.searchRecords()));

        # ignore_empty stays within data_cells
        dp = new OdsReadDataProvider({"data": data, "header_names": True, "ignore_empty": True,
            "data_cells": "a2:b3"});
        assertEq(({"Sku": "A-1", "Qty": 5.0},), (map $1, dp.searchRecords()));
    }

    testReadRepeatedEmptyRows() {
        # spreadsheet applications store runs of empty rows as one repeated row element: a million empty rows are
        # skipped without materializing them
        string path = test_data_dir + "/repeated-empty-rows.ods";
        OdsReadDataProvider dp(path, {"header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5.0},), (map $1, dp.searchRecords()));

        date start = now_us();
        dp = new OdsReadDataProvider(path, {"header_names": True, "ignore_empty": True});
        assertEq(({"Sku": "A-1", "Qty": 5.0}, {"Sku": "C-3", "Qty": 9.0}), (map $1, dp.searchRecords()));
        assertLt(10s, now_us() - start, "the repeated empty rows were not iterated one by one");
    }

    testProfileGrid() {
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(
            ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.ods"), 1000);
        assertEq("ods", grid.format);
        assertEq(("Confirmations", "Lookup"), (map $1.name, grid.sheets));
        hash<TabularSheetGrid> sheet = grid.sheets[0];
        assertFalse(sheet.hidden);
        assertTrue(grid.sheets[1].hidden, "the lookup sheet is hidden");
        assertEq(6, sheet.rows.size(), "rows are read up to the last row with content");
        assertEq((), sheet.rows[1], "an empty row is an empty list");
        assertEq(("PO-1001", "000123", 5.0, "10.10.2026"), sheet.rows[3]);
        assertEq((<TabularCellRange>{"first_row": 0, "last_row": 0, "first_col": 0, "last_col": 3},), sheet.merged);
        assertEq({"C6": "SUM(C4:C5)"}, sheet.formulas, "the ODF formula is returned in A1 notation");
        assertEq({"Rates": "$Lookup.$A$1:.$B$2"}, grid.named_ranges);

        grid = OdsProfileDataProvider::readWorkbookGrid(
            ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.ods"), 2);
        assertEq(2, grid.sheets[0].rows.size());
        assertEq(6, grid.sheets[0].row_count);

        # a million repeated empty rows are never expanded
        date start = now_us();
        grid = OdsProfileDataProvider::readWorkbookGrid(
            ReadOnlyFile::readBinaryFile(test_data_dir + "/repeated-empty-rows.ods"), 10);
        assertEq(10, grid.sheets[0].rows.size());
        assertEq(1000003, grid.sheets[0].row_count, "the row count ends at the last row with content");
        assertLt(30s, now_us() - start, "repeated empty rows are counted, not expanded");
    }

