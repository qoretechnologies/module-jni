%modern

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires Util
%requires DataProvider
%requires json
%requires FsUtil
%requires jni

# Add classpaths for ODFDOM and the test helper BEFORE loading OdsDataProvider
# so they share the same classloader context
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/qore-dataprovider-ods.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/odfdom-java-0.13.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/xercesImpl-2.12.2.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/serializer-2.7.3.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-lang3-3.20.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-compress-1.28.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-codec-1.19.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-io-2.20.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-logging-1.3.5.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-collections-3.2.2.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-collections4-4.4.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-csv-1.10.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-validator-1.10.1.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-beanutils-1.11.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-digester-2.1.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/commons-cli-1.5.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/slf4j-api-1.7.30.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/slf4j-nop-1.7.30.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/json-20251224.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/bcprov-jdk18on-1.83.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/caffeine-3.1.8.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/checker-qual-3.37.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/error_prone_annotations-2.21.1.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/collection-0.7.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/java-rdfa-1.0.0-BETA1.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/jena-core-4.10.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/jena-base-4.10.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/jena-iri-4.10.0.jar
%module-cmd(jni) add-relative-classpath ../qlib/OdsDataProvider/jar/RoaringBitmap-1.0.0.jar
%module-cmd(jni) import org.qore.dataprovider.ods.OdsTestHelper
%module-cmd(jni) import org.qore.dataprovider.ods.OdsIterator
%module-cmd(jni) import java.lang.System

%requires OdsDataProvider

%exec-class OdsDataProviderTest

public class OdsDataProviderTest inherits QUnit::Test {
    public {
        #! the number of data rows of the large document
        const LargeRows = 200000;
        #! the JVM heap of the child process that reads a large document
        const ChildHeap = "64m";
    }

    private {
        string test_data_dir;
    }

    constructor() : Test("OdsDataProviderTest", "1.0", \ARGV) {
        # Get absolute path for test data directory
        string script_dir = get_script_dir();
        if (script_dir == ".") {
            script_dir = getcwd();
        }
        test_data_dir = script_dir + "/ods-test-data";

        addTestCase("test setup", \testSetup());
        addTestCase("basic read from path", \testBasicReadPath());
        addTestCase("read from stream", \testReadStream());
        addTestCase("read from binary data", \testReadBinaryData());
        addTestCase("header_cells option", \testHeaderCells());
        addTestCase("data_cells option", \testDataCells());
        addTestCase("headers option", \testHeaders());
        addTestCase("header_names option", \testHeaderNames());
        addTestCase("tolwr option", \testTolwr());
        addTestCase("timezone option", \testTimezone());
        addTestCase("date and time cells are their clock time in the timezone", \testWallClockTimes());
        addTestCase("worksheet option", \testWorksheet());
        addTestCase("cell range parsing", \testCellRangeParsing());
        addTestCase("data types", \testDataTypes());
        addTestCase("multi-sheet navigation", \testMultiSheet());
        addTestCase("factory tests", \testFactory());
        addTestCase("negative: invalid path", \testNegativeInvalidPath());
        addTestCase("negative: invalid worksheet", \testNegativeInvalidWorksheet());
        addTestCase("negative: invalid cell range", \testNegativeInvalidCellRange());
        addTestCase("negative: option conflicts", \testNegativeOptionConflicts());
        addTestCase("edge case: empty worksheet", \testEdgeCaseEmptyWorksheet());
        addTestCase("edge case: no headers", \testEdgeCaseNoHeaders());
        addTestCase("edge case: special characters", \testEdgeCaseSpecialChars());
        addTestCase("write: basic file write", \testWriteBasic());
        addTestCase("write: with headers", \testWriteWithHeaders());
        addTestCase("write: to binary data", \testWriteToBinary());
        addTestCase("write: factory", \testWriteFactory());
        addTestCase("write: data only (no path/stream)", \testWriteDataOnly());
        addTestCase("write: negative - path+stream conflict", \testWriteNegativePathStreamConflict());
        addTestCase("action registration", \testActionRegistration());
        addTestCase("roundtrip: write and read", \testRoundtrip());
        addTestCase("read: no header options reads from the first row", \testReadFromFirstRow());
        addTestCase("cell ranges: columns past Z", \testColumnsPastZ());
        addTestCase("negative: headers + header_names in every constructor", \testHeaderOptionConflictAllCtors());
        addTestCase("worksheet provider: options constructor", \testWorksheetOptionsCtor());
        addTestCase("write: headers from the first record", \testWriteHeadersFromFirstRecord());

        addTestCase("write-data action returns the generated data", \testWriteDataAction());
        addTestCase("writer record type", \testWriterRecordType());
        addTestCase("read: empty rows", \testReadEmptyRows());
        addTestCase("read: repeated empty rows", \testReadRepeatedEmptyRows());
        addTestCase("profile: raw spreadsheet grid", \testProfileGrid());
        addTestCase("profile action", \testProfileAction());
        addTestCase("read: the workbook is reusable in any call order", \testWorkbookReuse());
        addTestCase("read: row groups, header rows, repeated and covered cells", \testStructuredTable());
        addTestCase("read: a large document is read in bounded memory", \testLargeDocument());
        addTestCase("read: closing an iteration early releases the document", \testEarlyClose());
        set_return_value(main());
    }

    testSetup() {
        # Create test data directory and files
        if (!is_dir(test_data_dir)) {
            mkdir(test_data_dir);
        }

        # Create all test ODS files
        OdsTestHelper::createSimpleOds(test_data_dir + "/simple.ods");
        OdsTestHelper::createMultiSheetOds(test_data_dir + "/multi-sheet.ods");
        OdsTestHelper::createDatesOds(test_data_dir + "/dates.ods");
        OdsTestHelper::createDateTimesOds(test_data_dir + "/date-times.ods");
        OdsTestHelper::createEmptyOds(test_data_dir + "/empty.ods");
        OdsTestHelper::createNoHeadersOds(test_data_dir + "/no-headers.ods");
        OdsTestHelper::createRepeatedEmptyRowsOds(test_data_dir + "/repeated-empty-rows.ods");
        OdsTestHelper::createSpecialCharsOds(test_data_dir + "/special-chars.ods");
        OdsTestHelper::createMixedCaseHeadersOds(test_data_dir + "/mixed-case-headers.ods");
        OdsTestHelper::createOffsetDataOds(test_data_dir + "/offset-data.ods");
        OdsTestHelper::createDataTypesOds(test_data_dir + "/data-types.ods");
        OdsTestHelper::createProfileOds(test_data_dir + "/profile.ods");

        assertTrue(is_file(test_data_dir + "/simple.ods"), "simple.ods created");
    }

    testBasicReadPath() {
        OdsReadDataProvider dp(test_data_dir + "/simple.ods", {
            "header_names": True,
        });

        assertEq("OdsReadDataProvider", dp.getInfo().type);
        assertTrue(dp.getInfo().supports_read);
        assertTrue(dp.getInfo().has_record);

        # Read all records
        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(3, records.size(), "should have 3 data rows");
        assertEq("Alice", records[0].Name);
        assertEq(30.0, records[0].Age);
        assertEq("New York", records[0].City);

        assertEq("Bob", records[1].Name);
        assertEq(25.0, records[1].Age);

        assertEq("Charlie", records[2].Name);
        assertEq(35.0, records[2].Age);
    }

    testReadStream() {
        FileInputStream fis(test_data_dir + "/simple.ods");
        OdsReadDataProvider dp(fis, {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(3, records.size());
        assertEq("Alice", records[0].Name);
    }

    testReadBinaryData() {
        binary data = OdsTestHelper::createSimpleOdsBytes();

        OdsReadDataProvider dp({
            "data": data,
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(2, records.size(), "should have 2 data rows");
        assertEq("Alice", records[0].Name);
        assertEq(30.0, records[0].Age);
    }

    testHeaderCells() {
        # Test with explicit header cells range
        OdsReadDataProvider dp(test_data_dir + "/offset-data.ods", {
            "header_cells": "b3",
            "data_cells": "b4:d5",
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(2, records.size());
        assertEq("A", records[0].Col1);
        assertEq("B", records[0].Col2);
        assertEq("C", records[0].Col3);
        assertEq("D", records[1].Col1);
    }

    testDataCells() {
        OdsReadDataProvider dp(test_data_dir + "/simple.ods", {
            "header_cells": "a1:c1",
            "data_cells": "a2:c3",
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        # Should only get 2 rows due to data_cells limit
        assertEq(2, records.size());
        assertEq("Alice", records[0].Name);
        assertEq("Bob", records[1].Name);
    }

    testHeaders() {
        OdsReadDataProvider dp(test_data_dir + "/no-headers.ods", {
            "headers": ("Field1", "Field2", "Field3"),
            "data_cells": "a1",
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(2, records.size());
        assertEq("value1", records[0].Field1);
        assertEq(100.0, records[0].Field2);
        assertTrue(records[0].Field3);
    }

    testHeaderNames() {
        # When header_names is true without header_cells, should default to row 1
        OdsReadDataProvider dp(test_data_dir + "/simple.ods", {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(3, records.size());
        assertTrue(records[0].hasKey("Name"), "should have Name header");
        assertEq("Alice", records[0].Name);
    }

    testTolwr() {
        OdsReadDataProvider dp(test_data_dir + "/mixed-case-headers.ods", {
            "header_names": True,
            "tolwr": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(1, records.size());
        # Headers should be converted to lowercase
        assertTrue(records[0].hasKey("firstname"), "should have lowercase header 'firstname'");
        assertTrue(records[0].hasKey("last_name"), "should have lowercase header 'last_name'");
        assertTrue(records[0].hasKey("email_address"), "should have lowercase header 'email_address'");
        assertEq("John", records[0].firstname);
    }

    testTimezone() {
        OdsReadDataProvider dp(test_data_dir + "/dates.ods", {
            "header_names": True,
            "timezone": "America/New_York",
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(2, records.size());
        assertTrue(records[0].Date instanceof date, "Date should be a date type");
    }

    testWallClockTimes() {
        # the file has no zone: each cell is its written clock time in the zone the reader is given, whatever
        # the zone of the JVM, as for Excel
        foreach string zone in (("America/New_York", "Europe/Prague", "Asia/Tokyo", "UTC")) {
            OdsReadDataProvider dp(test_data_dir + "/date-times.ods", {"header_names": True, "timezone": zone});
            hash<auto> r = (map $1, dp.searchRecords())[0];
            TimeZone tz(zone);
            assertEq(tz.date("2025-01-15 00:00:00", "YYYY-MM-DD HH:mm:SS"), r.Date, zone + ": a date");
            assertEq(tz.date("2025-07-01 14:30:05", "YYYY-MM-DD HH:mm:SS"), r.DateTime, zone + ": a date and time");
            # a time cell: its clock time, in the zone
            assertEq("09:45:00", r.Time.format("HH:mm:SS"), zone + ": a time");
            assertEq(tz.date(r.Time.format("YYYY-MM-DD HH:mm:SS"), "YYYY-MM-DD HH:mm:SS"), r.Time,
                zone + ": a time in the zone");
        }
    }

    testWorksheet() {
        OdsReadDataProvider dp(test_data_dir + "/multi-sheet.ods", {
            "worksheet": "Products",
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(1, records.size());
        assertEq("A001", records[0].SKU);
        assertEq("Widget", records[0].Product);
    }

    testCellRangeParsing() {
        # Test parseRange
        hash<OdsCellRangeInfo> range = OdsReadDataProvider::parseRange("a1:e10");
        assertEq("a", range.start.column);
        assertEq(1, range.start.row);
        assertEq("e", range.end.column);
        assertEq(10, range.end.row);

        # Test single cell (becomes a range with special end marker)
        range = OdsReadDataProvider::parseRange("b5");
        assertEq("b", range.start.column);
        assertEq(5, range.start.row);
        assertEq("-", range.end.column);
        assertEq(-1, range.end.row);

        # Test row-only range
        range = OdsReadDataProvider::parseRange("1:5");
        assertEq("-", range.start.column);
        assertEq(1, range.start.row);
        assertEq("-", range.end.column);
        assertEq(5, range.end.row);

        # Test parseCellLocation
        hash<OdsCellLocationInfo> loc = OdsReadDataProvider::parseCellLocation("c3");
        assertEq("c", loc.column);
        assertEq(3, loc.row);
    }

    testDataTypes() {
        OdsReadDataProvider dp(test_data_dir + "/data-types.ods", {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(2, records.size());

        # Check first row data types
        assertEq("text", records[0].String);
        assertEq(42.0, records[0].Integer);
        assertEq(Type::Float, records[0].Float.type());
        assertTrue(abs(records[0].Float - 3.14159) < 0.0001, "Float value should be approximately 3.14159");
        assertTrue(records[0].Boolean);
        assertTrue(records[0].Date instanceof date, "Date should be a date type");

        # Check second row
        assertEq("another", records[1].String);
        assertFalse(records[1].Boolean);
    }

    testMultiSheet() {
        OdsReadDataProvider dp(test_data_dir + "/multi-sheet.ods", {
            "header_names": True,
        });

        # Get child provider names (worksheets)
        *list<string> sheets = dp.getChildProviderNames();

        assertEq(3, sheets.size(), "should have 3 worksheets");
        assertTrue(sheets.contains("Users"), "should contain 'Users' sheet");
        assertTrue(sheets.contains("Products"), "should contain 'Products' sheet");
        assertTrue(sheets.contains("Orders"), "should contain 'Orders' sheet");

        # Get specific child provider - note: child providers need header_names option too
        *AbstractDataProvider child = dp.getChildProvider("Products");
        assertTrue(exists child, "should get Products child provider");

        # The child provider already has the options from the parent
        list<hash<auto>> records = map $1, child.searchRecords();
        assertEq(1, records.size());
        assertEq("Widget", records[0].Product);
    }

    testFactory() {
        OdsReadDataProviderFactory factory();

        assertEq("odsread", factory.getInfo().name);
        assertTrue(factory.getInfo().children_can_support_records);

        # Create provider via factory
        AbstractDataProvider dp = factory.create({
            "path": test_data_dir + "/simple.ods",
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(3, records.size());
    }

    testNegativeInvalidPath() {
        # Invalid path should throw an exception
        bool threw = False;
        try {
            OdsReadDataProvider dp("/nonexistent/path/to/file.ods");
            dp.searchRecords();
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
            assertTrue(ex.desc.contains("No such file") || ex.desc.contains("FileNotFoundException"),
                "should mention file not found");
        }
        assertTrue(threw, "should throw exception for invalid path");
    }

    testNegativeInvalidWorksheet() {
        # Invalid worksheet should throw an exception
        bool threw = False;
        try {
            OdsReadDataProvider dp(test_data_dir + "/simple.ods", {
                "worksheet": "NonexistentSheet",
            });
            dp.searchRecords();
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
            assertTrue(ex.desc.contains("unknown"), "should mention unknown sheet");
        }
        assertTrue(threw, "should throw exception for invalid worksheet");
    }

    testNegativeInvalidCellRange() {
        # Invalid range format
        assertThrows("ODS-INVALID-LOCATION", sub () {
            OdsReadDataProvider::parseRange("invalid");
        });

        # Start after end
        assertThrows("ODS-INVALID-LOCATION", sub () {
            OdsReadDataProvider::parseRange("e1:a1");
        });

        # Invalid row number
        assertThrows("ODS-INVALID-LOCATION", sub () {
            OdsReadDataProvider::parseCellLocation("a0");
        });
    }

    testNegativeOptionConflicts() {
        # Test headers and header_names conflict
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            OdsReadDataProvider dp({
                "path": test_data_dir + "/simple.ods",
                "headers": ("A", "B", "C"),
                "header_names": True,
            });
        });

        # Test path and stream conflict
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            FileInputStream fis(test_data_dir + "/simple.ods");
            OdsReadDataProvider dp({
                "path": test_data_dir + "/simple.ods",
                "stream": fis,
            });
        });

        # Test path and data conflict
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            OdsReadDataProvider dp({
                "path": test_data_dir + "/simple.ods",
                "data": <abcd>,
            });
        });
    }

    testEdgeCaseEmptyWorksheet() {
        OdsReadDataProvider dp(test_data_dir + "/empty.ods");

        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(0, records.size(), "empty worksheet should return no records");
    }

    testEdgeCaseNoHeaders() {
        # Without headers option, we need to specify data_cells to tell where data starts
        # Since no-headers.ods has raw data starting from row 1
        OdsReadDataProvider dp(test_data_dir + "/no-headers.ods", {
            "data_cells": "a1",
            "headers": ("Col1", "Col2", "Col3"),
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(2, records.size());
        assertEq("value1", records[0].Col1);
        assertEq(100.0, records[0].Col2);
    }

    testEdgeCaseSpecialChars() {
        OdsReadDataProvider dp(test_data_dir + "/special-chars.ods", {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, dp.searchRecords();

        assertEq(3, records.size());
        assertEq("Cafe", records[0].Name);
        assertEq("Tokyo", records[1].Name);
        assertEq("He said \"hello\"", records[2].Description);
    }

    testWriteBasic() {
        string output_path = test_data_dir + "/write-test.ods";
        on_exit unlink(output_path);

        OdsWriteDataProvider dp(output_path, {
            "worksheet": "TestSheet",
        });

        # Write some records
        dp.createRecord({"Name": "Alice", "Age": 30, "Active": True});
        dp.createRecord({"Name": "Bob", "Age": 25, "Active": False});

        # Commit to write the file
        dp.commit();

        # Read back and verify
        OdsReadDataProvider rdp(output_path, {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, rdp.searchRecords();

        assertEq(2, records.size());
        assertEq("Alice", records[0].Name);
        assertEq(30.0, records[0].Age);
        assertTrue(records[0].Active);
        assertEq("Bob", records[1].Name);
        assertFalse(records[1].Active);
    }

    testWriteWithHeaders() {
        string output_path = test_data_dir + "/write-headers-test.ods";
        on_exit unlink(output_path);

        OdsWriteDataProvider dp(output_path, {
            "headers": ("FirstName", "LastName", "Score"),
        });

        dp.createRecord({"FirstName": "John", "LastName": "Doe", "Score": 95.5});
        dp.createRecord({"FirstName": "Jane", "LastName": "Smith", "Score": 87.3});

        dp.commit();

        # Verify with read
        OdsReadDataProvider rdp(output_path, {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, rdp.searchRecords();

        assertEq(2, records.size());
        assertTrue(records[0].hasKey("FirstName"), "should have predefined header");
        assertEq("John", records[0].FirstName);
        assertEq(95.5, records[0].Score);
    }

    testWriteToBinary() {
        OdsWriteDataProvider dp({
            "path": test_data_dir + "/write-binary-test.ods",
        });

        dp.createRecord({"Key": "value1", "Number": 100});
        dp.createRecord({"Key": "value2", "Number": 200});

        # Get data as binary before commit
        binary data = dp.getData();

        assertTrue(data.size() > 0, "should have binary data");

        # Read back from binary
        OdsReadDataProvider rdp({
            "data": data,
            "header_names": True,
        });

        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(2, records.size());
        assertEq("value1", records[0].Key);
    }

    testWriteFactory() {
        string output_path = test_data_dir + "/write-factory-test.ods";
        on_exit unlink(output_path);

        OdsWriteDataProviderFactory factory();

        assertEq("odswrite", factory.getInfo().name);

        # Create provider via factory
        AbstractDataProvider dp = factory.create({
            "path": output_path,
            "worksheet": "FactorySheet",
        });

        dp.createRecord({"Test": "factory"});
        dp.commit();

        # Verify can read back
        OdsReadDataProvider rdp(output_path, {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(1, records.size());
        assertEq("factory", records[0].Test);
    }

    testWriteDataOnly() {
        # Test creating a provider without path or stream (for write-data action use case)
        OdsWriteDataProvider dp({
            "worksheet": "DataSheet",
            "headers": ("Name", "Value"),
        });

        assertEq("ods-data", dp.getName());

        # Write records
        dp.createRecord({"Name": "item1", "Value": 100});
        dp.createRecord({"Name": "item2", "Value": 200});

        # Get binary data
        binary data = dp.getData();
        assertTrue(data.size() > 0, "should have binary data");

        # Verify by reading back
        OdsReadDataProvider rdp({
            "data": data,
            "header_names": True,
        });

        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(2, records.size());
        assertEq("item1", records[0].Name);
        assertEq(100.0, records[0].Value);
        assertEq("item2", records[1].Name);
        assertEq(200.0, records[1].Value);
    }

