        assertRegex("NonexistentSheet", ex.desc);
        assertRegex("Users.*Products.*Orders", ex.desc);
        assertEq({"worksheet": "NonexistentSheet", "available": ("Users", "Products", "Orders")}, ex.arg);
        # the record type raises the same error
        assertThrows("ODS-WORKSHEET-NOT-FOUND", sub () {
