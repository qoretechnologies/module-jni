            "worksheet": sheet, "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # stream
        dp = new OdsWorksheetReadDataProvider({"stream": new BinaryInputStream(data), "worksheet": sheet,
            "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # path constructor, resolved as a file location (plain path and file:// URL)
        dp = new OdsWorksheetReadDataProvider(test_data_dir + "/multi-sheet.ods", "name", sheet, {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());
        dp = new OdsWorksheetReadDataProvider("file://" + test_data_dir + "/multi-sheet.ods", "name", sheet,
            {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # only one input source is allowed
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            OdsWorksheetReadDataProvider wdp({"data": data, "path": test_data_dir + "/multi-sheet.ods"});
        });
        assertThrows("ODS-READ-OPTION-ERROR", sub () {
            OdsWorksheetReadDataProvider wdp({"data": data, "stream": new BinaryInputStream(data)});
        });
    }

    testWriteHeadersFromFirstRecord() {
        # the first record defines the columns and keeps its value types (it was previously copied down a row,
        # which turned its dates into strings); later records are written by those columns
        OdsWriteDataProvider dp();
        date d = 2026-01-02T00:00:00;
        dp.createRecord({"B": 1, "A": d, "F": True});
        dp.createRecord({"A": d + 1D, "C": "ignored", "B": 2, "F": False});
        dp.createRecord({"B": 3});

        OdsReadDataProvider rdp({"data": dp.getData(), "header_names": True});
        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(3, records.size());
        assertEq(("B", "A", "F"), keys records[0]);
        assertEq(1, records[0].B);
        assertEq("date", records[0].A.type());
        assertEq(d, records[0].A);
        assertEq(True, records[0].F);
        assertEq(2, records[1].B);
        assertEq(d + 1D, records[1].A);
        assertEq(False, records[1].F);
        assertEq(3, records[2].B);
        assertEq(NOTHING, records[2].A);
    }

    # runs the action the way an action runner does: the provider is built from the action's class and constructor
    # options, the records are created, and finishCreate() completes the action and returns the generated data
    testWriteDataAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("ODS", "write-data");
        assertEq(DPAD_CREATE_OUTPUT, action.output_data_type);
        assertFalse(exists action.options.stream);
        AbstractDataProvider prov = Class::forName(action.cls).newObject({"headers": ("Sku", "Qty")});
        prov.createRecordsBulkWithOptions({"recs": {"Sku": ("A-1", "B-2"), "Qty": (5, 7)}});
        hash<auto> output = prov.finishCreate();
        assertEq(output, action.output_type.acceptsValue(output));
        assertEq(2, output.record_count);
        assertEq(Type::Binary, output.data.type());
        assertEq("PK", output.data.substr(0, 2).toString());
        OdsReadDataProvider rdp({"data": output.data, "header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5}, {"Sku": "B-2", "Qty": 7}), (map $1, rdp.searchRecords()));
    }

    testWriterRecordType() {
        # the headers option defines the columns
        OdsWriteDataProvider dp({"headers": ("Sku", "Qty")});
        assertEq(("Sku", "Qty"), keys dp.getRecordType());
        assertEq(("Sku", "Qty"), keys dp.getCreateRecordTypeWithOptions());
        # without headers, the first record's keys define the columns: an open record type
        dp = new OdsWriteDataProvider();
        assertNothing(dp.getRecordType());
        assertEq({}, dp.getOrNothingRecordTypeWithOptions());
    }

    testReadEmptyRows() {
        # a header row, two data rows separated by an empty row, and two trailing empty rows
        OdsWriteDataProvider wdp({"headers": ("Sku", "Qty")});
        wdp.createRecord({"Sku": "A-1", "Qty": 5});
        wdp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        wdp.createRecord({"Sku": "B-2", "Qty": 7});
        wdp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        wdp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        binary data = wdp.getData();

        # default: reading stops at the first empty row
        OdsReadDataProvider dp({"data": data, "header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5},), (map $1, dp.searchRecords()));

        # ignore_empty: empty rows are skipped, trailing empty rows end the iteration
        dp = new OdsReadDataProvider({"data": data, "header_names": True, "ignore_empty": True});
        assertEq(({"Sku": "A-1", "Qty": 5}, {"Sku": "B-2", "Qty": 7}), (map $1, dp.searchRecords()));

        # ignore_empty stays within data_cells
        dp = new OdsReadDataProvider({"data": data, "header_names": True, "ignore_empty": True,
            "data_cells": "a2:b3"});
        assertEq(({"Sku": "A-1", "Qty": 5},), (map $1, dp.searchRecords()));
        # Keeping empty records is explicit and bounded, including trailing rows and child providers.
        foreach bool skip in ((False, True)) {
            dp = new OdsReadDataProvider({"data": data, "header_names": True,
                "ignore_empty": skip, "preserve_empty_rows": True});
            list<hash<auto>> kept = map $1, dp.searchRecords();
            assertEq(5, kept.size());
            assertEq({"Sku": NOTHING, "Qty": NOTHING}, kept[1]);
            assertEq({"Sku": NOTHING, "Qty": NOTHING}, kept[4]);
            assertEq("B-2", kept[2].Sku);
        }
        dp = new OdsReadDataProvider({"data": data, "header_names": True,
            "preserve_empty_rows": True, "data_cells": "a2:b3"});
        list<hash<auto>> bounded = map $1, dp.getChildProviderEx("Sheet1").searchRecords();
        assertEq(2, bounded.size());
        assertEq({"Sku": NOTHING, "Qty": NOTHING}, bounded[1]);

        OdsWriteDataProvider empty_writer({"headers": ("Sku", "Qty"), "write_headers": False});
        empty_writer.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        empty_writer.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        dp = new OdsReadDataProvider({"data": empty_writer.getData(), "headers": ("Sku", "Qty"),
            "preserve_empty_rows": True});
        list<hash<auto>> empty_records = map $1, dp.searchRecords();
        assertEq(({"Sku": NOTHING, "Qty": NOTHING}, {"Sku": NOTHING, "Qty": NOTHING}), empty_records);

        OdsWriteDataProvider offset_writer({"headers": ("Sku", "Qty"), "header_row": 3});
        offset_writer.createRecord({"Sku": "A-1", "Qty": 5});
        dp = new OdsReadDataProvider({"data": offset_writer.getData(), "headers": ("Sku", "Qty"),
            "preserve_empty_rows": True, "data_cells": "a1:b3"});
        list<hash<auto>> offset_records = map $1, dp.searchRecords();
        assertEq(3, offset_records.size(), "gaps before the first stored row are preserved");
        assertEq({"Sku": NOTHING, "Qty": NOTHING}, offset_records[0]);
        assertEq({"Sku": "Sku", "Qty": "Qty"}, offset_records[2]);

    }

    testReadRepeatedEmptyRows() {
        # spreadsheet applications store runs of empty rows as one repeated row element: a million empty rows are
        # skipped without materializing them
        string path = test_data_dir + "/repeated-empty-rows.ods";
        OdsReadDataProvider dp(path, {"header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5},), (map $1, dp.searchRecords()));

        date start = now_us();
        dp = new OdsReadDataProvider(path, {"header_names": True, "ignore_empty": True});
        assertEq(({"Sku": "A-1", "Qty": 5}, {"Sku": "C-3", "Qty": 9}), (map $1, dp.searchRecords()));
        assertLt(10s, now_us() - start, "the repeated empty rows were not iterated one by one");
    }

    testProfileGrid() {
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(
            ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.ods"), 1000);
        assertEq("ods", grid.format);
        assertEq(("Confirmations", "Lookup"), (map $1.name, grid.sheets));
        hash<TabularSheetGrid> sheet = grid.sheets[0];
        assertFalse(sheet.hidden);
        assertTrue(grid.sheets[1].hidden, "the lookup sheet is hidden");
        assertEq(6, sheet.rows.size(), "rows are read up to the last row with content");
        assertEq((), sheet.rows[1], "an empty row is an empty list");
        assertEq(("PO-1001", "000123", 5.0, "10.10.2026"), sheet.rows[3]);
        assertEq((<TabularCellRange>{"first_row": 0, "last_row": 0, "first_col": 0, "last_col": 3},), sheet.merged);
        assertEq({"C6": "SUM(C4:C5)"}, sheet.formulas, "the ODF formula is returned in A1 notation");
        assertEq({"Rates": "$Lookup.$A$1:.$B$2"}, grid.named_ranges);

        grid = OdsProfileDataProvider::readWorkbookGrid(
            ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.ods"), 2);
        assertEq(2, grid.sheets[0].rows.size());
        assertEq(6, grid.sheets[0].row_count);

        # a million repeated empty rows are never expanded
        date start = now_us();
        grid = OdsProfileDataProvider::readWorkbookGrid(
            ReadOnlyFile::readBinaryFile(test_data_dir + "/repeated-empty-rows.ods"), 10);
        assertEq(10, grid.sheets[0].rows.size());
        assertEq(1000003, grid.sheets[0].row_count, "the row count ends at the last row with content");
        assertLt(30s, now_us() - start, "repeated empty rows are counted, not expanded");
    }

    testProfileAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("ODS", "profile");
        assertEq(DPAT_API, action.action_code);
        assertEq("TabularWorkbookProfile", action.output_type.getName());

        hash<auto> opts = {"path": test_data_dir + "/profile.ods"};
        AbstractDataProvider prov = DataProviderActionCatalog::getDataProviderForAction(action, \opts);
        hash<auto> profile = prov.doRequest(opts);
        assertEq(profile, action.output_type.acceptsValue(profile));
        hash<auto> sheet = profile.sheets[0];
        assertEq(3, sheet.header_row);
        assertEq((1,), sheet.title_rows);
        assertEq((6,), sheet.totals_rows);
        assertEq(("string", "string", "int", "date"), (map $1.type, sheet.columns));
        assertEq("DD.MM.YYYY", sheet.columns[3].date_format);
        assertEq(("XX-9999", "999999", "9", "99.99.9999"), sheet.samples[0]);
        assertTrue(profile.sheets[1].hidden);

        profile = prov.doRequest({"data": ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.ods"),
            "redact": False, "sample_rows": 1});
        assertEq((("PO-1001", "000123", 5.0, "10.10.2026"),), profile.sheets[0].samples);
        assertThrows("TABULAR-PROFILE-ERROR", "exactly one", \prov.doRequest(), {});
    }

    #! The record type, the records, the worksheet names, and worksheet providers can be acquired in any order
    /** Qorus reads the provider info (and with it the worksheet names) after the record type when it executes an
        action; the worksheet names were then read from the input stream already consumed by the record type
    */
    testWorkbookReuse() {
        string path = test_data_dir + "/multi-sheet.ods";
        binary data = ReadOnlyFile::readBinaryFile(path);
        hash<auto> opts = {"worksheet": "Users", "header_names": True};
        hash<string, code> sources = {
            "data": OdsReadDataProvider sub () {
                return new OdsReadDataProvider(opts + {"data": data});
            },
            "stream": OdsReadDataProvider sub () {
                return new OdsReadDataProvider(opts + {"stream": new BinaryInputStream(data)});
            },
            "path": OdsReadDataProvider sub () {
                return new OdsReadDataProvider(opts + {"path": path});
            },
            "stream constructor": OdsReadDataProvider sub () {
                return new OdsReadDataProvider(new BinaryInputStream(data), opts);
            },
            "path constructor": OdsReadDataProvider sub () {
                return new OdsReadDataProvider(path, opts);
            },
        };
        list<string> sheets = ("Users", "Products", "Orders");
        foreach hash<auto> i in (sources.pairIterator()) {
            # the record type, then the provider info, as Qorus acquires them when executing an action
            OdsReadDataProvider dp = i.value();
            assertEq(("ID", "Username"), keys dp.getRecordType(), i.key);
            assertEq(sheets, dp.getInfo().children, i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);
            assertEq(sheets, dp.getChildProviderNames(), i.key);
            assertEq(("Widget",), (map $1.Product, dp.getChildProvider("Products").searchRecords()), i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);

            # a worksheet provider first, then the parent's own worksheet
            dp = i.value();
            assertEq((1001,), (map $1.OrderID.toInt(), dp.getChildProvider("Orders").searchRecords()), i.key);
            assertEq(sheets, dp.getChildProviderNames(), i.key);
            assertEq(("ID", "Username"), keys dp.getRecordType(), i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);
        }

        # a provider without input has no worksheets, record fields, or records
        OdsReadDataProvider empty();
        assertEq(NOTHING, empty.getChildProviderNames());
        assertEq({}, empty.getRecordType());
    }

    testStructuredTable() {
        string path = test_data_dir + "/structured.ods";
        OdsTestHelper::createStructuredOds(path);

        list<hash<auto>> expected = (
            # a row in table:table-header-rows (a row to repeat on printed pages)
            {"Sku": "A-1", "Qty": 5, "Note": "x", "Day": 2025-03-01T00:00:00Z},
            # rows in a row group; the second row element is repeated for two rows
            {"Sku": "B-2", "Qty": 6, "Note": "y", "Day": 2025-03-02T00:00:00Z},
            {"Sku": "C-3", "Qty": 7, "Note": "z", "Day": 2025-03-03T00:00:00Z},
            {"Sku": "C-3", "Qty": 7, "Note": "z", "Day": 2025-03-03T00:00:00Z},
            # a cell repeated over two columns and a covered (merged) cell
            {"Sku": "D-4", "Qty": 8, "Note": 8.0, "Day": NOTHING},
        );
        OdsReadDataProvider dp(path, {"header_names": True, "timezone": "UTC"});
        assertEq(("Sku", "Qty", "Note", "Day"), keys dp.getRecordType());
        # reading stops at the empty row 7
        assertEq(expected, (map $1, dp.searchRecords()));
        # each iteration reads the table from its first data row
        assertEq(expected, (map $1, dp.searchRecords()));

        # spaces, tabs, and line breaks are part of the text
        dp = new OdsReadDataProvider(path, {"header_names": True, "timezone": "UTC", "ignore_empty": True});
        assertEq(expected + ({"Sku": "E-5", "Qty": 9, "Note": "a   b\tc\nd", "Day": 2025-03-08T00:00:00Z},),
            (map $1, dp.searchRecords()));

        # data cells within the repeated rows
        dp = new OdsReadDataProvider(path, {"header_names": True, "timezone": "UTC", "data_cells": "a5:c6"});
        assertEq(({"Sku": "C-3", "Qty": 7, "Note": "z"}, {"Sku": "D-4", "Qty": 8, "Note": 8.0}),
            (map $1, dp.searchRecords()));
    }

    testLargeDocument() {
        # a table with 200000 rows is read with a JVM heap far smaller than the document loaded in memory needs;
        # a child process has its own JVM with a 64 MB heap
        string path = test_data_dir + "/large.ods";
        on_exit unlink(path);
        OdsTestHelper::createLargeOds(path, LargeRows);

        string src = sprintf("%%modern
%%prepend-module-path \"%s/../qlib\"
%%requires DataProvider
%%requires json
%%requires OdsDataProvider

OdsReadDataProvider dp({\"path\": ARGV[0], \"header_names\": True, \"timezone\": \"UTC\"});
AbstractDataProviderRecordIterator i = dp.searchRecords();
int count = 0;
int mismatches = 0;
int repeated = 0;
int rows = ARGV[1].toInt();
while (i.next()) {
    hash<auto> r = i.getValue();
    ++count;
    if (count > rows) {
        # the rows of the repeated row element at the end
        if (r == {\"Id\": -1.0, \"Name\": \"repeated\", \"Amount\": 0.5, \"When\": 2025-06-30T12:00:00Z,
            \"Flag\": False}) {
            ++repeated;
        }
        continue;
    }
    if (keys r != (\"Id\", \"Name\", \"Amount\", \"When\", \"Flag\") || r.Id != count.toFloat()
        || r.Name != (\"name-\" + count) || r.Amount != (count / 4.0)
        || r.When != (2025-01-01T00:00:00Z + seconds(count)) || r.Flag != (count %% 2 == 0)) {
        ++mismatches;
    }
}
printf(\"RESULT:%%s\\n\", make_json({\"count\": count, \"mismatches\": mismatches, \"repeated\": repeated}));
", get_script_dir() == "." ? getcwd() : get_script_dir());
        hash<auto> result = runChild(src, path, LargeRows.toString());
        assertEq(LargeRows + 3, result.count);
        assertEq(0, result.mismatches);
        assertEq(3, result.repeated);
    }

    #! The grid of a document read as it is streamed is the grid that ODFDOM's document model gives, with every row
    #! limit
    testProfileGridStreamed() {
        list<string> files = sort(glob(test_data_dir + "/*.ods"));
        assertGt(10, files.size());
        foreach string path in (files) {
            # ODFDOM's document model fails on the cells of header rows and row groups; see testProfileStructured()
            if (basename(path) == "structured.ods") {
                continue;
            }
            foreach int max_rows in ((1, 2, 3, 5, 10000)) {
                assertEq(OdsTestHelper::readGridDom(path, max_rows),
                    OdsGridReader::readGrid(new FileInputStream(path), max_rows),
                    sprintf("%s max_rows %d", basename(path), max_rows));
            }
        }
    }

    #! A document with header rows, row groups, repeated rows and cells, and covered (merged) cells is profiled; the
    #! document model failed on the cells of header rows and row groups with a Java NullPointerException
    testProfileStructured() {
        string path = test_data_dir + "/structured.ods";
        OdsTestHelper::createStructuredOds(path);
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path),
            1000);
        hash<TabularSheetGrid> sheet = grid.sheets[0];
        # the rows up to the last row with content; the repeated row is two rows, and the empty row 7 is empty
        assertEq((
            ("Sku", "Qty", "Note", "Day"),
            ("A-1", 5.0, "x", 2025-03-01),
            ("B-2", 6.0, "y", 2025-03-02),
            ("C-3", 7.0, "z", 2025-03-03),
            ("C-3", 7.0, "z", 2025-03-03),
            ("D-4", 8.0, 8.0),
            (),
            ("E-5", 9.0, "a   b\tc\nd", 2025-03-08),
        ), sheet.rows);
        assertNothing(sheet.row_count);

        grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path), 3);
        assertEq(3, grid.sheets[0].rows.size());
        assertEq(8, grid.sheets[0].row_count);
    }

    #! A table with 200000 rows is profiled with a JVM heap far smaller than the document loaded in memory needs; a
    #! child process has its own JVM with a 64 MB heap
    testProfileLargeDocument() {
        string path = test_data_dir + "/large-profile.ods";
        on_exit unlink(path);
        OdsTestHelper::createLargeOds(path, LargeRows);

        string src = sprintf("%%modern
%%prepend-module-path \"%s/../qlib\"
%%requires DataProvider
%%requires json
%%requires OdsDataProvider

OdsProfileDataProvider prov();
hash<auto> profile = prov.doRequest({\"path\": ARGV[0], \"max_rows\": 1000});
hash<auto> sheet = profile.sheets[0];
printf(\"RESULT:%%s\\n\", make_json({\"format\": profile.format, \"row_count\": sheet.row_count,
    \"header_row\": sheet.header_row, \"columns\": (map $1.header, sheet.columns)}));
", get_script_dir() == "." ? getcwd() : get_script_dir());
        hash<auto> result = runChild(src, path, "");
        assertEq("ods", result.format);
        # the header row, the data rows, and the 3 repeated rows; the empty rows after them are not counted
        assertEq(LargeRows + 4, result.row_count);
        assertEq(1, result.header_row);
        assertEq(("Id", "Name", "Amount", "When", "Flag"), result.columns);
    }

    testEarlyClose() {
        string path = test_data_dir + "/early-close.ods";
        on_exit unlink(path);
        OdsTestHelper::createLargeOds(path, 20000);
        binary data = ReadOnlyFile::readBinaryFile(path);

        # a complete iteration first, so that later file counts do not include the JVM's class files
        {
            OdsIterator it(new BinaryInputStream(data), "");
            it.setHeaderCells("-", 1, "-", 1);
            int count = 0;
            while (it.next()) {
                ++count;
            }
            assertEq(20003, count);
            it.close();
        }
        list<string> temp_files = getTempFiles("qore-ods-");
        int open_files = countOpenFiles();

        OdsIterator it(new BinaryInputStream(data), "");
        it.setHeaderCells("-", 1, "-", 1);
        for (int i = 1; i <= 10; ++i) {
            assertTrue(it.next());
            assertEq(i.toFloat(), it.getValue().Id);
        }
        # the document is open while the iteration is in progress; its temporary copy is already deleted
        assertGt(open_files, countOpenFiles());
        assertEq(temp_files, getTempFiles("qore-ods-"));

        # closing the iterator in the middle of the table releases the document
        it.close();
        assertEq(open_files, countOpenFiles());
        assertEq(temp_files, getTempFiles("qore-ods-"));
        assertThrows("JNI-ERROR", "the ODS iterator is closed", \it.next());
    }

    testNumberFormats() {
        string path = test_data_dir + "/number-formats.ods";
        OdsTestHelper::createNumberFormatsOds(path);

        # a currency cell is its amount and a percentage cell its fraction; a cell without a value is its text
        OdsReadDataProvider dp(path, {"header_names": True});
        assertEq((
            {"Item": "A", "Price": 3.5, "Share": 0.25},
            {"Item": "B", "Price": -1250.75, "Share": 1.5},
            {"Item": "C", "Price": "n/a", "Share": 0.0},
        ), (map $1, dp.searchRecords()));

        # as header cells, the numbers are the header names
        dp = new OdsReadDataProvider(path, {"header_cells": "a2:c2", "data_cells": "a3:c3"});
        assertEq(("A", "3.5", "0.25"), keys dp.getRecordType());
        assertEq(({"A": "B", "3.5": -1250.75, "0.25": 1.5},), (map $1, dp.searchRecords()));

        # the profiler reads them as numbers as well
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path),
            10);
        assertEq(("A", 3.5, 0.25), grid.sheets[0].rows[1]);
        assertEq(("B", -1250.75, 1.5), grid.sheets[0].rows[2]);
        assertEq(("C", NOTHING, 0.0), grid.sheets[0].rows[3]);
    }

    testDaylightSaving() {
        string path = test_data_dir + "/daylight-saving.ods";
        OdsTestHelper::createDaylightSavingOds(path);

        # a date and time is its clock time in the reader's zone; a clock time in a gap of the reader's zone is moved
        # later by the length of the gap, and one that occurs twice is the earlier one, as java.time resolves them;
        # a time is its clock time on Excel's day zero, 1899-12-31, as for Excel
        hash<string, hash<string, string>> expected = {
            "Europe/Prague": {
                "prague-gap": "2025-03-30 03:30:00.000 +02:00",
                "ny-gap": "2025-03-09 02:30:00.000 +01:00",
                "prague-overlap": "2025-10-26 02:30:00.000 +02:00",
                "date-only": "2025-03-30 00:00:00.000 +01:00",
            },
            "America/New_York": {
                "prague-gap": "2025-03-30 02:30:00.000 -04:00",
                "ny-gap": "2025-03-09 03:30:00.000 -04:00",
                "prague-overlap": "2025-10-26 02:30:00.000 -04:00",
                "date-only": "2025-03-30 00:00:00.000 -04:00",
            },
        };
        hash<string, string> times = {
            "prague-gap": "1899-12-31 13:45:00.000",
            "ny-gap": "1900-01-01 12:00:00.000",
            "prague-overlap": "1899-12-31 00:00:00.000",
            "date-only": "1899-12-31 23:59:59.500",
        };
        foreach hash<auto> i in (expected.pairIterator()) {
            OdsReadDataProvider dp(path, {"header_names": True, "timezone": i.key});
            hash<string, string> when;
            hash<string, string> time;
            foreach hash<auto> r in (dp.searchRecords()) {
                when{r.Event} = r.When.format("YYYY-MM-DD HH:mm:SS.ms Z");
                time{r.Event} = r.Time.format("YYYY-MM-DD HH:mm:SS.ms");
            }
            assertEq(i.value, when, i.key);
            assertEq(times, time, i.key);
        }

        # the JVM's own zone does not change the clock times: a child process has a JVM in America/New_York and
        # reads the file in Europe/Prague
        string src = sprintf("%%modern
%%prepend-module-path \"%s/../qlib\"
%%requires DataProvider
%%requires json
%%requires OdsDataProvider

OdsReadDataProvider dp({\"path\": ARGV[0], \"header_names\": True, \"timezone\": \"Europe/Prague\"});
hash<string, string> rv;
foreach hash<auto> r in (dp.searchRecords()) {
    rv{r.Event} = r.When.format(\"YYYY-MM-DD HH:mm:SS.ms Z\") + \" \" + r.Time.format(\"YYYY-MM-DD HH:mm:SS.ms\");
}
printf(\"RESULT:%%s\\n\", make_json(rv));
", get_script_dir() == "." ? getcwd() : get_script_dir());
        hash<auto> result = runChild(src, path, "-", "TZ=America/New_York");
        assertEq((map {$1.key: $1.value + " " + times{$1.key}}, expected."Europe/Prague".pairIterator()), result);

        # the profiler reads date and time cells as the record reader does, in the JVM's zone
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path),
            10);
        assertEq("2025-03-30 00:00:00", grid.sheets[0].rows[4][1].format("YYYY-MM-DD HH:mm:SS"),
            "a date in the profile");
        assertEq("1899-12-31 13:45:00", grid.sheets[0].rows[1][2].format("YYYY-MM-DD HH:mm:SS"),
            "a time in the profile");
    }

    testOpenDataRange() {
        # without an end column and without headers, each row is read to its last cell with a value, not to the
        # last column of the table
        string path = test_data_dir + "/structured.ods";
        OdsTestHelper::createStructuredOds(path);
        OdsReadDataProvider dp(path, {"data_cells": "b2", "timezone": "UTC"});
        assertEq((
            {"A2": 5.0, "B2": "x", "C2": 2025-03-01T00:00:00Z},
            {"A3": 6.0, "B3": "y", "C3": 2025-03-02T00:00:00Z},
            {"A4": 7.0, "B4": "z", "C4": 2025-03-03T00:00:00Z},
            {"A5": 7.0, "B5": "z", "C5": 2025-03-03T00:00:00Z},
            # the covered cell after the repeated cell has no value
            {"A6": 8.0, "B6": 8.0},
        ), (map $1, dp.searchRecords()));

        # a row without a value from the start column is empty
        dp = new OdsReadDataProvider(path, {"data_cells": "c6", "ignore_empty": True});
        assertEq(({"A6": 8.0}, {"A8": "a   b\tc\nd", "B8": 2025-03-08T00:00:00}),
            (map $1, dp.searchRecords()));
    }

    testWorkbookFile() {
        string path = test_data_dir + "/workbook-file.ods";
        on_exit unlink(path);
        OdsTestHelper::createMultiSheetOds(path);
        list<string> temp_files = getTempFiles("qore-odsfile-");

        # the input stream is copied to a temporary file on first use, not read into memory
        OdsReadDataProvider dp(new FileInputStream(path), {"header_names": True});
        assertEq(temp_files, getTempFiles("qore-odsfile-"), "nothing is copied before the workbook is used");
        list<string> sheets = dp.getChildProviderNames();
        assertEq(elements temp_files + 1, elements getTempFiles("qore-odsfile-"), "the input is copied once");
        int records = elements (map $1, dp.searchRecords());
        assertGt(0, records);

        # a worksheet provider uses the same file, which is kept until the last provider using it is destroyed
        AbstractDataProvider ws = dp.getChildProviderEx(sheets[0]);
        assertEq(elements temp_files + 1, elements getTempFiles("qore-odsfile-"),
            "worksheet providers use the same file");
        delete dp;
        assertEq(elements temp_files + 1, elements getTempFiles("qore-odsfile-"),
            "the worksheet provider keeps the file");
        assertEq(records, elements (map $1, ws.searchRecords()));
        delete ws;
        assertEq(temp_files, getTempFiles("qore-odsfile-"), "the file is deleted with the last provider");

        # a provider given a path and data in the options works the same way
        foreach hash<auto> opts in ({"path": path}, {"data": ReadOnlyFile::readBinaryFile(path)}) {
            dp = new OdsReadDataProvider(opts + {"header_names": True});
            assertEq(sheets, dp.getChildProviderNames(), (keys opts)[0]);
            assertEq(records, elements (map $1, dp.searchRecords()), (keys opts)[0]);
            delete dp;
            assertEq(temp_files, getTempFiles("qore-odsfile-"), (keys opts)[0]);
        }
    }

    #! Runs a Qore program in a child process with a small JVM heap; returns the result it prints
    private hash<auto> runChild(string src, string arg1, string arg2, string env = "") {
        TmpFile tmp(NOTHING, ".qr");
        # the child loads the jni module that this test loaded
        tmp.file.write(sprintf("%%prepend-module-path \"%s\"\n", dirname(get_module_hash().jni.filename)) + src);
        tmp.file.close();
        string cmd = sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "QORE_JNI_MAX_HEAP_SIZE=%s %s %s --enable-debug %s %s %s 2>&1; echo CHILD_EXIT=$?", ChildHeap, env,
            shellQuote(qoreBin()), shellQuote(tmp.path), shellQuote(arg1), shellQuote(arg2));
        string output = trim(backquote(cmd));
        *string result = (output =~ x/^RESULT:(.*)$/m)[0];
        if (!result) {
            fail(sprintf("child process did not complete: %s", output));
        }
        assertRegex("CHILD_EXIT=0$", output);
        return parse_json(result);
    }

    #! Returns the number of open files of this process
    private static int countOpenFiles() {
        Dir dir();
        if (!dir.chdir("/dev/fd")) {
            throw "TEST-ERROR", "/dev/fd is not available";
        }
        return dir.list().size();
    }

    #! Returns the files with the given prefix in the JVM's temporary directory
    private static list<string> getTempFiles(string prefix) {
        Dir dir();
        dir.chdir(System::getProperty("java.io.tmpdir"));
        return sort(dir.list("^" + prefix) ?? ());
    }

    private string qoreBin() {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? ENV.QORE_EXECUTABLE ?? QORE_ARGV[0] ?? ARGV[0];
        assertTrue(exists qore_bin, "no qore binary path available");
        return qore_bin;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }

    testWriteDateTimes() {
        string path = test_data_dir + "/date-times-write.ods";
        on_exit unlink(path);
        list<date> dates = (2025-06-15T10:30:00, 2025-06-15T10:30:45.250, 2025-12-31T23:59:59, 2025-01-01T00:00:00);
        OdsWriteDataProvider dp(path, {"headers": ("When",)});
        map dp.createRecord({"When": $1}), dates;
        dp.finishCreate();

        # the clock time of each date is written with its seconds, as office:date-value is an xsd:dateTime
        assertEq(("2025-06-15T10:30:00", "2025-06-15T10:30:45.25", "2025-12-31T23:59:59", "2025-01-01T00:00:00"),
            (map OdsTestHelper::getDateValueAttribute(path, $1 + 1, 0), xrange(dates.size())));
        OdsReadDataProvider rdp(path, {"header_names": True});
        assertEq(dates, (map $1.When, rdp.searchRecords()));
    }

    testWriteColumnFormats() {
        string path = test_data_dir + "/column-formats.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": FormatHeaders, "column_formats": ColumnFormats});
        dp.createRecord(FormatRecord);
        dp.finishCreate();

        # the value type and data style of each cell, read with odfdom
        list<string> styles = OdsTestHelper::getCellDataStyles(path, 1, FormatHeaders.size());
        assertEq("string|", styles[0], "Name");
        assertRegex("^date\\|<number:date-style [^>]*number:format-source=\"fixed\"[^>]*>"
            "<number:day number:style=\"long\"/><number:text>\\.</number:text>"
            "<number:month number:style=\"long\"/><number:text>\\.</number:text>"
            "<number:year number:style=\"long\"/><number:text> </number:text>"
            "<number:hours number:style=\"long\"/><number:text>:</number:text>"
            "<number:minutes number:style=\"long\"/></number:date-style>$", styles[1], "Date");
        # the main style is the negative section, mapping values >= 0 to the positive section
        assertRegex("^float\\|<number:number-style [^>]*><number:text>\\(</number:text>"
            "<number:number number:decimal-places=\"2\" number:grouping=\"true\" number:min-decimal-places=\"2\" "
            "number:min-integer-digits=\"1\"/><number:text>\\)</number:text>"
            "<style:map style:apply-style-name=\"QoreFmt2P0\" style:condition=\"value\\(\\)&gt;=0\"/>"
            "</number:number-style> \\+ <number:number-style [^>]*style:name=\"QoreFmt2P0\"[^>]*>"
            "<number:number number:decimal-places=\"2\" number:grouping=\"true\" number:min-decimal-places=\"2\" "
            "number:min-integer-digits=\"1\"/></number:number-style>$", styles[2], "Amount");
        # a percentage cell holds the fraction
        assertRegex("^percentage\\|<number:percentage-style [^>]*>"
            "<number:number number:decimal-places=\"1\" number:min-decimal-places=\"1\" "
            "number:min-integer-digits=\"1\"/><number:text>%</number:text></number:percentage-style>$", styles[3],
            "Share");
        assertRegex("^string\\|<number:text-style [^>]*><number:text-content/></number:text-style>$", styles[4],
            "Code");
        assertEq("float|", styles[5], "Plain");
        assertEq("date|", styles[6], "Stamp");

        # the values keep their types: the percentage cell is read as its fraction, and dates keep their time
        OdsReadDataProvider rdp(path, {"header_names": True});
        assertEq((FormatRecord + {"Amount": -1234.5, "Plain": 42},), (map $1, rdp.searchRecords()));
    }

    testWriteColumnFormatsOtherValues() {
        string path = test_data_dir + "/column-formats-other.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": FormatHeaders, "column_formats": ColumnFormats});
        # a value of another kind than its column's code is written without the format; no value is an empty cell
        dp.createRecord({"Name": "b", "Date": 5, "Amount": "n/a", "Share": 2026-10-07T00:00:00, "Code": 3.5,
            "Plain": NOTHING, "Stamp": True});
        dp.finishCreate();
        assertEq(("string|", "float|", "string|", "date|", "float|", "null|", "boolean|"),
            OdsTestHelper::getCellDataStyles(path, 1, FormatHeaders.size()));
        OdsReadDataProvider rdp(path, {"header_names": True});
        assertEq(({"Name": "b", "Date": 5, "Amount": "n/a", "Share": 2026-10-07T00:00:00, "Code": 3.5,
            "Plain": NOTHING, "Stamp": True},), (map $1, rdp.searchRecords()));
    }

    testWriteColumnFormatStyles() {
        # a document without column formats, for the number of data styles a document has anyway
        string base_path = test_data_dir + "/styles-base.ods";
        on_exit unlink(base_path);
        OdsWriteDataProvider base(base_path, {"headers": ("A", "B", "C")});
        base.createRecord({"A": 1, "B": 2, "C": 3});
        base.finishCreate();

        # three columns with two distinct codes, one of them with two sections, and many rows
        string path = test_data_dir + "/styles.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": ("A", "B", "C"), "column_formats": {
            "A": "0.00", "B": "0.00", "C": "#,##0;(#,##0)",
        }});
        for (int i = 0; i < 500; ++i) {
            dp.createRecord({"A": i, "B": i * 2, "C": -i});
        }
        dp.finishCreate();
        assertEq(OdsTestHelper::getDataStyleCount(base_path) + 3, OdsTestHelper::getDataStyleCount(path));
        list<string> styles = OdsTestHelper::getCellDataStyles(path, 500, 3);
        assertEq(styles[0], styles[1]);
        assertRegex("^float\\|<number:number-style [^>]*><number:text>\\(</number:text>", styles[2]);
    }

    testWriteColumnFormatsFirstRecord() {
        string path = test_data_dir + "/column-formats-first-record.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"column_formats": {"Amount": "#,##0.00"}});
        dp.createRecord({"Name": "a", "Amount": 1234.5});
        dp.createRecord({"Name": "b", "Amount": 2});
        dp.finishCreate();
        foreach int row in (1, 2) {
            list<string> styles = OdsTestHelper::getCellDataStyles(path, row, 2);
            assertEq("string|", styles[0]);
            assertRegex("^float\\|<number:number-style [^>]*><number:number number:decimal-places=\"2\" "
                "number:grouping=\"true\"", styles[1]);
        }

        # a column format for a column that the first record does not have
        OdsWriteDataProvider bad({"column_formats": {"Amount": "0.00", "Total": "0.00"}});
        assertThrows("CREATE-RECORD-ERROR", "ODS-WRITE-OPTION-ERROR.*column \"Total\", which is not written",
            \bad.createRecord(), {"Name": "a", "Amount": 1});
        assertEq(0, bad.getCreatedCount());
    }

    testWriteNegativeColumnFormats() {
        # codes that odfdom's format string parser loops forever on are refused before odfdom sees them
        foreach string code in ("zz[[q", "[x]0", "0[", "[]0") {
            assertThrows("ODS-WRITE-OPTION-ERROR", "column \"A\": format code", sub () {
                OdsWriteDataProvider dp({"column_formats": {"A": code}});
            }, NOTHING, code);
        }
        # each constructor checks the codes
        assertThrows("ODS-WRITE-OPTION-ERROR", "column \"Amount\": format code \"#,##0.00 EUR\" has \"E\" at "
            "position 10, which must be quoted", sub () {
            OdsWriteDataProvider dp(test_data_dir + "/never.ods", {"column_formats": {"Amount": "#,##0.00 EUR"}});
        });
        assertThrows("ODS-WRITE-OPTION-ERROR", "General", sub () {
            OdsWriteDataProvider dp(new StringOutputStream(), {"column_formats": {"A": "General"}});
        });
        assertFalse(is_file(test_data_dir + "/never.ods"));
        # a column that is not in the headers
        assertThrows("ODS-WRITE-OPTION-ERROR", "column \"X\", which is not written; the columns written are: "
            "\\[\"A\"\\]", sub () {
            OdsWriteDataProvider dp({"headers": ("A",), "column_formats": {"A": "0", "X": "0"}});
        });
        # a format code must be a string: the option type check refuses other values
        assertThrows("RUNTIME-TYPE-ERROR", "option \"column_formats\" of type \"hash<string, string>\"", sub () {
            OdsWriteDataProvider dp({"column_formats": {"A": 1}});
        });
        assertNothing(OdsWriter::formatCodeIssue("#,##0.00;(#,##0.00)"));
        assertRegex("second decimal point", OdsWriter::formatCodeIssue("0.0.0") ?? "");
        # the Java writer refuses invalid codes and late formats too
        OdsWriter writer("Sheet1");
        on_exit writer.close();
        assertThrows("JNI-ERROR", "column \"A\": format code \"0.0.0\" has a second decimal point",
            \writer.setColumnFormats(), {"A": "0.0.0"});
        writer.writeRow({"A": 1});
        assertThrows("JNI-ERROR", "before any row is written", \writer.setColumnFormats(), {"A": "0"});
    }

    testColumnFormatsActionOption() {
        foreach string action in (("write", "write-data")) {
            hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("ODS", action);
            assertTrue(exists info.options.column_formats, action);
        }
        hash<DataProviderOptionInfo> opt = OdsWriteDataProvider::ConstructorOptions.column_formats;
        assertEq("hash<string, string>", opt.type[0].getName());
        # the example is a valid option value
        foreach hash<auto> i in (opt.example_value.pairIterator()) {
            assertNothing(OdsWriter::formatCodeIssue(i.value), i.key);
        }
    }

    testWriteColumnFormatsRendered() {
        *string soffice = findLibreOffice();
        if (!soffice) {
            testSkip("LibreOffice (soffice) is not installed");
        }
        string path = test_data_dir + "/column-formats-rendered.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": FormatHeaders, "column_formats": ColumnFormats});
        dp.createRecord(FormatRecord);
        dp.createRecord(FormatRecord + {"Amount": 1234567.891, "Share": 1});
        dp.finishCreate();
        # the columns without a format are shown in LibreOffice's default formats, which depend on its locale
        assertEq((
            {"Name": "a", "Date": "07.10.2026 13:45", "Amount": "(1,234.50)", "Share": "25.0%", "Code": "X1"},
            {"Name": "a", "Date": "07.10.2026 13:45", "Amount": "1,234,567.89", "Share": "100.0%", "Code": "X1"},
        ), (map $1{"Name", "Date", "Amount", "Share", "Code"}, renderWithLibreOffice(soffice, path)));
    }

    testColumnFormatsLikeExcel() {
        *string soffice = findLibreOffice();
        if (!soffice) {
            testSkip("LibreOffice (soffice) is not installed");
        }
        foreach hash<auto> i in ({
                "numbers": {"codes": NumberCodes, "values": NumberValues},
                "dates": {"codes": DateCodes, "values": DateValues},
                "text": {"codes": TextCodes, "values": TextValues},
            }.pairIterator()) {
            hash<string, string> formats = map {$1: $1}, i.value.codes;
            hash<string, list<hash<auto>>> rendered;
            foreach string ext in ("xlsx", "ods") {
                string path = sprintf("%s/like-excel-%s.%s", test_data_dir, i.key, ext);
                on_exit unlink(path);
                AbstractDataProvider dp = ext == "xlsx"
                    ? new ExcelWriteDataProvider(path, {"headers": i.value.codes, "column_formats": formats})
                    : new OdsWriteDataProvider(path, {"headers": i.value.codes, "column_formats": formats});
                map dp.createRecord(map {$1: i.value.values[$#]}, i.value.codes), xrange(i.value.values.size());
                dp.finishCreate();
                rendered{ext} = renderWithLibreOffice(soffice, path);
            }
            assertEq(i.value.values.size(), rendered.xlsx.size(), i.key);
            # each code is shown the same way in the .ods file as in the .xlsx file
            foreach string code in (i.value.codes) {
                assertEq((map $1{code}, rendered.xlsx), (map $1{code}, rendered.ods), i.key + ": " + code);
            }
        }
    }

    #! Returns the path of LibreOffice's soffice program, or NOTHING if it is not installed
    private static *string findLibreOffice() {
        foreach string dir in (ENV.PATH.split(":")) {
            string path = dir + "/soffice";
            if (is_executable(path)) {
                return path;
            }
        }
    }

    #! Returns the records of a spreadsheet's first sheet as LibreOffice shows its cells
    private list<hash<auto>> renderWithLibreOffice(string soffice, string path) {
        TmpDir dir("render-");
        # CSV with "save cell contents as shown"; the profile directory keeps a running LibreOffice out of the way
        string cmd = sprintf("%s -env:UserInstallation=file://%s/profile --headless --convert-to "
            "'csv:Text - txt - csv (StarCalc):44,34,76,1,,0,false,true,true' --outdir %s %s >/dev/null 2>&1",
            shellQuote(soffice), dir.path, shellQuote(dir.path), shellQuote(path));
        assertEq(0, system(cmd), cmd);
        string csv = sprintf("%s/%s.csv", dir.path, basename(path).split(".")[0]);
        return map $1, new CsvFileIterator(csv, {"header_names": True});
    }

    #! Returns TabularProfiler::hasTotalsFormula() if the DataProvider module has it (DataProvider 3.9 with
    #! qore e2005d254), otherwise NOTHING
    private static *code<bool(*hash<auto>)> getHasTotalsFormula() {
        try {
            hash<MethodAccessInfo> m = Class::forName("DataProvider::TabularProfiler")
                .findStaticMethod("hasTotalsFormula");
            StaticMethod method = cast<StaticMethod>(m.method);
            return bool sub (*hash<auto> formulas) {
                return method.call(formulas);
            };
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "UNKNOWN-METHOD") {
                rethrow;
            }
        }
    }

    #! A formula field returns the formulas of each record's cells as the profile gives them (qorus#646)
    testFormulaField() {
        *code<bool(*hash<auto>)> has_totals_formula = getHasTotalsFormula();
        string path = test_data_dir + "/formula-rows.ods";
        list<*hash<auto>> expected = (
            {"D2": "B2*C2"},
            {"D3": "SUM(B3:C3)"},
            {"D4": "SUM(B4:C4)"},
            {"B5": "SUM(B2:B4)", "D5": "SUBTOTAL(9;D2:D4)"},
            NOTHING,
        );
        OdsReadDataProvider dp({"path": path, "header_names": True, "formula_field": "_formulas"});
        hash<string, AbstractDataField> rec_type = dp.getRecordType();
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(5, records.size());
        assertEq(expected, (map $1._formulas, records));
        assertEq(("Item", "Qty", "Price", "Line", "Calc", "_formulas"), keys rec_type);
        assertEq("hash", rec_type._formulas.getType().getBaseTypeName());
        # values of formula cells are still their results
        assertEq((10, 7, 8, 25, 29), (map $1.Line, records));

        # the formulas are those of the profile of the sheet
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path),
            1000);
        hash<auto> all;
        map all += $1._formulas, records;
        assertEq(grid.sheets[0].formulas, all);

        # the shared totals row rule: only the totals row of formulas is a totals row; a line total is not
        if (has_totals_formula) {
            assertEq((False, False, False, True, False), (map has_totals_formula($1._formulas), records));
        } else {
            printf("skipped: TabularProfiler::hasTotalsFormula() needs DataProvider with qore e2005d254\n");
        }

        # the worksheet provider and the read-data input
        AbstractDataProvider sheet = new OdsReadDataProvider({"path": path, "header_names": True,
            "formula_field": "f"}).getChildProvider("Order");
        assertEq("f", (keys sheet.getRecordType())[5]);
        assertEq(expected, (map $1.f, sheet.searchRecords()));
        dp = new OdsReadDataProvider({"data": ReadOnlyFile::readBinaryFile(path), "header_names": True,
            "formula_field": "f"});
        assertEq(expected, (map $1.f, dp.searchRecords()));

        # a formula repeated over two columns and two rows is given for its first column and row, as the profile
        # gives it
        dp = new OdsReadDataProvider(test_data_dir + "/formula-repeated.ods", {"header_names": True,
            "formula_field": "_formulas"});
        records = map $1, dp.searchRecords();
        assertEq(7, records.size());
        assertEq(expected + ({"E7": "SUM(B7:C7)"}, NOTHING), (map $1._formulas, records));
        assertEq((2, 2), (map $1.Calc, records[5..6]));

        # a data range not starting at A1 gives the references of the sheet
        dp = new OdsReadDataProvider(path, {"header_cells": "b1:d1", "data_cells": "b3:d5",
            "formula_field": "_formulas"});
        records = map $1, dp.searchRecords();
        assertEq(("Qty", "Price", "Line", "_formulas"), keys records[0]);
        assertEq(expected[1..3], (map $1._formulas, records));

        # without the option there is no formula field
        dp = new OdsReadDataProvider({"path": path, "header_names": True});
        assertEq(("Item", "Qty", "Price", "Line", "Calc"), keys (map $1, dp.searchRecords())[0]);
    }

    #! A formula field name that is a column of the sheet is an error
    testFormulaFieldNegative() {
        string path = test_data_dir + "/formula-rows.ods";
        OdsReadDataProvider dp({"path": path, "header_names": True, "formula_field": "Line"});
        assertThrows("ODS-FORMULA-FIELD-ERROR", "Line", \dp.getRecordType());
        dp = new OdsReadDataProvider({"path": path, "data_cells": "a2:d2", "formula_field": "A2"});
        assertThrows("ODS-FORMULA-FIELD-ERROR", "A2", sub () { map $1, dp.searchRecords(); });
        assertThrows("ODS-FORMULA-FIELD-ERROR", sub () {
            OdsReadDataProvider p({"path": path, "formula_field": ""});
        });
        foreach string action in (("read", "read-data")) {
            hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("ODS", action);
            assertTrue(info.options.hasKey("formula_field"), action);
        }
    }

    #! A file that is not a readable ODS spreadsheet fails the read with the reader's error (qorus#646)
    /** A damaged file, another file type or an empty file fails before any record is returned; each raises
        @c JNI-ERROR, its description naming the Java exception.
    */
    testUnreadableFiles() {
        binary spreadsheet = File::readBinaryFile(test_data_dir + "/simple.ods");
        # the input -> the start of the description of the error its read raises
        hash<string, hash<auto>> cases = {
            "damaged (truncated)": {
                "data": spreadsheet.substr(0, spreadsheet.size() / 2),
                "exception": "java.util.zip.ZipException",
            },
            "a text file": {
                "data": binary("PO;SKU;Qty\n1;2;3\n"),
                "exception": "java.util.zip.ZipException",
            },
            "an empty file": {
                "data": binary(),
                "exception": "java.util.zip.ZipException",
            },
        };
        foreach hash<auto> i in (cases.pairIterator()) {
            *hash<ExceptionInfo> ex;
            int records = 0;
            try {
                OdsReadDataProvider dp({"data": i.value.data, "header_names": True});
                map ++records, dp.searchRecords();
            } catch (hash<ExceptionInfo> e) {
                ex = e;
            }
            assertEq("JNI-ERROR", ex.err, i.key);
            assertEq(0, ex.desc.find(i.value.exception), sprintf("%s: %s", i.key, ex.desc));
            assertEq(0, records, i.key + ": no record is returned");
        }
        OdsReadDataProvider dp({"data": spreadsheet, "header_names": True});
        assertTrue((map $1, dp.searchRecords()).size() > 0, "the intact spreadsheet reads");
    }

    #! Returns the records of a sheet read with the given options
    private list<hash<auto>> readOds(string file, *hash<auto> opts) {
        OdsReadDataProvider dp(test_data_dir + "/" + file, {"header_names": True, "timezone": "UTC"} + opts);
        return map $1, dp.searchRecords();
    }

    #! Returns the names of the types of the fields of a sheet read with the given options
    private hash<string, string> readOdsTypes(string file, *hash<auto> opts) {
        OdsReadDataProvider dp(test_data_dir + "/" + file, {"header_names": True} + opts);
        return map {$1.key: $1.value.getType().getName()}, dp.getRecordType().pairIterator();
    }

    #! Columns are typed from their values in the first rows
    testTypedColumns() {
        assertEq({
            "Id": "*int",
            "Price": "*float",
            "Paid": "*bool",
            "Shipped": "*date",
            "Name": "*string",
            "Note": "auto",
            "Empty": "auto",
        }, readOdsTypes("typed.ods"));
        list<hash<auto>> recs = readOds("typed.ods");
        assertEq(5, recs.size());
        assertEq((1, 2, 3, 4, 5), (map $1.Id, recs));
        assertEq(Type::Int, recs[0].Id.type());
        assertEq((1.25, 2.5, 3.75, 5.0, 6.25), (map $1.Price, recs));
        assertEq(Type::Float, recs[3].Price.type());
        assertEq((False, True, False, True, False), (map $1.Paid, recs));
        assertEq(2026-01-02T00:00:00Z, recs[0].Shipped);
        assertEq(Type::Date, recs[0].Shipped.type());
        assertEq("item-1", recs[0].Name);
        # a column of text and numbers is not converted
        assertEq(("n-1", 2.0, "n-3", 4.0, "n-5"), (map $1.Note, recs));
        assertEq((NOTHING, NOTHING, NOTHING, NOTHING, NOTHING), (map $1.Empty, recs));
        # the record type accepts the records
        OdsReadDataProvider dp(test_data_dir + "/typed.ods", {"header_names": True});
        hash<string, AbstractDataField> rec_type = dp.getRecordType();
        foreach hash<auto> rec in (recs) {
            map rec_type{$1.key}.getType().acceptsValue($1.value), rec.pairIterator();
        }
        # the worksheet provider of the file is typed as well, also after a search
        AbstractDataProvider sheet = dp.getChildProvider("Orders");
        assertEq((1, 2, 3, 4, 5), (map $1.Id, sheet.searchRecords()));
        assertEq("*int", sheet.getRecordType().Id.getType().getName());
        # each search reads the typed records again
        assertEq((1, 2, 3, 4, 5), (map $1.Id, dp.searchRecords()));
        assertEq((1, 2, 3, 4, 5), (map $1.Id, dp.searchRecords()));
    }

    #! type_sample_rows 0 reads every value as stored, with columns of any type
    testUntypedColumns() {
        list<hash<auto>> recs = readOds("typed.ods", {"type_sample_rows": 0});
        assertEq(1.0, recs[0].Id);
        assertEq(Type::Float, recs[0].Id.type());
        assertEq(("auto",), (keys (map {$1: True}, readOdsTypes("typed.ods", {"type_sample_rows": 0}).values())));
        # without headers, the fields are named by their cells and have no type
        OdsReadDataProvider dp(test_data_dir + "/typed.ods", {"data_cells": "a2:b3"});
        assertEq(({"A2": 1.0, "B2": 1.25}, {"A3": 2.0, "B3": 2.5}), (map $1, dp.searchRecords()));
    }

    #! column_types gives the type of columns
    testColumnTypes() {
        hash<auto> opts = {"column_types": {"Id": "float", "Note": "string", "Empty": "date", "Paid": "any",
            "Price": "number"}};
        hash<string, string> types = readOdsTypes("typed.ods", opts);
        assertEq("*float", types.Id);
        assertEq("*string", types.Note);
        assertEq("*date", types.Empty);
        assertEq("auto", types.Paid);
        assertEq("*number", types.Price);
        assertEq("*string", types.Name, "other columns are inferred");
        list<hash<auto>> recs = readOds("typed.ods", opts);
        assertEq((1.0, 2.0), (map $1.Id, recs[0..1]));
        assertEq(Type::Number, recs[0].Price.type());
        assertEq(1.25n, recs[0].Price);
        # numbers in a text column are converted to text
        assertEq(("n-1", "2", "n-3", "4", "n-5"), (map $1.Note, recs));
        # only the given columns are typed when there is no sampling
        types = readOdsTypes("typed.ods", opts + {"type_sample_rows": 0});
        assertEq("*float", types.Id);
        assertEq("auto", types.Name);

        assertThrows("ODS-READ-OPTION-ERROR", "column_types.*\"Id\".*\"bogus\"", \readOds(),
            ("typed.ods", {"column_types": {"Id": "bogus"}}));
        assertThrows("ODS-READ-OPTION-ERROR", "column_types.*\"Nope\".*not a column", \readOds(),
            ("typed.ods", {"column_types": {"Nope": "int"}}));
        assertThrows("ODS-READ-OPTION-ERROR", "type_sample_rows", \readOds(),
            ("typed.ods", {"type_sample_rows": -1}));
    }

    #! A value after the sampled rows that does not have its column's type fails the read, naming the remedy
    testTypeMismatch() {
        OdsReadDataProvider dp(test_data_dir + "/typed-mismatch.ods", {"header_names": True});
        assertEq("*int", dp.getRecordType().Id.getType().getName());
        int read = 0;
        *hash<ExceptionInfo> ex;
        try {
            map ++read, dp.searchRecords();
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("ODS-COLUMN-TYPE-ERROR", ex.err);
        assertEq(119, read, "the records before the value are read");
        assertRegex("worksheet \"Orders\" row 121 column \"Id\".*\"N/A\".*int.*first 100", ex.desc);
        assertRegex("column_types.*type_sample_rows", ex.desc);
        assertEq({"worksheet": "Orders", "row": 121, "column": "Id", "value": "N/A", "type": "int"},
            ex.arg{"worksheet", "row", "column", "value", "type"});

        # a given type names the option
        assertThrows("ODS-COLUMN-TYPE-ERROR", "row 121 column \"Price\".*\"free\".*given by \"column_types\"",
            \readOds(), ("typed-mismatch.ods", {"column_types": {"Id": "any", "Price": "float"}}));

        # the remedies
        list<hash<auto>> recs = readOds("typed-mismatch.ods", {"type_sample_rows": 150});
        assertEq(150, recs.size());
        assertEq("N/A", recs[119].Id);
        assertEq(1.0, recs[0].Id, "a column of numbers and text is not converted");
        recs = readOds("typed-mismatch.ods", {"column_types": {"Id": "string", "Price": "any"}});
        assertEq("1", recs[0].Id);
        assertEq("N/A", recs[119].Id);
    }

    #! An error cell fails the read by default, naming the ways to accept it
    testErrorCells() {
        *hash<ExceptionInfo> ex;
        try {
            readOds("errors.ods");
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("ODS-CELL-ERROR", ex.err);
        assertRegex("worksheet \"Rates\" cell B2 \\(column \"Ratio\"\\).*#DIV/0!", ex.desc);
        assertRegex("error_cells.*\"null\".*\"text\".*error_field", ex.desc);
        assertEq({"worksheet": "Rates", "cell": "B2", "row": 2, "column": "Ratio", "error": "#DIV/0!"},
            ex.arg{"worksheet", "cell", "row", "column", "error"});

        # errors read as no value; the columns are typed from their other values; a formula with a text result is
        # not an error
        list<hash<auto>> recs = readOds("errors.ods", {"error_cells": "null"});
        assertEq((NOTHING, 0.5, NOTHING, NOTHING), (map $1.Ratio, recs));
        assertEq((NOTHING, "x", "y", "z"), (map $1.Lookup, recs));
        assertEq("*float", readOdsTypes("errors.ods", {"error_cells": "null"}).Ratio);
        assertEq("*string", readOdsTypes("errors.ods", {"error_cells": "null"}).Lookup);

        # errors read as their text, in any column
        recs = readOds("errors.ods", {"error_cells": "text"});
        assertEq(("#DIV/0!", 0.5, "#N/A", "Err:502"), (map $1.Ratio, recs));
        assertEq(("#N/A", "x", "y", "z"), (map $1.Lookup, recs));

        # errors in a field of their own
        recs = readOds("errors.ods", {"error_field": "errors"});
        assertEq(({"Ratio": "#DIV/0!", "Lookup": "#N/A"}, NOTHING, {"Ratio": "#N/A"}, {"Ratio": "Err:502"}),
            (map $1.errors, recs));
        assertEq((NOTHING, 0.5, NOTHING, NOTHING), (map $1.Ratio, recs));
        assertEq("*hash<auto>", readOdsTypes("errors.ods", {"error_field": "errors"}).errors);
        recs = readOds("errors.ods", {"error_field": "errors", "error_cells": "text"});
        assertEq(("#DIV/0!", 0.5, "#N/A", "Err:502"), (map $1.Ratio, recs));
        assertEq({"Ratio": "#DIV/0!", "Lookup": "#N/A"}, recs[0].errors);

        # with formulas
        recs = readOds("errors.ods", {"error_field": "errors", "formula_field": "formulas"});
        assertEq({"B2": "1/0", "C2": "NA()"}, recs[0].formulas);
        assertEq({"Ratio": "#DIV/0!", "Lookup": "#N/A"}, recs[0].errors);

        # a row of only error cells is a row with content
        recs = readOds("errors.ods", {"header_names": False, "error_cells": "null", "data_cells": "b2:c2",
            "headers": ("Ratio", "Lookup")});
        assertEq(({"Ratio": NOTHING, "Lookup": NOTHING},), recs);
    }

    #! Invalid error options
    testErrorOptionsNegative() {
        # the allowed values of the option are checked with the options
        assertThrows("OPTION-VALUE-ERROR", "error_cells", \readOds(), ("errors.ods", {"error_cells": "skip"}));
        assertThrows("ODS-READ-OPTION-ERROR", "error_field.*\"Ratio\".*column", \readOds(),
            ("errors.ods", {"error_field": "Ratio"}));
        assertThrows("ODS-READ-OPTION-ERROR", "error_field.*\"f\".*formula field", \readOds(),
            ("errors.ods", {"error_field": "f", "formula_field": "f"}));
        assertThrows("ODS-READ-OPTION-ERROR", "error_field.*must not be empty", \readOds(),
            ("errors.ods", {"error_field": ""}));
    }

    #! The read actions offer the typing and error options
    testTypingActionOptions() {
        foreach string action in ("read", "read-data") {
            hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("ODS", action);
            foreach string opt in ("type_sample_rows", "column_types", "error_cells", "error_field") {
                assertTrue(info.options.hasKey(opt), action + " " + opt);
            }
            assertEq(100, info.options.type_sample_rows.default_value);
            assertEq("fail", info.options.error_cells.default_value);
            assertEq(("fail", "null", "text"), (map $1.value, info.options.error_cells.allowed_values));
        }
    }

    #! Returns the list-worksheets action and its data provider
    private hash<auto> getListWorksheetsAction(hash<auto> opts) {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("ODS", "list-worksheets");
        return {
            "action": action,
            "provider": DataProviderActionCatalog::getDataProviderForAction(action, \opts),
        };
    }

    #! The list-worksheets action lists the tables of a spreadsheet in order, with their position and visibility
    testListWorksheetsAction() {
        hash<auto> opts = {"path": test_data_dir + "/multi-sheet.ods"};
        hash<auto> a = getListWorksheetsAction(opts);
        hash<DataProviderActionInfo> action = a.action;
        AbstractDataProvider prov = a.provider;
        assertEq(DPAT_API, action.action_code);
        assertEq("OdsWorksheetList", action.output_type.getName());
        assertEq(("data", "path"), sort(keys action.options));
        assertTrue(action.options.path.preselected);
        assertFalse(action.options.path.required, "path and data are alternatives");
        assertFalse(action.options.data.required, "path and data are alternatives");
        assertEq("OdsWorksheetListRequest", prov.getRequestType().getName());
        assertEq("OdsWorksheetList", prov.getResponseType().getName());

        hash<auto> rv = prov.doRequest(opts);
        assertEq(rv, action.output_type.acceptsValue(rv));
        assertEq({"worksheets": (
            {"name": "Users", "index": 0, "hidden": False},
            {"name": "Products", "index": 1, "hidden": False},
            {"name": "Orders", "index": 2, "hidden": False},
        )}, rv);

        # the same tables as the read provider's child providers, from a location or inline data
        foreach string file in ("multi-sheet.ods", "profile.ods", "sheet-visibility.ods", "simple.ods") {
            string path = test_data_dir + "/" + file;
            list<string> names = (new OdsReadDataProvider({"path": path})).getChildProviderNames();
            hash<auto> by_path = prov.doRequest({"path": path});
            hash<auto> by_data = prov.doRequest({"data": ReadOnlyFile::readBinaryFile(path)});
            assertEq(by_path, by_data, file);
            assertEq(names, (map $1.name, by_path.worksheets), file);
            assertEq(range(names.size()), (map $1.index, by_path.worksheets), file);
            assertEq(by_path, action.output_type.acceptsValue(by_path), file);
        }

        # a hidden table is listed where it is in the spreadsheet, as the profile gives it
        string path = test_data_dir + "/profile.ods";
        assertEq({"worksheets": (
            {"name": "Confirmations", "index": 0, "hidden": False},
            {"name": "Lookup", "index": 1, "hidden": True},
        )}, prov.doRequest({"path": path}));
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path),
            10);
        assertEq((map $1.hidden, grid.sheets), (map $1.hidden, prov.doRequest({"path": path}).worksheets));

        # a data string in Base64 is accepted as the spreadsheet's bytes
        assertEq(prov.doRequest({"path": test_data_dir + "/multi-sheet.ods"}),
            prov.doRequest({"data": make_base64_string(ReadOnlyFile::readBinaryFile(test_data_dir
                + "/multi-sheet.ods"))}));
    }

    #! A table is hidden only by a table style that does not display it; its index selects it for reading
    testListWorksheetsVisibility() {
        AbstractDataProvider prov = getListWorksheetsAction({}).provider;
        string path = test_data_dir + "/sheet-visibility.ods";
        hash<auto> rv = prov.doRequest({"path": path});
        assertEq({"worksheets": (
            {"name": "Visible", "index": 0, "hidden": False},
            {"name": "Hidden", "index": 1, "hidden": True},
            {"name": "Shown", "index": 2, "hidden": False},
            {"name": "Last", "index": 3, "hidden": False},
        )}, rv);
        # the visibility is that of the profile
        hash<TabularWorkbookGrid> grid = OdsProfileDataProvider::readWorkbookGrid(ReadOnlyFile::readBinaryFile(path),
            10);
        assertEq((map $1.hidden, grid.sheets), (map $1.hidden, rv.worksheets));
        # each table is read by its index as by its name
        foreach hash<auto> sheet in (rv.worksheets) {
            list<hash<auto>> by_index = map $1, (new OdsReadDataProvider({"path": path,
                "worksheet": string(sheet.index), "header_names": True})).searchRecords();
            assertEq(({"Sheet": sheet.name},), by_index, sheet.name);
        }
    }

    #! The list-worksheets action requires exactly one input, and fails for input that is not a spreadsheet
    testListWorksheetsNegative() {
        AbstractDataProvider prov = getListWorksheetsAction({}).provider;
        string path = test_data_dir + "/multi-sheet.ods";
        assertThrows("ODS-READ-OPTION-ERROR", "exactly one of the \"path\" and \"data\" options",
            \prov.doRequest(), {});
        assertThrows("ODS-READ-OPTION-ERROR", "exactly one of the \"path\" and \"data\" options",
            \prov.doRequest(), {"path": path, "data": ReadOnlyFile::readBinaryFile(path)});
        # input that is not a spreadsheet raises the Java exception of the read
        binary ods = File::readBinaryFile(path);
        # an ODF text document is a ZIP archive with an ODF media type, but not a spreadsheet
        string odt = tmp_location() + "/ods-list-worksheets-" + get_random_string(8) + ".odt";
        on_exit unlink(odt);
        {
            OdfTextDocument doc = OdfTextDocument::newTextDocument();
            on_exit doc.close();
            doc.save(new Jni::java::io::File(odt));
        }
        hash<string, hash<auto>> cases = {
            "a text file": {
                "data": binary("PO;SKU;Qty\n1;2;3\n"),
                "exception": "java.util.zip.ZipException",
            },
            "an empty file": {
                "data": binary(),
                "exception": "java.util.zip.ZipException",
            },
            "damaged (truncated)": {
                "data": ods.substr(0, ods.size() / 2),
                "exception": "java.util.zip.ZipException",
            },
            "an ODF text document": {
                "data": File::readBinaryFile(odt),
                "exception": "java.lang.IllegalArgumentException: the document is not an ODF spreadsheet",
            },
        };
        foreach hash<auto> i in (cases.pairIterator()) {
            *hash<ExceptionInfo> ex;
            try {
                prov.doRequest({"data": i.value.data});
            } catch (hash<ExceptionInfo> e) {
                ex = e;
            }
            assertEq("JNI-ERROR", ex.err, i.key);
            assertEq(0, ex.desc.find(i.value.exception), sprintf("%s: %s", i.key, ex.desc));
        }
        # a location that does not exist
        assertThrows("FILE-OPEN2-ERROR", \prov.doRequest(), {"path": test_data_dir + "/no-such-file.ods"});
    }

    testWriteColumnMasks() {
        string path = test_data_dir + "/column-masks.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": MaskHeaders, "column_masks": ColumnMasks});
        dp.createRecord(MaskRecord);
        dp.finishCreate();

        # each masked cell has the data style of its mask's display format
        list<string> styles = OdsTestHelper::getCellDataStyles(path, 1, MaskHeaders.size());
        assertEq("string|", styles[0], "Name");
        assertRegex("^date\\|<number:date-style [^>]*><number:day number:style=\"long\"/><number:text>\\.</number:text>"
            "<number:month number:style=\"long\"/><number:text>\\.</number:text><number:year number:style=\"long\"/>"
            "</number:date-style>$", styles[1], "Date");
        assertRegex("^date\\|<number:date-style [^>]*><number:hours number:style=\"long\"/><number:text>:"
            "</number:text><number:minutes number:style=\"long\"/><number:text> </number:text><number:am-pm/>"
            "</number:date-style>$", styles[2], "Time");
        assertRegex("^percentage\\|<number:percentage-style ", styles[5], "Share");
        foreach string column in (MaskHeaders[1..]) {
            assertRegex("^(date|float|percentage)\\|<number:", styles[$# + 1], column);
        }

        # the values keep their types: the percentage cell is read as its fraction
        OdsReadDataProvider rdp(path, {"header_names": True});
        assertEq((MaskRecord + {"Count": 1234567},), (map $1, rdp.searchRecords()));
    }

    testCommonColumnMasks() {
        foreach string mask in (ValueMask::DateFormats + ValueMask::TimeFormats + ValueMask::NumberFormats
                + ValueMask::AmountFormats) {
            # a mask with an offset has no display format
            if (mask =~ /ZZ/) {
                assertThrows("ODS-WRITE-OPTION-ERROR", "column \"V\": .*holds no UTC offset", sub () {
                    OdsWriteDataProvider dp({"column_masks": {"V": mask}});
                }, NOTHING, mask);
                continue;
            }
            assertNothing(OdsWriter::formatCodeIssue(ValueMask::toSpreadsheetFormat(mask)), mask);
            auto value = ValueMask::maskKind(mask) == "number" ? -1234.5 : 2026-11-02T15:05:09.123;
            string path = test_data_dir + "/common-mask.ods";
            on_exit unlink(path);
            OdsWriteDataProvider dp(path, {"headers": ("V",), "column_masks": {"V": mask}});
            dp.createRecord({"V": value});
            dp.finishCreate();
            assertRegex("^(date|float|percentage)\\|<number:(date|number|percentage)-style ",
                OdsTestHelper::getCellDataStyles(path, 1, 1)[0], mask);
        }
    }

    testWriteNegativeColumnMasks() {
        hash<string, string> refused = {
            "YYYY-MM-DDTHH:mm:SSZZ": "holds no UTC offset \\(ZZ\\)",
            "DD MON YYYY": "no upper-case month name \\(use Mon\\)",
            "HH:mm:SS,sss": "a fraction of a second only directly after the seconds and a decimal point",
            "mm HH": "shows mm as a minute only directly after an hour or before the seconds",
            "DD.MM.JJJJ": "is not a valid date, time or number mask: unknown letters \"JJJJ\"",
        };
        foreach hash<auto> i in (refused.pairIterator()) {
            assertThrows("ODS-WRITE-OPTION-ERROR", "invalid \"column_masks\" option: column \"V\": .*" + i.value,
                sub () {
                    OdsWriteDataProvider dp({"column_masks": {"V": i.key}});
                }, NOTHING, i.key);
        }
        assertThrows("ODS-WRITE-OPTION-ERROR", "column \"A\" also has a format code in the \"column_formats\" "
            "option", sub () {
            OdsWriteDataProvider dp({"column_formats": {"A": "0.00"}, "column_masks": {"A": "0.00"}});
        });
        assertThrows("ODS-WRITE-OPTION-ERROR", "invalid \"column_masks\" option: a mask is given for column "
            "\"X\", which is not written", sub () {
            OdsWriteDataProvider dp({"headers": ("A",), "column_masks": {"A": "0", "X": "0"}});
        });
        OdsWriteDataProvider bad({"column_masks": {"Amount": "0.00", "Total": "0.00"}});
        assertThrows("CREATE-RECORD-ERROR", "ODS-WRITE-OPTION-ERROR.*a mask is given for column \"Total\", which "
            "is not written", \bad.createRecord(), {"Name": "a", "Amount": 1});
        assertEq(0, bad.getCreatedCount());
    }

    testWriteColumnHeaders() {
        string path = test_data_dir + "/column-headers.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {
            "headers": ("id", "amount"),
            "column_headers": {"id": "Order No.", "amount": "Amount (EUR)"},
            "column_masks": {"amount": "#,##0.00"},
        });
        dp.createRecord({"id": "A-1", "amount": 1234.5});
        dp.finishCreate();
        assertRegex("^float\\|<number:number-style ", OdsTestHelper::getCellDataStyles(path, 1, 2)[1]);
        OdsReadDataProvider rdp(path, {"header_names": True});
        assertEq(({"Order No.": "A-1", "Amount (EUR)": 1234.5},), (map $1, rdp.searchRecords()));

        assertThrows("ODS-WRITE-OPTION-ERROR", "invalid \"column_headers\" option: a header is given for "
            "column \"x\", which is not written", sub () {
            OdsWriteDataProvider bad({"headers": ("id",), "column_headers": {"x": "X"}});
        });
    }

    testWriteHeaderPlacement() {
        string path = test_data_dir + "/header-placement.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": ("sku", "amount"), "header_row": 3,
            "column_masks": {"amount": "0.00"}});
        dp.createRecord({"sku": "A-1", "amount": 1.5});
        dp.finishCreate();
        OdsReadDataProvider reader(path, {"header_names": True, "header_cells": "3"});
        assertEq(({"sku": "A-1", "amount": 1.5},), map $1, reader.searchRecords());
        foreach int row in ((0, -1, 1048577)) {
            assertThrows("ODS-WRITE-OPTION-ERROR", sub () {
                OdsWriteDataProvider bad({"header_row": row});
            });
        }
        assertThrows("ODS-WRITE-OPTION-ERROR", sub () {
            OdsWriteDataProvider bad({"header_row": 3, "write_headers": False});
        });
        OdsWriteDataProvider multi(path, {"sheets": (
            {"worksheet": "Orders", "columns": ("sku", "amount"), "header_row": 3},
        )});
        multi.createRecord({"sku": "B-2", "amount": 7});
        multi.finishCreate();
        reader = new OdsReadDataProvider(path, {"worksheet": "Orders", "header_names": True, "header_cells": "3"});
        assertEq(({"sku": "B-2", "amount": 7},), map $1, reader.searchRecords());
    }

    testWriteNoHeaderRow() {
        string path = test_data_dir + "/no-header-row.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": ("id", "date"), "write_headers": False,
            "column_masks": {"date": "DD.MM.YYYY"}});
        dp.createRecord({"id": "A-1", "date": 2026-11-02T00:00:00});
        dp.createRecord({"id": "A-2", "date": 2026-11-03T00:00:00});
        dp.finishCreate();
        # the first record is in the first row
        assertRegex("^date\\|<number:date-style ", OdsTestHelper::getCellDataStyles(path, 0, 2)[1]);
        OdsReadDataProvider rdp(path, {"headers": ("id", "date")});
        assertEq(({"id": "A-1", "date": 2026-11-02T00:00:00}, {"id": "A-2", "date": 2026-11-03T00:00:00}),
            (map $1, rdp.searchRecords()));
    }

    testWriteTimeZone() {
        string path = test_data_dir + "/time-zone.ods";
        on_exit unlink(path);
        # a date is written as its own wall-clock time
        OdsWriteDataProvider dp(path, {"headers": ("d",)});
        dp.createRecord({"d": 2026-11-02T14:05:00+05:30});
        dp.finishCreate();
        assertEq("2026-11-02T14:05:00", OdsTestHelper::getDateValueAttribute(path, 1, 0));

        # the wall-clock time in the given time zone
        dp = new OdsWriteDataProvider(path, {"headers": ("d",), "timezone": "Europe/Berlin"});
        dp.createRecord({"d": 2026-11-02T14:05:00Z});
        dp.createRecord({"d": 2026-07-02T14:05:00Z});
        dp.finishCreate();
        assertEq(("2026-11-02T15:05:00", "2026-07-02T16:05:00"), (OdsTestHelper::getDateValueAttribute(path, 1, 0),
            OdsTestHelper::getDateValueAttribute(path, 2, 0)));
        assertThrows("ODS-WRITE-OPTION-ERROR", "invalid \"timezone\" option \"Mars/Base\"", sub () {
            OdsWriteDataProvider bad({"timezone": "Mars/Base"});
        });
    }

    testOutputOptionsAction() {
        foreach string action in (("write", "write-data")) {
            hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("ODS", action);
            foreach string opt in (("column_masks", "column_headers", "write_headers", "header_row", "timezone")) {
                assertTrue(exists info.options{opt}, action + ": " + opt);
            }
        }
        foreach hash<auto> i in (OdsWriteDataProvider::ConstructorOptions.column_masks.example_value.pairIterator()) {
            assertNothing(ValueMask::spreadsheetFormatIssue(i.value), i.key);
        }
    }

    testWriteColumnMasksRendered() {
        *string soffice = findLibreOffice();
        if (!soffice) {
            testSkip("LibreOffice (soffice) is not installed");
        }
        string path = test_data_dir + "/column-masks-rendered.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"headers": MaskHeaders, "column_masks": RenderMasks});
        dp.createRecord(MaskRecord);
        dp.finishCreate();
        # a cell is shown as the mask writes the value as text
        hash<auto> expected = {"Name": "a"} + map {
            $1.key: MaskRecord{$1.key}.typeCode() == NT_DATE
                ? ValueMask::formatDate(MaskRecord{$1.key}, $1.value, NOTHING,
                    ValueMask::maskKind($1.value) == "time" ? "time" : "date")
                : ValueMask::formatNumber(MaskRecord{$1.key}, $1.value)
        }, RenderMasks.pairIterator();
        assertEq((expected,), renderWithLibreOffice(soffice, path));
    }
    #! Returns the records of each worksheet of a document, in document order, read with their header row
    private hash<auto> readWorksheets(binary data) {
        hash<auto> rv = {};
        foreach hash<TabularSheetGrid> sheet in (OdsProfileDataProvider::readWorkbookGrid(data, 1).sheets) {
            if (!sheet.rows) {
                rv{sheet.name} = ();
                continue;
            }
            OdsReadDataProvider rdp({"data": data, "worksheet": sheet.name, "header_names": True});
            rv{sheet.name} = map $1, rdp.searchRecords();
        }
        return rv;
    }

    #! Returns the rows of each worksheet of a document as they are stored, in document order
    private hash<auto> readWorksheetRows(binary data) {
        return map {$1.name: $1.rows}, OdsProfileDataProvider::readWorkbookGrid(data, 1000).sheets;
    }

    #! Returns the description of the exception that the code raises, which must have the given error code
    /** The \c "data provider class ...: " prefix of option errors is removed
    */
    private string getErrorDesc(string err, code c) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            assertEq(err, ex.err, ex.desc);
            string desc = ex.desc ?? "";
            desc =~ s/^data provider (class "[^"]+"|"[^"]*" \("[^"]+"\)): //;
            return desc;
        }
        throw "TEST-ERROR", sprintf("no %s exception was raised", err);
    }

    #! Returns the description of the exception that the code raises when it creates a record
    /** An exception raised by a data provider when a record is created is raised as \c CREATE-RECORD-ERROR, whose
        description begins with the error code of the exception; the error code and the \c "data provider ...: "
        prefix are removed
    */
    private string getCreateErrorDesc(string err, code c) {
        string desc = getErrorDesc("CREATE-RECORD-ERROR", c);
        assertEq(err + ": ", desc.substr(0, err.size() + 2), desc);
        desc = desc.substr(err.size() + 2);
        desc =~ s/^data provider (class "[^"]+"|"[^"]*" \("[^"]+"\)): //;
        return desc;
    }

    testWriteSheets() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("ODS", "write-data");
        AbstractDataProvider prov = Class::forName(action.cls).newObject({"sheets": RoutedSheets});
        map prov.createRecord($1), SheetRecords;
        hash<auto> output = prov.finishCreate();
        assertEq(output, action.output_type.acceptsValue(output));
        assertEq(5, output.record_count);
        # the records of each worksheet, in document order
        assertEq(("Orders", "Returns", "Other"), keys output.sheet_counts);
        assertEq({"Orders": 2, "Returns": 1, "Other": 2}, output.sheet_counts);
        # each worksheet has its own columns: a missing field is an empty cell and other fields are not written; a
        # worksheet without columns has the fields of the first record written to it
        assertEq({
            "Orders": (
                {"Id": 1, "Customer": "ACME", "Amount": 10.5},
                {"Id": 3, "Customer": NOTHING, "Amount": 7.25},
            ),
            "Returns": ({"Id": 2, "Reason": "damaged"},),
            "Other": (
                {"kind": "note", "Id": 4, "Text": "hello"},
                {"kind": "memo", "Id": 5, "Text": "bye"},
            ),
        }, readWorksheets(output.data));

        # many rows in alternating worksheets
        OdsWriteDataProvider dp({"sheets": RoutedSheets});
        for (int n = 1; n <= 300; ++n) {
            dp.createRecord({"kind": n % 2 ? "order" : "return", "Id": n, "Amount": n * 1.5, "Reason": "r" + n});
        }
        output = dp.finishCreate();
        assertEq(300, output.record_count);
        assertEq({"Orders": 150, "Returns": 150, "Other": 0}, output.sheet_counts);
        hash<auto> written = readWorksheets(output.data);
        assertEq((150, 150, 0), (map $1.size(), written.values()));
        assertEq({"Id": 1, "Customer": NOTHING, "Amount": 1.5}, written.Orders[0]);
        assertEq({"Id": 299, "Customer": NOTHING, "Amount": 448.5}, written.Orders[149]);
        assertEq({"Id": 300, "Reason": "r300"}, written.Returns[149]);
    }

    testWriteSheetsOutput() {
        string path = test_data_dir + "/sheets.ods";
        on_exit unlink(path);
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("ODS", "write");
        AbstractDataProvider prov = Class::forName(action.cls).newObject({"path": path, "sheets": RoutedSheets});
        map prov.createRecord($1), SheetRecords;
        # the workbook is written to the file, and there is no output
        assertNothing(prov.finishCreate());
        hash<auto> written = readWorksheets(ReadOnlyFile::readBinaryFile(path));
        assertEq(("Orders", "Returns", "Other"), keys written);
        assertEq((2, 1, 2), (map $1.size(), written.values()));

        BinaryOutputStream stream();
        OdsWriteDataProvider dp(stream, {"sheets": RoutedSheets});
        map dp.createRecord($1), SheetRecords;
        assertNothing(dp.finishCreate());
        assertEq(written, readWorksheets(stream.getData()));
    }

    testWriteSheetsRouteAll() {
        list<hash<auto>> sheets = (
            {"worksheet": "All", "columns": ("kind", "Id")},
            {"worksheet": "Returns", "columns": ("Id", "Reason"), "when": "@kind == \"return\""},
        );
        # with "all", a record is written in every worksheet it matches; the record count counts each record once
        OdsWriteDataProvider dp({"sheets": sheets, "route": "all"});
        map dp.createRecord($1), SheetRecords;
        hash<auto> output = dp.finishCreate();
        assertEq(5, output.record_count);
        assertEq({"All": 5, "Returns": 1}, output.sheet_counts);
        hash<auto> written = readWorksheets(output.data);
        assertEq((1, 2, 3, 4, 5), (map $1.Id, written.All));
        assertEq(({"Id": 2, "Reason": "damaged"},), written.Returns);

        # with "first", the default, a record is written in the first worksheet it matches, so a worksheet without a
        # condition takes every record that no worksheet before it takes
        dp = new OdsWriteDataProvider({"sheets": sheets});
        map dp.createRecord($1), SheetRecords;
        output = dp.finishCreate();
        assertEq(5, output.record_count);
        assertEq({"All": 5, "Returns": 0}, output.sheet_counts);
        written = readWorksheets(output.data);
        assertEq(5, written.All.size());
        assertEq((), written.Returns);

        # with "all", records matching several conditions
        dp = new OdsWriteDataProvider({"route": "all", "sheets": (
            {"worksheet": "Large", "columns": ("Id",), "when": "@Amount > 5"},
            {"worksheet": "Orders", "columns": ("Id",), "when": "@kind == \"order\""},
        ), "unmatched": "skip"});
        map dp.createRecord($1), SheetRecords[0..2];
        output = dp.finishCreate();
        assertEq(2, output.record_count);
        assertEq({"Large": 2, "Orders": 2}, output.sheet_counts);
    }

    testWriteSheetsUnmatched() {
        list<hash<auto>> sheets = RoutedSheets[0..1];
        # by default, a record that matches no worksheet fails the write, naming the record and the conditions
        foreach string route in ("first", "all") {
            OdsWriteDataProvider dp({"sheets": sheets, "route": route});
            dp.createRecord(SheetRecords[0]);
            dp.createRecord(SheetRecords[1]);
            assertEq("record 3 matches no worksheet; the conditions of the worksheets are: \"Orders\": "
                "@kind == \"order\"; \"Returns\": @kind == \"return\"; with \"unmatched\": \"skip\", records that "
                "match no worksheet are skipped",
                getCreateErrorDesc("ODS-WRITE-ROUTE-ERROR", sub () { dp.createRecord(SheetRecords[3]); }), route);
        }

        # with "skip", a record that matches no worksheet is neither written nor counted
        OdsWriteDataProvider dp({"sheets": sheets, "unmatched": "skip"});
        map dp.createRecord($1), SheetRecords;
        hash<auto> output = dp.finishCreate();
        assertEq(3, output.record_count);
        assertEq({"Orders": 2, "Returns": 1}, output.sheet_counts);
        assertEq((2, 1), (map $1.size(), readWorksheets(output.data).values()));

        # a condition that cannot be evaluated for a record fails the write, naming the record and the worksheet
        dp = new OdsWriteDataProvider({"sheets": sheets});
        dp.createRecord(SheetRecords[0]);
        assertRegex("^record 2: the condition of worksheet \"Orders\" \\(@kind == \"order\"\\) cannot be evaluated: "
            "INVALID-OPERATION: ", getCreateErrorDesc("ODS-WRITE-ROUTE-ERROR", sub () {
                dp.createRecord({"Id": 1});
            }));

        # records of different shapes: exists tests whether a record has the field, so a record without it does not
        # match and is written to the next worksheet
        dp = new OdsWriteDataProvider({"sheets": (
            {"worksheet": "Returns", "columns": ("id", "type"), "when": "exists @type && @type == \"return\""},
            {"worksheet": "Other", "columns": ("id",)},
        )});
        dp.createRecord({"type": "return", "id": 1});
        dp.createRecord({"id": 2});
        dp.createRecord({"type": "order", "id": 3});
        output = dp.finishCreate();
        assertEq(3, output.record_count);
        assertEq({"Returns": 1, "Other": 2}, output.sheet_counts);
        hash<auto> written = readWorksheets(output.data);
        assertEq(({"id": 1, "type": "return"},), written.Returns);
        assertEq(({"id": 2}, {"id": 3}), written.Other);
    }

    testWriteSheetsEmpty() {
        # every worksheet is created in order, even without records; one with columns has its header row, unless it
        # is written without one
        OdsWriteDataProvider dp({"sheets": (
            {"worksheet": "Orders", "columns": ("Id", "Amount"), "column_headers": {"Amount": "Amount (EUR)"}},
            {"worksheet": "Returns", "columns": ("Id", "Reason"), "write_headers": False},
            {"worksheet": "Other"},
        )});
        hash<auto> output = dp.finishCreate();
        assertEq(0, output.record_count);
        assertEq({"Orders": 0, "Returns": 0, "Other": 0}, output.sheet_counts);
        assertEq({"Orders": (("Id", "Amount (EUR)"),), "Returns": (), "Other": ()}, readWorksheetRows(output.data));

        # Empty tables have no stored data rows, even when the reader preserves blank records.
        foreach string sheet in (("Returns", "Other")) {
            OdsReadDataProvider reader({"data": output.data, "worksheet": sheet,
                "headers": ("Id", "Amount"), "preserve_empty_rows": True});
            assertEq((), (map $1, reader.searchRecords()), sheet);
        }
        dp = new OdsWriteDataProvider({"headers": ("Id", "Amount"), "write_headers": False});
        OdsReadDataProvider reader({"data": dp.finishCreate().data, "headers": ("Id", "Amount"),
            "preserve_empty_rows": True});
        assertEq((), (map $1, reader.searchRecords()), "a headerless export of zero records is empty");

        dp = new OdsWriteDataProvider({"headers": ("Id", "Amount"), "write_headers": False});
        foreach int i in (xrange(2)) {
            reader = new OdsReadDataProvider({"data": dp.getData(), "headers": ("Id", "Amount"),
                "preserve_empty_rows": True});
            assertEq((), (map $1, reader.searchRecords()), "reading the unfinished empty writer is repeatable: read "
                + (i + 1));
        }
        dp.createRecord({"Id": 9, "Amount": 12});
        reader = new OdsReadDataProvider({"data": dp.getData(), "headers": ("Id", "Amount"),
            "preserve_empty_rows": True});
        assertEq(({"Id": 9, "Amount": 12},), (map $1, reader.searchRecords()));

        # a single worksheet with columns and no records has its header row
        dp = new OdsWriteDataProvider({"headers": ("Id", "Amount")});
        output = dp.finishCreate();
        assertEq({"Sheet1": (("Id", "Amount"),)}, readWorksheetRows(output.data));
        assertFalse(output.hasKey("sheet_counts"));
    }

    testWriteSheetsColumnOptions() {
        string path = test_data_dir + "/sheet-columns.ods";
        on_exit unlink(path);
        OdsWriteDataProvider dp(path, {"timezone": "Europe/Berlin", "sheets": (
            {"worksheet": "Orders", "columns": ("Id", "Date", "Amount"), "when": "@kind == \"order\"",
                "column_formats": {"Amount": "#,##0.00"}, "column_masks": {"Date": "DD.MM.YYYY"},
                "column_headers": {"Amount": "Amount (EUR)"}},
            {"worksheet": "Returns", "columns": ("Id", "Date", "Amount"), "write_headers": False,
                "column_formats": {"Date": "yyyy-mm-dd", "Amount": "0.0"}},
        )});
        dp.createRecord({"kind": "order", "Id": 1, "Date": 2026-11-02T23:30:00Z, "Amount": 1234.5});
        dp.createRecord({"kind": "return", "Id": 2, "Date": 2026-11-03T12:00:00Z, "Amount": 2.25});
        dp.finishCreate();
        # each worksheet has its own formats, as a single worksheet has them
        string single_path = test_data_dir + "/sheet-columns-single.ods";
        on_exit unlink(single_path);
        foreach hash<auto> i in ((
                {"sheet": 0, "row": 1, "formats": {"Date": "dd\\.mm\\.yyyy", "Amount": "#,##0.00"}},
                {"sheet": 1, "row": 0, "formats": {"Date": "yyyy-mm-dd", "Amount": "0.0"}},
            )) {
            OdsWriteDataProvider single(single_path, {"headers": ("Id", "Date", "Amount"),
                "column_formats": i.formats});
            single.createRecord({"Id": 1, "Date": 2026-11-02T23:30:00, "Amount": 1234.5});
            single.finishCreate();
            # the data styles without their names, which are unique in a document
            list<string> styles = map regex_subst($1, " style:name=\"[^\"]*\"", "", RE_Global),
                OdsTestHelper::getCellDataStyles(path, i.sheet, i.row, 3);
            list<string> single_styles = map regex_subst($1, " style:name=\"[^\"]*\"", "", RE_Global),
                OdsTestHelper::getCellDataStyles(single_path, 1, 3);
            assertEq("float|", styles[0], "sheet " + i.sheet);
            assertRegex("^date\\|<number:date-style ", styles[1], "sheet " + i.sheet);
            assertRegex("^float\\|<number:number-style ", styles[2], "sheet " + i.sheet);
            assertEq(single_styles, styles, "sheet " + i.sheet);
        }
        # and its own header row: the Returns worksheet has none, so its record is in the first row; dates are written
        # in the time zone of the document
        OdsReadDataProvider rdp(path, {"worksheet": "Orders", "header_names": True});
        assertEq(({"Id": 1, "Date": 2026-11-03T00:30:00, "Amount (EUR)": 1234.5},), (map $1, rdp.searchRecords()));
        rdp = new OdsReadDataProvider(path, {"worksheet": "Returns", "headers": ("Id", "Date", "Amount")});
        assertEq(({"Id": 2, "Date": 2026-11-03T13:00:00, "Amount": 2.25},), (map $1, rdp.searchRecords()));

        # a worksheet without columns has the columns of the first record written to it, which its column options
        # must name
        dp = new OdsWriteDataProvider({"sheets": (
            {"worksheet": "Orders", "when": "@kind == \"order\"", "column_formats": {"Amount": "0.00"}},
            {"worksheet": "Other", "column_headers": {"Text": "Message"}},
        )});
        dp.createRecord(SheetRecords[0]);
        assertEq("invalid \"sheets\" option: worksheet \"Other\": invalid \"column_headers\": a header is given for "
            "column \"Text\", which is not written; the columns written are: [\"kind\", \"Id\", \"Reason\", "
            "\"Amount\"]",
            getCreateErrorDesc("ODS-WRITE-OPTION-ERROR", sub () { dp.createRecord(SheetRecords[1]); }));
    }

    testWriteSheetsNegative() {
        # the options of a single worksheet are given for each worksheet instead
        foreach hash<auto> i in ({
                "worksheet": "worksheet",
                "headers": "columns",
                "column_formats": "column_formats",
                "column_masks": "column_masks",
                "column_headers": "column_headers",
                "write_headers": "write_headers",
                "header_row": "header_row",
            }.pairIterator()) {
            auto value = {
                "worksheet": "Data",
                "headers": ("Id",),
                "column_formats": {"Id": "0"},
                "column_masks": {"Id": "#"},
                "column_headers": {"Id": "No."},
                "write_headers": False,
                "header_row": 3,
            }{i.key};
            assertEq(sprintf("cannot use the \"%s\" option with the \"sheets\" option; give each worksheet its \"%s\" "
                "instead", i.key, i.value), getErrorDesc("ODS-WRITE-OPTION-ERROR", sub () {
                    OdsWriteDataProvider bad({"sheets": RoutedSheets, i.key: value});
                }), i.key);
        }
        # the default of write_headers is the default of each worksheet
        OdsWriteDataProvider dp({"sheets": RoutedSheets, "write_headers": True});

        # route and unmatched are options of worksheets
        assertEq("the \"route\" option is used only with the \"sheets\" option", getErrorDesc(
            "ODS-WRITE-OPTION-ERROR", sub () { OdsWriteDataProvider bad({"route": "all"}); }));
        assertEq("the \"unmatched\" option is used only with the \"sheets\" option", getErrorDesc(
            "ODS-WRITE-OPTION-ERROR", sub () { OdsWriteDataProvider bad({"unmatched": "skip"}); }));
        assertThrows("OPTION-VALUE-ERROR", sub () { OdsWriteDataProvider bad({"sheets": RoutedSheets,
            "route": "any"}); });
        assertThrows("OPTION-VALUE-ERROR", sub () { OdsWriteDataProvider bad({"sheets": RoutedSheets,
            "unmatched": "ignore"}); });

        # a worksheet name of an ODS document can have more than the 31 characters and the characters that an Excel
        # worksheet name cannot have
        string long_name = strmul("x", 40);
        dp = new OdsWriteDataProvider({"sheets": ({"worksheet": long_name}, {"worksheet": "Q1/Q2"},
            {"worksheet": "'Data'"})});
        binary data = dp.finishCreate().data;
        assertEq((long_name, "Q1/Q2", "'Data'"), keys readWorksheetRows(data));

        # invalid worksheets
        foreach hash<auto> i in ((
                {"sheets": (), "error": "no worksheets are given"},
                {"sheets": ({"columns": ("Id",)},), "error": "worksheet 1 has no \"worksheet\" name"},
                {"sheets": ({"worksheet": 1},), "error": "worksheet 1: \"worksheet\" must be a value of type "
                    "\"string\", not \"integer\""},
                {"sheets": ({"worksheet": "Data", "headers": ("Id",), "where": "x"},), "error":
                    "worksheet \"Data\": unknown keys \"headers\", \"where\"; the keys of a worksheet are: worksheet, "
                    "columns, when, column_headers, column_formats, column_masks, write_headers, header_row"},
                {"sheets": ({"worksheet": "Data", "columns": ("Id", 2)},), "error": "worksheet \"Data\": \"columns\" "
                    "must be a value of type \"softlist<string>\", not \"list<auto>\""},
                {"sheets": ({"worksheet": "Data", "columns": ()},), "error": "worksheet \"Data\": \"columns\" is "
                    "empty; leave it out to take the columns from the first record written to the worksheet"},
                {"sheets": ({"worksheet": "Data", "column_headers": {"Id": 1}},), "error": "worksheet \"Data\": "
                    "\"column_headers\" must be a value of type \"hash<string, string>\", not \"hash<string, int>\""},
                {"sheets": ({"worksheet": ""},), "error": "worksheet 1: invalid worksheet name \"\": a worksheet name "
                    "cannot be empty"},
                {"sheets": ({"worksheet": "Orders"}, {"worksheet": "Data"}, {"worksheet": "ORDERS"}), "error":
                    "worksheet 3: the worksheet name \"ORDERS\" is already the name of worksheet 1 (\"Orders\"); "
                    "worksheet names must be unique, regardless of case"},
                {"sheets": ({"worksheet": "Data", "columns": ("Id",), "column_headers": {"x": "X"}},), "error":
                    "worksheet \"Data\": invalid \"column_headers\": a header is given for column \"x\", which is not "
                    "written; the columns written are: [\"Id\"]"},
                {"sheets": ({"worksheet": "Data", "column_formats": {"Id": "0"}, "column_masks": {"Id": "#"}},),
                    "error": "worksheet \"Data\": invalid \"column_masks\": column \"Id\" also has a format code in "
                    "\"column_formats\"; a column can have one or the other"},
            )) {
            assertEq("invalid \"sheets\" option: " + i.error, getErrorDesc("ODS-WRITE-OPTION-ERROR", sub () {
                OdsWriteDataProvider bad({"sheets": i.sheets});
            }), i.error);
        }
        assertRegex("^invalid \"sheets\" option: worksheet \"Data\": invalid \"column_formats\": column \"Id\": ",
            getErrorDesc("ODS-WRITE-OPTION-ERROR", sub () {
                OdsWriteDataProvider bad({"sheets": ({"worksheet": "Data", "column_formats": {"Id": "General"}},)});
            }));
        assertRegex("^invalid \"sheets\" option: worksheet \"Data\": invalid \"column_masks\": column \"Id\": ",
            getErrorDesc("ODS-WRITE-OPTION-ERROR", sub () {
                OdsWriteDataProvider bad({"sheets": ({"worksheet": "Data", "column_masks": {"Id": "ZZ"}},)});
            }));
        assertRegex("^invalid \"sheets\" option: worksheet \"Data\": invalid \"when\" condition \"@kind ==\": "
            "DPQL-PARSE-ERROR: ", getErrorDesc("ODS-WRITE-OPTION-ERROR", sub () {
                OdsWriteDataProvider bad({"sheets": ({"worksheet": "Data", "when": "@kind =="},)});
            }));
    }

    testWriteSheetsActionOptions() {
        foreach string action in ("write", "write-data") {
            hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("ODS", action);
            foreach string opt in ("sheets", "route", "unmatched") {
                assertTrue(exists info.options{opt}, action + ": " + opt);
            }
        }
        # the generated data gives the records of each worksheet
        hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("ODS", "write-data");
        assertEq("SpreadsheetGeneratedDataOutput", info.output_type.getName());
        assertEq(("data", "record_count", "sheet_counts"), keys info.output_type.getFields());
        # the example of the sheets option is a valid value
        hash<auto> opts = OdsWriteDataProvider::ConstructorOptions;
        OdsWriteDataProvider dp({"sheets": opts.sheets.example_value});
        dp.createRecord({"kind": "order", "Id": 1, "Amount": 1.5});
        dp.createRecord({"kind": "return", "Id": 2, "Reason": "late"});
        dp.createRecord({"kind": "other", "Id": 3});
        assertEq({"Orders": 1, "Returns": 1, "Other": 1}, dp.finishCreate().sheet_counts);
        assertEq("first", opts.route.default_value);
        assertEq(("first", "all"), (map $1.value, opts.route.allowed_values));
        assertEq("fail", opts.unmatched.default_value);
        assertEq(("fail", "skip"), (map $1.value, opts.unmatched.allowed_values));
        # a worksheet provider writes open records, since a condition can use fields that are not written
        dp = new OdsWriteDataProvider({"sheets": RoutedSheets});
        assertNothing(dp.getRecordType());
    }
}
