        binary data = ReadOnlyFile::readBinaryFile(test_data_dir + "/multi-sheet.ods");
        string sheet = (new OdsReadDataProvider({"data": data})).getChildProviderNames()[1];

        # inline data
        OdsWorksheetReadDataProvider dp({"data": data, "worksheet": sheet, "header_names": True});
        list<hash<auto>> from_data = map $1, dp.searchRecords();
        assertTrue(from_data.size() > 0);

        # path, resolved as a file location
