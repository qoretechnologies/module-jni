#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The jdbc database driver is uncontrolled Java code: it resolves and connects to its destinations in Java, where the
# sandbox network policy cannot be applied to them (qore#5747), and does its other I/O there too.  With the sandbox
# API that has QoreSandboxManager::trustsUncontrolledApis() (jni module info key "sandbox_restricts_api"), it is
# refused unless the governing sandbox trusts the code with uncontrolled APIs (every member of a composition), whatever
# the sandbox restricts; without it, it is refused to code that a sandbox network policy restricts, so a SandboxManager
# that is attached but restricts nothing (an allow-all manager) does not refuse it

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires jni
%requires QUnit

%exec-class JniJdbcNetworkSandboxTest

class JniJdbcNetworkSandboxTest inherits QUnit::Test {
    private:internal {
        #! no driver accepts this URL, so a connection that is not refused fails with the driver's error
        const Url = "jdbc:u/p@ignored{url=qore-none://127.0.0.1:1/x}";

        #! the result of a connection that was not refused: the driver manager finds no driver for the URL
        /** reported by result_err() (ErrSource) for a JNI-ERROR whose description is the driver manager's, so that
            any other JNI-ERROR does not count as a connection that was not refused
        */
        const NoDriver = "NO-DRIVER";

        #! the description of the error of a connection that was not refused
        const NoDriverDesc = "java.sql.SQLException: No suitable driver found for jdbc:";

        #! the code that every Program of the test has: the result of an error of a connection
        const ErrSource = "
string sub result_err(hash<ExceptionInfo> ex) {
    if (ex.err == \"JNI-ERROR\") {
        return ex.desc.equalPartial(\"" + NoDriverDesc + "\") ? \"" + NoDriver + "\" : ex.err + \": \" + ex.desc;
    }
    return ex.err;
}
";

        const Denied = "NETWORK-ACCESS-DENIED";

        #! returns the error of opening a connection, or "ok"
        const OpenSource = "
string sub open_url(string url) {
    try {
        Datasource ds(url);
        ds.open();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
";

        #! returns the error of a pool, or "ok"
        const PoolSource = "
string sub open_pool(string url) {
    try {
        DatasourcePool dsp(url);
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
";

        #! the code of a trusted library that connects for its callers
        const TrustedSource = OpenSource + "
string sub open_barrier(string url) {
    try {
        return SandboxManager::callWithSystemPolicy(\\open_url(), url);
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}

code sub make_capability(string url) {
    return SandboxManager::createSystemPolicyCall(string sub () { return open_url(url); });
}

# a connection with a Qore socket, which the network policy is applied to
string sub connect_socket() {
    try {
        Socket s();
        s.connect(\"127.0.0.1:1\", 1s);
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}

string sub socket_barrier() {
    try {
        return SandboxManager::callWithSystemPolicy(\\connect_socket());
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
";
    }

    constructor() : QUnit::Test("JNI jdbc network sandbox", "1.0", \ARGV) {
        addTestCase("sandboxed code cannot connect", \sandboxedTest());
        addTestCase("a sandbox that restricts the network and allows the destination does not allow the connection",
            \allowedPolicyTest());
        addTestCase("an allow-all manager: trusted, and without the API", \allowAllTest());
        addTestCase("every kind of network restriction refuses the connection", \restrictingPolicyTest());
        addTestCase("a restricting policy refuses a pool and a trusted Datasource", \restrictingPoolTest());
        addTestCase("sandboxed code cannot use a pool", \poolTest());
        addTestCase("trusted code connects", \trustedTest());
        addTestCase("sandboxed code cannot establish a barrier for itself", \ownBarrierTest());
        addTestCase("trusted code called by sandboxed code", \trustedCalleeTest());
        addTestCase("a trusted Datasource used by sandboxed code", \trustedDatasourceTest());
        addTestCase("the options are not processed for a refused connection", \optionsTest());
        addTestCase("a sandbox that trusts the code with uncontrolled APIs does not refuse it", \trustedSandboxTest());
        addTestCase("a sandbox that does not trust the code refuses it whatever it restricts", \restrictsApiTest());
        addTestCase("a sandbox that trusts the code connects whatever it restricts", \restrictsApiTrustTest());
        addTestCase("compositions of sandboxes", \restrictsApiCompositionTest());
        addTestCase("a composition of trusting allow-all managers connects", \trustingCompositionTest());
        addTestCase("trusted code in a system-policy call connects for a sandboxed caller",
            \restrictsApiSystemPolicyTest());
        set_return_value(main());
    }

    #! Returns True if the jni module was built with the restriction API of sandboxes (Qore batch R)
    /** QoreSandboxManager::restricts() and QoreSandboxManager::trustsUncontrolledApis(), aggregated over the members
        of a composition of sandboxes; the module decides this when it is built, so its own report is tested
    */
    private static bool restrictsApi() {
        *hash<auto> info = get_module_hash().jni.info;
        return info.sandbox_restricts_api ?? False;
    }

    private skipIfNoRestrictsApi() {
        if (!restrictsApi()) {
            testSkip("the jni module was built without the restriction API of sandboxes");
        }
    }

    #! Returns a sandboxed Program with the code given
    private static Program getSandboxed(string source, *SandboxManager sm) {
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm ?? new SandboxManager());
        p.parse(ErrSource + source, "jni-jdbc-network-sandboxed");
        return p;
    }

    #! Returns a trusted Program with the code given
    private static Program getTrusted(string source) {
        Program p(PO_NEW_STYLE);
        p.parse(ErrSource + source, "jni-jdbc-network-trusted");
        return p;
    }

    sandboxedTest() {
        Program p = getSandboxed(OpenSource);
        # the destinations are not parsed: the form of the URL does not matter
        foreach string url in (Url, "jdbc:u/p@qore-none:x", "jdbc:u/p@ignored{url=qore-none://db1:1;db2:2/x}",
                "jdbc:u/p@ignored{url=qore-none:mem:x}") {
            assertEq(Denied, p.callFunction("open_url", url), url);
        }
    }

    trustedSandboxTest() {
        # a host that governs trusted code with a sandbox only for its interrupts or limits allows uncontrolled APIs
        # (SandboxManager::setUncontrolledApiPolicy(), a Qore with the trust policy); the jdbc driver does not refuse
        # that code
        SandboxManager sm();
        if (!sm.hasCallableMethod("setUncontrolledApiPolicy")) {
            testSkip("the Qore library has no uncontrolled-API policy of sandboxes");
        }
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(True);
        call_object_method(sm, "setUncontrolledApiPolicy", True);
        assertEq(NoDriver, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "a trusting sandbox");
        # a sandbox that does not trust the code and restricts nothing (an allow-all manager) refuses it with the API
        # (trust only); without it, only a network policy that restricts refuses it
        assertEq(allowAllResult(), getSandboxed(OpenSource, allowAll()).callFunction("open_url", Url),
            "an allow-all sandbox that does not trust the code");
        # one that does not trust the code and restricts its network refuses it
        SandboxManager deny = allowAll();
        deny.blockPrivateNetworks();
        assertEq(Denied, getSandboxed(OpenSource, deny).callFunction("open_url", Url),
            "a restricting sandbox that does not trust the code");
        # a trusting sandbox that restricts the network: the trust of the sandbox exempts the code only with the API;
        # without it, the network policy decides, as for any sandbox
        SandboxManager tsm = allowAll();
        tsm.blockPrivateNetworks();
        call_object_method(tsm, "setUncontrolledApiPolicy", True);
        assertEq(restrictsApi() ? NoDriver : Denied, getSandboxed(OpenSource, tsm).callFunction("open_url", Url),
            "a trusting sandbox that restricts the network");
    }

    allowedPolicyTest() {
        # the default policy allows every destination, but the private networks are blocked
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sm.blockPrivateNetworks();
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url));
    }

    #! returns an allow-all manager, which restricts nothing and does not trust the code with uncontrolled APIs
    private static SandboxManager allowAll() {
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sm.setFilesystemDefaultPolicy(True);
        return sm;
    }

    #! the result of a connection for code that an allow-all manager that does not trust it governs
    /** with the API, the driver is refused to code that its sandbox does not trust, whatever the sandbox restricts;
        without it, only a network policy that restricts refuses it
    */
    private static string allowAllResult() {
        return restrictsApi() ? Denied : NoDriver;
    }

    allowAllTest() {
        # without the API, an allow-all manager does not refuse the connection: it fails with the error of the missing
        # driver, as for code with no manager; with the API, it refuses it unless it trusts the code
        assertEq(allowAllResult(), getSandboxed(OpenSource, allowAll()).callFunction("open_url", Url));
        assertEq(allowAllResult(), getSandboxed(PoolSource, allowAll()).callFunction("open_pool", Url), "pool");
        # a connection to a closed local port fails with the driver's error
        assertEq(allowAllResult(), getSandboxed(OpenSource, allowAll()).callFunction("open_url",
            "jdbc:u/p@ignored{url=qore-none://127.0.0.1:9/x}"), "closed port");
        # without the API, only the network policy counts: a restricted filesystem does not refuse a connection
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        assertEq(allowAllResult(), getSandboxed(OpenSource, sm).callFunction("open_url", Url),
            "network allow-all only");
        if (restrictsApi()) {
            # an allow-all manager that trusts the code connects
            assertEq(NoDriver, getSandboxed(OpenSource, trusting()).callFunction("open_url", Url), "trusting");
            assertEq(NoDriver, getSandboxed(PoolSource, trusting()).callFunction("open_pool", Url), "trusting pool");
        }
    }

    restrictingPolicyTest() {
        # default deny
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "default deny");

        # blockPrivateNetworks()
        sm = allowAll();
        sm.blockPrivateNetworks();
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "blockPrivateNetworks");

        # a denied range
        sm = allowAll();
        sm.addNetworkDeniedIPRange("203.0.113.0/24");
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "denied range");

        # a policy that allows only some ranges, also with the default policy allow
        sm = allowAll();
        sm.addNetworkAllowedIPRange("10.0.0.0/8");
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "allowed range, default allow");
        sm = new SandboxManager();
        sm.addNetworkAllowedIPRange("10.0.0.0/8");
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "allowed range, default deny");

        # a policy that allows only some hosts
        sm = new SandboxManager();
        sm.addNetworkAllowedHost("*.example.com");
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "allowed host");

        # a policy that allows only some ports
        sm = allowAll();
        sm.addNetworkAllowedPort(443);
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "allowed port");
    }

    restrictingPoolTest() {
        SandboxManager sm = allowAll();
        sm.addNetworkDeniedIPRange("203.0.113.0/24");
        assertEq(Denied, getSandboxed(PoolSource, sm).callFunction("open_pool", Url), "pool");

        # a Datasource that trusted code made is refused for code that a restricting policy governs, and connects for
        # code that an allow-all manager is attached to
        Datasource ds(Url);
        string src = "
string sub open_ds(Datasource ds) {
    try {
        ds.open();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
";
        assertEq(Denied, getSandboxed(src, sm).callFunction("open_ds", ds), "restricting");
        assertEq(allowAllResult(), getSandboxed(src, allowAll()).callFunction("open_ds", ds), "allow-all");
    }

    poolTest() {
        assertEq(Denied, getSandboxed(PoolSource).callFunction("open_pool", Url), "sandboxed");
        assertEq(NoDriver, getTrusted(PoolSource).callFunction("open_pool", Url), "trusted");
    }

    trustedTest() {
        assertEq(NoDriver, getTrusted(OpenSource).callFunction("open_url", Url));
    }

    ownBarrierTest() {
        # the error of the barrier itself, if any, with its description; open_url() returns the connection's error
        string src = OpenSource + "
string sub run(string url) {
    try {
        return SandboxManager::callWithSystemPolicy(\\open_url(), url);
    } catch (hash<ExceptionInfo> ex) {
        return ex.err == \"JNI-ERROR\" ? result_err(ex) : ex.err + \": \" + ex.desc;
    }
}

sub probe() {
    SandboxManager::callWithSystemPolicy(sub () {});
}
";
        # a sandbox that allows uncontrolled APIs (qore#5741; the call is dynamic because the Qore library may lack
        # the policy) lets the code establish the barrier: the barrier stops at the Program of the call, whose own
        # sandbox still applies
        SandboxManager sm();
        if (sm.hasCallableMethod("setUncontrolledApiPolicy")) {
            call_object_method(sm, "setUncontrolledApiPolicy", True);
        }
        # with the restriction API of sandboxes, the trusting sandbox does not refuse the driver (the Program's own
        # sandbox governs the code in its barrier), which then fails for the missing driver; without it, the network
        # policy of the sandbox refuses it
        assertEq(restrictsApi() ? NoDriver : Denied, getSandboxed(src, sm).callFunction("run", Url),
            "barrier established");

        # a default sandbox: a Qore library that refuses uncontrolled APIs at run time (qore#5741) refuses the barrier
        # itself to the sandboxed code; without the refusal, the barrier stops at the Program of the call as above
        Program p = getSandboxed(src);
        bool refused;
        try {
            p.callFunction("probe");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "INVALID-FUNCTION-ACCESS") {
                rethrow;
            }
            refused = True;
        }
        string rv = p.callFunction("run", Url);
        if (refused) {
            assertRegex("^INVALID-FUNCTION-ACCESS: .*does not allow access to uncontrolled API "
                "method '.*SandboxManager::callWithSystemPolicy\\(", rv, "default sandbox: the barrier is refused");
        } else {
            assertEq(Denied, rv, "default sandbox");
        }
    }

    trustedCalleeTest() {
        Program lib = getTrusted(TrustedSource);
        code direct = string sub (string url) { return lib.callFunction("open_url", url); };
        code barrier = string sub (string url) { return lib.callFunction("open_barrier", url); };
        code socket_barrier = string sub (string url) { return lib.callFunction("socket_barrier"); };
        code cap = lib.callFunction("make_capability", Url);

        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        Program p = getSandboxed("
string sub call(code c, string url) { return c(url); }
string sub call_cap(code c) { return c(); }
", sm);
        assertEq(Denied, p.callFunction("call", direct, Url), "no barrier: the caller's sandbox applies");
        # under a policy barrier the connection is judged as a Qore socket's is: the policy that applies is resolved
        # in the same way
        # the socket's refusal, if any, is the jdbc driver's too: the network policy (NETWORK-ACCESS-DENIED), or the
        # refusal of the barrier itself where a sandbox refuses uncontrolled APIs at run time (qore#5741); a socket
        # that was not refused fails to connect, and the jdbc driver then finds no driver
        string socket_result = p.callFunction("call", socket_barrier, Url);
        string expected = inlist(socket_result, (Denied, "INVALID-FUNCTION-ACCESS")) ? socket_result : NoDriver;
        assertEq(expected, p.callFunction("call", barrier, Url), "policy barrier: as a socket (" + socket_result + ")");
        assertEq(NoDriver, p.callFunction("call_cap", cap), "capability");
    }

    trustedDatasourceTest() {
        Datasource ds(Url);
        Program p = getSandboxed("
string sub open_ds(Datasource ds) {
    try {
        ds.open();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
");
        assertEq(Denied, p.callFunction("open_ds", ds));
        # the refusal leaves nothing behind: trusted code opens the same Datasource
        try {
            ds.open();
            fail("the connection was not refused by the missing driver");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("JNI-ERROR", ex.err, "trusted code after the refusal");
            assertTrue(ex.desc.equalPartial(NoDriverDesc), "trusted code after the refusal: " + ex.desc);
        }
    }

    optionsTest() {
        # an invalid classpath option is reported by the code that processes the options, which runs before the
        # connection; for sandboxed code the connection is refused first, so the classpath option does not load jars
        string src = OpenSource + "
string sub open_options() {
    try {
        Datasource ds({\"type\": \"jdbc\", \"db\": \"qore-none:x\", \"options\": {\"classpath\": 1}});
        ds.open();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
";
        assertEq("JDBC-OPTION-ERROR", getTrusted(src).callFunction("open_options"), "trusted: the options are processed");
        assertEq(Denied, getSandboxed(src).callFunction("open_options"), "sandboxed: refused before the options");
    }

    #! Returns the restrictions of the API test cases: a description and code that applies one to an allow-all manager
    /** each restricts one dimension only: the network, the filesystem or a resource limit
    */
    private static list<hash<auto>> restrictions() {
        return (
            {"name": "network: default deny", "set": sub (SandboxManager sm) { sm.setNetworkDefaultPolicy(False); }},
            {"name": "network: blockPrivateNetworks", "set": sub (SandboxManager sm) { sm.blockPrivateNetworks(); }},
            {"name": "network: denied range",
                "set": sub (SandboxManager sm) { sm.addNetworkDeniedIPRange("203.0.113.0/24"); }},
            {"name": "network: allowed range",
                "set": sub (SandboxManager sm) { sm.addNetworkAllowedIPRange("10.0.0.0/8"); }},
            {"name": "network: allowed port", "set": sub (SandboxManager sm) { sm.addNetworkAllowedPort(443); }},
            {"name": "filesystem: default deny",
                "set": sub (SandboxManager sm) { sm.setFilesystemDefaultPolicy(False); }},
            {"name": "filesystem: allowed path",
                "set": sub (SandboxManager sm) { sm.addFilesystemAllowedPath("/tmp", QSEC_READ); }},
            {"name": "filesystem: denied path",
                "set": sub (SandboxManager sm) { sm.addFilesystemDeniedPath("/nonexistent-qore-test-dir"); }},
            {"name": "filesystem: sandbox root",
                "set": sub (SandboxManager sm) { sm.setFilesystemSandboxRoot("/tmp"); }},
            {"name": "limits: threads", "set": sub (SandboxManager sm) { sm.setMaxThreads(64); }},
            {"name": "limits: wall time", "set": sub (SandboxManager sm) { sm.setWallTimeLimit(600000); }},
            {"name": "limits: CPU time", "set": sub (SandboxManager sm) { sm.setCPUTimeLimit(600000); }},
            {"name": "limits: stack size", "set": sub (SandboxManager sm) { sm.setMaxStackSize(64 * 1024 * 1024); }},
            {"name": "limits: memory", "set": sub (SandboxManager sm) { sm.setMemoryLimit(16 * 1024 * 1024 * 1024); }},
        );
    }

    #! Returns an allow-all manager with the restriction applied
    private static SandboxManager restricted(hash<auto> r) {
        SandboxManager sm = allowAll();
        r.set(sm);
        return sm;
    }

    #! Returns a manager that trusts the code with uncontrolled APIs
    private static SandboxManager trusting(*SandboxManager sm) {
        if (!sm) {
            sm = allowAll();
        }
        call_object_method(sm, "setUncontrolledApiPolicy", True);
        return sm;
    }

    restrictsApiTest() {
        skipIfNoRestrictsApi();
        # a sandbox that restricts nothing but does not trust the code refuses it: an allow-all manager, also with an
        # allowed host pattern, and with a cleared interrupt request
        assertEq(Denied, getSandboxed(OpenSource, allowAll()).callFunction("open_url", Url), "allow-all");
        SandboxManager sm = allowAll();
        sm.addNetworkAllowedHost("*.example.com");
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "allowed host only");
        sm = allowAll();
        sm.requestInterrupt();
        sm.clearInterrupt();
        assertEq(Denied, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "interrupt cleared");

        # whatever it restricts, also a pool and a Datasource that trusted code made
        Datasource ds(Url);
        string src = OpenSource + PoolSource + "
string sub open_ds(Datasource ds) {
    try {
        ds.open();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return result_err(ex);
    }
}
";
        foreach hash<auto> r in (restrictions()) {
            Program p = getSandboxed(src, restricted(r));
            assertEq(Denied, p.callFunction("open_url", Url), r.name);
            assertEq(Denied, p.callFunction("open_pool", Url), r.name + ": pool");
            assertEq(Denied, p.callFunction("open_ds", ds), r.name + ": trusted Datasource");
        }
        # the refusal names the rule
        try {
            Datasource rds(Url);
            Program p = getSandboxed("sub run(Datasource ds) { ds.open(); }", allowAll());
            p.callFunction("run", rds);
            fail("not refused");
        } catch (hash<ExceptionInfo> ex) {
            assertEq(Denied, ex.err);
            assertRegex("code that a sandbox does not trust with uncontrolled APIs", ex.desc);
        }
    }

    restrictsApiTrustTest() {
        skipIfNoRestrictsApi();
        # every restriction at once: a sandbox that trusts the code does not refuse it
        SandboxManager sm = allowAll();
        map $1.set(sm), restrictions();
        trusting(sm);
        assertEq(NoDriver, getSandboxed(OpenSource, sm).callFunction("open_url", Url), "all restrictions, trusted");
        foreach hash<auto> r in (restrictions()) {
            assertEq(NoDriver, getSandboxed(OpenSource, trusting(restricted(r))).callFunction("open_url", Url),
                r.name + ": trusted");
        }
    }

    #! Returns the result of the connection of code that two sandboxes govern
    /** a closure that the Program under @p outer created calls the Program under @p inner: the closure has the
        sandbox provenance of @p outer, so the governing sandbox of the code of @p inner is the composition of both
        (a filesystem path that @p outer denies is denied in the Program under @p inner as well)
    */
    private static string composed(SandboxManager outer, SandboxManager inner) {
        Program ip = getSandboxed(OpenSource, inner);
        Program op = getSandboxed("code sub make(Program p) { return string sub (string url) { "
            "return p.callFunction(\"open_url\", url); }; }", outer);
        code c = op.callFunction("make", ip);
        return c(Url);
    }

    restrictsApiCompositionTest() {
        # the construction of composed() makes the governing sandbox a composition: a path that the outer manager
        # denies is denied to the code of the Program under the inner allow-all manager
        {
            SandboxManager outer = allowAll();
            outer.addFilesystemDeniedPath("/etc");
            Program ip = getSandboxed("string sub rd() { try { ReadOnlyFile f(\"/etc/passwd\"); return \"ok\"; } "
                "catch (hash<ExceptionInfo> ex) { return result_err(ex); } }", allowAll());
            Program op = getSandboxed("code sub make(Program p) { return string sub () { "
                "return p.callFunction(\"rd\"); }; }", outer);
            code c = op.callFunction("make", ip);
            assertEq("FILESYSTEM-ACCESS-DENIED", c(), "the outer member's policy applies");
            assertEq("ok", ip.callFunction("rd"), "the inner member alone");
        }
        skipIfNoRestrictsApi();
        # a composition trusts the code only if every member does, whatever the members restrict
        assertEq(Denied, composed(allowAll(), allowAll()), "allow-all members that do not trust the code");
        assertEq(NoDriver, composed(trusting(), trusting()), "allow-all members that trust the code");
        assertEq(Denied, composed(trusting(), allowAll()), "one allow-all member that does not trust the code");
        assertEq(Denied, composed(allowAll(), trusting()), "one allow-all member that does not trust the code, inner");
        foreach hash<auto> r in (restrictions()) {
            assertEq(Denied, composed(allowAll(), restricted(r)), r.name + ": restricting inner member");
            assertEq(Denied, composed(restricted(r), allowAll()), r.name + ": restricting outer member");
            assertEq(NoDriver, composed(trusting(restricted(r)), trusting()), r.name + ": trusting members");
            assertEq(Denied, composed(trusting(restricted(r)), allowAll()), r.name
                + ": a member that does not trust the code");
            assertEq(Denied, composed(allowAll(), trusting(restricted(r))), r.name
                + ": a member that does not trust the code, inner");
        }
    }

    #! trusted code that connects in a system-policy call on behalf of a sandboxed caller
    /** the governing sandbox is resolved as for a policy check, so the check does not apply inside
        SandboxManager::callWithSystemPolicy() or a SandboxManager::createSystemPolicyCall() capability: a
        system-policy call is an explicit, trusted capability in which trusted code acts as the system for its caller.
        As for every policy check, the code that the barrier calls is created by trusted code before it serves the
        sandboxed caller: a callback created while serving it keeps the caller's sandbox (its provenance)
    */
    restrictsApiSystemPolicyTest() {
        skipIfNoRestrictsApi();
        Program lib = getTrusted(TrustedSource);
        # with a jdbc option
        string url = "jdbc:u/p@ignored{url=qore-none://127.0.0.1:1/x,lob-max-size=1000}";
        # the classpath option, which loads jars, is judged by the restrictions of the code that sets it, which a
        # barrier does not lift (module commands are judged the same way; see jni-jdbc-option-setter.qtest)
        string cp_url = sprintf("jdbc:u/p@ignored{url=qore-none://127.0.0.1:1/x,classpath=%s}", get_script_dir());
        code direct = string sub (string url) { return lib.callFunction("open_url", url); };
        code open = \lib.callFunction();
        code barrier = string sub (string url) {
            return SandboxManager::callWithSystemPolicy(open, ("open_url", url));
        };
        # a barrier that trusted code establishes while it serves the sandboxed caller, around a callback that it
        # creates then, is no system-policy call: the callback has the caller's sandbox, as for a Qore socket
        code provenance = string sub (string url) { return lib.callFunction("open_barrier", url); };
        foreach hash<auto> r in (restrictions()) {
            Program p = getSandboxed("
string sub call(code c, string url) { return c(url); }
string sub call_cap(code c) { return c(); }
", restricted(r));
            assertEq(Denied, p.callFunction("call", direct, url), r.name + ": outside a system-policy call");
            assertEq(NoDriver, p.callFunction("call", barrier, url), r.name + ": callWithSystemPolicy()");
            assertEq(Denied, p.callFunction("call", provenance, url), r.name + ": a callback with provenance");
            assertEq("JNI-SANDBOX-ERROR", p.callFunction("call", barrier, cp_url), r.name
                + ": callWithSystemPolicy(), classpath option");
            assertEq(NoDriver, p.callFunction("call_cap", lib.callFunction("make_capability", url)), r.name
                + ": createSystemPolicyCall()");
        }
    }

    #! code that two allow-all sandboxes that trust it govern together connects
    /** a closure of one allow-all sandboxed Program calls another allow-all sandboxed Program, so the governing
        sandbox is the composition of two allow-all managers, as when the callbacks, closures and mappers of one
        interface Program, each of which has an allow-all manager, run with the code of another on the stack.  With the
        API, the composition trusts the code if every member trusts it, so the jdbc driver connects (it fails for the
        missing driver), and it refuses it if a member does not trust it.

        Without the API, module code cannot read the members of a composition, whose own configuration denies the
        network, so the driver refuses it (NETWORK-ACCESS-DENIED), also when every member restricts nothing and
        trusts the code: develop's network check (#208) refuses such a composition
    */
    trustingCompositionTest() {
        bool policy = (new SandboxManager()).hasCallableMethod("setUncontrolledApiPolicy");
        if (policy) {
            # each manager alone connects
            assertEq(NoDriver, getSandboxed(OpenSource, trusting()).callFunction("open_url", Url),
                "one trusting allow-all manager");
            assertEq(restrictsApi() ? NoDriver : Denied, composed(trusting(), trusting()),
                "a composition of two trusting allow-all managers");
        }
        assertEq(Denied, composed(allowAll(), allowAll()), "a composition of two allow-all managers");
    }
}
