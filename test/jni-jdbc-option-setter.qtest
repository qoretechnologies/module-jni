#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires jni
%requires QUnit
%requires FsUtil

# the classpath of every Program: the fixture JDBC driver that DriverManager has registered is the same class in the
# Program of the code that grows a pool
%module-cmd(jni) global-add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.JdbcTransactionDriver
%module-cmd(jni) import java.net.URLClassLoader
%module-cmd(jni) import java.net.URL

%exec-class JniJdbcOptionSetterTest

#! The classpath option of the jdbc driver is judged by the code that set it, not by the code that opens a connection
/** The option adds jars to a Program's class loader, so it is refused to sandboxed and restricted code (the rule of
    the "add-classpath" module command, qore#5699).  It is applied when a connection is opened, which can be on
    another thread and for other code than the code that set it; with a Qore library that records the setters of
    datasource options (qore#5741), whoever configures the datasource decides:
    - a datasource whose classpath restricted code set is refused when trusted code opens it
    - a trusted datasource or pool is not refused when it opens a connection on a restricted caller's thread
    - the classpath entries are checked against the filesystem policy of the code that set the option

    The cases of the new rule are skipped with a jni module built for a Qore library that does not record the
    setters; the cases where the same code sets the option and opens the connection run with every library.
*/
class JniJdbcOptionSetterTest inherits QUnit::Test {
    private:internal {
        #! the cached result of coreChecksTargets()
        static *bool core_checks_targets;

        #! the restricting parse options of the kinds of code: name -> parse options, or -1 for a sandbox
        const Kinds = {
            "trusted": 0,
            "no-filesystem": PO_NO_FILESYSTEM,
            "no-uncontrolled": PO_NO_UNCONTROLLED_APIS,
            "sandboxed": -1,
            "trusted-sandbox": -2,
        };

        #! the kinds of code that may not set the classpath option (see isRefused())
        const Refused = ("no-filesystem", "no-uncontrolled", "sandboxed");

        #! the code of the Programs of the test
        const Source = "
string sub open(Datasource ds) {
    try {
        ds.open();
        ds.close();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

string sub open_desc(Datasource ds) {
    try {
        ds.open();
        ds.close();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}

Datasource sub make(string cp) {
    return new Datasource(\"jdbc:u/p@jdbc:qore-none://x{classpath=\" + cp + \"}\");
}

Datasource sub make_hash(string cp) {
    return new Datasource({\"type\": \"jdbc\", \"user\": \"u\", \"pass\": \"p\", \"db\": \"jdbc:qore-none://x\",
        \"options\": {\"classpath\": cp}});
}

string sub open_new(string cp) {
    return open(make(cp));
}

nothing sub set_classpath(Datasource ds, string cp) {
    ds.setOption(\"classpath\", cp);
}

string sub try_set_classpath(Datasource ds, string cp) {
    try {
        ds.setOption(\"classpath\", cp);
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

Datasource sub copy_ds(Datasource ds) {
    return ds.copy();
}

string sub make_pool(string cp) {
    try {
        DatasourcePool p({\"type\": \"jdbc\", \"db\": \"qore-transaction-test:fixture\",
            \"options\": {\"classpath\": cp, \"min\": 1, \"max\": 2}});
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

auto sub pool_read(DatasourcePool p) {
    try {
        return p.select(\"read\");
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
";

        #! a classpath entry that does not exist; the jdbc driver that is not found then raises JNI-ERROR
        const NoSuchEntry = "/nonexistent-qore-jdbc-option-setter-dir";

        #! the code that lists the classpath of a Program's own class loader, for the kinds of code that can use it
        const LoaderSource = "%requires jni
%module-cmd(jni) import java.net.URLClassLoader
%module-cmd(jni) import java.net.URL
list<string> sub loader_urls() {
    list<string> rv = ();
    foreach Jni::java::net::URL url in (cast<Jni::java::net::URLClassLoader>(
            Jni::org::qore::jni::get_class_loader()).getURLs()) {
        rv += url.toString();
    }
    return rv;
}
";

        #! the kinds of code whose class loader the test can list (only in the cases that need a jni module that
        #! judges the option by its setter, where the trusted-sandbox code may use the uncontrolled APIs of the module)
        const LoaderKinds = ("trusted", "trusted-sandbox");
    }

    private {
        #! the Programs of the test, one for each kind of code
        hash<string, Program> pgms;

        #! a directory that the sandbox of the trusted-sandbox code allows to read
        string allowed;
        #! a directory that no sandbox of the test allows to read
        string denied;
    }

    constructor() : QUnit::Test("JNI jdbc classpath option setter", "1.0", \ARGV) {
        addTestCase("the features of the jni module match the Qore library", \featureTest());
        addTestCase("code that sets the option and opens the connection", \directTest());
        addTestCase("a datasource configured by restricted code is refused to trusted code", \configuredTest());
        addTestCase("a copy keeps the code that configured the datasource", \copyTest());
        addTestCase("a trusted datasource opened on a restricted thread", \trustedOpenedTest());
        addTestCase("the option set on an open connection", \openConnectionTest());
        addTestCase("a trusted pool that grows on a restricted thread", \poolTest());
        addTestCase("the filesystem policy of the code that sets the option", \policyTest());
        set_return_value(main());
    }

    globalSetUp() {
        allowed = make_tmp_dir();
        denied = make_tmp_dir();
        foreach string kind in (keys Kinds) {
            pgms{kind} = getProgram(kind);
        }
    }

    globalTearDown() {
        remove_tree(allowed);
        remove_tree(denied);
    }

    #! Returns True if a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem or the network
    #! refuses Java code (qore#7832)
    private static bool sandboxClassesRefused() {
        return get_module_hash().jni.info.sandbox_uncontrolled_api_classes ?? False;
    }

    #! Returns the kinds of code that may not set the classpath option
    /** with the rule of qore#7832, the sandbox of the trusted-sandbox code trusts it with uncontrolled APIs but
        restricts the filesystem, which Java code does not enforce, so it refuses the code the option (and every Java
        use) as a sandbox that does not trust it does
    */
    private static list<string> refusedKinds() {
        return sandboxClassesRefused() ? Refused + ("trusted-sandbox",) : Refused;
    }

    #! Returns True if the code of the kind given may not set the classpath option
    private static bool isRefused(string kind) {
        return inlist(kind, refusedKinds());
    }

    #! Returns the kinds of code whose class loader the test can list
    /** with the rule of qore#7832, the sandbox of the trusted-sandbox code, which restricts the filesystem, refuses
        its code Java code, so it cannot import the classes that list its class loader
    */
    private static list<string> loaderKinds() {
        return sandboxClassesRefused() ? ("trusted",) : LoaderKinds;
    }

    #! Returns True if the jdbc driver judges its options by the code that set them (qore#5741)
    private static bool setterAware() {
        *hash<auto> info = get_module_hash().jni.info;
        return info.jdbc_option_setter ?? False;
    }

    #! Returns True if the jni module was built with the uncontrolled-API policy of sandboxes (qore#5741)
    /** without it, the jni module refuses every caller that a sandbox governs, even one whose sandbox a host uses only
        for its limits and interrupts; the module decides this when it is built, so its own report is tested, not the
        Qore library it runs on
    */
    private static bool hasUncontrolledApiPolicy() {
        *hash<auto> info = get_module_hash().jni.info;
        return info.uncontrolled_api_policy ?? False;
    }

    private skipIfNotSetterAware() {
        if (!setterAware()) {
            testSkip("the jni module was built for a Qore library that does not record the setters of datasource "
                "options");
        }
    }

    #! Returns the sandbox of the trusted-sandbox code
    /** a sandbox that a host attaches to trusted code for its limits and interrupts: it allows uncontrolled APIs, and
        its filesystem policy allows only one directory (its code loads no module)
    */
    private SandboxManager getTrustingSandbox() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        sm.setNetworkDefaultPolicy(True);
        # (a Qore without the policy has no run-time refusal of uncontrolled APIs: the call is dynamic)
        if (sm.hasCallableMethod("setUncontrolledApiPolicy")) {
            call_object_method(sm, "setUncontrolledApiPolicy", True);
        }
        sm.addFilesystemAllowedPath(allowed, QSEC_READ);
        return sm;
    }

    #! Returns a Program of the kind of code given
    private Program getProgram(string kind) {
        int po = Kinds{kind};
        Program p(PO_NEW_STYLE | (po > 0 ? po : 0));
        if (po == -1) {
            p.setSandboxManager(new SandboxManager());
        } else if (po == -2) {
            p.setSandboxManager(getTrustingSandbox());
        }
        # a Program is parsed once
        p.parse(inlist(kind, loaderKinds()) ? LoaderSource + Source : Source, "jni-jdbc-option-setter-" + kind);
        return p;
    }

    #! Returns True if the class loader of the Program of the kind given (or of this Program) has the entry
    private bool loaderHas(*string kind, string entry) {
        list<string> urls;
        if (kind) {
            urls = pgms{kind}.callFunction("loader_urls");
        } else {
            foreach Jni::java::net::URL url in (cast<Jni::java::net::URLClassLoader>(
                    Jni::org::qore::jni::get_class_loader()).getURLs()) {
                urls += url.toString();
            }
        }
        # the loader keeps the canonical path of the entry: compare its directory and file name
        string tail = basename(dirname(entry)) + DirSep + basename(entry);
        return (select urls, $1.find(tail) >= 0).size() > 0;
    }

    #! Opens a datasource as this trusted code; returns "ok" or the error
    private static string open(Datasource ds) {
        try {
            ds.open();
            ds.close();
            return "ok";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    #! Returns the result that opening a datasource with the classpath entry gives, as the code of the kind set it
    /** the classpath option is accepted for trusted code, and the jdbc driver that is not found raises JNI-ERROR; a
        sandbox that allows uncontrolled APIs checks the entry against its filesystem policy (with a Qore library
        without that policy, the sandbox refuses the option like any other)
    */
    private string expectedFor(string kind, string entry) {
        if (isRefused(kind)) {
            return "JNI-SANDBOX-ERROR";
        }
        # without the uncontrolled-API policy of sandboxes, every governing sandbox restricts the code it governs
        if (kind == "trusted-sandbox" && !hasUncontrolledApiPolicy()) {
            return "JNI-SANDBOX-ERROR";
        }
        if (kind == "trusted-sandbox" && entry.substr(0, allowed.size()) != allowed) {
            return "FILESYSTEM-ACCESS-DENIED";
        }
        return "JNI-ERROR";
    }

    #! Returns True if the jdbc driver refuses to connect for the code of the kind given (qore#5747)
    /** the driver refuses to connect, before it processes any option, for code of the sandboxed Program (whose
        default sandbox restricts everything and does not trust it with uncontrolled APIs), also when it opens a
        datasource that trusted code configured, a pool that grows on its thread, and a datasource object that its
        Program created or copied, whoever opens it.  The jni module does not refuse the code of the trusted-sandbox
        Program: with the restriction API of sandboxes, its sandbox trusts it; without it, the driver is refused only
        for code that a sandbox network policy restricts, and that sandbox allows the network (its classpath option is
        then refused by the option check where the sandbox cannot trust it; see expectedFor()).  But its sandbox
        restricts filesystem access, so a Qore library that checks the destinations of connections against the
        sandbox of the code that chose them refuses the jdbc driver, which cannot report its destinations, for a
        connection that this code chose (created the datasource of, or set its connection values), whatever its
        sandbox trusts (see chooserRefused()); opening a datasource that trusted code created is not refused for it
    */
    private static bool connectRefused(string kind) {
        # with the rule of qore#7832, the driver also refuses to connect for the trusted-sandbox code, whose sandbox
        # restricts the filesystem, which the driver does not enforce
        return kind == "sandboxed" || (kind == "trusted-sandbox" && sandboxClassesRefused());
    }

    #! Returns True if the code of the kind given has a parse option that limits the connections that it chooses to
    #! the allow-listed jdbc drivers, which the qore-none URLs of the test are not (qore#7867)
    private static bool parseRestricted(string kind) {
        return kind == "no-filesystem" || kind == "no-uncontrolled";
    }

    #! Returns True if the Qore library refuses a connection that the code of the kind given chose
    /** a Qore library that checks the destinations of connections refuses the jdbc driver, which cannot report its
        destinations, for a connection chosen by code whose sandbox restricts network or filesystem access, as the
        sandbox of the trusted-sandbox code does, whatever the sandbox trusts
    */
    private static bool chooserRefused(string kind) {
        return kind == "trusted-sandbox" && coreChecksTargets();
    }

    #! Returns True if the Qore library checks the destinations of connections against the sandbox of the code that
    #! chose them
    /** Such a library refuses a driver that cannot report its destinations, such as the jdbc driver, for a
        connection chosen by code whose sandbox restricts network or filesystem access, whatever the sandbox trusts
    */
    private static bool coreChecksTargets() {
        if (exists core_checks_targets) {
            return core_checks_targets;
        }
        SandboxManager sm();
        if (!sm.hasCallableMethod("setUncontrolledApiPolicy")) {
            return core_checks_targets = False;
        }
        sm.setNetworkDefaultPolicy(False);
        sm.setFilesystemDefaultPolicy(True);
        call_object_method(sm, "setUncontrolledApiPolicy", True);
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm);
        p.parse("
string sub open_desc() {
    try {
        Datasource ds(\"jdbc:u/p@jdbc:qore-none://x\");
        ds.open();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
", "jni-jdbc-option-setter-core-check");
        string rv = p.callFunction("open_desc");
        return core_checks_targets = (rv =~ /^NETWORK-ACCESS-DENIED:.*cannot report the destinations/);
    }

    #! Returns the result of a connection that the code of the kind \a connecting chose and opens, with the option
    #! set by \a setter
    private string expectedConnect(string connecting, string setter, string entry) {
        return connectRefused(connecting) || chooserRefused(connecting) ? "NETWORK-ACCESS-DENIED"
            : expectedFor(setter, entry);
    }

    #! the classpath entries of the test: one in the allowed directory, one in the denied directory
    private list<string> entries() {
        return (allowed + DirSep + "driver.jar", denied + DirSep + "driver.jar");
    }

    #! the cases of the new rule are skipped only with a module and a Qore library that both lack the features
    /** a jni module built with the uncontrolled-API policy, or run on a Qore library that has it, but that does not
        judge the option by its setter is a mismatch of module and library, not a reason to skip
    */
    featureTest() {
        bool core_policy = (new SandboxManager()).hasCallableMethod("setUncontrolledApiPolicy");
        assertEq(core_policy, hasUncontrolledApiPolicy(), "the module's uncontrolled-API policy flag and the Qore "
            "library's SandboxManager::setUncontrolledApiPolicy()");
        if (core_policy || hasUncontrolledApiPolicy()) {
            assertTrue(setterAware(), "a jni module with the uncontrolled-API policy judges the jdbc classpath "
                "option by its setter (\"jdbc_option_setter\" in the \"info\" key of the module hash)");
        }
        if (!sandboxClassesRefused()) {
            return;
        }
        # qore#7832: the sandbox of the trusted-sandbox code trusts it with uncontrolled APIs but restricts the
        # filesystem, which Java code does not enforce: it is refused Java classes, the classpath option and the
        # connections of the driver, as code that its sandbox does not trust is
        try {
            Program lp(PO_NEW_STYLE);
            lp.setSandboxManager(getTrustingSandbox());
            lp.parse(LoaderSource, "jni-jdbc-option-setter-trusted-sandbox-loader");
            fail("the trusted-sandbox code imported Java classes");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("JNI-SANDBOX-ERROR", ex.err, "trusted-sandbox: import");
            assertRegex("cannot use the \"import\" module command.*parse options that forbid it \\(0x200000000000, ",
                ex.desc, "trusted-sandbox: import (description)");
        }
        Program ts = pgms."trusted-sandbox";
        Datasource ds("jdbc:u/p@jdbc:qore-none://x");
        ts.callFunction("set_classpath", ds, allowed + DirSep + "driver.jar");
        # the sandbox adds PO_NO_UNCONTROLLED_APIS to the restrictions of the code that sets the option
        assertRegex("^JNI-SANDBOX-ERROR: the jdbc 'classpath' option adds to the Program's classpath, which code that "
            "does not allow uncontrolled APIs", openDesc(ds),
            "trusted-sandbox: the classpath option in its own policy");
        assertRegex("^NETWORK-ACCESS-DENIED: the jdbc driver cannot connect for code that a sandbox does not trust "
            "with uncontrolled APIs, or whose sandbox restricts the filesystem or the network",
            ts.callFunction("open_desc", new Datasource("jdbc:u/p@jdbc:qore-none://x")),
            "trusted-sandbox: a connection that trusted code chose");
    }

    #! Opens a datasource as this trusted code; returns "ok" or the error and its description
    private static string openDesc(Datasource ds) {
        try {
            ds.open();
            ds.close();
            return "ok";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err + ": " + ex.desc;
        }
    }

    directTest() {
        # the code that sets the option opens the connection: the same result with every Qore library
        foreach string kind in (keys Kinds) {
            foreach string entry in (entries()) {
                assertEq(expectedConnect(kind, kind, entry), pgms{kind}.callFunction("open_new", entry),
                    kind + ": " + entry);
            }
        }
        # restricted code cannot create a pool with a classpath either: the pool opens its first connection
        foreach string kind in (refusedKinds()) {
            assertEq(connectRefused(kind) ? "NETWORK-ACCESS-DENIED" : "JNI-SANDBOX-ERROR",
                pgms{kind}.callFunction("make_pool", get_script_dir() + "qore-jni-test.jar"), kind + ": a pool");
        }
    }

    configuredTest() {
        skipIfNotSetterAware();
        foreach string kind in (keys Kinds) {
            foreach string entry in (entries()) {
                # trusted code creates the datasource, the code of the kind sets the option, trusted code opens it
                Datasource ds("jdbc:u/p@jdbc:qore-none://x");
                pgms{kind}.callFunction("set_classpath", ds, entry);
                assertEq(expectedFor(kind, entry), open(ds), kind + ": setOption(): " + entry);
                # the last setter decides: trusted code sets the option again
                ds.setOption("classpath", NoSuchEntry);
                assertEq("JNI-ERROR", open(ds), kind + ": set again by trusted code");

                # the code of the kind creates the datasource with the option; the datasource object is its code's
                assertEq(expectedConnect(kind, kind, entry), open(pgms{kind}.callFunction("make", entry)),
                    kind + ": connection string: " + entry);
                assertEq(expectedConnect(kind, kind, entry), open(pgms{kind}.callFunction("make_hash", entry)),
                    kind + ": constructor hash: " + entry);
            }
        }
    }

    copyTest() {
        skipIfNotSetterAware();
        foreach string kind in (keys Kinds) {
            foreach string entry in (entries()) {
                # trusted code copies a datasource that the code of the kind configured
                Datasource configured = pgms{kind}.callFunction("make", entry);
                assertEq(expectedConnect(kind, kind, entry), open(configured.copy()), kind + ": a trusted copy: "
                    + entry);
            }
            # the code of the kind sets the option on a datasource that trusted code created; trusted code copies it:
            # the copy keeps the setter
            foreach string entry in (entries()) {
                Datasource ds("jdbc:u/p@jdbc:qore-none://x");
                pgms{kind}.callFunction("set_classpath", ds, entry);
                assertEq(expectedFor(kind, entry), open(ds.copy()), kind + ": a trusted copy of its setting: " + entry);
            }
            # the code of the kind copies a datasource that trusted code configured
            Datasource trusted("jdbc:u/p@jdbc:qore-none://x{classpath=" + NoSuchEntry + "}");
            # the copy is the code's own datasource object: the code of the kind chose its connection, so code
            # restricted by parse options is limited to the allow-listed drivers (qore#7867)
            assertEq(connectRefused(kind) || chooserRefused(kind)
                ? "NETWORK-ACCESS-DENIED"
                : (parseRestricted(kind) ? "JNI-SANDBOX-ERROR" : "JNI-ERROR"),
                open(pgms{kind}.callFunction("copy_ds", trusted)), kind + ": its copy of a trusted datasource");
        }
    }

    trustedOpenedTest() {
        skipIfNotSetterAware();
        foreach string kind in (keys Kinds) {
            # trusted code configures the datasource: the code of the kind opens it, also with a classpath entry
            # that its own policy denies
            foreach string entry in ((NoSuchEntry,) + entries()) {
                Datasource ds("jdbc:u/p@jdbc:qore-none://x{classpath=" + entry + "}");
                assertEq(connectRefused(kind) ? "NETWORK-ACCESS-DENIED" : "JNI-ERROR",
                    pgms{kind}.callFunction("open", ds), kind + ": " + entry);
            }
        }
    }

    openConnectionTest() {
        skipIfNotSetterAware();
        string jar = get_script_dir() + "qore-jni-test.jar";
        # the fixture driver is registered with the DriverManager, so a datasource without a classpath connects
        JdbcTransactionDriver::reset();
        foreach string kind in (keys Kinds) {
            # trusted code opens the datasource, the code of the kind sets the option on the open connection: the
            # driver is given the value with the code of the kind as its setter
            Datasource ds({"type": "jdbc", "db": "qore-transaction-test:fixture"});
            ds.open();
            on_exit ds.close();
            string exp = isRefused(kind)
                ? "JNI-SANDBOX-ERROR"
                : (kind == "trusted-sandbox" ? "FILESYSTEM-ACCESS-DENIED" : "ok");
            assertEq(exp, pgms{kind}.callFunction("try_set_classpath", ds, jar), kind + ": setOption() when open");
            if (exp != "ok") {
                # the refused value is not kept: a copy opens without it
                assertEq("ok", open(ds.copy()), kind + ": a copy after the refusal");
                # trusted code can set the option on the open connection
                assertEq("ok", try_set_classpath(ds, jar), kind + ": set by trusted code when open");
            }
            # the value that was set is kept with its setter: a copy that trusted code opens is allowed
            assertEq("ok", open(ds.copy()), kind + ": a copy of the trusted configuration");
        }
        # the value that the connection already has, set again on the open connection by the code of the kind: it is
        # judged by its new setter at once, not only when the next connection is opened
        foreach string kind in (keys Kinds) {
            Datasource ds({"type": "jdbc", "db": "qore-transaction-test:fixture"});
            ds.open();
            on_exit ds.close();
            assertEq("ok", try_set_classpath(ds, jar), kind + ": trusted code sets the classpath when open");
            string exp = isRefused(kind)
                ? "JNI-SANDBOX-ERROR"
                : (kind == "trusted-sandbox" ? "FILESYSTEM-ACCESS-DENIED" : "ok");
            assertEq(exp, pgms{kind}.callFunction("try_set_classpath", ds, jar), kind + ": the same value set again");
            # a refused value keeps the trusted setter: a copy opens
            assertEq("ok", open(ds.copy()), kind + ": a copy after the same value was set again");
        }

        # a classpath with an environment variable, expanded when the value is applied: the raw value set twice, and
        # the raw value followed by the value already expanded, which is the same classpath
        # the previous value of the variable is restored afterwards
        *string old_cp_dir = getenv("QORE_JNI_TEST_CP_DIR");
        on_exit {
            if (exists old_cp_dir) {
                setenv("QORE_JNI_TEST_CP_DIR", old_cp_dir);
            } else {
                unsetenv("QORE_JNI_TEST_CP_DIR");
            }
        }
        setenv("QORE_JNI_TEST_CP_DIR", dirname(jar));
        string raw = "$QORE_JNI_TEST_CP_DIR" + DirSep + basename(jar);
        foreach string kind in (keys Kinds) {
            string exp = isRefused(kind)
                ? "JNI-SANDBOX-ERROR"
                : (kind == "trusted-sandbox" ? "FILESYSTEM-ACCESS-DENIED" : "ok");
            foreach string again in ((raw, jar)) {
                string label = sprintf("%s: %y after the raw value %y", kind, again, raw);
                Datasource ds({"type": "jdbc", "db": "qore-transaction-test:fixture"});
                ds.open();
                on_exit ds.close();
                assertEq("ok", try_set_classpath(ds, raw), label + ": trusted code sets the raw value");
                # the connection reports the expanded value
                assertEq(jar, ds.getOptionHash().classpath.value, label + ": the value is expanded");
                assertEq(exp, pgms{kind}.callFunction("try_set_classpath", ds, again), label + ": set again");
                assertEq(jar, ds.getOptionHash().classpath.value, label + ": the value after it was set again");
                # the kept value and its setter: a copy opens with the variable expanded when it opens
                assertEq("ok", open(ds.copy()), label + ": a copy opens");
            }
        }

        # the variable points into the directory that the trusted sandbox allows: the entry is checked against the
        # policy after it is expanded, so the trusted sandbox can set it
        setenv("QORE_JNI_TEST_CP_DIR", allowed);
        {
            string allowed_raw = "$QORE_JNI_TEST_CP_DIR" + DirSep + "env-allowed.jar";
            foreach string kind in (keys Kinds) {
                string exp = isRefused(kind) ? "JNI-SANDBOX-ERROR" : "ok";
                Datasource ds({"type": "jdbc", "db": "qore-transaction-test:fixture"});
                ds.open();
                on_exit ds.close();
                assertEq(exp, pgms{kind}.callFunction("try_set_classpath", ds, allowed_raw),
                    kind + ": a variable that points into the allowed directory");
            }
        }

        # the sandbox that allows uncontrolled APIs can set an entry that its policy allows
        Datasource ds({"type": "jdbc", "db": "qore-transaction-test:fixture"});
        ds.open();
        on_exit ds.close();
        string entry = allowed + DirSep + "open-connection.jar";
        # with the rule of qore#7832, the sandbox refuses the option, as it restricts the filesystem
        assertEq(isRefused("trusted-sandbox") ? "JNI-SANDBOX-ERROR" : "ok",
            pgms."trusted-sandbox".callFunction("try_set_classpath", ds, entry),
            "trusted-sandbox: an allowed entry when open");
        # the copy keeps the trusted sandbox as the setter: its policy allows the entry for trusted code too (or the
        # refused value is not kept)
        assertEq("ok", open(ds.copy()), "trusted-sandbox: a copy with an allowed entry");
    }

    #! Sets the option as this trusted code; returns "ok" or the error
    private static string try_set_classpath(Datasource ds, string cp) {
        try {
            ds.setOption("classpath", cp);
            return "ok";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    poolTest() {
        skipIfNotSetterAware();
        string jar = get_script_dir() + "qore-jni-test.jar";
        foreach string kind in (keys Kinds) {
            JdbcTransactionDriver::reset();
            # a directory of the classpath shows which class loader the classpath was added to (the jar is in the
            # global classpath, so a Program's own class loader does not list it)
            string marker = allowed + DirSep + "pool-" + kind;
            mkdir(marker);
            DatasourcePool pool({"type": "jdbc", "db": "qore-transaction-test:fixture",
                "options": {"classpath": jar + ";" + marker, "min": 1, "max": 2}});
            # this thread holds the first connection in a transaction, so the code of the kind on another thread
            # needs a new one
            pool.beginTransaction();
            auto rv;
            {
                on_exit pool.rollback();
                Queue q();
                background q.push(pgms{kind}.callFunction("pool_read", pool));
                rv = q.get();
            }
            if (connectRefused(kind)) {
                # the driver does not connect for the code on its thread; the classpath is not the reason
                assertEq("NETWORK-ACCESS-DENIED", rv, kind + ": the pool does not connect on the thread of the code");
                assertEq(1, (select JdbcTransactionDriver::events(), $1 == "connect").size(), kind + ": connections");
            } else {
                assertEq(1, rv, kind + ": the connection that the pool opened on the thread of the code");
                # the fixture driver connected twice: the first connection and the new one
                assertEq(2, (select JdbcTransactionDriver::events(), $1 == "connect").size(), kind + ": connections");
            }
            # the current behavior (see the jdbc driver guide): the classpath of every connection of the pool is
            # added to the class loader of the Program that created the pool, not of the code that opened the
            # connection
            assertTrue(loaderHas(NOTHING, marker), kind + ": the class loader of the code that created the pool");
            if (inlist(kind, loaderKinds())) {
                assertFalse(loaderHas(kind, marker), kind + ": the class loader of the code that opened the "
                    "connection");
            }
        }
    }

    policyTest() {
        skipIfNotSetterAware();
        # the trusted sandbox sets the option: its policy applies when trusted or sandboxed code opens the datasource
        foreach string entry in (entries()) {
            Datasource ds = pgms."trusted-sandbox".callFunction("make", entry);
            # the trusted-sandbox code created the datasource: a Qore library that checks the destinations of
            # connections refuses it, as that code's sandbox restricts filesystem access
            string exp = expectedConnect("trusted-sandbox", "trusted-sandbox", entry);
            assertEq(exp, open(ds.copy()), "opened by trusted code: " + entry);
            foreach string kind in (keys Kinds) {
                assertEq(connectRefused(kind) ? "NETWORK-ACCESS-DENIED" : exp,
                    pgms{kind}.callFunction("open", ds.copy()), "opened by " + kind + " code: " + entry);
            }
        }

        # the current behavior (see the jdbc driver guide): the classpath is added to the class loader of the Program
        # that created the Datasource object, not of the code that opens the connection; a directory of the classpath
        # shows which class loader it was added to
        string dir = allowed + DirSep + "policy-classes";
        mkdir(dir);
        if (chooserRefused("trusted-sandbox")) {
            # a Qore library that checks the destinations of connections refuses a connection that the
            # trusted-sandbox code chose, as its sandbox restricts filesystem access; the class loader is then shown
            # with a creator that it does not refuse: the trusted Program
            assertEq("NETWORK-ACCESS-DENIED", open(pgms."trusted-sandbox".callFunction("make", dir)),
                "created by the trusted-sandbox code, opened by trusted code: " + dir);
            Datasource tds = pgms.trusted.callFunction("make", dir);
            assertEq("JNI-ERROR", open(tds), "created by the trusted Program, opened by trusted code: " + dir);
            assertTrue(loaderHas("trusted", dir), "the class loader of the Program that created the datasource");
            assertFalse(loaderHas(NOTHING, dir), "the class loader of the trusted code that opened it");
            assertEq("JNI-ERROR", open(tds.copy()), "a copy opened by trusted code: " + dir);
            assertFalse(loaderHas(NOTHING, dir), "the class loader of the trusted code that copied and opened it");
            return;
        }
        Datasource ds = pgms."trusted-sandbox".callFunction("make", dir);
        # the driver is not found in the directory
        assertEq("JNI-ERROR", open(ds), "opened by trusted code: " + dir);
        assertEq("JNI-ERROR", pgms.trusted.callFunction("open", ds), "opened by the trusted Program: " + dir);
        assertTrue(loaderHas("trusted-sandbox", dir), "the class loader of the code that created the datasource");
        assertFalse(loaderHas(NOTHING, dir), "the class loader of the trusted code that opened it");
        assertFalse(loaderHas("trusted", dir), "the class loader of the trusted Program that opened it");
        # nor of the trusted code that copies the datasource and opens the copy
        assertEq("JNI-ERROR", open(ds.copy()), "a copy opened by trusted code: " + dir);
        assertFalse(loaderHas(NOTHING, dir), "the class loader of the trusted code that copied and opened it");
    }
}
