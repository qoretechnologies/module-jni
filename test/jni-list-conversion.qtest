#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

# conversion to Java has to resolve these; see indirectReferences()
%allow-weak-references
%allow-opaque-references
%requires QUnit
%requires jni
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.ListConversions
%exec-class JniListConversionTest

class JniListConversionTest inherits QUnit::Test {
    constructor() : QUnit::Test("JNI list conversion", "1.0") {
        addTestCase("Empty lists become Object arrays", \emptyLists());
        addTestCase("Hash entries distinguish empty lists, null, and absent keys", \hashEntries());
        addTestCase("Nested empty lists survive a round trip", \nestedLists());
        addTestCase("Nonempty arrays retain inferred types and null elements", \nonemptyLists());
        addTestCase("Typed empty arrays retain their component type", \typedArrays());
        addTestCase("Varargs retain their component type and offset", \varargs());
        addTestCase("Invalid typed elements throw and subsequent conversions recover", \invalidElements());
        addTestCase("Indirect references convert as their targets", \indirectReferences());
        set_return_value(main());
    }

    #! A weak or opaque reference must convert exactly as the value it refers to
    /** A container holds what was assigned to it, so a member assigned with ":=" or "@=" is stored
        as the reference itself and iterating the container yields that, not its target.  Without
        QoreValue::resolveIndirect(), Array::getClassForValue() picks a Java class for the reference
        and QoreToJava::toAnyObject() refuses to convert it.

        Comparing against the same structure built with "=" is what makes this meaningful: it
        asserts the indirection is invisible, rather than pinning a particular Java signature.
    */
    indirectReferences() {
        hash<auto> inner = {"a": 1, "b": "two"};
        list<auto> ilist = ("one", "two");

        list<auto> plain = (inner, ilist);
        list<auto> weak = ();
        weak[0] := inner;
        weak[1] := ilist;
        assertEq(ListConversions::describe(plain), ListConversions::describe(weak),
            "a list of weak references describes as a list of their targets");
        assertEq(ListConversions::roundTrip(plain), ListConversions::roundTrip(weak),
            "a list of weak references round trips as its targets");

        list<auto> opaque = ();
        opaque[0] @= inner;
        opaque[1] @= ilist;
        assertEq(ListConversions::describe(plain), ListConversions::describe(opaque),
            "a list of opaque references describes as a list of their targets");
        assertEq(ListConversions::roundTrip(plain), ListConversions::roundTrip(opaque),
            "a list of opaque references round trips as its targets");

        # the hash path reaches QoreToJava::toAnyObject() through a different caller
        hash<auto> plain_hash = {"h": inner, "l": ilist};
        hash<auto> weak_hash = {};
        weak_hash{"h"} := inner;
        weak_hash{"l"} := ilist;
        assertEq(ListConversions::roundTrip((plain_hash,)), ListConversions::roundTrip((weak_hash,)),
            "weak references inside a hash round trip as their targets");
    }

    emptyLists() {
        assertEq("[Ljava.lang.Object;:0", ListConversions::describe(()));
        list<string> strings = ();
        assertEq("[Ljava.lang.Object;:0", ListConversions::describe(strings));
        auto result = ListConversions::roundTrip(());
        assertTrue(result instanceof list);
        assertEq(0, result.size());
        assertEq("null", ListConversions::describe(NULL));
    }

    hashEntries() {
        hash<auto> value = {"empty": (), "null": NULL};
        assertEq("[Ljava.lang.Object;:0", ListConversions::describeEntry(value, "empty"));
        assertEq("null", ListConversions::describeEntry(value, "null"));
        assertEq("absent", ListConversions::describeEntry(value, "missing"));
        hash<auto> result = ListConversions::roundTrip(value);
        assertTrue(result.hasKey("empty"));
        assertTrue(result.empty instanceof list);
        assertEq(0, result.empty.size());
        assertTrue(result.hasKey("null"));
        assertFalse(result.hasKey("missing"));
    }

    nestedLists() {
        list<auto> value = ((), {"items": ()}, ((), ("value",)));
        list<auto> result = ListConversions::roundTrip(value);
        assertEq(value, result);
        assertTrue(result[0] instanceof list);
        assertTrue(result[1].items instanceof list);
        assertTrue(result[2][0] instanceof list);
    }

    nonemptyLists() {
        assertEq("[Ljava.lang.String;:2", ListConversions::describe(("a", "b")));
        assertEq("[Ljava.lang.Long;:2", ListConversions::describe((1, 2)));
        assertEq("[Ljava.lang.Object;:2", ListConversions::describe(("a", 1)));
        assertEq("[Ljava.lang.Object;:2", ListConversions::describe((NULL, NOTHING)));
        assertEq("[Ljava.lang.String;:2", ListConversions::describe((NULL, "a")));
        list<auto> result = ListConversions::roundTrip((NULL, "a"));
        assertEq(2, result.size());
        assertEq(NOTHING, result[0]);
        assertEq("a", result[1]);
    }

    typedArrays() {
        assertEq("[Ljava.lang.Object;:0", ListConversions::describeObjects(()));
        assertEq("[Ljava.lang.String;:0", ListConversions::describeStrings(()));
        assertEq("[J:0", ListConversions::describeLongs(()));
        assertEq("[J:2", ListConversions::describeLongs((1, 2)));
        auto method = jni::load_class("org/qore/jni/test/ListConversions").getDeclaredMethod(
            "describeStrings", (jni::load_class("[Ljava/lang/String;"),));
        assertEq("null", jni::invoke(method, NOTHING, NULL));
    }

    varargs() {
        assertEq("prefix:[Ljava.lang.String;:0", ListConversions::describeVarargs("prefix:", ()));
        assertEq("prefix:[Ljava.lang.String;:2", ListConversions::describeVarargs("prefix:", ("a", "b")));
        auto method = jni::load_class("org/qore/jni/test/ListConversions").getDeclaredMethod(
            "describeVarargs", (jni::load_class("java/lang/String"), jni::load_class("[Ljava/lang/String;")));
        assertEq("prefix:[Ljava.lang.String;:2", jni::invoke(method, NOTHING, "prefix:", "a", "b"));
        assertEq("prefix:[Ljava.lang.String;:0", jni::invoke(method, NOTHING, "prefix:"));
        assertEq("prefix:[Ljava.lang.String;:0", ListConversions::describeVarargs("prefix:"));
    }

    invalidElements() {
        auto method = jni::load_class("org/qore/jni/test/ListConversions").getDeclaredMethod(
            "describeStrings", (jni::load_class("[Ljava/lang/String;"),));
        assertThrows("JNI-ERROR", sub() { jni::invoke(method, NOTHING, ("a", {})); });
        assertEq("[Ljava.lang.Object;:0", ListConversions::describe(()));
        assertEq("[Ljava.lang.String;:1", ListConversions::describeStrings(("a",)));
    }
}
