#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires jni
%requires QUnit
%requires DataProvider
%requires ConnectionProvider

%exec-class JniClassOptionsSandboxTest

#! Provider options checked with check_class_option() are refused to sandboxed callers (qore#5742)
class JniClassOptionsSandboxTest inherits QUnit::Test {
    private:internal {
        const Modules = ("JdbcDataProvider", "JakartaJmsDataProvider", "KafkaDataProvider", "CamelDataProvider",
            "JasperReportsDataProvider", "FlywayDataProvider");

        #! The Kafka option that names a command, its default and another value
        const KinitOpt = "sasl.kerberos.kinit.cmd";
        const KinitDefault = "/usr/bin/kinit";
        const KinitOther = "/nonexistent-qore-test-dir/kinit";

        #! Code of a trusted Program that makes what the test gives to sandboxed code
        const TrustedKinitCode = sprintf("
auto sub default_value() {
    return KafkaDataProvider::KafkaConnection::ConnectionScheme.options.%y.default_value;
}

KafkaDataProvider::KafkaConnection sub make_connection(string cmd) {
    return new KafkaDataProvider::KafkaConnection(\"k\", \"k\", \"kafka://127.0.0.1:1\", {}, {%y: cmd});
}

code sub make_capability(string cmd) {
    return SandboxManager::createSystemPolicyCall(sub () {
        KafkaDataProvider::KafkaDataProviderBase::checkClassOptions({%y: cmd});
    });
}
", KinitOpt, KinitOpt, KinitOpt);

        #! trusted code that creates the Camel objects that sandboxed code then uses
        const TrustedCamelCode = "
list<object> sub make_producer() {
    CamelDataProvider::CamelDataProvider dp();
    # the parent is returned too, so that it lives as long as its child
    return (dp, dp.getChildProvider(\"producer\"));
}

CamelDataProvider::CamelConnection sub make_connection() {
    return new CamelDataProvider::CamelConnection(\"c\", \"c\", \"camel://x\");
}
";

        #! sandboxed code that uses objects that trusted code created
        const SandboxedUseCode = "
string sub send(object producer, string endpoint) {
    try {
        producer.doRequest({\"endpoint\": endpoint, \"body\": \"x\"});
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}

string sub get_context(object c) {
    try {
        object ctx = c.get(False);
        delete ctx;
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";
    }

    constructor() : QUnit::Test("JNI class options sandbox", "1.0", \ARGV) {
        addTestCase("objects that trusted code created", \trustedObjectTest());
        addTestCase("jdbc options", \jdbcTest());
        addTestCase("jms options", \jmsTest());
        addTestCase("kafka options", \kafkaTest());
        addTestCase("kafka jaas entries", \kafkaJaasTest());
        addTestCase("kafka clients", \kafkaClientTest());
        addTestCase("kafka kinit command", \kafkaKinitTest());
        addTestCase("jdbc and jms connections", \connectionTest());
        addTestCase("camel endpoints", \camelTest());
        addTestCase("jasperreports templates", \jasperTest());
        addTestCase("flyway options", \flywayTest());
        addTestCase("barrier and capability", \barrierTest());
        addTestCase("a sandbox that trusts the code with uncontrolled APIs does not refuse it", \trustedSandboxTest());
        set_return_value(main());
    }

    #! Runs the code in a new Program, sandboxed or not; returns the error code, or "ok"
    private static string runAs(bool sandboxed, string body, *reference<string> desc) {
        Program p(PO_NEW_STYLE);
        if (sandboxed) {
            SandboxManager sm();
            sm.setNetworkDefaultPolicy(True);
            p.setSandboxManager(sm);
        }
        map p.loadModule($1), Modules;
        p.parse("sub run() {\n" + body + "\n}\n", "jni-class-options");
        try {
            p.callFunction("run");
            return "ok";
        } catch (hash<ExceptionInfo> ex) {
            desc = ex.desc;
            return ex.err;
        }
    }

    #! Checks that the sandboxed run is refused for the option and that the trusted run is not
    /** @param trusted_desc if given, a regular expression that the trusted run's error must match
    */
    private checkOption(string label, string option, string body, *string trusted_desc) {
        checkSandboxed(label, option, body);
        string tdesc;
        string err = runAs(False, body, \tdesc);
        assertTrue(err != "JNI-SANDBOX-ERROR", label + ": trusted: " + err);
        if (trusted_desc) {
            assertRegex(trusted_desc, tdesc, label + ": trusted: the option was used");
        }
    }

    #! Checks an option of a connection or data provider that the code creates: sandboxed code is refused the object
    /** the connections and data providers of the apps with external I/O that the sandbox does not control refuse
        sandboxed code in their constructors (\c APP-SANDBOX-ACCESS-DENIED), before the options are read; the option
        check is tested for sandboxed code through the static checks and objects that trusted code created

        @param trusted_desc if given, a regular expression that the trusted run's error must match
    */
    private checkAppOption(string label, string body, *string trusted_desc) {
        checkAppRefused(label, body);
        string tdesc;
        string err = runAs(False, body, \tdesc);
        assertTrue(err != "JNI-SANDBOX-ERROR" && err != "APP-SANDBOX-ACCESS-DENIED", label + ": trusted: " + err);
        if (trusted_desc) {
            assertRegex(trusted_desc, tdesc, label + ": trusted: the option was used");
        }
    }

    #! Checks that the sandboxed run is refused by the app before the options are read
    private checkAppRefused(string label, string body) {
        string desc;
        assertEq("APP-SANDBOX-ACCESS-DENIED", runAs(True, body, \desc), label + ": sandboxed");
        assertRegex("not declared sandbox-aware", desc, label + ": sandboxed: refused by the app");
    }

    #! Checks that the sandboxed run is refused for the option
    private checkSandboxed(string label, string option, string body) {
        string desc;
        assertSandboxRefused(runAs(True, body, \desc), desc, label + ": sandboxed", option);
    }

    #! Asserts that a sandboxed run was refused: by the check, naming the option, or, where a sandbox refuses
    #! uncontrolled APIs at run time (qore#5741), by the core before the check is reached
    private assertSandboxRefused(string err, *string desc, string label, *string option) {
        if (err == "INVALID-FUNCTION-ACCESS") {
            assertRegex("uncontrolled API", desc, label + ": refused as an uncontrolled API");
            return;
        }
        assertEq("JNI-SANDBOX-ERROR", err, label);
        if (option) {
            assertRegex(option, desc, label + ": option named");
        }
    }

    #! Checks that neither run is refused by the check
    private checkAllowed(string label, string body) {
        foreach bool sandboxed in ((True, False)) {
            string desc;
            string err = runAs(sandboxed, body, \desc);
            assertTrue(err != "JNI-SANDBOX-ERROR", sprintf("%s: %s: %s", label, sandboxed ? "sandboxed" : "trusted",
                desc));
        }
    }

    jdbcTest() {
        string base = "\"url\": \"jdbc:qore-none://x\", \"user\": \"u\", \"password\": \"p\"";
        checkAppOption("classpath", "new JdbcDataProvider::JdbcDataProvider({" + base
            + ", \"classpath\": \"/nonexistent-qore-test-dir\"});");
        checkAppOption("driver_class", "new JdbcDataProvider::JdbcDataProvider({" + base
            + ", \"driver_class\": \"com.example.Placeholder\"});", "com.example.Placeholder");
        foreach string url in ("jdbc:qore-none://x?a=b", "jdbc:qore-none://x;a=b", "jdbc:qore-none://(host=x,a=b)/d",
                "jdbc:qore-none://address=(host=x)/d") {
            checkAppOption("url properties " + url, sprintf("new JdbcDataProvider::JdbcDataProvider({\"url\": "
                "%y, \"user\": \"u\", \"password\": \"p\"});", url));
        }
        checkAllowed("plain url", "new JdbcDataProvider::JdbcDataProvider({" + base + "});");
    }

    jmsTest() {
        string base = "\"url\": \"tcp://127.0.0.1:1\", \"connection_factory_class\": \"com.example.Placeholder\"";
        checkOption("provider_classpath", "provider_classpath",
            "JakartaJmsDataProvider::JmsDataProviderBase::createConnectionFactory({" + base
            + ", \"provider_classpath\": \"/nonexistent-qore-test-dir\"});");
        checkOption("connection_factory_class", "connection_factory_class",
            "JakartaJmsDataProvider::JmsDataProviderBase::createConnectionFactory({" + base + "});",
            "com.example.Placeholder");
    }

    #! Returns code that checks one Kafka option value
    private static string kafkaCheck(string opt, string value) {
        return sprintf("KafkaDataProvider::KafkaDataProviderBase::checkClassOptions({%y: %y});", opt, value);
    }

    kafkaTest() {
        foreach string opt in ("ssl.engine.factory.class", "sasl.client.callback.handler.class",
                "sasl.login.callback.handler.class", "sasl.login.class", "key.serializer", "value.serializer",
                "key.deserializer", "value.deserializer") {
            checkOption(opt, opt, kafkaCheck(opt, "com.example.Placeholder"));
        }
        checkAllowed("default ssl.engine.factory.class", kafkaCheck("ssl.engine.factory.class",
            "org.apache.kafka.common.security.ssl.DefaultSslEngineFactory"));
        checkAllowed("builtin key.serializer", kafkaCheck("key.serializer",
            "org.apache.kafka.common.serialization.StringSerializer"));
        checkAllowed("builtin value.deserializer", kafkaCheck("value.deserializer",
            "org.apache.kafka.common.serialization.ByteArrayDeserializer"));
    }

    kafkaJaasTest() {
        string plain = "org.apache.kafka.common.security.plain.PlainLoginModule";
        checkAllowed("one builtin entry", kafkaCheck("sasl.jaas.config",
            plain + " required username=\"user\" password=\"a;b\";"));
        checkOption("other module", "sasl.jaas.config", kafkaCheck("sasl.jaas.config",
            "com.example.PlaceholderModule required;"));
        checkOption("two entries", "sasl.jaas.config", kafkaCheck("sasl.jaas.config",
            plain + " required; com.example.PlaceholderModule required;"));
        checkOption("no flag", "sasl.jaas.config", kafkaCheck("sasl.jaas.config", plain));
    }

    kafkaClientTest() {
        string conn = "new KafkaDataProvider::KafkaConnection(\"k\", \"k\", \"kafka://127.0.0.1:1\"";
        checkAppOption("consumer", "new KafkaDataProvider::KafkaConsumerDataProvider(" + conn
            + "), {\"topics\": (\"t\",), \"value.deserializer\": \"com.example.Placeholder\"});");
        checkAppOption("producer", "new KafkaDataProvider::KafkaProducerDataProvider(" + conn
            + "), {\"value.serializer\": \"com.example.Placeholder\"});");
        checkAppOption("connection option", "new KafkaDataProvider::KafkaConsumerDataProvider("
            + conn + ", {}, {\"sasl.login.class\": \"com.example.Placeholder\"}), {\"topics\": (\"t\",)});");
    }

    kafkaKinitTest() {
        string Opt = KinitOpt;
        string Default = KinitDefault;
        string Other = KinitOther;

        Program tp(PO_NEW_STYLE);
        map tp.loadModule($1), Modules;
        tp.parse(TrustedKinitCode, "jni-class-options-kinit-trusted");
        assertEq(Default, tp.callFunction("default_value"), "the allowed value is the connection's default");

        checkOption("the check", Opt, kafkaCheck(Opt, Other));
        checkAllowed("the check: default", kafkaCheck(Opt, Default));
        checkAllowed("the check: not set", "KafkaDataProvider::KafkaDataProviderBase::checkClassOptions({});");

        string conn = "new KafkaDataProvider::KafkaConnection(\"k\", \"k\", \"kafka://127.0.0.1:1\"";
        foreach hash<auto> p in (
                {"name": "consumer", "cls": "KafkaConsumerDataProvider", "args": "\"topics\": (\"t\",)"},
                {"name": "producer", "cls": "KafkaProducerDataProvider", "args": ""},
            ) {
            string prefix = "new KafkaDataProvider::" + p.cls + "(";
            string sep = p.args ? ", " : "";
            # the data provider of the connection gives the connection's options to its children
            string root = conn + ", {}, {%y: %y}).getDataProvider({" + p.args + "}).getChildProviderEx("
                + sprintf("%y", p.name) + ");";
            checkAppOption(p.name + ": connection option", sprintf("%s%s, {}, {%y: %y}), {%s});", prefix, conn, Opt,
                Other, p.args));
            checkAppOption(p.name + ": data provider of the connection", sprintf(root, Opt, Other));
            # it is a connection option only: a provider does not accept it from any caller
            string direct = sprintf("%s%s), {%s%s%y: %y});", prefix, conn, p.args, sep, Opt, Other);
            {
                string desc;
                assertEq("CONSTRUCTOR-ERROR", runAs(False, direct, \desc), p.name + ": provider option: trusted");
                assertRegex(Opt, desc, p.name + ": provider option: named");
                # sandboxed code cannot create the provider at all: the app refuses it before the options are read
                assertEq("APP-SANDBOX-ACCESS-DENIED", runAs(True, direct, \desc), p.name
                    + ": provider option: sandboxed");
            }
            checkAllowed(p.name + ": connection option, default", sprintf("%s%s, {}, {%y: %y}), {%s});", prefix, conn,
                Opt, Default, p.args));
            checkAllowed(p.name + ": data provider of the connection, default", sprintf(root, Opt, Default));
        }

        # a connection that trusted code configured does not let sandboxed code use the command: the app refuses
        # sandboxed code a provider before the connection's options are read
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(new SandboxManager());
        map p.loadModule($1), Modules;
        p.parse("sub run(KafkaDataProvider::KafkaConnection c) { new KafkaDataProvider::KafkaConsumerDataProvider(c, "
            "{\"topics\": (\"t\",)}); }", "jni-class-options-kinit-connection");
        assertThrows("APP-SANDBOX-ACCESS-DENIED", "not declared sandbox-aware", \p.callFunction(),
            ("run", tp.callFunction("make_connection", Other)), "trusted connection");

        # through a policy barrier and a capability
        string check = kafkaCheck(Opt, Other);
        string desc;
        assertSandboxRefused(runAs(True, "SandboxManager::callWithSystemPolicy(sub () {" + check + "});", \desc), desc,
            "policy barrier", Opt);
        code cap = tp.callFunction("make_capability", Other);
        Program cp(PO_NEW_STYLE);
        cp.setSandboxManager(new SandboxManager());
        cp.parse("sub run(code c) { c(); }", "jni-class-options-kinit-capability");
        assertThrows("JNI-SANDBOX-ERROR", Opt, \cp.callFunction(), ("run", cap), "capability");

        # at run time only the sandbox restricts module code: a Program that forbids process control and has no sandbox
        # is not refused
        Program np(PO_NEW_STYLE | PO_NO_PROCESS_CONTROL);
        map np.loadModule($1), Modules;
        np.parse("sub run() {" + check + "}", "jni-class-options-kinit-no-process");
        assertEq(NOTHING, np.callFunction("run"), "no sandbox");
    }

    connectionTest() {
        string jdbc = "new JdbcDataProvider::JdbcConnection(\"j\", \"j\", \"jdbc-dp://x\", {}, {\"user\": \"u\", "
            "\"password\": \"p\", \"driver_class\": \"com.example.Placeholder\"})";
        checkAppOption("jdbc connection get", jdbc + ".get();");
        checkAppOption("jdbc connection provider", jdbc + ".getDataProvider();");
        string jms = "new JakartaJmsDataProvider::JmsConnection(\"m\", \"m\", \"jms://127.0.0.1:1\", {}, "
            "{\"connection_factory_class\": \"com.example.Placeholder\"})";
        checkAppOption("jms connection get", jms + ".get();");
    }

    #! Returns code that sends a message to the endpoint
    private static string camelSend(string endpoint) {
        return sprintf("CamelDataProvider::CamelDataProvider dp(); on_exit delete dp; "
            "dp.getChildProvider(\"producer\").doRequest({\"endpoint\": %y, \"body\": \"x\"});", endpoint);
    }

    camelTest() {
        foreach string endpoint in ("seda:qoretest", "direct:qoretest", "log:qoretest", "mock:qoretest") {
            checkAllowed(endpoint, camelSend(endpoint));
        }
        foreach string endpoint in ("file:/nonexistent-qore-test-dir", "seda:qoretest?size=1", "log:x?level=INFO",
                "direct:{{qoretest}}", "no-scheme", "seda:qoretest\n") {
            checkAppOption(endpoint, camelSend(endpoint));
        }
        # the connection returns the Camel context, which has no endpoint check
        checkAppOption("connection get", "CamelDataProvider::CamelConnection c(\"c\", \"c\", "
            "\"camel://x\"); object ctx = c.get(False); delete ctx;");
    }

    #! the option checks of objects that trusted code created, which sandboxed code then uses
    /** the app refuses sandboxed code only the creation of its objects: the option checks refuse sandboxed code the
        options that it gives to an object that trusted code created
    */
    trustedObjectTest() {
        Program tp(PO_NEW_STYLE);
        map tp.loadModule($1), Modules;
        tp.parse(TrustedCamelCode, "jni-class-options-trusted-objects");
        list<object> producer = tp.callFunction("make_producer");
        on_exit delete producer[0];
        object conn = tp.callFunction("make_connection");

        Program sp(PO_NEW_STYLE);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sp.setSandboxManager(sm);
        sp.parse(SandboxedUseCode, "jni-class-options-sandboxed-use");

        foreach string endpoint in ("file:/nonexistent-qore-test-dir", "seda:qoretest?size=1") {
            (*string err, *string desc) = (sp.callFunction("send", producer[1], endpoint) =~ x/^([^:]+): (.*)$/s);
            assertSandboxRefused(err ?? "ok", desc, endpoint + ": sandboxed send with a trusted producer", "endpoint");
        }
        # the endpoint that the check allows is not refused by it
        string rv = sp.callFunction("send", producer[1], "seda:qoretest");
        assertFalse(rv =~ /^JNI-SANDBOX-ERROR/, "an allowed endpoint: " + rv);
        # the trusted code itself may use the endpoint that sandboxed code is refused (the producer sends to the
        # endpoint, or fails for another reason than the check)
        try {
            producer[1].doRequest({"endpoint": "seda:qoretest?size=1", "body": "x"});
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err != "JNI-SANDBOX-ERROR", "trusted send: " + ex.err + ": " + ex.desc);
        }

        # a connection refuses sandboxed callers its object in AbstractConnection::get() itself, before its getImpl()
        # makes the option check, also when trusted code created it
        (*string err, *string desc) = (sp.callFunction("get_context", conn) =~ x/^([^:]+): (.*)$/s);
        assertEq("APP-SANDBOX-ACCESS-DENIED", err, "sandboxed get of a trusted connection");
        assertRegex("sandbox", desc, "sandboxed get of a trusted connection: refused by the connection");
    }

    jasperTest() {
        string cls = "JasperReportsDataProvider::JasperReportsDataProvider";
        # the trusted run of an in-memory template is not made here: it would compile the placeholder template
        checkAppRefused("template_data", "new " + cls + "({\"template_data\": <00>, \"output_format\": "
            "\"pdf\"});");
        checkAppOption("template option", "new " + cls + "({\"template\": "
            "\"/nonexistent-qore-test-dir/x.jrxml\", \"output_format\": \"pdf\"});");
        checkAppOption("template path", "new " + cls + "(\"/nonexistent-qore-test-dir/x.jrxml\", "
            "\"pdf\");");
    }

    #! Returns code that creates a Flyway provider with the given url and location
    private static string flywayWith(string url, string location) {
        return sprintf("new FlywayDataProvider::FlywayDataProvider({\"url\": %y, \"user\": \"u\", "
            "\"password\": \"p\", \"locations\": (%y,)});", url, location);
    }

    flywayTest() {
        checkAppOption("classpath location", flywayWith("jdbc:qore-none://x", "classpath:qore/test/x"));
        checkAppOption("url properties", flywayWith("jdbc:qore-none://x;a=b", "/nonexistent-qore-test-dir"));
        checkAllowed("directory location", flywayWith("jdbc:qore-none://x", "/nonexistent-qore-test-dir"));
        checkAppOption("connection", "new FlywayDataProvider::FlywayConnection(\"f\", \"f\", "
            "\"flyway://x\", {}, {\"url\": \"jdbc:qore-none://x\", \"user\": \"u\", \"password\": \"p\", "
            "\"locations\": (\"classpath:qore/test/x\",)}).getDataProvider();");
    }

    trustedSandboxTest() {
        # a host that governs trusted code with a sandbox only for its interrupts or limits allows uncontrolled APIs
        # (SandboxManager::setUncontrolledApiPolicy(), a Qore with the trust policy); that code may use the options
        SandboxManager sm();
        if (!sm.hasCallableMethod("setUncontrolledApiPolicy")) {
            testSkip("the Qore library has no uncontrolled-API policy of sandboxes");
        }
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(True);
        call_object_method(sm, "setUncontrolledApiPolicy", True);
        string check = "Jni::org::qore::jni::check_class_option(\"qore-test\", \"placeholder\");";
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm);
        p.parse("sub run() {\n" + check + "\n}\n", "jni-class-options-trusted-sandbox");
        p.callFunction("run");
        # the provider options too: a Kafka serializer of the caller's own
        Program kp(PO_NEW_STYLE);
        kp.setSandboxManager(sm);
        kp.loadModule("KafkaDataProvider");
        kp.parse("sub run() {\n" + kafkaCheck("value.serializer", "com.example.Placeholder") + "\n}\n",
            "jni-class-options-trusted-sandbox-kafka");
        kp.callFunction("run");
        # the default sandbox, with the same filesystem and network policy, still refuses it
        SandboxManager deny();
        deny.setFilesystemDefaultPolicy(True);
        deny.setNetworkDefaultPolicy(True);
        Program dp(PO_NEW_STYLE);
        dp.setSandboxManager(deny);
        dp.parse("sub run() {\n" + check + "\n}\n", "jni-class-options-default-sandbox");
        assertThrows("JNI-SANDBOX-ERROR", \dp.callFunction(), "run", "the default sandbox");
    }

    barrierTest() {
        string check = "Jni::org::qore::jni::check_class_option(\"qore-test\", \"placeholder\");";
        string desc;
        assertSandboxRefused(runAs(True, "SandboxManager::callWithSystemPolicy(sub () {" + check + "});", \desc), desc,
            "policy barrier");
        code cap = SandboxManager::createSystemPolicyCall(sub () {
            Jni::org::qore::jni::check_class_option("qore-test", "placeholder");
        });
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(new SandboxManager());
        p.parse("sub run(code c) { c(); }", "jni-class-options-capability");
        assertThrows("JNI-SANDBOX-ERROR", \p.callFunction(), ("run", cap), "capability");
        assertEq("ok", runAs(False, check), "trusted");
    }
}
