%modern
%requires jni

module JniCmdIssuerFixture {
    version = "1.0";
    desc = "issues jni module commands from library module code";
    author = "Qore Technologies";
    url = "http://qore.org";
    license = "MIT";
}

public namespace JniCmdIssuerFixture {
#! Issues the jni module command from this module's code; returns the error code, or "ok"
public string sub issue(string cmd) {
    try {
        Program::issueModuleCmd("jni", cmd);
        return "ok";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
}
