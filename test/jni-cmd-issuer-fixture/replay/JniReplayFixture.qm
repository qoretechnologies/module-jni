%modern
%requires jni
%module-cmd(jni) add-classpath /nonexistent-qore-test-dir

module JniReplayFixture {
    version = "1.0";
    desc = "a module with a jni module command, compiled to replay it";
    author = "Qore Technologies";
    url = "http://qore.org";
    license = "MIT";
}

public namespace JniReplayFixture {
public const Loaded = True;
}
