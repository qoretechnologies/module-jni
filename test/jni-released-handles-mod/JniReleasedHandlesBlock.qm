# a user module for test/jni-released-handles.qtest ("shutdown-in-use"): a Java thread calls a closure of the module,
# whose Qore code blocks until the process ends; the Qore library leaves the Program of a module that a foreign thread
# runs code in, and ends the process without running any exit handler (qore#7340)

%modern
%requires jni
%module-cmd(jni) add-relative-classpath ../qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.ReleasedHandleCalls

module JniReleasedHandlesBlock {
    version = "1.0";
    desc = "test module: a closure call that is in progress when the jni module is shut down";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace JniReleasedHandlesBlock {
    #! starts a Java thread that calls a closure of the module, which blocks until the process ends; returns once the
    #! call is in progress
    public sub start() {
        ReleasedHandleCalls::keep(sub () { ReleasedHandleCalls::blockForever(); });
        ReleasedHandleCalls::startBlockedCall();
        # registers a JVM shutdown hook that would report the state of the closure's handle; it does not run, as the
        # process ends without running any exit handler while the call is in progress (qore#7340)
        ReleasedHandleCalls::reportClosureAtShutdown();
    }
}
