# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#! test module for jni-library-caller-program.qtest: library code that creates Java state for the code that calls it

%modern
%requires jni
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.HostObjectProbe
%module-cmd(jni) import org.qore.jni.QoreJavaApi
%module-cmd(jni) import org.qore.jni.test.LibraryFieldHolder

module JniLibraryCallerProgram {
    version = "1.0";
    desc = "library code that creates Java state for the code that calls it";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the name that Java's calls into this module's Program see; not exported
string sub jlcp_name() {
    return "library";
}

#! the class of the objects that Java creates in this module's Program; not exported
class JlcpMarker {
    public {
        string owner = "library";
    }
}

public namespace JniLibraryCallerProgram {
#! defines a Java class with the class loader of the calling code
public object sub jlcp_define_class(string name, binary bytecode) {
    return define_class(name, bytecode);
}

#! sets the save object callback of the calling code
public nothing sub jlcp_set_save_object_callback(*code callback) {
    set_save_object_callback(callback);
}

#! returns a Java byte array
public object sub jlcp_byte_array(binary b) {
    return JavaArray::get(b);
}

#! returns the length of a Java byte array that a thread that this function starts creates, or the exception
public string sub jlcp_byte_array_background(binary b) {
    Queue q();
    background sub () {
        try {
            q.push(sprintf("%d", JavaArray::get(b).length()));
        } catch (hash<ExceptionInfo> ex) {
            q.push(sprintf("%s: %s", ex.err, ex.desc));
        }
    }();
    return q.get();
}

#! runs an operation that creates Java state in a thread that this function starts; returns its result or the
#! exception
public string sub jlcp_background(string op) {
    Queue q();
    background sub () {
        try {
            switch (op) {
                case "new_array":
                    q.push(sprintf("%d", new_array(load_class("java.lang.String"), 2).length()));
                    break;
                case "field_read": {
                    LibraryFieldHolder holder();
                    code c = holder.closure;
                    q.push(sprintf("%s", c("jlcp_name")));
                    break;
                }
                case "static_field_read": {
                    code c = LibraryFieldHolder::staticClosure;
                    q.push(sprintf("%s", c("jlcp_name")));
                    break;
                }
                default:
                    q.push("unknown operation: " + op);
            }
        } catch (hash<ExceptionInfo> ex) {
            q.push(sprintf("%s: %s", ex.err, ex.desc));
        }
    }();
    return q.get();
}

#! returns the class of a Java array
public object sub jlcp_array_class(object array) {
    return array.getClass();
}

#! returns a Java object used as a Qore closure
public code sub jlcp_java_closure() {
    return HostObjectProbe::caller();
}

#! Java creates an object of the class given in the Program of the calling code
public object sub jlcp_new_object(string class_name) {
    return QoreJavaApi::newObjectSave(class_name);
}

#! Java code calls into Qore with the class loader of this module's Program
public string sub jlcp_call_qore(string func) {
    return HostObjectProbe::staticCallQore(func);
}

#! returns a new Java array of strings
public object sub jlcp_new_array() {
    return new_array(load_class("java.lang.String"), 2);
}

#! returns a Java byte array and the Program that the frame of a call that this function makes names
public hash<auto> sub jlcp_byte_array_frame(binary b) {
    return {
        "array": JavaArray::get(b),
        "frame": get_thread_call_stack()[0].programid,
    };
}

#! the same as jlcp_byte_array(), through a static method of this module
public object sub jlcp_nested_byte_array(binary b) {
    return Lib::byteArray(b);
}

#! returns the Java closure in an instance field of a Java object
public code sub jlcp_field_closure() {
    LibraryFieldHolder holder();
    return holder.closure;
}

#! returns the Java closure in a static Java field
public code sub jlcp_static_field_closure() {
    return LibraryFieldHolder::staticClosure;
}

#! a Java closure that this module keeps for later calls
our *code jlcp_stored;

#! keeps a Java closure, obtained for the calling code
public nothing sub jlcp_store_closure() {
    jlcp_stored = HostObjectProbe::caller();
}

#! returns the Java closure kept
public *code sub jlcp_stored_closure() {
    return jlcp_stored;
}

#! releases the Java closure kept
public nothing sub jlcp_clear_stored() {
    remove jlcp_stored;
}

#! writes a Java closure that it obtains to an instance field of a Java object, and returns the field's value
public code sub jlcp_field_set_closure() {
    LibraryFieldHolder holder();
    holder.closure = HostObjectProbe::caller();
    return holder.closure;
}

#! sets the static Java field to a new Java closure
public nothing sub jlcp_reset_static_field() {
    LibraryFieldHolder::reset();
}

#! writes a Java closure that it obtains to a static Java field, and returns the field's value
public code sub jlcp_static_field_set_closure() {
    LibraryFieldHolder::staticClosure = HostObjectProbe::caller();
    return LibraryFieldHolder::staticClosure;
}

#! the same calls through the static methods of a class of the library
public class Lib {
    static object defineClass(string name, binary bytecode) {
        return define_class(name, bytecode);
    }

    static object byteArray(binary b) {
        return JavaArray::get(b);
    }

    static code javaClosure() {
        return HostObjectProbe::caller();
    }

    static object newObject(string class_name) {
        return QoreJavaApi::newObjectSave(class_name);
    }
}
}
