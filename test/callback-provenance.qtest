#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires jni
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.Callbacks
%requires QUnit

%exec-class ProvenanceTest

class ProvenanceTest inherits QUnit::Test {
    constructor() : QUnit::Test("JNI callback provenance", "1.0", \ARGV) {
        addTestCase("a returned foreign callback retains its creation policy", \testProvenance());
        set_return_value(main());
    }

    testProvenance() {
        string path = get_script_path();
        code reader = string sub () {
            try { ReadOnlyFile::readTextFile(path); return "allowed"; }
            catch (hash<ExceptionInfo> ex) { return ex.err; }
        };
        Program sandbox(PO_NEW_STYLE);
        sandbox.parse("code sub make(code reader) { return Callbacks::readingClosure(reader); }", "foreign-callback-factory");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        # qore#5741 run-time refusal of uncontrolled APIs: the sandboxed factory calls Java, which its sandbox must
        # allow; the filesystem policy that the callback must retain is unchanged (the call is dynamic because the Qore
        # library may lack the rule)
        if (sm.hasCallableMethod("setUncontrolledApiPolicy")) {
            call_object_method(sm, "setUncontrolledApiPolicy", True);
        }
        sandbox.setSandboxManager(sm);
        code trusted = Callbacks::readingClosure(reader);
        assertEq("allowed", trusted());
        if (sandboxClassesRefused()) {
            # qore#7832: a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem refuses
            # Java code, so the sandboxed factory cannot create the callback whose retained policy this case checks
            assertThrows("INVALID-FUNCTION-ACCESS", "restricts FILESYSTEM.*readingClosure.*qore#7832",
                \sandbox.callFunction(), ("make", reader));
            testSkip("qore#7832: the sandbox that restricts the filesystem refuses Java code, so no restricted "
                "callback can be created");
        }
        code restricted = sandbox.callFunction("make", reader);
        assertEq("FILESYSTEM-ACCESS-DENIED", restricted());
        Queue results();
        ThreadPool pool(1);
        on_exit pool.stopWait();
        pool.submit(sub () { results.push(restricted()); });
        assertEq("FILESYSTEM-ACCESS-DENIED", results.get(10s));
        pool.submit(sub () { results.push(trusted()); });
        assertEq("allowed", results.get(10s), "worker reuse restores the previous context");
    }

    #! Returns True if a sandbox that trusts its code with uncontrolled APIs but restricts the filesystem or the network
    #! refuses Java code (qore#7832)
    private static bool sandboxClassesRefused() {
        return get_module_hash().jni.info.sandbox_uncontrolled_api_classes ?? False;
    }
}
