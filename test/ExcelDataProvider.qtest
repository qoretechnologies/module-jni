    # returns an xlsx with a header row, two data rows separated by an empty row, and two trailing empty rows
    private binary getEmptyRowsData() {
        ExcelWriteDataProvider dp({"headers": ("Sku", "Qty")});
        dp.createRecord({"Sku": "A-1", "Qty": 5});
        dp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        dp.createRecord({"Sku": "B-2", "Qty": 7});
        dp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        dp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        return dp.getData();
    }

    testReadEmptyRows() {
        binary data = getEmptyRowsData();

        # default: reading stops at the first empty row
        ExcelReadDataProvider dp({"data": data, "header_names": True});
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(({"Sku": "A-1", "Qty": 5},), records);

        # ignore_empty: empty rows are skipped, trailing empty rows end the iteration
        dp = new ExcelReadDataProvider({"data": data, "header_names": True, "ignore_empty": True});
        records = map $1, dp.searchRecords();
        assertEq(({"Sku": "A-1", "Qty": 5}, {"Sku": "B-2", "Qty": 7}), records);

        # ignore_empty stays within data_cells (rows 2-3 hold only the first record and the empty row)
        dp = new ExcelReadDataProvider({"data": data, "header_names": True, "ignore_empty": True,
            "data_cells": "a2:b3"});
        records = map $1, dp.searchRecords();
        assertEq(({"Sku": "A-1", "Qty": 5},), records);

        # the option is also applied to worksheet child providers
        dp = new ExcelReadDataProvider({"data": data, "header_names": True, "ignore_empty": True});
        records = map $1, dp.getChildProviderEx("Sheet1").searchRecords();
        assertEq(2, records.size());
        assertEq("B-2", records[1].Sku);
        # Keeping empty records is explicit and bounded, including trailing rows and child providers.
        foreach bool skip in ((False, True)) {
            dp = new ExcelReadDataProvider({"data": data, "header_names": True,
                "ignore_empty": skip, "preserve_empty_rows": True});
            list<hash<auto>> kept = map $1, dp.searchRecords();
            assertEq(5, kept.size());
            assertEq({"Sku": NOTHING, "Qty": NOTHING}, kept[1]);
            assertEq({"Sku": NOTHING, "Qty": NOTHING}, kept[4]);
            assertEq("B-2", kept[2].Sku);
        }
        dp = new ExcelReadDataProvider({"data": data, "header_names": True,
            "preserve_empty_rows": True, "data_cells": "a2:b3"});
        list<hash<auto>> bounded = map $1, dp.getChildProviderEx("Sheet1").searchRecords();
        assertEq(2, bounded.size());
        assertEq({"Sku": NOTHING, "Qty": NOTHING}, bounded[1]);

        ExcelWriteDataProvider empty_writer({"headers": ("Sku", "Qty"), "write_headers": False});
        empty_writer.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        empty_writer.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        dp = new ExcelReadDataProvider({"data": empty_writer.getData(), "headers": ("Sku", "Qty"),
            "preserve_empty_rows": True});
        list<hash<auto>> empty_records = map $1, dp.searchRecords();
        assertEq(({"Sku": NOTHING, "Qty": NOTHING}, {"Sku": NOTHING, "Qty": NOTHING}), empty_records);

        ExcelWriteDataProvider offset_writer({"headers": ("Sku", "Qty"), "header_row": 3});
        offset_writer.createRecord({"Sku": "A-1", "Qty": 5});
        dp = new ExcelReadDataProvider({"data": offset_writer.getData(), "headers": ("Sku", "Qty"),
            "preserve_empty_rows": True, "data_cells": "a1:b3"});
        list<hash<auto>> offset_records = map $1, dp.searchRecords();
        assertEq(3, offset_records.size(), "gaps before the first stored row are preserved");
        assertEq({"Sku": NOTHING, "Qty": NOTHING}, offset_records[0]);
        assertEq({"Sku": "Sku", "Qty": "Qty"}, offset_records[2]);

    }

    testColumnsPastZ() {
        assertEq(0, ExcelReadDataProvider::getColumnIndex("a"));
        assertEq(0, ExcelReadDataProvider::getColumnIndex("-"));
        assertEq(25, ExcelReadDataProvider::getColumnIndex("Z"));
        assertEq(26, ExcelReadDataProvider::getColumnIndex("aa"));
        assertEq(51, ExcelReadDataProvider::getColumnIndex("AZ"));
        assertEq(52, ExcelReadDataProvider::getColumnIndex("bA"));
        assertEq(16383, ExcelReadDataProvider::getColumnIndex("XFD"));

        # "z" < "aa" by column position even though it sorts after it as a string
        hash<CellRangeInfo> r = ExcelReadDataProvider::parseRange("z1:aa10");
        assertEq("z", r.start.column);
        assertEq("aa", r.end.column);
        assertThrows("EXCEL-INVALID-LOCATION", \ExcelReadDataProvider::parseRange(), "aa1:z10");
        # case does not affect ordering
        assertEq("B", ExcelReadDataProvider::parseRange("B1:c2").start.column);
        assertThrows("EXCEL-INVALID-LOCATION", \ExcelReadDataProvider::parseRange(), "c1:B2");

        # header and data start columns are compared by position as well
        hash<auto> opts = {"header_cells": "z1", "data_cells": "aa2"};
        assertEq("aa", ExcelReadDataProvider::processCellOptions(opts).data_cells.start.column);
        opts = {"header_cells": "aa1", "data_cells": "z2"};
        assertThrows("EXCEL-INVALID-LOCATION", \ExcelReadDataProvider::processCellOptions(), opts);

        # read a sheet whose headers and data are in columns Y-AB
        hash<auto> rec = map {sprintf("c%d", $1): $1}, xrange(1, 29);
        ExcelWriteDataProvider wdp({"headers": keys rec});
        wdp.createRecord(rec);
        ExcelReadDataProvider dp({"data": wdp.getData(), "header_cells": "y1:ab1", "data_cells": "y2:ab2"});
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(({"c25": 25, "c26": 26, "c27": 27, "c28": 28},), records);

        # a data range wider than the header range ends at the last header column
        dp = new ExcelReadDataProvider({"data": wdp.getData(), "header_cells": "y1:z1", "data_cells": "y2:ab2"});
        records = map $1, dp.searchRecords();
        assertEq(({"c25": 25, "c26": 26},), records);
    }

    testHeaderOptionConflictAllCtors() {
        hash<auto> opts = {"headers": ("A", "B"), "header_names": True};
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelReadDataProvider dp(test_data_dir + "/simple.xlsx", opts);
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            FileInputStream fis(test_data_dir + "/simple.xlsx");
            ExcelReadDataProvider dp(fis, opts);
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelReadDataProvider dp({"path": test_data_dir + "/simple.xlsx"} + opts);
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelWorksheetReadDataProvider dp({"path": test_data_dir + "/simple.xlsx"} + opts);
        });
    }

    #! A worksheet provider can be searched more than once, whatever its input
    testWorksheetRepeatedSearch() {
        foreach string file in (("multi-sheet.xlsx", "formula-rows.xls")) {
            string path = test_data_dir + "/" + file;
            binary data = ReadOnlyFile::readBinaryFile(path);
            ExcelReadDataProvider parent(path, {"header_names": True});
            string sheet = parent.getChildProviderNames()[0];
            list<hash<auto>> expected = map $1, (new ExcelReadDataProvider(path, {"header_names": True, "worksheet": sheet}))
                .searchRecords();
            assertGt(1, expected.size(), file);
            hash<string, AbstractDataProvider> providers = {
                "child": parent.getChildProvider(sheet),
                "stream": new ExcelWorksheetReadDataProvider(new BinaryInputStream(data), "name", sheet, {"header_names": True}),
                "path": new ExcelWorksheetReadDataProvider(path, "name", sheet, {"header_names": True}),
                "data option": new ExcelWorksheetReadDataProvider({"data": data, "worksheet": sheet, "header_names": True}),
                "stream option": new ExcelWorksheetReadDataProvider({"stream": new BinaryInputStream(data), "worksheet": sheet,
                    "header_names": True}),
                "path option": new ExcelWorksheetReadDataProvider({"path": path, "worksheet": sheet, "header_names": True}),
            };
            foreach hash<auto> i in (providers.pairIterator()) {
                string label = sprintf("%s %s", file, i.key);
                assertEq(expected, (map $1, i.value.searchRecords()), label + ": first search");
                assertEq(expected, (map $1, i.value.searchRecords()), label + ": second search");
                # a search that ends early, and one that ends at its limit
                AbstractDataProviderRecordIterator it = i.value.searchRecords();
                assertTrue(it.next(), label);
                delete it;
                assertEq(expected[0..0], (map $1, i.value.searchRecords(NOTHING, {"limit": 1})), label + ": limit");
                assertEq(expected, (map $1, i.value.searchRecords()), label + ": after searches that ended early");
                assertEq(keys expected[0], keys i.value.getRecordType(), label + ": record type after searches");
            }
        }
        # the worksheet and the options are still checked when the provider is created
        string path = test_data_dir + "/" + "multi-sheet.xlsx";
        ExcelReadDataProvider parent(path, {"header_names": True});
        string sheet = parent.getChildProviderNames()[0];
        string column = (keys parent.getChildProvider(sheet).getRecordType())[0];
        # a provider created from its own input copies it to a temporary file, which is deleted with the provider,
        # and is not left behind when the provider cannot be created
        list<string> temp_files = getTempFiles("qore-excelfile-");
        ExcelWorksheetReadDataProvider dp(new BinaryInputStream(ReadOnlyFile::readBinaryFile(path)), "name", sheet,
            {"header_names": True});
        assertEq(elements temp_files + 1, elements getTempFiles("qore-excelfile-"), "the input is copied");
        assertGt(0, elements (map $1, dp.searchRecords()));
        delete dp;
        assertEq(temp_files, getTempFiles("qore-excelfile-"), "the copy is deleted with the provider");
        assertThrows("JNI-ERROR", sub () {
            ExcelWorksheetReadDataProvider wdp(path, "name", "no-such-sheet", {"header_names": True});
        });
        assertEq(temp_files, getTempFiles("qore-excelfile-"), "a provider that cannot be created leaves no file");
        assertThrows("EXCEL-FORMULA-FIELD-ERROR", column, sub () {
            ExcelWorksheetReadDataProvider fdp(path, "name", sheet, {"header_names": True, "formula_field": column});
        });
    }

