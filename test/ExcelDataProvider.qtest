    testActionRegistration() {
        # Verify that actions are properly registered with correct properties
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("Excel");
        assertTrue(exists actions, "should have actions registered for Excel app");
        assertTrue(actions.size() >= 4, "should have at least 4 actions (read, read-data, write, write-data)");

        # Create a lookup hash for easier testing
        hash<string, hash<DataProviderActionInfo>> action_map;
        foreach hash<DataProviderActionInfo> action in (actions) {
            action_map{action.action} = action;
        }

        # Verify read action
        assertTrue(action_map.hasKey("read"), "should have 'read' action");
        assertEq("Read Excel Spreadsheet File", action_map."read".display_name);
        assertTrue(action_map."read".options.hasKey("path"), "read action should have 'path' option");
        assertTrue(action_map."read".options.hasKey("header_names"), "read action should have 'header_names' option");

        # Verify read-data action
        assertTrue(action_map.hasKey("read-data"), "should have 'read-data' action");
        assertEq("Read Excel Spreadsheet Inline Data", action_map."read-data".display_name);
        assertTrue(action_map."read-data".options.hasKey("data"), "read-data action should have 'data' option");

        # Verify write action
        assertTrue(action_map.hasKey("write"), "should have 'write' action");
        assertEq("Write Excel Spreadsheet File", action_map."write".display_name);
        assertTrue(action_map."write".options.hasKey("path"), "write action should have 'path' option");
        assertTrue(action_map."write".options.hasKey("format"), "write action should have 'format' option");
        assertTrue(action_map."write".options.hasKey("headers"), "write action should have 'headers' option");

        # Verify write-data action
        assertTrue(action_map.hasKey("write-data"), "should have 'write-data' action");
        assertEq("Create Excel Spreadsheet Data", action_map."write-data".display_name);
        assertFalse(action_map."write-data".options.hasKey("path"), "write-data action should NOT have 'path' option");
        assertTrue(action_map."write-data".options.hasKey("format"), "write-data action should have 'format' option");
        assertTrue(action_map."write-data".options.hasKey("headers"), "write-data action should have 'headers' option");

        # Verify format option has allowed_values
        hash<auto> format_opt = action_map."write".options."format";
        assertTrue(exists format_opt.allowed_values, "format option should have allowed_values");
        assertEq(2, format_opt.allowed_values.size(), "format should have 2 allowed values");
    }

    testRoundtrip() {
        string output_path = test_data_dir + "/roundtrip-test.xlsx";
        on_exit unlink(output_path);

        # Write complex data
        ExcelWriteDataProvider wdp(output_path, {
            "headers": ("Name", "Amount", "Date", "Active"),
        });

        date d = 2025-06-15T10:30:00Z;

        wdp.createRecord({"Name": "Item1", "Amount": 99.99, "Date": d, "Active": True});
        wdp.createRecord({"Name": "Item2", "Amount": 50.00, "Date": d, "Active": False});
        wdp.createRecord({"Name": "Item3", "Amount": 0.01, "Date": d, "Active": True});

        wdp.commit();

        # Read back all data
        ExcelReadDataProvider rdp(output_path, {
            "header_names": True,
        });

        list<hash<auto>> records = map $1, rdp.searchRecords();

        assertEq(3, records.size());
        assertEq("Item1", records[0].Name);
        assertEq(99.99, records[0].Amount);
        assertTrue(records[0].Active);
        assertEq("Item2", records[1].Name);
        assertFalse(records[1].Active);
        assertEq("Item3", records[2].Name);
        assertEq(0.01, records[2].Amount);
    }

    testReadFromFirstRow() {
        # with no header options at all, data starts on row 1 and keys are cell references
        ExcelReadDataProvider dp(test_data_dir + "/no-headers.xlsx");
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(2, records.size());
        assertEq({"A1": "value1", "B1": 100.0, "C1": True}, records[0]);
        assertEq({"A2": "value2", "B2": 200.0, "C2": False}, records[1]);

        # explicit headers without data_cells also start on row 1
        dp = new ExcelReadDataProvider(test_data_dir + "/no-headers.xlsx", {
            "headers": ("Col1", "Col2", "Col3"),
        });
        records = map $1, dp.searchRecords();
        assertEq(2, records.size());
        assertEq({"Col1": "value1", "Col2": 100.0, "Col3": True}, records[0]);
        assertEq({"Col1": "value2", "Col2": 200.0, "Col3": False}, records[1]);
    }

    # returns an xlsx with a header row, two data rows separated by an empty row, and two trailing empty rows
    private binary getEmptyRowsData() {
        ExcelWriteDataProvider dp({"headers": ("Sku", "Qty")});
        dp.createRecord({"Sku": "A-1", "Qty": 5});
        dp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        dp.createRecord({"Sku": "B-2", "Qty": 7});
        dp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        dp.createRecord({"Sku": NOTHING, "Qty": NOTHING});
        return dp.getData();
    }

    testReadEmptyRows() {
        binary data = getEmptyRowsData();

        # default: reading stops at the first empty row
        ExcelReadDataProvider dp({"data": data, "header_names": True});
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(({"Sku": "A-1", "Qty": 5.0},), records);

        # ignore_empty: empty rows are skipped, trailing empty rows end the iteration
        dp = new ExcelReadDataProvider({"data": data, "header_names": True, "ignore_empty": True});
        records = map $1, dp.searchRecords();
        assertEq(({"Sku": "A-1", "Qty": 5.0}, {"Sku": "B-2", "Qty": 7.0}), records);

        # ignore_empty stays within data_cells (rows 2-3 hold only the first record and the empty row)
        dp = new ExcelReadDataProvider({"data": data, "header_names": True, "ignore_empty": True,
            "data_cells": "a2:b3"});
        records = map $1, dp.searchRecords();
        assertEq(({"Sku": "A-1", "Qty": 5.0},), records);

        # the option is also applied to worksheet child providers
        dp = new ExcelReadDataProvider({"data": data, "header_names": True, "ignore_empty": True});
        records = map $1, dp.getChildProviderEx("Sheet1").searchRecords();
        assertEq(2, records.size());
        assertEq("B-2", records[1].Sku);
    }

    testColumnsPastZ() {
        assertEq(0, ExcelReadDataProvider::getColumnIndex("a"));
        assertEq(0, ExcelReadDataProvider::getColumnIndex("-"));
        assertEq(25, ExcelReadDataProvider::getColumnIndex("Z"));
        assertEq(26, ExcelReadDataProvider::getColumnIndex("aa"));
        assertEq(51, ExcelReadDataProvider::getColumnIndex("AZ"));
        assertEq(52, ExcelReadDataProvider::getColumnIndex("bA"));
        assertEq(16383, ExcelReadDataProvider::getColumnIndex("XFD"));

        # "z" < "aa" by column position even though it sorts after it as a string
        hash<CellRangeInfo> r = ExcelReadDataProvider::parseRange("z1:aa10");
        assertEq("z", r.start.column);
        assertEq("aa", r.end.column);
        assertThrows("EXCEL-INVALID-LOCATION", \ExcelReadDataProvider::parseRange(), "aa1:z10");
        # case does not affect ordering
        assertEq("B", ExcelReadDataProvider::parseRange("B1:c2").start.column);
        assertThrows("EXCEL-INVALID-LOCATION", \ExcelReadDataProvider::parseRange(), "c1:B2");

        # header and data start columns are compared by position as well
        hash<auto> opts = {"header_cells": "z1", "data_cells": "aa2"};
        assertEq("aa", ExcelReadDataProvider::processCellOptions(opts).data_cells.start.column);
        opts = {"header_cells": "aa1", "data_cells": "z2"};
        assertThrows("EXCEL-INVALID-LOCATION", \ExcelReadDataProvider::processCellOptions(), opts);

        # read a sheet whose headers and data are in columns Y-AB
        hash<auto> rec = map {sprintf("c%d", $1): $1}, xrange(1, 29);
        ExcelWriteDataProvider wdp({"headers": keys rec});
        wdp.createRecord(rec);
        ExcelReadDataProvider dp({"data": wdp.getData(), "header_cells": "y1:ab1", "data_cells": "y2:ab2"});
        list<hash<auto>> records = map $1, dp.searchRecords();
        assertEq(({"c25": 25.0, "c26": 26.0, "c27": 27.0, "c28": 28.0},), records);

        # a data range wider than the header range ends at the last header column
        dp = new ExcelReadDataProvider({"data": wdp.getData(), "header_cells": "y1:z1", "data_cells": "y2:ab2"});
        records = map $1, dp.searchRecords();
        assertEq(({"c25": 25.0, "c26": 26.0},), records);
    }

    testHeaderOptionConflictAllCtors() {
        hash<auto> opts = {"headers": ("A", "B"), "header_names": True};
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelReadDataProvider dp(test_data_dir + "/simple.xlsx", opts);
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            FileInputStream fis(test_data_dir + "/simple.xlsx");
            ExcelReadDataProvider dp(fis, opts);
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelReadDataProvider dp({"path": test_data_dir + "/simple.xlsx"} + opts);
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelWorksheetReadDataProvider dp({"path": test_data_dir + "/simple.xlsx"} + opts);
        });
    }

    testWorksheetOptionsCtor() {
        binary data = ReadOnlyFile::readBinaryFile(test_data_dir + "/multi-sheet.xlsx");
        string sheet = (new ExcelReadDataProvider({"data": data})).getChildProviderNames()[1];

        # inline data
        ExcelWorksheetReadDataProvider dp({"data": data, "worksheet": sheet, "header_names": True});
        list<hash<auto>> from_data = map $1, dp.searchRecords();
        assertTrue(from_data.size() > 0);

        # path, resolved as a file location
        dp = new ExcelWorksheetReadDataProvider({"path": "file://" + test_data_dir + "/multi-sheet.xlsx",
            "worksheet": sheet, "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # stream
        dp = new ExcelWorksheetReadDataProvider({"stream": new BinaryInputStream(data), "worksheet": sheet,
            "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # path constructor, resolved as a file location (plain path and file:// URL)
        dp = new ExcelWorksheetReadDataProvider(test_data_dir + "/multi-sheet.xlsx", "name", sheet, {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());
        dp = new ExcelWorksheetReadDataProvider("file://" + test_data_dir + "/multi-sheet.xlsx", "name", sheet,
            {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # only one input source is allowed
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelWorksheetReadDataProvider wdp({"data": data, "path": test_data_dir + "/multi-sheet.xlsx"});
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelWorksheetReadDataProvider wdp({"data": data, "stream": new BinaryInputStream(data)});
        });
    }

    testWriteStreamingNoHeaders() {
        # more rows than the 100-row SXSSF window, so rows are flushed while writing; dates are written and read
        # in the local time zone
        ExcelWriteDataProvider dp({"streaming": True});
        date d = 2026-03-04T05:06:07;
        for (int n = 1; n <= 250; ++n) {
            dp.createRecord({"Id": n, "Name": sprintf("row-%d", n), "Shipped": d});
        }
        assertEq(250, dp.getCreatedCount());

        ExcelReadDataProvider rdp({"data": dp.getData(), "header_names": True});
        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(250, records.size());
        assertEq(("Id", "Name", "Shipped"), keys records[0]);
        assertEq({"Id": 1.0, "Name": "row-1", "Shipped": d}, records[0]);
        assertEq({"Id": 250.0, "Name": "row-250", "Shipped": d}, records[249]);
    }

    testWriteHeadersFromFirstRecord() {
        # the first record defines the columns; later records are written by those columns
        ExcelWriteDataProvider dp();
        date d = 2026-01-02T00:00:00;
        dp.createRecord({"B": 1, "A": d});
        dp.createRecord({"A": d + 1D, "C": "ignored", "B": 2});
        dp.createRecord({"B": 3});

        ExcelReadDataProvider rdp({"data": dp.getData(), "header_names": True});
        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq((
            {"B": 1.0, "A": d},
            {"B": 2.0, "A": d + 1D},
            {"B": 3.0, "A": NOTHING},
        ), records);
    }

    # runs the action the way an action runner does: the provider is built from the action's class and constructor
    # options, the records are created, and finishCreate() completes the action and returns the generated data
    testWriteDataAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("Excel", "write-data");
        assertEq(DPAD_CREATE_OUTPUT, action.output_data_type);
        assertFalse(exists action.options.stream);
        AbstractDataProvider prov = Class::forName(action.cls).newObject({"headers": ("Sku", "Qty")});
        prov.createRecordsBulkWithOptions({"recs": {"Sku": ("A-1", "B-2"), "Qty": (5, 7)}});
        hash<auto> output = prov.finishCreate();
        assertEq(output, action.output_type.acceptsValue(output));
        assertEq(2, output.record_count);
        assertEq(Type::Binary, output.data.type());
        assertEq("PK", output.data.substr(0, 2).toString());
        ExcelReadDataProvider rdp({"data": output.data, "header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5.0}, {"Sku": "B-2", "Qty": 7.0}), (map $1, rdp.searchRecords()));
    }

    testProfileGrid() {
        foreach string ext in (("xlsx", "xls")) {
            hash<TabularWorkbookGrid> grid = ExcelProfileDataProvider::readWorkbookGrid(
                ReadOnlyFile::readBinaryFile(test_data_dir + "/profile." + ext), 1000);
            assertEq(ext, grid.format);
            assertEq(("Confirmations", "Lookup"), (map $1.name, grid.sheets));
            hash<TabularSheetGrid> sheet = grid.sheets[0];
            assertFalse(sheet.hidden);
            assertTrue(grid.sheets[1].hidden, ext + ": the lookup sheet is hidden");
            assertEq(6, sheet.rows.size(), ext + ": every row up to the last is read");
            assertEq((), sheet.rows[1], ext + ": an empty row is an empty list");
            assertEq(("PO-1001", "000123", 5.0, "10.10.2026"), sheet.rows[3]);
            assertEq((<TabularCellRange>{"first_row": 0, "last_row": 0, "first_col": 0, "last_col": 3},),
                sheet.merged);
            assertEq({"C6": "SUM(C4:C5)"}, sheet.formulas);
            assertEq(12.0, sheet.rows[5][2], ext + ": a formula cell holds its cached value");
            assertEq({"Rates": "Lookup!$A$1:$B$2"}, grid.named_ranges);
            assertNothing(sheet.row_count);

            # a row limit reports the row count
            grid = ExcelProfileDataProvider::readWorkbookGrid(
                ReadOnlyFile::readBinaryFile(test_data_dir + "/profile." + ext), 2);
            assertEq(2, grid.sheets[0].rows.size());
            assertEq(6, grid.sheets[0].row_count);
        }
        assertThrows("JNI-ERROR", \ExcelProfileDataProvider::readWorkbookGrid(), (binary("not a workbook"), 10));
    }

    testProfileAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("Excel", "profile");
        assertEq(DPAT_API, action.action_code);
        assertEq("TabularWorkbookProfile", action.output_type.getName());
        assertTrue(action.options.path.preselected);

        hash<auto> opts = {"path": test_data_dir + "/profile.xlsx"};
        AbstractDataProvider prov = DataProviderActionCatalog::getDataProviderForAction(action, \opts);
        hash<auto> profile = prov.doRequest(opts);
        assertEq(profile, action.output_type.acceptsValue(profile));
        assertEq("xlsx", profile.format);
        hash<auto> sheet = profile.sheets[0];
        assertEq(3, sheet.header_row);
        assertEq((1,), sheet.title_rows);
        assertEq((6,), sheet.totals_rows);
        assertEq(("PO", "SKU", "Qty", "Ship date"), (map $1.header, sheet.columns));
        assertEq(("string", "string", "int", "date"), (map $1.type, sheet.columns));
        assertTrue(sheet.columns[1].leading_zeros);
        assertEq("DD.MM.YYYY", sheet.columns[3].date_format);
        assertEq(("SUM",), (select sheet.findings, $1.code == "formulas")[0].detail);
        assertTrue(profile.sheets[1].hidden);
        assertEq("hidden_sheet", profile.sheets[1].findings[0].code);
        assertEq({"Rates": "Lookup!$A$1:$B$2"}, profile.named_ranges);
        assertEq(("XX-9999", "999999", "9", "99.99.9999"), sheet.samples[0], "samples are redacted by default");

        # inline data and options
        profile = prov.doRequest({"data": ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.xls"),
            "redact": False, "sample_rows": 1});
        assertEq("xls", profile.format);
        assertEq((("PO-1001", "000123", 5.0, "10.10.2026"),), profile.sheets[0].samples);

        assertThrows("TABULAR-PROFILE-ERROR", "exactly one", \prov.doRequest(), {});
    }

    testWriterRecordType() {
        # the headers option defines the columns
        ExcelWriteDataProvider dp({"headers": ("Sku", "Qty")});
        assertEq(("Sku", "Qty"), keys dp.getRecordType());
        assertEq(("Sku", "Qty"), keys dp.getCreateRecordTypeWithOptions());
        # without headers, the first record's keys define the columns: an open record type
        dp = new ExcelWriteDataProvider();
        assertNothing(dp.getRecordType());
        assertEq({}, dp.getOrNothingRecordTypeWithOptions());
    }

    #! The record type, the records, the worksheet names, and worksheet providers can be acquired in any order
    /** Qorus reads the provider info (and with it the worksheet names) after the record type when it executes an
        action; the worksheet names were then read from the input stream already consumed by the record type
    */
    testWorkbookReuse() {
        string path = test_data_dir + "/multi-sheet.xlsx";
        binary data = ReadOnlyFile::readBinaryFile(path);
        hash<auto> opts = {"worksheet": "Users", "header_names": True};
        hash<string, code> sources = {
            "data": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(opts + {"data": data});
            },
            "stream": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(opts + {"stream": new BinaryInputStream(data)});
            },
            "path": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(opts + {"path": path});
            },
            "stream constructor": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(new BinaryInputStream(data), opts);
            },
            "path constructor": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(path, opts);
            },
        };
        list<string> sheets = ("Users", "Products", "Orders");
        foreach hash<auto> i in (sources.pairIterator()) {
            # the record type, then the provider info, as Qorus acquires them when executing an action
            ExcelReadDataProvider dp = i.value();
            assertEq(("ID", "Username"), keys dp.getRecordType(), i.key);
            assertEq(sheets, dp.getInfo().children, i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);
            assertEq(sheets, dp.getChildProviderNames(), i.key);
            assertEq(("Widget",), (map $1.Product, dp.getChildProvider("Products").searchRecords()), i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);

            # a worksheet provider first, then the parent's own worksheet
            dp = i.value();
            assertEq((1001,), (map $1.OrderID.toInt(), dp.getChildProvider("Orders").searchRecords()), i.key);
            assertEq(sheets, dp.getChildProviderNames(), i.key);
            assertEq(("ID", "Username"), keys dp.getRecordType(), i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);
        }

        # a provider without input has no worksheets, record fields, or records
        ExcelReadDataProvider empty();
        assertEq(NOTHING, empty.getChildProviderNames());
        assertEq({}, empty.getRecordType());
    }

    testStreamedCellEncodings() {
        string path = test_data_dir + "/streaming-features.xlsx";
        ExcelTestHelper::createStreamingFeaturesExcel(path);

        ExcelReadDataProvider dp(path, {"header_names": True, "timezone": "UTC", "ignore_empty": True});
        assertEq(("Main", "Chart", "Sparse"), dp.getChildProviderNames());
        assertEq(("Name", "Val", "When", "Inline"), keys dp.getRecordType());
        list<hash<auto>> expected = (
            # a rich shared string without its phonetic run, a date from the column's style, and inline rich text
            {"Name": "rich", "Val": 42.5, "When": 2023-03-15T06:00:00Z, "Inline": "a b"},
            # escaped characters; the cell's own number style overrides the column's date style
            {"Name": "escA", "Val": 7.0, "When": 1.0, "Inline": "B"},
            # a boolean cell is true only for "1"; an error cell has no value
            {"Name": True, "Val": False, "When": 2023-03-16T00:00:00Z, "Inline": NOTHING},
            # formula cells give their cached results
            {"Name": 2.0, "Val": "xyC", "When": True, "Inline": NOTHING},
            # a cell of an array formula without a cached value is 0; an invalid shared string index is empty
            {"Name": 1.0, "Val": 0.0, "When": 2023-03-15T12:00:00Z, "Inline": ""},
        );
        assertEq(expected, (map $1, dp.searchRecords()));
        # each iteration reads the worksheet from its first data row
        assertEq(expected, (map $1, dp.searchRecords()));

        # without ignore_empty, reading stops at the missing row 4
        dp = new ExcelReadDataProvider(path, {"header_names": True, "timezone": "UTC"});
        assertEq(expected[0..1], (map $1, dp.searchRecords()));

        # a chart sheet has no cells
        dp = new ExcelReadDataProvider(path, {"worksheet": "Chart", "ignore_empty": True});
        assertEq(0, elements (map $1, dp.searchRecords()));

        # rows and cells without references follow the previous ones
        dp = new ExcelReadDataProvider(path, {"worksheet": "Sparse", "ignore_empty": True});
        assertEq(({"A1": 1.0, "B1": 2.0}, {"A20": "far"}, {"A21": 5.0}), (map $1, dp.searchRecords()));
    }

    testLargeWorkbook() {
        # a worksheet with 200000 rows is read with a JVM heap far smaller than the workbook loaded in memory
        # needs (about 1 GB); a child process has its own JVM with a 64 MB heap
        foreach bool shared_strings in ((True, False)) {
            string path = sprintf("%s/large-%s.xlsx", test_data_dir, shared_strings ? "shared" : "inline");
            on_exit unlink(path);
            ExcelTestHelper::createLargeExcel(path, LargeRows, shared_strings);

            string src = sprintf("%%modern
%%prepend-module-path \"%s/../qlib\"
%%requires DataProvider
%%requires json
%%requires ExcelDataProvider

ExcelReadDataProvider dp({\"path\": ARGV[0], \"header_names\": True, \"timezone\": \"UTC\"});
AbstractDataProviderRecordIterator i = dp.searchRecords();
int count = 0;
int mismatches = 0;
*hash<auto> last;
while (i.next()) {
    hash<auto> r = i.getValue();
    ++count;
    if (keys r != (\"Id\", \"Name\", \"Amount\", \"When\", \"Flag\") || r.Id != count.toFloat()
        || r.Name != (\"name-\" + count) || r.Amount != (count / 4.0)
        || r.When != (2025-01-01T00:00:00Z + seconds(count)) || r.Flag != (count %% 2 == 0)) {
        ++mismatches;
    }
    last = r;
}
printf(\"RESULT:%%s\\n\", make_json({\"count\": count, \"mismatches\": mismatches, \"last\": last}));
", get_script_dir() == "." ? getcwd() : get_script_dir());
            hash<auto> result = runChild(src, path);
            string label = shared_strings ? "shared strings" : "inline strings";
            assertEq(LargeRows, result.count, label);
            assertEq(0, result.mismatches, label);
            assertEq("name-" + LargeRows, result.last.Name, label);
            assertEq(LargeRows / 4.0, result.last.Amount.toFloat(), label);
        }
    }

    testEarlyClose() {
        string path = test_data_dir + "/early-close.xlsx";
        on_exit unlink(path);
        ExcelTestHelper::createLargeExcel(path, 20000, True);
        binary data = ReadOnlyFile::readBinaryFile(path);

        # a complete iteration first, so that later file counts do not include the JVM's class files
        {
            ExcelIterator it(new BinaryInputStream(data), "");
            it.setHeaderCells("-", 1, "-", 1);
            int count = 0;
            while (it.next()) {
                ++count;
            }
            assertEq(20000, count);
            it.close();
        }
        list<string> temp_files = getTempFiles("qore-xlsx-");
        int open_files = countOpenFiles();

        ExcelIterator it(new BinaryInputStream(data), "");
        it.setHeaderCells("-", 1, "-", 1);
        for (int i = 1; i <= 10; ++i) {
            assertTrue(it.next());
            assertEq(i.toFloat(), it.getValue().Id);
        }
        # the workbook is open while the iteration is in progress; its temporary copy is already deleted
        assertGt(open_files, countOpenFiles());
        assertEq(temp_files, getTempFiles("qore-xlsx-"));

        # closing the iterator in the middle of the worksheet releases the workbook
        it.close();
        assertEq(open_files, countOpenFiles());
        assertEq(temp_files, getTempFiles("qore-xlsx-"));
        assertThrows("JNI-ERROR", "the Excel iterator is closed", \it.next());
    }

    testOpenDataRange() {
        # without an end column and without headers, each row is read to its last cell with a value; reading such a
        # range never ended before
        ExcelReadDataProvider dp(test_data_dir + "/simple.xlsx", {"data_cells": "b2"});
        assertEq((
            {"A2": 30.0, "B2": "New York"},
            {"A3": 25.0, "B3": "Los Angeles"},
            {"A4": 35.0, "B4": "Chicago"},
        ), (map $1, dp.searchRecords()));

        # rows end at different columns; a row without a value from the start column is empty
        string path = test_data_dir + "/streaming-features.xlsx";
        ExcelTestHelper::createStreamingFeaturesExcel(path);
        dp = new ExcelReadDataProvider(path, {"worksheet": "Sparse", "data_cells": "b1", "ignore_empty": True});
        assertEq(({"A1": 2.0}, {"A2": NOTHING, "B2": 3.0, "C2": 4.0}), (map $1, dp.searchRecords()));
        # without ignore_empty, reading stops at the first row without a value
        dp = new ExcelReadDataProvider(path, {"worksheet": "Sparse", "data_cells": "c1"});
        assertEq(0, elements (map $1, dp.searchRecords()));

        # an .xls workbook
        string xls = test_data_dir + "/open-range.xls";
        on_exit unlink(xls);
        ExcelWriteDataProvider w(xls, {"format": "xls"});
        w.createRecord({"Sku": "A-1", "Qty": 5, "Note": "x"});
        w.createRecord({"Sku": "B-2", "Qty": 7, "Note": NOTHING});
        w.commit();
        dp = new ExcelReadDataProvider(xls, {"data_cells": "b2"});
        assertEq(({"A2": 5.0, "B2": "x"}, {"A3": 7.0}), (map $1, dp.searchRecords()));
    }

    #! Runs a Qore program in a child process with a small JVM heap; returns the result it prints
    private hash<auto> runChild(string src, string arg) {
        TmpFile tmp(NOTHING, ".qr");
        tmp.file.write(src);
        tmp.file.close();
        string cmd = sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "QORE_JNI_MAX_HEAP_SIZE=%s %s --enable-debug %s %s 2>&1; echo CHILD_EXIT=$?", ChildHeap,
            shellQuote(qoreBin()), shellQuote(tmp.path), shellQuote(arg));
        string output = trim(backquote(cmd));
        *string result = (output =~ x/^RESULT:(.*)$/m)[0];
        if (!result) {
            fail(sprintf("child process did not complete: %s", output));
        }
        assertRegex("CHILD_EXIT=0$", output);
        return parse_json(result);
    }

    #! Returns the number of open files of this process
    private static int countOpenFiles() {
        Dir dir();
        if (!dir.chdir("/dev/fd")) {
            throw "TEST-ERROR", "/dev/fd is not available";
        }
        return dir.list().size();
    }

    #! Returns the files with the given prefix in the JVM's temporary directory
    private static list<string> getTempFiles(string prefix) {
        Dir dir();
        dir.chdir(System::getProperty("java.io.tmpdir"));
        return sort(dir.list("^" + prefix) ?? ());
    }

    private string qoreBin() {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? ENV.QORE_EXECUTABLE ?? QORE_ARGV[0] ?? ARGV[0];
        assertTrue(exists qore_bin, "no qore binary path available");
        return qore_bin;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
