    testWorksheetOptionsCtor() {
        binary data = ReadOnlyFile::readBinaryFile(test_data_dir + "/multi-sheet.xlsx");
        string sheet = (new ExcelReadDataProvider({"data": data})).getChildProviderNames()[1];

        # inline data
        ExcelWorksheetReadDataProvider dp({"data": data, "worksheet": sheet, "header_names": True});
        list<hash<auto>> from_data = map $1, dp.searchRecords();
        assertTrue(from_data.size() > 0);

        # path, resolved as a file location
        dp = new ExcelWorksheetReadDataProvider({"path": "file://" + test_data_dir + "/multi-sheet.xlsx",
            "worksheet": sheet, "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # stream
        dp = new ExcelWorksheetReadDataProvider({"stream": new BinaryInputStream(data), "worksheet": sheet,
            "header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # path constructor, resolved as a file location (plain path and file:// URL)
        dp = new ExcelWorksheetReadDataProvider(test_data_dir + "/multi-sheet.xlsx", "name", sheet, {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());
        dp = new ExcelWorksheetReadDataProvider("file://" + test_data_dir + "/multi-sheet.xlsx", "name", sheet,
            {"header_names": True});
        assertEq(from_data, map $1, dp.searchRecords());

        # only one input source is allowed
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelWorksheetReadDataProvider wdp({"data": data, "path": test_data_dir + "/multi-sheet.xlsx"});
        });
        assertThrows("EXCEL-READ-OPTION-ERROR", sub () {
            ExcelWorksheetReadDataProvider wdp({"data": data, "stream": new BinaryInputStream(data)});
        });
    }

    testWriteStreamingNoHeaders() {
        # more rows than the 100-row SXSSF window, so rows are flushed while writing; dates are written and read
        # in the local time zone
        ExcelWriteDataProvider dp({"streaming": True});
        date d = 2026-03-04T05:06:07;
        for (int n = 1; n <= 250; ++n) {
            dp.createRecord({"Id": n, "Name": sprintf("row-%d", n), "Shipped": d});
        }
        assertEq(250, dp.getCreatedCount());

        ExcelReadDataProvider rdp({"data": dp.getData(), "header_names": True});
        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq(250, records.size());
        assertEq(("Id", "Name", "Shipped"), keys records[0]);
        assertEq({"Id": 1, "Name": "row-1", "Shipped": d}, records[0]);
        assertEq({"Id": 250, "Name": "row-250", "Shipped": d}, records[249]);
    }

    testWriteHeadersFromFirstRecord() {
        # the first record defines the columns; later records are written by those columns
        ExcelWriteDataProvider dp();
        date d = 2026-01-02T00:00:00;
        dp.createRecord({"B": 1, "A": d});
        dp.createRecord({"A": d + 1D, "C": "ignored", "B": 2});
        dp.createRecord({"B": 3});

        ExcelReadDataProvider rdp({"data": dp.getData(), "header_names": True});
        list<hash<auto>> records = map $1, rdp.searchRecords();
        assertEq((
            {"B": 1, "A": d},
            {"B": 2, "A": d + 1D},
            {"B": 3, "A": NOTHING},
        ), records);
    }

    # runs the action the way an action runner does: the provider is built from the action's class and constructor
    # options, the records are created, and finishCreate() completes the action and returns the generated data
    testWriteDataAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("Excel", "write-data");
        assertEq(DPAD_CREATE_OUTPUT, action.output_data_type);
        assertFalse(exists action.options.stream);
        AbstractDataProvider prov = Class::forName(action.cls).newObject({"headers": ("Sku", "Qty")});
        prov.createRecordsBulkWithOptions({"recs": {"Sku": ("A-1", "B-2"), "Qty": (5, 7)}});
        hash<auto> output = prov.finishCreate();
        assertEq(output, action.output_type.acceptsValue(output));
        assertEq(2, output.record_count);
        assertEq(Type::Binary, output.data.type());
        assertEq("PK", output.data.substr(0, 2).toString());
        ExcelReadDataProvider rdp({"data": output.data, "header_names": True});
        assertEq(({"Sku": "A-1", "Qty": 5}, {"Sku": "B-2", "Qty": 7}), (map $1, rdp.searchRecords()));
    }

    testProfileGrid() {
        foreach string ext in (("xlsx", "xls")) {
            hash<TabularWorkbookGrid> grid = ExcelProfileDataProvider::readWorkbookGrid(
                ReadOnlyFile::readBinaryFile(test_data_dir + "/profile." + ext), 1000);
            assertEq(ext, grid.format);
            assertEq(("Confirmations", "Lookup"), (map $1.name, grid.sheets));
            hash<TabularSheetGrid> sheet = grid.sheets[0];
            assertFalse(sheet.hidden);
            assertTrue(grid.sheets[1].hidden, ext + ": the lookup sheet is hidden");
            assertEq(6, sheet.rows.size(), ext + ": every row up to the last is read");
            assertEq((), sheet.rows[1], ext + ": an empty row is an empty list");
            assertEq(("PO-1001", "000123", 5.0, "10.10.2026"), sheet.rows[3]);
            assertEq((<TabularCellRange>{"first_row": 0, "last_row": 0, "first_col": 0, "last_col": 3},),
                sheet.merged);
            assertEq({"C6": "SUM(C4:C5)"}, sheet.formulas);
            assertEq(12.0, sheet.rows[5][2], ext + ": a formula cell holds its cached value");
            assertEq({"Rates": "Lookup!$A$1:$B$2"}, grid.named_ranges);
            assertNothing(sheet.row_count);

            # a row limit reports the row count
            grid = ExcelProfileDataProvider::readWorkbookGrid(
                ReadOnlyFile::readBinaryFile(test_data_dir + "/profile." + ext), 2);
            assertEq(2, grid.sheets[0].rows.size());
            assertEq(6, grid.sheets[0].row_count);
        }
        assertThrows("JNI-ERROR", \ExcelProfileDataProvider::readWorkbookGrid(), (binary("not a workbook"), 10));
    }

    #! The grid of an .xlsx workbook read as it is streamed is the grid that POI's usermodel gives, with every row
    #! limit; an .xls workbook is read into memory
    testProfileGridStreamed() {
        list<string> files = sort(glob(test_data_dir + "/*.xls*"));
        assertGt(10, files.size());
        foreach string path in (files) {
            foreach int max_rows in ((1, 2, 3, 5, 10000)) {
                assertEq(ExcelTestHelper::readGridInMemory(path, max_rows),
                    ExcelGridReader::readGrid(new FileInputStream(path), max_rows),
                    sprintf("%s max_rows %d", basename(path), max_rows));
            }
        }
    }

    #! A worksheet with 200000 rows is profiled with a JVM heap far smaller than the workbook loaded in memory
    #! needs; a child process has its own JVM with a 64 MB heap
    testProfileLargeWorkbook() {
        string path = test_data_dir + "/large-profile.xlsx";
        on_exit unlink(path);
        ExcelTestHelper::createLargeExcel(path, LargeRows, True);

        string src = sprintf("%%modern
%%prepend-module-path \"%s/../qlib\"
%%requires DataProvider
%%requires json
%%requires ExcelDataProvider

ExcelProfileDataProvider prov();
hash<auto> profile = prov.doRequest({\"path\": ARGV[0], \"max_rows\": 1000});
hash<auto> sheet = profile.sheets[0];
printf(\"RESULT:%%s\\n\", make_json({\"format\": profile.format, \"row_count\": sheet.row_count,
    \"header_row\": sheet.header_row, \"columns\": (map $1.header, sheet.columns)}));
", get_script_dir() == "." ? getcwd() : get_script_dir());
        hash<auto> result = runChild(src, path);
        assertEq("xlsx", result.format);
        # the header row and the data rows
        assertEq(LargeRows + 1, result.row_count);
        assertEq(1, result.header_row);
        assertEq(("Id", "Name", "Amount", "When", "Flag"), result.columns);
    }

    testProfileAction() {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("Excel", "profile");
        assertEq(DPAT_API, action.action_code);
        assertEq("TabularWorkbookProfile", action.output_type.getName());
        assertTrue(action.options.path.preselected);

        hash<auto> opts = {"path": test_data_dir + "/profile.xlsx"};
        AbstractDataProvider prov = DataProviderActionCatalog::getDataProviderForAction(action, \opts);
        hash<auto> profile = prov.doRequest(opts);
        assertEq(profile, action.output_type.acceptsValue(profile));
        assertEq("xlsx", profile.format);
        hash<auto> sheet = profile.sheets[0];
        assertEq(3, sheet.header_row);
        assertEq((1,), sheet.title_rows);
        assertEq((6,), sheet.totals_rows);
        assertEq(("PO", "SKU", "Qty", "Ship date"), (map $1.header, sheet.columns));
        assertEq(("string", "string", "int", "date"), (map $1.type, sheet.columns));
        assertTrue(sheet.columns[1].leading_zeros);
        assertEq("DD.MM.YYYY", sheet.columns[3].date_format);
        assertEq(("SUM",), (select sheet.findings, $1.code == "formulas")[0].detail);
        assertTrue(profile.sheets[1].hidden);
        assertEq("hidden_sheet", profile.sheets[1].findings[0].code);
        assertEq({"Rates": "Lookup!$A$1:$B$2"}, profile.named_ranges);
        assertEq(("XX-9999", "999999", "9", "99.99.9999"), sheet.samples[0], "samples are redacted by default");

        # inline data and options
        profile = prov.doRequest({"data": ReadOnlyFile::readBinaryFile(test_data_dir + "/profile.xls"),
            "redact": False, "sample_rows": 1});
        assertEq("xls", profile.format);
        assertEq((("PO-1001", "000123", 5.0, "10.10.2026"),), profile.sheets[0].samples);

        assertThrows("TABULAR-PROFILE-ERROR", "exactly one", \prov.doRequest(), {});
    }

    testWriterRecordType() {
        # the headers option defines the columns
        ExcelWriteDataProvider dp({"headers": ("Sku", "Qty")});
        assertEq(("Sku", "Qty"), keys dp.getRecordType());
        assertEq(("Sku", "Qty"), keys dp.getCreateRecordTypeWithOptions());
        # without headers, the first record's keys define the columns: an open record type
        dp = new ExcelWriteDataProvider();
        assertNothing(dp.getRecordType());
        assertEq({}, dp.getOrNothingRecordTypeWithOptions());
    }

    #! The record type, the records, the worksheet names, and worksheet providers can be acquired in any order
    /** Qorus reads the provider info (and with it the worksheet names) after the record type when it executes an
        action; the worksheet names were then read from the input stream already consumed by the record type
    */
    testWorkbookReuse() {
        string path = test_data_dir + "/multi-sheet.xlsx";
        binary data = ReadOnlyFile::readBinaryFile(path);
        hash<auto> opts = {"worksheet": "Users", "header_names": True};
        hash<string, code> sources = {
            "data": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(opts + {"data": data});
            },
            "stream": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(opts + {"stream": new BinaryInputStream(data)});
            },
            "path": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(opts + {"path": path});
            },
            "stream constructor": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(new BinaryInputStream(data), opts);
            },
            "path constructor": ExcelReadDataProvider sub () {
                return new ExcelReadDataProvider(path, opts);
            },
        };
        list<string> sheets = ("Users", "Products", "Orders");
        foreach hash<auto> i in (sources.pairIterator()) {
            # the record type, then the provider info, as Qorus acquires them when executing an action
            ExcelReadDataProvider dp = i.value();
            assertEq(("ID", "Username"), keys dp.getRecordType(), i.key);
            assertEq(sheets, dp.getInfo().children, i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);
            assertEq(sheets, dp.getChildProviderNames(), i.key);
            assertEq(("Widget",), (map $1.Product, dp.getChildProvider("Products").searchRecords()), i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);

            # a worksheet provider first, then the parent's own worksheet
            dp = i.value();
            assertEq((1001,), (map $1.OrderID.toInt(), dp.getChildProvider("Orders").searchRecords()), i.key);
            assertEq(sheets, dp.getChildProviderNames(), i.key);
            assertEq(("ID", "Username"), keys dp.getRecordType(), i.key);
            assertEq(("alice", "bob"), (map $1.Username, dp.searchRecords()), i.key);
        }

        # a provider without input has no worksheets, record fields, or records
        ExcelReadDataProvider empty();
        assertEq(NOTHING, empty.getChildProviderNames());
        assertEq({}, empty.getRecordType());
    }

    testStreamedCellEncodings() {
        string path = test_data_dir + "/streaming-features.xlsx";
        ExcelTestHelper::createStreamingFeaturesExcel(path);

        # error cells fail the read by default
        assertThrows("EXCEL-CELL-ERROR", "cell D5 \\(column \"Inline\"\\) is the error #N/A", sub () {
            map $1, (new ExcelReadDataProvider(path, {"header_names": True, "ignore_empty": True})).searchRecords();
        });
        ExcelReadDataProvider dp(path, {"header_names": True, "timezone": "UTC", "ignore_empty": True,
            "error_cells": "null"});
        assertEq(("Main", "Chart", "Sparse"), dp.getChildProviderNames());
        assertEq(("Name", "Val", "When", "Inline"), keys dp.getRecordType());
        list<hash<auto>> expected = (
            # a rich shared string without its phonetic run, a date from the column's style, and inline rich text
            {"Name": "rich", "Val": 42.5, "When": 2023-03-15T06:00:00Z, "Inline": "a b"},
            # escaped characters; the cell's own number style overrides the column's date style
            {"Name": "escA", "Val": 7.0, "When": 1.0, "Inline": "B"},
            # a boolean cell is true only for "1"; an error cell has no value with "error_cells": "null"
            {"Name": True, "Val": False, "When": 2023-03-16T00:00:00Z, "Inline": NOTHING},
            # formula cells give their cached results
            {"Name": 2.0, "Val": "xyC", "When": True, "Inline": NOTHING},
            # a cell of an array formula without a cached value is 0; an invalid shared string index is empty
            {"Name": 1.0, "Val": 0.0, "When": 2023-03-15T12:00:00Z, "Inline": ""},
        );
        assertEq(expected, (map $1, dp.searchRecords()));
        # each iteration reads the worksheet from its first data row
        assertEq(expected, (map $1, dp.searchRecords()));

        # without ignore_empty, reading stops at the missing row 4
        dp = new ExcelReadDataProvider(path, {"header_names": True, "timezone": "UTC", "error_cells": "null"});
        assertEq(expected[0..1], (map $1, dp.searchRecords()));

        # a chart sheet has no cells
        dp = new ExcelReadDataProvider(path, {"worksheet": "Chart", "ignore_empty": True});
        assertEq(0, elements (map $1, dp.searchRecords()));

        # rows and cells without references follow the previous ones
        dp = new ExcelReadDataProvider(path, {"worksheet": "Sparse", "ignore_empty": True});
        assertEq(({"A1": 1.0, "B1": 2.0}, {"A20": "far"}, {"A21": 5.0}), (map $1, dp.searchRecords()));
    }

    testLargeWorkbook() {
        # a worksheet with 200000 rows is read with a JVM heap far smaller than the workbook loaded in memory
        # needs (about 1 GB); a child process has its own JVM with a 64 MB heap
        foreach bool shared_strings in ((True, False)) {
            string path = sprintf("%s/large-%s.xlsx", test_data_dir, shared_strings ? "shared" : "inline");
            on_exit unlink(path);
            ExcelTestHelper::createLargeExcel(path, LargeRows, shared_strings);

            string src = sprintf("%%modern
%%prepend-module-path \"%s/../qlib\"
%%requires DataProvider
%%requires json
%%requires ExcelDataProvider

ExcelReadDataProvider dp({\"path\": ARGV[0], \"header_names\": True, \"timezone\": \"UTC\"});
AbstractDataProviderRecordIterator i = dp.searchRecords();
int count = 0;
int mismatches = 0;
*hash<auto> last;
while (i.next()) {
    hash<auto> r = i.getValue();
    ++count;
    if (keys r != (\"Id\", \"Name\", \"Amount\", \"When\", \"Flag\") || r.Id != count.toFloat()
        || r.Name != (\"name-\" + count) || r.Amount != (count / 4.0)
        || r.When != (2025-01-01T00:00:00Z + seconds(count)) || r.Flag != (count %% 2 == 0)) {
        ++mismatches;
    }
    last = r;
}
printf(\"RESULT:%%s\\n\", make_json({\"count\": count, \"mismatches\": mismatches, \"last\": last}));
", get_script_dir() == "." ? getcwd() : get_script_dir());
            hash<auto> result = runChild(src, path);
            string label = shared_strings ? "shared strings" : "inline strings";
            assertEq(LargeRows, result.count, label);
            assertEq(0, result.mismatches, label);
            assertEq("name-" + LargeRows, result.last.Name, label);
            assertEq(LargeRows / 4.0, result.last.Amount.toFloat(), label);
        }
    }

    testEarlyClose() {
        string path = test_data_dir + "/early-close.xlsx";
        on_exit unlink(path);
        ExcelTestHelper::createLargeExcel(path, 20000, True);
        binary data = ReadOnlyFile::readBinaryFile(path);

        # a complete iteration first, so that later file counts do not include the JVM's class files
        {
            ExcelIterator it(new BinaryInputStream(data), "");
            it.setHeaderCells("-", 1, "-", 1);
            int count = 0;
            while (it.next()) {
                ++count;
            }
            assertEq(20000, count);
            it.close();
        }
        list<string> temp_files = getTempFiles("qore-xlsx-");
        int open_files = countOpenFiles();

        ExcelIterator it(new BinaryInputStream(data), "");
        it.setHeaderCells("-", 1, "-", 1);
        for (int i = 1; i <= 10; ++i) {
            assertTrue(it.next());
            assertEq(i.toFloat(), it.getValue().Id);
        }
        # the workbook is open while the iteration is in progress; its temporary copy is already deleted
        assertGt(open_files, countOpenFiles());
        assertEq(temp_files, getTempFiles("qore-xlsx-"));

        # closing the iterator in the middle of the worksheet releases the workbook
        it.close();
        assertEq(open_files, countOpenFiles());
        assertEq(temp_files, getTempFiles("qore-xlsx-"));
        assertThrows("JNI-ERROR", "the Excel iterator is closed", \it.next());
    }

    testOpenDataRange() {
        # without an end column and without headers, each row is read to its last cell with a value; reading such a
        # range never ended before
        ExcelReadDataProvider dp(test_data_dir + "/simple.xlsx", {"data_cells": "b2"});
        assertEq((
            {"A2": 30.0, "B2": "New York"},
            {"A3": 25.0, "B3": "Los Angeles"},
            {"A4": 35.0, "B4": "Chicago"},
        ), (map $1, dp.searchRecords()));

        # rows end at different columns; a row without a value from the start column is empty
        string path = test_data_dir + "/streaming-features.xlsx";
        ExcelTestHelper::createStreamingFeaturesExcel(path);
        dp = new ExcelReadDataProvider(path, {"worksheet": "Sparse", "data_cells": "b1", "ignore_empty": True});
        assertEq(({"A1": 2.0}, {"A2": NOTHING, "B2": 3.0, "C2": 4.0}), (map $1, dp.searchRecords()));
        # without ignore_empty, reading stops at the first row without a value
        dp = new ExcelReadDataProvider(path, {"worksheet": "Sparse", "data_cells": "c1"});
        assertEq(0, elements (map $1, dp.searchRecords()));

        # an .xls workbook
        string xls = test_data_dir + "/open-range.xls";
        on_exit unlink(xls);
        ExcelWriteDataProvider w(xls, {"format": "xls"});
        w.createRecord({"Sku": "A-1", "Qty": 5, "Note": "x"});
        w.createRecord({"Sku": "B-2", "Qty": 7, "Note": NOTHING});
        w.commit();
        dp = new ExcelReadDataProvider(xls, {"data_cells": "b2"});
        assertEq(({"A2": 5.0, "B2": "x"}, {"A3": 7.0}), (map $1, dp.searchRecords()));
    }

    testWorkbookFile() {
        string path = test_data_dir + "/workbook-file.xlsx";
        on_exit unlink(path);
        ExcelTestHelper::createMultiSheetExcel(path);
        list<string> temp_files = getTempFiles("qore-excelfile-");

        # the input stream is copied to a temporary file on first use, not read into memory
        ExcelReadDataProvider dp(new FileInputStream(path), {"header_names": True});
        assertEq(temp_files, getTempFiles("qore-excelfile-"), "nothing is copied before the workbook is used");
        list<string> sheets = dp.getChildProviderNames();
        assertEq(elements temp_files + 1, elements getTempFiles("qore-excelfile-"), "the input is copied once");
        int records = elements (map $1, dp.searchRecords());
        assertGt(0, records);

        # a worksheet provider uses the same file, which is kept until the last provider using it is destroyed
        AbstractDataProvider ws = dp.getChildProviderEx(sheets[0]);
        assertEq(elements temp_files + 1, elements getTempFiles("qore-excelfile-"),
            "worksheet providers use the same file");
        delete dp;
        assertEq(elements temp_files + 1, elements getTempFiles("qore-excelfile-"),
            "the worksheet provider keeps the file");
        assertEq(records, elements (map $1, ws.searchRecords()));
        delete ws;
        assertEq(temp_files, getTempFiles("qore-excelfile-"), "the file is deleted with the last provider");

        # a provider given a path and data in the options works the same way
        foreach hash<auto> opts in ({"path": path}, {"data": ReadOnlyFile::readBinaryFile(path)}) {
            dp = new ExcelReadDataProvider(opts + {"header_names": True});
            assertEq(sheets, dp.getChildProviderNames(), (keys opts)[0]);
            assertEq(records, elements (map $1, dp.searchRecords()), (keys opts)[0]);
            delete dp;
            assertEq(temp_files, getTempFiles("qore-excelfile-"), (keys opts)[0]);
        }
    }

    #! Runs a Qore program in a child process with a small JVM heap; returns the result it prints
    private hash<auto> runChild(string src, string arg) {
        TmpFile tmp(NOTHING, ".qr");
        # the child loads the jni module that this test loaded
        tmp.file.write(sprintf("%%prepend-module-path \"%s\"\n", dirname(get_module_hash().jni.filename)) + src);
        tmp.file.close();
        string cmd = sprintf("env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "
            "QORE_JNI_MAX_HEAP_SIZE=%s %s --enable-debug %s %s 2>&1; echo CHILD_EXIT=$?", ChildHeap,
            shellQuote(qoreBin()), shellQuote(tmp.path), shellQuote(arg));
        string output = trim(backquote(cmd));
        *string result = (output =~ x/^RESULT:(.*)$/m)[0];
        if (!result) {
            fail(sprintf("child process did not complete: %s", output));
        }
        assertRegex("CHILD_EXIT=0$", output);
        return parse_json(result);
    }

    #! Returns the number of open files of this process
    private static int countOpenFiles() {
        Dir dir();
        if (!dir.chdir("/dev/fd")) {
            throw "TEST-ERROR", "/dev/fd is not available";
        }
        return dir.list().size();
    }

    #! Returns the files with the given prefix in the JVM's temporary directory
    private static list<string> getTempFiles(string prefix) {
        Dir dir();
        dir.chdir(System::getProperty("java.io.tmpdir"));
        return sort(dir.list("^" + prefix) ?? ());
    }

    private string qoreBin() {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? ENV.QORE_EXECUTABLE ?? QORE_ARGV[0] ?? ARGV[0];
        assertTrue(exists qore_bin, "no qore binary path available");
        return qore_bin;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }

    testWriteColumnFormats() {
        # each variant: the writer options and the file extension
        hash<string, hash<auto>> variants = {
            "xlsx": {"ext": "xlsx", "opts": {}},
            "streaming xlsx": {"ext": "xlsx", "opts": {"streaming": True}},
            "xls": {"ext": "xls", "opts": {"format": "xls"}},
        };
        foreach hash<auto> i in (variants.pairIterator()) {
            string path = sprintf("%s/column-formats.%s", test_data_dir, i.value.ext);
            on_exit unlink(path);
            ExcelWriteDataProvider dp(path, i.value.opts + {
                "headers": FormatHeaders,
                "column_formats": ColumnFormats,
            });
            dp.createRecord(FormatRecord);
            dp.finishCreate();

            # the format code of each cell, read with POI
            assertEq((map "General", FormatHeaders), ExcelTestHelper::getCellFormats(path, 0), i.key + ": headers");
            assertEq(("General", "dd.mm.yyyy hh:mm", "#,##0.00;(#,##0.00)", "0.0%", "@", "General",
                "yyyy-mm-dd hh:mm:ss"), ExcelTestHelper::getCellFormats(path, 1), i.key + ": formats");

            # the values keep their types
            ExcelReadDataProvider rdp(path, {"header_names": True});
            list<hash<auto>> recs = map $1, rdp.searchRecords();
            assertEq(1, recs.size(), i.key);
            assertEq(FormatRecord + {"Amount": -1234.5, "Plain": 42}, recs[0], i.key + ": values");
        }
    }

    testWriteColumnFormatsOtherValues() {
        string path = test_data_dir + "/column-formats-other.xlsx";
        on_exit unlink(path);
        ExcelWriteDataProvider dp(path, {"headers": FormatHeaders, "column_formats": ColumnFormats});
        # a value of another kind than its column's code is written without the format; no value is a blank cell
        dp.createRecord({"Name": "b", "Date": 5, "Amount": "n/a", "Share": 2026-10-07T00:00:00, "Code": 3.5,
            "Plain": NOTHING, "Stamp": True});
        dp.finishCreate();
        assertEq(("General", "General", "General", "yyyy-mm-dd hh:mm:ss", "General", "General", "General"),
            ExcelTestHelper::getCellFormats(path, 1));
        ExcelReadDataProvider rdp(path, {"header_names": True});
        assertEq(({"Name": "b", "Date": 5, "Amount": "n/a", "Share": 2026-10-07T00:00:00, "Code": 3.5,
            "Plain": NOTHING, "Stamp": True},), (map $1, rdp.searchRecords()));
    }

    testWriteColumnFormatStyles() {
        foreach string format in (("xlsx", "xls")) {
            # a workbook without column formats, for the number of cell styles a workbook has anyway
            string base_path = sprintf("%s/styles-base.%s", test_data_dir, format);
            on_exit unlink(base_path);
            ExcelWriteDataProvider base(base_path, {"format": format, "headers": ("A", "B", "C")});
            base.createRecord({"A": 1, "B": 2, "C": 3});
            base.finishCreate();

            # three columns with two distinct codes and many rows
            string path = sprintf("%s/styles.%s", test_data_dir, format);
            on_exit unlink(path);
            ExcelWriteDataProvider dp(path, {"format": format, "headers": ("A", "B", "C"), "column_formats": {
                "A": "0.00", "B": "0.00", "C": "0.0%",
            }});
            for (int i = 0; i < 500; ++i) {
                dp.createRecord({"A": i, "B": i * 2, "C": i / 100.0});
            }
            dp.finishCreate();
            assertEq(ExcelTestHelper::getCellStyleCount(base_path) + 2, ExcelTestHelper::getCellStyleCount(path),
                format + ": one cell style per distinct code");
            assertEq(("0.00", "0.00", "0.0%"), ExcelTestHelper::getCellFormats(path, 500), format);
        }
    }

    testWriteColumnFormatsFirstRecord() {
        string path = test_data_dir + "/column-formats-first-record.xlsx";
        on_exit unlink(path);
        ExcelWriteDataProvider dp(path, {"column_formats": {"Amount": "#,##0.00"}});
        dp.createRecord({"Name": "a", "Amount": 1234.5});
        dp.createRecord({"Name": "b", "Amount": 2});
        dp.finishCreate();
        assertEq(("General", "#,##0.00"), ExcelTestHelper::getCellFormats(path, 1));
        assertEq(("General", "#,##0.00"), ExcelTestHelper::getCellFormats(path, 2));

        # a column format for a column that the first record does not have
        ExcelWriteDataProvider bad({"column_formats": {"Amount": "0.00", "Total": "0.00"}});
        assertThrows("CREATE-RECORD-ERROR", "EXCEL-WRITE-OPTION-ERROR.*column \"Total\", which is not written",
            \bad.createRecord(), {"Name": "a", "Amount": 1});
        assertEq(0, bad.getCreatedCount());
    }

    testFormatCodes() {
        foreach string code in (ValidFormatCodes) {
            assertNothing(ExcelWriter::formatCodeIssue(code), code);
        }
        foreach hash<auto> i in (InvalidFormatCodes.pairIterator()) {
            *string issue = ExcelWriter::formatCodeIssue(i.key);
            assertNeq(NOTHING, issue, i.key);
            assertRegex(i.value, issue ?? "", i.key);
        }
    }

    testWriteNegativeColumnFormats() {
        # an invalid code names its column
        assertThrows("EXCEL-WRITE-OPTION-ERROR", "column \"Amount\": format code \"#,##0.00 EUR\" has \"E\" at "
            "position 10, which must be quoted", sub () {
            ExcelWriteDataProvider dp({"column_formats": {"Amount": "#,##0.00 EUR"}});
        });
        # each constructor checks the codes
        assertThrows("EXCEL-WRITE-OPTION-ERROR", "unterminated", sub () {
            ExcelWriteDataProvider dp(test_data_dir + "/never.xlsx", {"column_formats": {"A": "0.00["}});
        });
        assertThrows("EXCEL-WRITE-OPTION-ERROR", "General", sub () {
            ExcelWriteDataProvider dp(new StringOutputStream(), {"column_formats": {"A": "General"}});
        });
        assertFalse(is_file(test_data_dir + "/never.xlsx"));
        # a column that is not in the headers
        assertThrows("EXCEL-WRITE-OPTION-ERROR", "columns \\[\"X\", \"Y\"\\], which are not written; the columns "
            "written are: \\[\"A\"\\]", sub () {
            ExcelWriteDataProvider dp({"headers": ("A",), "column_formats": {"A": "0", "X": "0", "Y": "0"}});
        });
        # a format code must be a string: the option type check refuses other values
        assertThrows("OPTION-VALUE-ERROR", "option \"column_formats\" of type \"hash<string, string>\"", sub () {
            ExcelWriteDataProvider dp({"column_formats": {"A": 1}});
        });
        # the Java writer refuses invalid codes and late formats too
        ExcelWriter writer("Sheet1", "xlsx", False);
        on_exit writer.close();
        assertThrows("JNI-ERROR", "column \"A\": format code \"0.0.0\" has a second decimal point",
            \writer.setColumnFormats(), {"A": "0.0.0"});
        writer.writeRow({"A": 1});
        assertThrows("JNI-ERROR", "before any row is written", \writer.setColumnFormats(), {"A": "0"});
    }

    testColumnFormatsActionOption() {
        foreach string action in (("write", "write-data")) {
            hash<DataProviderActionInfo> info = DataProviderActionCatalog::getAppActionEx("Excel", action);
            assertTrue(exists info.options.column_formats, action);
        }
        hash<DataProviderOptionInfo> opt = ExcelWriteDataProvider::ConstructorOptions.column_formats;
        assertEq("hash<string, string>", opt.type[0].getName());
        # the example is a valid option value
        foreach hash<auto> i in (opt.example_value.pairIterator()) {
            assertNothing(ExcelWriter::formatCodeIssue(i.value), i.key);
        }
    }

    testWriteColumnFormatsRendered() {
        *string soffice = findLibreOffice();
        if (!soffice) {
            testSkip("LibreOffice (soffice) is not installed");
        }
        foreach string format in (("xlsx", "xls")) {
            string path = sprintf("%s/column-formats-rendered.%s", test_data_dir, format);
            on_exit unlink(path);
            ExcelWriteDataProvider dp(path, {"format": format, "headers": FormatHeaders,
                "column_formats": ColumnFormats});
            dp.createRecord(FormatRecord);
            dp.createRecord(FormatRecord + {"Amount": 1234567.891, "Share": 1});
            dp.finishCreate();
            assertEq((
                {"Name": "a", "Date": "07.10.2026 13:45", "Amount": "(1,234.50)", "Share": "25.0%", "Code": "X1",
                    "Plain": "42", "Stamp": "2026-01-05 08:05:09"},
                {"Name": "a", "Date": "07.10.2026 13:45", "Amount": "1,234,567.89", "Share": "100.0%",
                    "Code": "X1", "Plain": "42", "Stamp": "2026-01-05 08:05:09"},
            ), renderWithLibreOffice(soffice, path), format);
        }
    }

    #! Returns the path of LibreOffice's soffice program, or NOTHING if it is not installed
    private static *string findLibreOffice() {
        foreach string dir in (ENV.PATH.split(":")) {
            string path = dir + "/soffice";
            if (is_executable(path)) {
                return path;
            }
        }
    }

    #! Returns the records of a spreadsheet's first sheet as LibreOffice shows its cells
    private list<hash<auto>> renderWithLibreOffice(string soffice, string path) {
        TmpDir dir("render-");
        # CSV with "save cell contents as shown"; the profile directory keeps a running LibreOffice out of the way
        string cmd = sprintf("%s -env:UserInstallation=file://%s/profile --headless --convert-to "
            "'csv:Text - txt - csv (StarCalc):44,34,76,1,,0,false,true,true' --outdir %s %s >/dev/null 2>&1",
            shellQuote(soffice), dir.path, shellQuote(dir.path), shellQuote(path));
        assertEq(0, system(cmd), cmd);
        string csv = sprintf("%s/%s.csv", dir.path, basename(path).split(".")[0]);
        return map $1, new CsvFileIterator(csv, {"header_names": True});
    }
    testWriteColumnMasks() {
        # each variant: the writer options and the file extension
        hash<string, hash<auto>> variants = {
            "xlsx": {"ext": "xlsx", "opts": {}},
            "streaming xlsx": {"ext": "xlsx", "opts": {"streaming": True}},
            "xls": {"ext": "xls", "opts": {"format": "xls"}},
        };
        foreach hash<auto> i in (variants.pairIterator()) {
            string path = sprintf("%s/column-masks.%s", test_data_dir, i.value.ext);
            on_exit unlink(path);
            ExcelWriteDataProvider dp(path, i.value.opts + {
                "headers": MaskHeaders,
                "column_masks": ColumnMasks,
            });
            dp.createRecord(MaskRecord);
            dp.finishCreate();

            # the format code of each cell is the display format of its mask
            assertEq(("General", "dd\\.mm\\.yyyy", "hh:mm AM/PM", "yyyy-mm-dd\\Thh:mm:ss", "#,##0.00\" €\"",
                "0.##########%", "#,##0.00;(#,##0.00)", "#,##0.00;#,##0.00-", "#,##0"),
                ExcelTestHelper::getCellFormats(path, 1), i.key + ": formats");
            assertEq(("General",) + (map ValueMask::toSpreadsheetFormat(ColumnMasks{$1}), MaskHeaders[1..]),
                ExcelTestHelper::getCellFormats(path, 1), i.key + ": ValueMask");

            # the values keep their types
            ExcelReadDataProvider rdp(path, {"header_names": True});
            list<hash<auto>> recs = map $1, rdp.searchRecords();
            assertEq((MaskRecord + {"Count": 1234567},), recs, i.key + ": values");
        }
        # a column format and a column mask for different columns
        string path = test_data_dir + "/column-masks-formats.xlsx";
        on_exit unlink(path);
        ExcelWriteDataProvider dp(path, {"headers": ("A", "B"), "column_formats": {"A": "0.00"},
            "column_masks": {"B": "DD.MM.YYYY"}});
        dp.createRecord({"A": 1, "B": 2026-11-02T00:00:00});
        dp.finishCreate();
        assertEq(("0.00", "dd\\.mm\\.yyyy"), ExcelTestHelper::getCellFormats(path, 1));
    }

    testCommonColumnMasks() {
        foreach string mask in (ValueMask::DateFormats + ValueMask::TimeFormats + ValueMask::NumberFormats
                + ValueMask::AmountFormats) {
            # a mask with an offset has no display format
            if (mask =~ /ZZ/) {
                assertThrows("EXCEL-WRITE-OPTION-ERROR", "column \"V\": .*holds no UTC offset", sub () {
                    ExcelWriteDataProvider dp({"column_masks": {"V": mask}});
                }, NOTHING, mask);
                continue;
            }
            string code = ValueMask::toSpreadsheetFormat(mask);
            assertNothing(ExcelWriter::formatCodeIssue(code), mask);
            auto value = ValueMask::maskKind(mask) == "number" ? -1234.5 : 2026-11-02T15:05:09.123;
            foreach string format in (("xlsx", "xls")) {
                string path = sprintf("%s/common-mask.%s", test_data_dir, format);
                on_exit unlink(path);
                ExcelWriteDataProvider dp(path, {"format": format, "headers": ("V",), "column_masks": {"V": mask}});
                dp.createRecord({"V": value});
                dp.finishCreate();
                assertEq((code,), ExcelTestHelper::getCellFormats(path, 1), format + ": " + mask);
            }
        }
    }

    testWriteNegativeColumnMasks() {
        hash<string, string> refused = {
            "YYYY-MM-DDTHH:mm:SSZZ": "holds no UTC offset \\(ZZ\\)",
            "DD MON YYYY": "no upper-case month name \\(use Mon\\)",
            "HH:mm:SS,sss": "a fraction of a second only directly after the seconds and a decimal point",
            "mm HH": "shows mm as a minute only directly after an hour or before the seconds",
            "YYYY-DD HH MM": "shows MM directly after an hour or before the seconds as a minute",
            "DD.MM.JJJJ": "is not a valid date, time or number mask: unknown letters \"JJJJ\"",
        };
        foreach hash<auto> i in (refused.pairIterator()) {
            assertThrows("EXCEL-WRITE-OPTION-ERROR", "invalid \"column_masks\" option: column \"V\": .*" + i.value,
                sub () {
                    ExcelWriteDataProvider dp({"column_masks": {"V": i.key}});
                }, NOTHING, i.key);
        }
        # a column with a mask and a format code
        assertThrows("EXCEL-WRITE-OPTION-ERROR", "column \"A\" also has a format code in the \"column_formats\" "
            "option", sub () {
            ExcelWriteDataProvider dp({"column_formats": {"A": "0.00"}, "column_masks": {"A": "0.00"}});
        });
        # a column that is not written
        assertThrows("EXCEL-WRITE-OPTION-ERROR", "invalid \"column_masks\" option: a mask is given for column "
            "\"X\", which is not written; the columns written are: \\[\"A\"\\]", sub () {
            ExcelWriteDataProvider dp({"headers": ("A",), "column_masks": {"A": "0", "X": "0"}});
        });
        ExcelWriteDataProvider bad({"column_masks": {"Amount": "0.00", "Total": "0.00"}});
        assertThrows("CREATE-RECORD-ERROR", "EXCEL-WRITE-OPTION-ERROR.*a mask is given for column \"Total\", which "
            "is not written", \bad.createRecord(), {"Name": "a", "Amount": 1});
        assertEq(0, bad.getCreatedCount());
    }

    testWriteColumnHeaders() {
        string path = test_data_dir + "/column-headers.xlsx";
        on_exit unlink(path);
        # the records and the column options name the columns as the records do
        ExcelWriteDataProvider dp(path, {
            "headers": ("id", "amount"),
