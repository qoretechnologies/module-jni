    #! Returns the list-worksheets action and its data provider
    private hash<auto> getListWorksheetsAction(hash<auto> opts) {
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx("Excel", "list-worksheets");
        return {
            "action": action,
            "provider": DataProviderActionCatalog::getDataProviderForAction(action, \opts),
        };
    }

    #! The list-worksheets action lists the worksheets of a workbook in order, with their position and visibility
    testListWorksheetsAction() {
        hash<auto> opts = {"path": test_data_dir + "/multi-sheet.xlsx"};
        hash<auto> a = getListWorksheetsAction(opts);
        hash<DataProviderActionInfo> action = a.action;
        AbstractDataProvider prov = a.provider;
        assertEq(DPAT_API, action.action_code);
        assertEq("ExcelWorksheetList", action.output_type.getName());
        assertEq(("data", "path"), sort(keys action.options));
        assertTrue(action.options.path.preselected);
        assertFalse(action.options.path.required, "path and data are alternatives");
        assertFalse(action.options.data.required, "path and data are alternatives");
        assertEq("ExcelWorksheetListRequest", prov.getRequestType().getName());
        assertEq("ExcelWorksheetList", prov.getResponseType().getName());

        hash<auto> rv = prov.doRequest(opts);
        assertEq(rv, action.output_type.acceptsValue(rv));
        assertEq({"worksheets": (
            {"name": "Users", "index": 0, "hidden": False},
            {"name": "Products", "index": 1, "hidden": False},
            {"name": "Orders", "index": 2, "hidden": False},
        )}, rv);

        # the same worksheets as the read provider's child providers, from a location or inline data, for .xlsx and
        # .xls workbooks
        foreach string file in ("multi-sheet.xlsx", "profile.xlsx", "profile.xls", "sheet-visibility.xlsx",
                "sheet-visibility.xls") {
            string path = test_data_dir + "/" + file;
            list<string> names = (new ExcelReadDataProvider({"path": path})).getChildProviderNames();
            hash<auto> by_path = prov.doRequest({"path": path});
            hash<auto> by_data = prov.doRequest({"data": ReadOnlyFile::readBinaryFile(path)});
            assertEq(by_path, by_data, file);
            assertEq(names, (map $1.name, by_path.worksheets), file);
            assertEq(range(names.size()), (map $1.index, by_path.worksheets), file);
            assertEq(by_path, action.output_type.acceptsValue(by_path), file);
        }

        # a hidden worksheet is listed where it is in the workbook
        assertEq({"worksheets": (
            {"name": "Confirmations", "index": 0, "hidden": False},
            {"name": "Lookup", "index": 1, "hidden": True},
        )}, prov.doRequest({"path": test_data_dir + "/profile.xls"}));

        # a data string in Base64 is accepted as the workbook's bytes
        assertEq(prov.doRequest({"path": test_data_dir + "/multi-sheet.xlsx"}),
            prov.doRequest({"data": make_base64_string(ReadOnlyFile::readBinaryFile(test_data_dir
                + "/multi-sheet.xlsx"))}));
    }

