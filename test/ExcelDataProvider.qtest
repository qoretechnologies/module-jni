    testWorksheetNoInput() {
        ExcelWorksheetReadDataProvider dp();
        assertEq({}, dp.getRecordType());
        assertEq((), (map $1, dp.searchRecords()));
        dp = new ExcelWorksheetReadDataProvider({"header_names": True, "worksheet": "Sheet1"});
