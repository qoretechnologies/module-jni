    #! Columns are typed from their values in the first rows
    testTypedColumns() {
        foreach string file in ("typed.xlsx", "typed.xls") {
            assertEq({
                "Id": "*int",
                "Price": "*float",
                "Paid": "*bool",
                "Shipped": "*date",
                "Name": "*string",
                "Note": "auto",
                "Empty": "auto",
            }, readExcelTypes(file), file);
            list<hash<auto>> recs = readExcel(file);
            assertEq(5, recs.size(), file);
            assertEq((1, 2, 3, 4, 5), (map $1.Id, recs), file);
            assertEq(Type::Int, recs[0].Id.type(), file);
            assertEq((1.25, 2.5, 3.75, 5.0, 6.25), (map $1.Price, recs), file);
            assertEq(Type::Float, recs[3].Price.type(), file);
            assertEq((False, True, False, True, False), (map $1.Paid, recs), file);
            assertEq(2026-01-02, recs[0].Shipped, file);
            assertEq(Type::Date, recs[0].Shipped.type(), file);
            assertEq("item-1", recs[0].Name, file);
            # a column of text and numbers is not converted
            assertEq(("n-1", 2.0, "n-3", 4.0, "n-5"), (map $1.Note, recs), file);
            assertEq((NOTHING, NOTHING, NOTHING, NOTHING, NOTHING), (map $1.Empty, recs), file);
            # the record type accepts the records
            ExcelReadDataProvider dp(test_data_dir + "/" + file, {"header_names": True});
            hash<string, AbstractDataField> rec_type = dp.getRecordType();
            foreach hash<auto> rec in (recs) {
                map rec_type{$1.key}.getType().acceptsValue($1.value), rec.pairIterator();
            }
            # the worksheet provider of the file is typed as well
            AbstractDataProvider sheet = dp.getChildProvider("Orders");
            assertEq((1, 2, 3, 4, 5), (map $1.Id, sheet.searchRecords()), file);
            assertEq("*int", sheet.getRecordType().Id.getType().getName(), file);
        }
    }

