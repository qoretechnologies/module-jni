    #! column_types gives the type of columns
    testColumnTypes() {
        hash<auto> opts = {"column_types": {"Id": "float", "Note": "string", "Empty": "date", "Paid": "any"}};
        hash<string, string> types = readExcelTypes("typed.xlsx", opts);
        assertEq("*float", types.Id);
        assertEq("*string", types.Note);
        assertEq("*date", types.Empty);
        assertEq("auto", types.Paid);
        assertEq("*float", types.Price, "other columns are inferred");
        list<hash<auto>> recs = readExcel("typed.xlsx", opts);
        assertEq((1.0, 2.0), (map $1.Id, recs[0..1]));
        # numbers in a text column are converted to text
        assertEq(("n-1", "2", "n-3", "4", "n-5"), (map $1.Note, recs));
        # only the given columns are typed when there is no sampling
        types = readExcelTypes("typed.xlsx", opts + {"type_sample_rows": 0});
        assertEq("*float", types.Id);
        assertEq("auto", types.Price);

        assertThrows("EXCEL-READ-OPTION-ERROR", "column_types.*\"Id\".*\"bogus\"", \readExcel(),
            ("typed.xlsx", {"column_types": {"Id": "bogus"}}));
        assertThrows("EXCEL-READ-OPTION-ERROR", "column_types.*\"Nope\".*not a column", \readExcel(),
            ("typed.xlsx", {"column_types": {"Nope": "int"}}));
        assertThrows("EXCEL-READ-OPTION-ERROR", "type_sample_rows", \readExcel(),
            ("typed.xlsx", {"type_sample_rows": -1}));
    }

    #! A value after the sampled rows that does not have its column's type fails the read, naming the remedy
    testTypeMismatch() {
        foreach string file in ("typed-mismatch.xlsx", "typed-mismatch.xls") {
            ExcelReadDataProvider dp(test_data_dir + "/" + file, {"header_names": True});
            assertEq("*int", dp.getRecordType().Id.getType().getName(), file);
            int read = 0;
            *hash<ExceptionInfo> ex;
            try {
                map ++read, dp.searchRecords();
            } catch (hash<ExceptionInfo> e) {
                ex = e;
            }
            assertEq("EXCEL-COLUMN-TYPE-ERROR", ex.err, file);
            assertEq(119, read, file + ": the records before the value are read");
            assertRegex("worksheet \"Orders\" row 121 column \"Id\".*\"N/A\".*int.*first 100", ex.desc, file);
            assertRegex("column_types.*type_sample_rows", ex.desc, file);
            assertEq({"worksheet": "Orders", "row": 121, "column": "Id", "value": "N/A", "type": "int"},
                ex.arg{"worksheet", "row", "column", "value", "type"}, file);

            # the remedies
            list<hash<auto>> recs = readExcel(file, {"type_sample_rows": 150});
            assertEq(150, recs.size(), file);
            assertEq("N/A", recs[119].Id, file);
            assertEq(1.0, recs[0].Id, file + ": a column of numbers and text is not converted");
            recs = readExcel(file, {"column_types": {"Id": "string", "Price": "any"}});
            assertEq("1", recs[0].Id, file);
            assertEq("N/A", recs[119].Id, file);
        }
    }

    #! An error cell fails the read by default, naming the ways to accept it
    testErrorCells() {
        foreach string file in ("errors.xlsx", "errors.xls") {
            *hash<ExceptionInfo> ex;
            try {
                readExcel(file);
            } catch (hash<ExceptionInfo> e) {
                ex = e;
            }
            assertEq("EXCEL-CELL-ERROR", ex.err, file);
            assertRegex("worksheet \"Rates\" cell B2 \\(column \"Ratio\"\\).*#DIV/0!", ex.desc, file);
            assertRegex("error_cells.*\"null\".*\"text\".*error_field", ex.desc, file);
            assertEq({"worksheet": "Rates", "cell": "B2", "column": "Ratio", "error": "#DIV/0!"},
                ex.arg{"worksheet", "cell", "column", "error"}, file);

            # errors read as no value; the columns are typed from their other values
            list<hash<auto>> recs = readExcel(file, {"error_cells": "null"});
            assertEq((NOTHING, 0.5, NOTHING), (map $1.Ratio, recs), file);
            assertEq((NOTHING, "x", "y"), (map $1.Lookup, recs), file);
            assertEq("*float", readExcelTypes(file, {"error_cells": "null"}).Ratio, file);

            # errors read as their text
            recs = readExcel(file, {"error_cells": "text"});
            assertEq(("#DIV/0!", 0.5, "#N/A"), (map $1.Ratio, recs), file);
            assertEq(("#N/A", "x", "y"), (map $1.Lookup, recs), file);

            # errors in a field of their own
            recs = readExcel(file, {"error_field": "errors"});
            assertEq(({"Ratio": "#DIV/0!", "Lookup": "#N/A"}, NOTHING, {"Ratio": "#N/A"}), (map $1.errors, recs),
                file);
            assertEq((NOTHING, 0.5, NOTHING), (map $1.Ratio, recs), file);
            assertEq("*hash<auto>", readExcelTypes(file, {"error_field": "errors"}).errors, file);
            recs = readExcel(file, {"error_field": "errors", "error_cells": "text"});
            assertEq(("#DIV/0!", 0.5, "#N/A"), (map $1.Ratio, recs), file);
            assertEq({"Ratio": "#DIV/0!", "Lookup": "#N/A"}, recs[0].errors, file);
        }
        # the allowed values of the option are checked with the options
        assertThrows("OPTION-VALUE-ERROR", "error_cells", \readExcel(), ("errors.xlsx", {"error_cells": "skip"}));
        assertThrows("EXCEL-READ-OPTION-ERROR", "error_field.*\"Ratio\".*column", \readExcel(),
            ("errors.xlsx", {"error_field": "Ratio"}));
    }

