#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit

%exec-class JniClassOptionsRestrictedLoadTest

#! Pins the load-time rule for Programs restricted only with parse options (qore#5742)
/** Module code is checked against parse options when the module is loaded; at run time only sandbox restrictions
    apply to it.  This test loads no provider module itself, so each restricted Program here is the first to load it:
    the load is refused.  (A restricted Program that uses a module that trusted code loaded runs it with the module's
    own options; that case is not a run-time boundary and is not tested.)
*/
class JniClassOptionsRestrictedLoadTest inherits QUnit::Test {
    private:internal {
        const Modules = ("JdbcDataProvider", "JakartaJmsDataProvider", "KafkaDataProvider", "CamelDataProvider",
            "JasperReportsDataProvider", "FlywayDataProvider");
    }

    constructor() : QUnit::Test("JNI class options restricted load", "1.0", \ARGV) {
        addTestCase("a restricted Program that loads a provider module first is refused at load", \loadTest());
        set_return_value(main());
    }

    loadTest() {
        foreach string mod in (Modules) {
            Program p(PO_NEW_STYLE | PO_NO_UNCONTROLLED_APIS);
            try {
                p.loadModule(mod);
                fail(mod + ": the load was not refused");
            } catch (hash<ExceptionInfo> ex) {
                # refused when the module's code is parsed, or when its initialization creates a Java object; or the
                # module's classpath commands are refused first by the jni module: with a jni module built for a
                # module API before 2.3, which judges a module command by the Program that loads the module
                # (qore#5699), and with module API 2.3, which judges it by the code that issued it, when the module is
                # not library code (its directory is not in the module path, only added with %prepend-module-path),
                # so that its Program has the parse options of the restricted Program that loads it
                if (ex.err == "JNI-SANDBOX-ERROR") {
                    hash<auto> jh = get_module_hash().jni;
                    if (jh.api_major > 2 || (jh.api_major == 2 && jh.api_minor >= 3)) {
                        assertRegex("^cannot use the \"[-a-z]+\" module command, which .*: the code that issued the "
                            "command has parse options that forbid it", ex.desc, mod + ": refused at load by the jni "
                            "module for the parse options of the module's code");
                    } else {
                        assertRegex("module command .* cannot be used in a Program that does not allow uncontrolled "
                            "APIs", ex.desc, mod + ": refused at load by the jni module");
                    }
                    continue;
                }
                assertTrue(inlist(ex.err, ("PARSE-EXCEPTION", "ILLEGAL-CLASS-INSTANTIATION")),
                    mod + ": refused at load: " + ex.err + ": " + ex.desc);
            }
        }
    }
}
